  </Item>
  <Item class="StarterPlayer" referent="46">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">120</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <token name="CameraMode">1</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="47">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="48">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Survive at Sea · Client bootstrap
-- If Rojo didn't sync the Workspace map (common on existing places like "dnd"),
-- this client builds the boarding dock locally so you still see it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local LobbyWorld = require(Shared:WaitForChild("LobbyWorld"))

local LobbyUI = require(script:WaitForChild("Lobby"):WaitForChild("LobbyUI"))
local HelmController = require(script:WaitForChild("Lobby"):WaitForChild("HelmController"))
local OceanController = require(script:WaitForChild("Lobby"):WaitForChild("OceanController"))
local LobbyFX = require(script:WaitForChild("Lobby"):WaitForChild("LobbyFX"))
local ClockHUD = require(script:WaitForChild("Lobby"):WaitForChild("ClockHUD"))
local WeatherController = require(script:WaitForChild("Gameplay"):WaitForChild("WeatherController"))
local GunController = require(script:WaitForChild("Gameplay"):WaitForChild("GunController"))
local MeleeController = require(script:WaitForChild("Gameplay"):WaitForChild("MeleeController"))
local DragController = require(script:WaitForChild("Gameplay"):WaitForChild("DragController"))
local MerchantController = require(script:WaitForChild("Gameplay"):WaitForChild("MerchantController"))

print(`[SurviveAtSea] Client hello — welcome aboard {Config.GameName}`)

-- Prefer a server-replicated lobby; otherwise build one here.
local builtLocalLobby = false
local lobby = Workspace:FindFirstChild("SurviveAtSeaLobby")
if not lobby then
	lobby = Workspace:WaitForChild("SurviveAtSeaLobby", 2)
end
if not lobby then
	print("[SurviveAtSea] No lobby in Workspace yet — building on client")
	lobby = LobbyWorld.ensure()
	builtLocalLobby = true
else
	print("[SurviveAtSea] Found Workspace.SurviveAtSeaLobby")
end

-- Fault isolation: a crash in any single controller must never stop the rest
-- (especially the portal wiring below) from starting.
local function safeStart(label: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn(`[SurviveAtSea] {label} failed to start (lobby still playable):`, err)
	end
end

-- Lighting lock first so lobby stays daytime before any crew UI opens.
safeStart("ClockHUD", ClockHUD.start)
safeStart("LobbyFX", LobbyFX.start)
safeStart("LobbyUI", LobbyUI.start)
safeStart("HelmController", HelmController.start)
safeStart("GunController", GunController.start)
safeStart("MeleeController", MeleeController.start)
safeStart("DragController", DragController.start)
safeStart("MerchantController", MerchantController.start)

local player = Players.LocalPlayer

local function seat(character: Model)
	task.defer(function()
		LobbyWorld.seatCharacter(character)
	end)
end

if player.Character then
	seat(player.Character)
end
player.CharacterAdded:Connect(seat)

-- Only a client-built emergency lobby needs local prompt wiring. Server-replicated
-- prompts are owned by PortalService; wiring those again here caused one press to
-- open the Create a Server flow twice.
if builtLocalLobby then
	task.spawn(function()
		local openEvent = ReplicatedStorage:FindFirstChild("SurviveAtSeaOpenCreate")
		if not (openEvent and openEvent:IsA("BindableEvent")) then
			openEvent = Instance.new("BindableEvent")
			openEvent.Name = "SurviveAtSeaOpenCreate"
			openEvent.Parent = ReplicatedStorage
		end

		local wiredPrompts: { [ProximityPrompt]: boolean } = {}
		local folderConn: RBXScriptConnection? = nil
		local lobbyChildConn: RBXScriptConnection? = nil

		local function wirePrompt(model: Model)
			local indexValue = model:FindFirstChild("PortalIndex")
			local promptAnchor = model:FindFirstChild("PromptAnchor")
			local prompt = promptAnchor and promptAnchor:FindFirstChild("BoardPrompt")
			if not (indexValue and indexValue:IsA("IntValue") and prompt and prompt:IsA("ProximityPrompt")) then
				return
			end
			if wiredPrompts[prompt] then
				return
			end
			wiredPrompts[prompt] = true

			local portalIndex = indexValue.Value
			-- Press-E fallback; walk-in is handled by the server PortalService.
			prompt.Triggered:Connect(function()
				(openEvent :: BindableEvent):Fire(portalIndex)
			end)
		end

		local function wirePortalsFolder(portals: Instance)
			if folderConn then
				folderConn:Disconnect()
				folderConn = nil
			end

			for prompt, _ in wiredPrompts do
				if not prompt.Parent then
					wiredPrompts[prompt] = nil
				end
			end

			for _, model in portals:GetChildren() do
				if model:IsA("Model") then
					wirePrompt(model)
				end
			end

			folderConn = portals.ChildAdded:Connect(function(child)
				if child:IsA("Model") then
					task.defer(function()
						wirePrompt(child)
					end)
				end
			end)

			print("[SurviveAtSea] Local fallback portals wired:", #portals:GetChildren())
		end

		local function bindLobbyInstance(lobbyInstance: Instance)
			if lobbyChildConn then
				lobbyChildConn:Disconnect()
				lobbyChildConn = nil
			end

			local portals = lobbyInstance:FindFirstChild("Portals")
			if portals then
				wirePortalsFolder(portals)
			else
				warn("[SurviveAtSea] Local fallback portals folder missing")
			end

			lobbyChildConn = lobbyInstance.ChildAdded:Connect(function(child)
				if child.Name == "Portals" then
					wirePortalsFolder(child)
				end
			end)
		end

		bindLobbyInstance(lobby)
	end)
end

pcall(function()
	local Lighting = game:GetService("Lighting")
	-- Client ClockHUD owns ClockTime / brightness / fog — only strip neon bloom here.
	for _, child in Lighting:GetChildren() do
		if child:IsA("BloomEffect") then
			child:Destroy()
		end
	end
end)

-- After lighting baseline so underwater fog restore matches the open-sea look.
safeStart("OceanController", OceanController.start)

-- Open-sea weather only (rain / thunder / overcast). Lobby pier stays clear.
safeStart("WeatherController", WeatherController.start)
]]></string>
        </Properties>
        <Item class="Folder" referent="49">
          <Properties>
            <string name="Name">Gameplay</string>
          </Properties>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">DragController</string>
              <string name="Source"><![CDATA[-- Hold-to-drag world loot: RMB (PC), RT / ButtonR2 (console), hold touch / Drag button (mobile).
-- Weld / unweld: X key · Xbox ButtonX (ProximityPrompt) · Weld button on mobile.
-- Place equipped loot tool with left click / LT / Place button.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlatformInput = require(script.Parent.Parent:WaitForChild("Lobby"):WaitForChild("PlatformInput"))

local DragController = {}

local player = Players.LocalPlayer

local DragStart: RemoteEvent? = nil
local DragUpdate: RemoteEvent? = nil
local DragEnd: RemoteEvent? = nil
local WeldRemote: RemoteEvent? = nil
local UnweldRemote: RemoteEvent? = nil
local PlaceRemote: RemoteEvent? = nil

local holding = false
local holdStartedAt = 0
local dragging = false
local dragPropId: string? = nil
local dragModel: Model? = nil
local mobileGui: ScreenGui? = nil
local hintGui: ScreenGui? = nil

-- Shared flag so MeleeController won't swing while we're dragging / aiming loot
DragController.isBusy = false

local function getCamera(): Camera?
	return Workspace.CurrentCamera
end

local function findLootModel(inst: Instance?): Model?
	local cur: Instance? = inst
	while cur and cur ~= Workspace do
		if cur:IsA("Model") and cur:GetAttribute("IsLootProp") == true then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

local function raycastLoot(maxDist: number): (Model?, Vector3?)
	local camera = getCamera()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (camera and root and root:IsA("BasePart")) then
		return nil, nil
	end

	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * maxDist

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true

	local result = Workspace:Raycast(origin, direction, params)
	if not result then
		return nil, nil
	end
	local model = findLootModel(result.Instance)
	if not model then
		return nil, nil
	end
	if (root.Position - result.Position).Magnitude > Config.Loot.DragRange + 6 then
		return nil, nil
	end
	return model, result.Position
end

local function targetCFrameForModel(model: Model): CFrame?
	local camera = getCamera()
	local primary = model.PrimaryPart
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (camera and primary and root and root:IsA("BasePart")) then
		return nil
	end

	local hitDist = 10
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, model }
	params.IgnoreWater = true
	local result = Workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * Config.Loot.DragRange, params)
	local aimPos: Vector3
	if result then
		aimPos = result.Position + result.Normal * (math.max(primary.Size.X, primary.Size.Y, primary.Size.Z) * 0.35)
	else
		aimPos = camera.CFrame.Position + camera.CFrame.LookVector * hitDist
	end

	-- Keep roughly upright for walls / torches
	local kind = model:GetAttribute("LootKind")
	local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if flatLook.Magnitude < 0.05 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end

	if kind == "Wall" then
		return CFrame.lookAt(aimPos, aimPos + flatLook)
	elseif kind == "Torch" then
		return CFrame.new(aimPos)
	elseif kind == "Plank" then
		return CFrame.lookAt(aimPos, aimPos + flatLook) * CFrame.Angles(0, 0, 0)
	end
	return CFrame.new(aimPos)
end

local function beginDrag(model: Model)
	local propId = model:GetAttribute("PropId")
	if typeof(propId) ~= "string" then
		return
	end
	dragging = true
	dragPropId = propId
	dragModel = model
	DragController.isBusy = true
	if DragStart then
		DragStart:FireServer(propId)
	end
end

local function endDrag()
	if dragging and dragPropId and DragEnd then
		DragEnd:FireServer(dragPropId)
	end
	dragging = false
	dragPropId = nil
	dragModel = nil
	holding = false
	DragController.isBusy = false
end

local function tryStartHold()
	if dragging then
		return
	end
	holding = true
	holdStartedAt = os.clock()
	local model = raycastLoot(Config.Loot.DragRange + 10)
	if model then
		DragController.isBusy = true
		-- Start after short hold so tap-melee still works when not aiming loot
		task.delay(Config.Loot.DragHoldSeconds, function()
			if holding and not dragging then
				local still, _ = raycastLoot(Config.Loot.DragRange + 10)
				if still == model then
					beginDrag(model)
				else
					DragController.isBusy = false
				end
			end
		end)
	end
end

local function onRelease()
	if dragging then
		endDrag()
		return
	end
	holding = false
	if not dragging then
		DragController.isBusy = false
	end
end

local function tryWeldKey()
	local model = dragModel or select(1, raycastLoot(Config.Loot.DragRange + 8))
	if not model then
		return
	end
	local propId = model:GetAttribute("PropId")
	if typeof(propId) ~= "string" then
		return
	end
	if model:GetAttribute("Welded") == true then
		if UnweldRemote then
			UnweldRemote:FireServer(propId)
		end
	else
		if WeldRemote then
			WeldRemote:FireServer(propId)
		end
	end
end

local function tryPlaceTool()
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not (tool and tool:GetAttribute("IsLootTool") == true) then
		return
	end
	local camera = getCamera()
	if not (camera and PlaceRemote) then
		return
	end
	PlaceRemote:FireServer(camera.CFrame.LookVector)
end

local function destroyMobileGui()
	if mobileGui then
		mobileGui:Destroy()
		mobileGui = nil
	end
end

local function isVoyageActive(): boolean
	return player:GetAttribute("VoyageActive") == true
end

local function ensureMobileGui()
	local kind = PlatformInput.getDeviceKind()
	if (kind ~= "Phone" and kind ~= "Tablet") or not isVoyageActive() then
		destroyMobileGui()
		return
	end
	if mobileGui then
		return
	end

	local scale = PlatformInput.scaleForDevice()
	local size = math.floor(58 * scale)

	local gui = Instance.new("ScreenGui")
	gui.Name = "LootDragButtons"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 36
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local function makeBtn(name: string, text: string, pos: UDim2, color: Color3): TextButton
		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.AnchorPoint = Vector2.new(0, 1)
		btn.Position = pos
		btn.Size = UDim2.fromOffset(size, size)
		btn.BackgroundColor3 = color
		btn.BackgroundTransparency = 0.08
		btn.BorderSizePixel = 0
		btn.Font = Config.UI.Font
		btn.Text = text
		btn.TextColor3 = Config.Theme.Foam
		btn.TextScaled = true
		btn.AutoButtonColor = true
		btn.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 14)
		corner.Parent = btn
		return btn
	end

	local dragBtn = makeBtn("Drag", "DRAG", UDim2.new(0, 20, 1, -170), Color3.fromRGB(48, 88, 78))
	local weldBtn = makeBtn("Weld", "WELD", UDim2.new(0, 20, 1, -240), Color3.fromRGB(72, 56, 28))
	local placeBtn = makeBtn("Place", "PLACE", UDim2.new(0, 88, 1, -170), Color3.fromRGB(58, 72, 96))

	dragBtn.MouseButton1Down:Connect(function()
		tryStartHold()
	end)
	dragBtn.MouseButton1Up:Connect(function()
		onRelease()
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			-- Safety: if touch ended anywhere, stop drag hold from the button
			if holding or dragging then
				-- only if our drag button started it — handled via MouseButton1Up mostly
			end
		end
	end)

	weldBtn.MouseButton1Click:Connect(function()
		tryWeldKey()
	end)
	placeBtn.MouseButton1Click:Connect(function()
		tryPlaceTool()
	end)

	mobileGui = gui
end

local function ensureHint()
	if hintGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "LootHint"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.Parent = player:WaitForChild("PlayerGui")

	local label = Instance.new("TextLabel")
	label.Name = "Hint"
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, -24)
	label.Size = UDim2.new(0.7, 0, 0, 28)
	label.BackgroundTransparency = 1
	label.Font = Config.UI.BodyFont
	label.TextSize = 15
	label.TextColor3 = Config.Theme.Foam
	label.TextTransparency = 0.15
	label.Text = "Hold RMB / RT to drag loot · X to weld · E to pick up"
	label.Parent = gui
	hintGui = gui
end

function DragController.isLookingAtLoot(): boolean
	local model = raycastLoot(Config.Loot.DragRange + 6)
	return model ~= nil
end

function DragController.start()
	DragStart = Remotes.waitFor("LootDragStart") :: RemoteEvent
	DragUpdate = Remotes.waitFor("LootDragUpdate") :: RemoteEvent
	DragEnd = Remotes.waitFor("LootDragEnd") :: RemoteEvent
	WeldRemote = Remotes.waitFor("LootWeld") :: RemoteEvent
	UnweldRemote = Remotes.waitFor("LootUnweld") :: RemoteEvent
	PlaceRemote = Remotes.waitFor("LootPlace") :: RemoteEvent

	ensureMobileGui()
	ensureHint()

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.ButtonR2 then
			tryStartHold()
			return
		end

		-- Weld / unweld: X (PC) — console uses ProximityPrompt ButtonX; also allow ButtonY as alt
		if input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.ButtonY then
			tryWeldKey()
			return
		end

		-- Place loot tool from inventory
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonL2 then
			tryPlaceTool()
			return
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.ButtonR2 then
			onRelease()
		end
	end)

	-- Touch hold anywhere when aiming at loot (phones without pressing DRAG)
	UserInputService.TouchLongPress:Connect(function(_positions, state, _processed)
		if state == Enum.UserInputState.Begin then
			tryStartHold()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			onRelease()
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not dragging or not dragPropId or not dragModel then
			return
		end
		if not dragModel.Parent then
			endDrag()
			return
		end
		local cf = targetCFrameForModel(dragModel)
		if cf and DragUpdate then
			DragUpdate:FireServer(dragPropId, cf)
		end
	end)

	player.CharacterAdded:Connect(function()
		endDrag()
		task.defer(ensureMobileGui)
	end)
	player:GetAttributeChangedSignal("VoyageActive"):Connect(function()
		if not isVoyageActive() then
			endDrag()
		end
		ensureMobileGui()
	end)
end

return DragController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">GunController</string>
              <string name="Source"><![CDATA[-- Client ranged-weapon input: while any ranged weapon (Ranged attribute) or the legacy
-- flintlock (SurviveGun) is equipped, tap / click fires; R (or a mobile button) reloads.
-- Firing an empty magazine auto-reloads so gamepad / touch players aren't stuck.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlatformInput = require(script.Parent.Parent:WaitForChild("Lobby"):WaitForChild("PlatformInput"))

local GunController = {}

local player = Players.LocalPlayer
local shootRemote: RemoteEvent? = nil
local reloadRemote: RemoteEvent? = nil
local fxRemote: RemoteEvent? = nil
local toolConns: { RBXScriptConnection } = {}
local equippedRanged: Tool? = nil
local reloadGui: ScreenGui? = nil

local function isRanged(tool: Instance?): boolean
	return tool ~= nil
		and tool:IsA("Tool")
		and (tool:GetAttribute("Ranged") == true or tool:GetAttribute("SurviveGun") == true)
end

local function clearToolConns()
	for _, conn in toolConns do
		conn:Disconnect()
	end
	table.clear(toolConns)
end

local function currentLook(): Vector3
	local cam = Workspace.CurrentCamera
	if cam then
		return cam.CFrame.LookVector
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.CFrame.LookVector
	end
	return Vector3.new(0, 0, -1)
end

local function fire(tool: Tool)
	-- Auto-reload an empty mag instead of dry-firing.
	if tool:GetAttribute("Ammo") ~= nil then
		local loaded = tool:GetAttribute("Loaded")
		if typeof(loaded) == "number" and loaded <= 0 then
			if reloadRemote then
				reloadRemote:FireServer()
			end
			return
		end
	end
	if shootRemote then
		shootRemote:FireServer(currentLook())
	end
end

local function destroyReloadButton()
	if reloadGui then
		reloadGui:Destroy()
		reloadGui = nil
	end
end

local function showReloadButton()
	destroyReloadButton()
	local kind = PlatformInput.getDeviceKind()
	if kind ~= "Phone" and kind ~= "Tablet" then
		return
	end
	if not equippedRanged then
		return
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "ReloadButton"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 35
	gui.Parent = player:WaitForChild("PlayerGui")

	local btn = Instance.new("TextButton")
	btn.Name = "Reload"
	btn.AnchorPoint = Vector2.new(1, 1)
	btn.Position = UDim2.new(1, -96, 1, -160)
	btn.Size = UDim2.fromOffset(64, 64)
	btn.BackgroundColor3 = Color3.fromRGB(40, 56, 84)
	btn.BackgroundTransparency = 0.08
	btn.BorderSizePixel = 0
	btn.Font = Enum.Font.GothamBold
	btn.Text = "RELOAD"
	btn.TextColor3 = Color3.fromRGB(220, 235, 245)
	btn.TextScaled = true
	btn.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = btn
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 18
	constraint.Parent = btn

	btn.MouseButton1Click:Connect(function()
		if reloadRemote then
			reloadRemote:FireServer()
		end
	end)

	reloadGui = gui
end

local function bindTool(tool: Tool)
	if not isRanged(tool) then
		return
	end
	table.insert(
		toolConns,
		tool.Activated:Connect(function()
			fire(tool)
		end)
	)
	table.insert(
		toolConns,
		tool.Equipped:Connect(function()
			equippedRanged = tool
			showReloadButton()
		end)
	)
	table.insert(
		toolConns,
		tool.Unequipped:Connect(function()
			if equippedRanged == tool then
				equippedRanged = nil
				destroyReloadButton()
			end
		end)
	)
	if tool.Parent == player.Character then
		equippedRanged = tool
		showReloadButton()
	end
end

local function watchCharacter(character: Model)
	clearToolConns()
	equippedRanged = nil
	destroyReloadButton()
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			bindTool(child)
		end
	end
	table.insert(
		toolConns,
		character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				bindTool(child)
			end
		end)
	)
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		table.insert(
			toolConns,
			backpack.ChildAdded:Connect(function(child)
				if child:IsA("Tool") then
					bindTool(child)
				end
			end)
		)
		for _, child in backpack:GetChildren() do
			if child:IsA("Tool") then
				bindTool(child)
			end
		end
	end
end

-- Lightweight tracer + muzzle flash so shots read clearly for everyone.
local function playShotFx(origin: Vector3, dir: Vector3)
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 220, 140)
	beam.Size = Vector3.new(0.12, 0.12, 40)
	beam.CFrame = CFrame.lookAt(origin + dir * 20, origin + dir * 40)
	beam.Parent = Workspace
	Debris:AddItem(beam, 0.06)

	local flash = Instance.new("Part")
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255, 200, 90)
	flash.Size = Vector3.new(0.8, 0.8, 0.8)
	flash.CFrame = CFrame.new(origin + dir * 1.5)
	flash.Parent = Workspace
	Debris:AddItem(flash, 0.05)
end

function GunController.start()
	shootRemote = Remotes.waitFor("ShootGun") :: RemoteEvent
	reloadRemote = Remotes.waitFor("WeaponReload") :: RemoteEvent
	fxRemote = Remotes.waitFor("WeaponFx") :: RemoteEvent

	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if not equippedRanged then
			return
		end
		if input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.DPadUp then
			if reloadRemote then
				reloadRemote:FireServer()
			end
		end
	end)

	fxRemote.OnClientEvent:Connect(function(_userId, _weaponId, origin, dir)
		if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
			playShotFx(origin, dir)
		end
	end)
end

return GunController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">InventoryHUD</string>
              <string name="Source"><![CDATA[-- Small always-on HUD showing looted currency (Doubloons / Scrap) and the equipped
-- ranged weapon's ammo (loaded / reserve). Reads Player attributes which the server
-- keeps authoritative and which replicate automatically to the owning client.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local InventoryHUD = {}

local player = Players.LocalPlayer
local panel: Frame? = nil
local doubloonLabel: TextLabel? = nil
local scrapLabel: TextLabel? = nil
local armorLabel: TextLabel? = nil
local ammoLabel: TextLabel? = nil
local equippedRanged: Tool? = nil
local loadedConn: RBXScriptConnection? = nil
-- Panel is hidden on the lobby pier and only shown once the player is out at sea
-- (on a crew). Mirrors WeatherController / OceanController gameplay gating.
local atSea = false

local function makeRow(parent: Instance, order: number, color: Color3): TextLabel
	local row = Instance.new("TextLabel")
	row.Name = "Row" .. order
	row.LayoutOrder = order
	row.Size = UDim2.new(1, 0, 0, 24)
	row.BackgroundTransparency = 1
	row.Font = Enum.Font.GothamBold
	row.TextXAlignment = Enum.TextXAlignment.Left
	row.TextSize = 16
	row.TextColor3 = color
	row.Text = ""
	row.Parent = parent
	return row
end

local function refreshCurrency()
	if doubloonLabel then
		local v = player:GetAttribute(Config.Currency.Doubloons.Attribute) or 0
		doubloonLabel.Text = `Doubloons: {v}`
	end
	if scrapLabel then
		local v = player:GetAttribute(Config.Currency.Scrap.Attribute) or 0
		scrapLabel.Text = `Scrap: {v}`
	end
end

local function refreshArmor()
	if not armorLabel then
		return
	end
	local rating = player:GetAttribute("ArmorRating")
	rating = if typeof(rating) == "number" then rating else 0
	-- Only show the armor line once you're actually wearing something.
	if rating <= 0 then
		armorLabel.Visible = false
		armorLabel.Text = ""
		return
	end
	armorLabel.Visible = true
	armorLabel.Text = `Armor: {math.floor(rating * 100 + 0.5)}%`
end

-- Pick the ammo type to display when no gun is equipped: whichever reserve the
-- player is actually carrying the most of. Returns nil when they hold no ammo.
local function bestCarriedAmmo(): ({ [string]: any }?, number)
	local bestDef: { [string]: any }? = nil
	local bestReserve = 0
	for _, ammoDef in Weapons.Ammo do
		local reserve = player:GetAttribute(ammoDef.Attribute)
		reserve = if typeof(reserve) == "number" then reserve else 0
		if reserve > bestReserve then
			bestReserve = reserve
			bestDef = ammoDef
		end
	end
	return bestDef, bestReserve
end

local function refreshAmmo()
	if not ammoLabel then
		return
	end
	-- Ammo shows whenever the player has ammo — either loaded in an equipped gun or
	-- sitting in reserve. With no ammo at all the line is hidden entirely (not blank).
	local tool = equippedRanged
	if tool and tool.Parent then
		local ammoId = tool:GetAttribute("Ammo")
		if typeof(ammoId) == "string" then
			-- Per-gun ammo: the equipped gun's own type + chambered / reserve counts.
			local ammoDef = Weapons.Ammo[ammoId]
			local reserve = player:GetAttribute(ammoDef and ammoDef.Attribute) or 0
			local loaded = tool:GetAttribute("Loaded") or 0
			local label = ammoDef and ammoDef.Label or ammoId
			ammoLabel.Visible = true
			ammoLabel.Text = `{label}: {loaded} / {reserve}`
			return
		end
	end

	-- No gun equipped: still surface the reserve the player is carrying so ammo looted
	-- before finding a weapon is visible. Nothing carried → hide the line.
	local ammoDef, reserve = bestCarriedAmmo()
	if ammoDef and reserve > 0 then
		ammoLabel.Visible = true
		ammoLabel.Text = `{ammoDef.Label}: {reserve}`
		return
	end

	ammoLabel.Visible = false
	ammoLabel.Text = ""
end

local function watchEquipped(tool: Tool?)
	if loadedConn then
		loadedConn:Disconnect()
		loadedConn = nil
	end
	equippedRanged = tool
	if tool then
		loadedConn = tool:GetAttributeChangedSignal("Loaded"):Connect(refreshAmmo)
	end
	refreshAmmo()
end

local function isRanged(tool: Instance?): boolean
	-- Match the gun controller: real ranged weapons (Ranged) and the legacy flintlock.
	return tool ~= nil
		and tool:IsA("Tool")
		and (tool:GetAttribute("Ranged") == true or tool:GetAttribute("SurviveGun") == true)
end

local function hookCharacter(character: Model)
	watchEquipped(nil)
	character.ChildAdded:Connect(function(child)
		if isRanged(child) then
			watchEquipped(child :: Tool)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if child == equippedRanged then
			watchEquipped(nil)
		end
	end)
	for _, child in character:GetChildren() do
		if isRanged(child) then
			watchEquipped(child :: Tool)
		end
	end
end

local function applyVisibility()
	if panel then
		panel.Visible = atSea
	end
end

local function setAtSea(value: boolean)
	if atSea == value then
		return
	end
	atSea = value
	applyVisibility()
end

-- Detect lobby vs. out-at-sea the same way WeatherController does: seed from the
-- GetLobbyState RemoteFunction, then follow PartyUpdated. Panel hides on the pier
-- (no party) and appears once you're on a crew.
local function watchPartyState()
	task.spawn(function()
		local ok, folder = pcall(function()
			return Remotes.getFolder()
		end)
		if not ok or not folder then
			return
		end
		local getLobbyState = folder:WaitForChild("GetLobbyState", 30)
		if getLobbyState and getLobbyState:IsA("RemoteFunction") then
			local success, lobbyState = pcall(function()
				return getLobbyState:InvokeServer()
			end)
			if success and typeof(lobbyState) == "table" then
				setAtSea(typeof(lobbyState.party) == "table")
			end
		end
		local partyUpdated = folder:WaitForChild("PartyUpdated", 30)
		if partyUpdated and partyUpdated:IsA("RemoteEvent") then
			partyUpdated.OnClientEvent:Connect(function(party)
				if typeof(party) == "table" and party.__openCreate then
					return
				end
				setAtSea(typeof(party) == "table")
			end)
		end
	end)
end

function InventoryHUD.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "InventoryHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.DisplayOrder = 22
	gui.Parent = player:WaitForChild("PlayerGui")

	panel = Instance.new("Frame")
	panel.Name = "Panel"
	-- Hidden until watchPartyState confirms we're on a crew (out at sea).
	panel.Visible = false
	panel.AnchorPoint = Vector2.new(0, 0)
	panel.Position = UDim2.new(0, 16, 0, 96)
	panel.Size = UDim2.fromOffset(190, 108)
	panel.BackgroundColor3 = Color3.fromRGB(10, 24, 36)
	panel.BackgroundTransparency = 0.25
	panel.BorderSizePixel = 0
	panel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = panel
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 6)
	pad.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = panel

	doubloonLabel = makeRow(panel, 1, Color3.fromRGB(255, 214, 120))
	scrapLabel = makeRow(panel, 2, Color3.fromRGB(190, 200, 210))
	armorLabel = makeRow(panel, 3, Color3.fromRGB(170, 220, 175))
	ammoLabel = makeRow(panel, 4, Color3.fromRGB(150, 205, 255))

	-- Currency attribute listeners
	player:GetAttributeChangedSignal(Config.Currency.Doubloons.Attribute):Connect(refreshCurrency)
	player:GetAttributeChangedSignal(Config.Currency.Scrap.Attribute):Connect(refreshCurrency)
	player:GetAttributeChangedSignal("ArmorRating"):Connect(refreshArmor)
	for _, ammo in Weapons.Ammo do
		player:GetAttributeChangedSignal(ammo.Attribute):Connect(refreshAmmo)
	end

	refreshCurrency()
	refreshArmor()
	refreshAmmo()

	if player.Character then
		hookCharacter(player.Character)
	end
	player.CharacterAdded:Connect(hookCharacter)

	-- Gate the whole panel on lobby vs. at-sea state (starts hidden on the pier).
	applyVisibility()
	watchPartyState()
end

return InventoryHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">MeleeController</string>
              <string name="Source"><![CDATA[-- Melee input for equipped Club: right-click (PC), RT / ButtonR2 (console), tap the world (mobile).
-- Drop uses default Roblox backpack (Backspace / Xbox X / backpack drop) via CanBeDropped.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlatformInput = require(script.Parent.Parent:WaitForChild("Lobby"):WaitForChild("PlatformInput"))

-- Optional: DragController may load after us; lazy-require when swinging
local function isDragBusy(): boolean
	local drag = script.Parent:FindFirstChild("DragController")
	if not drag then
		return false
	end
	local ok, mod = pcall(require, drag)
	if not ok or typeof(mod) ~= "table" then
		return false
	end
	if mod.isBusy then
		return true
	end
	if typeof(mod.isLookingAtLoot) == "function" and mod.isLookingAtLoot() then
		return true
	end
	return false
end

local MeleeController = {}

local player = Players.LocalPlayer
local MeleeAttack: RemoteEvent? = nil
local lastClientSwing = 0
local equippedTool: Tool? = nil
local swinging = false

local function isMeleeTool(tool: Instance?): boolean
	return tool ~= nil and tool:IsA("Tool") and tool:GetAttribute("MeleeWeapon") == true
end

local function playLocalSwing(tool: Tool)
	if swinging then
		return
	end
	swinging = true

	local gripWas = tool.Grip
	local swingGrip = gripWas * CFrame.Angles(math.rad(-55), math.rad(15), math.rad(-25))
	tool.Grip = swingGrip

	local head = tool:FindFirstChild("ClubHead")
	if head and head:IsA("BasePart") then
		local flash = Instance.new("PointLight")
		flash.Brightness = 0.6
		flash.Range = 6
		flash.Color = Color3.fromRGB(255, 210, 140)
		flash.Parent = head
		task.delay(0.12, function()
			if flash.Parent then
				flash:Destroy()
			end
		end)
	end

	-- Animate grip back
	task.spawn(function()
		local duration = Config.Club.SwingDuration
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			local alpha = (os.clock() - t0) / duration
			-- Ease out back toward rest
			local eased = 1 - (1 - alpha) * (1 - alpha)
			tool.Grip = gripWas:Lerp(swingGrip, 1 - eased)
			task.wait()
		end
		tool.Grip = gripWas
		swinging = false
	end)
end

function MeleeController.requestSwing()
	if not equippedTool or not MeleeAttack then
		return
	end
	if isDragBusy() then
		return
	end
	local now = os.clock()
	if now - lastClientSwing < Config.Club.SwingCooldown * 0.85 then
		return
	end
	lastClientSwing = now
	playLocalSwing(equippedTool)
	MeleeAttack:FireServer()
end

local function onEquipped(tool: Tool)
	equippedTool = tool
end

local function onUnequipped(tool: Tool)
	if equippedTool == tool then
		equippedTool = nil
		swinging = false
	end
end

local function hookTool(tool: Tool)
	if not isMeleeTool(tool) then
		return
	end
	tool.Equipped:Connect(function()
		onEquipped(tool)
	end)
	tool.Unequipped:Connect(function()
		onUnequipped(tool)
	end)
	if tool.Parent == player.Character then
		onEquipped(tool)
	end
end

local function scanContainers()
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, child in backpack:GetChildren() do
			if child:IsA("Tool") then
				hookTool(child)
			end
		end
	end
	local character = player.Character
	if character then
		for _, child in character:GetChildren() do
			if child:IsA("Tool") then
				hookTool(child)
			end
		end
	end
end

local function hookCharacter(character: Model)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			hookTool(child)
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			hookTool(child)
		end
	end
end

function MeleeController.start()
	local attack = Remotes.waitFor("MeleeAttack")
	local swingFx = Remotes.waitFor("MeleeSwingFx")
	assert(attack:IsA("RemoteEvent") and swingFx:IsA("RemoteEvent"))
	MeleeAttack = attack

	-- Other players' swings: brief toast-free cue via their held tool grip if we can find it
	swingFx.OnClientEvent:Connect(function(userId: number, _toolName: string)
		if typeof(userId) ~= "number" or userId == player.UserId then
			return
		end
		local other = Players:GetPlayerByUserId(userId)
		local character = other and other.Character
		if not character then
			return
		end
		for _, child in character:GetChildren() do
			if isMeleeTool(child) then
				local gripWas = (child :: Tool).Grip
				;(child :: Tool).Grip = gripWas * CFrame.Angles(math.rad(-50), 0, math.rad(-20))
				task.delay(Config.Club.SwingDuration, function()
					if child.Parent then
						(child :: Tool).Grip = gripWas
					end
				end)
				break
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if not equippedTool then
			return
		end
		-- Don't swing when dragging loot or aiming at a draggable prop (hold RT / RMB)
		if isDragBusy() then
			return
		end

		-- PC: right mouse button
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			MeleeController.requestSwing()
			return
		end

		-- Console / gamepad: right trigger
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			MeleeController.requestSwing()
			return
		end
	end)

	-- Mobile players attack by tapping the world. UI taps are marked processed, so
	-- this does not conflict with the boat, loot, or Roblox's built-in controls.
	UserInputService.TouchTap:Connect(function(_touchPositions, processed)
		local kind = PlatformInput.getDeviceKind()
		if processed or (kind ~= "Phone" and kind ~= "Tablet") then
			return
		end
		MeleeController.requestSwing()
	end)

	local function onBackpack(backpack: Instance)
		backpack.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				hookTool(child)
			end
		end)
	end

	if player:FindFirstChild("Backpack") then
		onBackpack(player.Backpack)
	end
	player.ChildAdded:Connect(function(child)
		if child.Name == "Backpack" then
			onBackpack(child)
		end
	end)

	if player.Character then
		hookCharacter(player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		equippedTool = nil
		swinging = false
		hookCharacter(character)
		task.defer(scanContainers)
	end)

	scanContainers()
end

return MeleeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">MerchantController</string>
              <string name="Source"><![CDATA[-- Merchant shop UI. When the server fires MerchantShop (after you trigger a merchant's
-- Trade prompt) this opens a panel listing wares: buy weapons / ammo with Doubloons, or
-- craft ammo from Scrap. Purchases go through the MerchantTrade RemoteFunction which the
-- server validates (proximity + currency).

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local MerchantController = {}

local player = Players.LocalPlayer
local shopRemote: RemoteEvent? = nil
local tradeRemote: RemoteFunction? = nil
local gui: ScreenGui? = nil
local currencyLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local scrollFrame: ScrollingFrame? = nil
local shopItems: { any }? = nil
-- Forward declaration: invokeTrade() re-runs populateRows() after a sale changes your bag.
local populateRows: () -> ()

local function currencyText(): string
	local d = player:GetAttribute(Config.Currency.Doubloons.Attribute) or 0
	local s = player:GetAttribute(Config.Currency.Scrap.Attribute) or 0
	return `Doubloons: {d}    Scrap: {s}`
end

local function refreshCurrency()
	if currencyLabel then
		currencyLabel.Text = currencyText()
	end
end

local function close()
	if gui then
		gui:Destroy()
		gui = nil
		currencyLabel = nil
		statusLabel = nil
		scrollFrame = nil
		shopItems = nil
	end
end

local function setStatus(message: string?, ok: boolean?)
	if statusLabel then
		statusLabel.Text = message or ""
		statusLabel.TextColor3 = if ok
			then Color3.fromRGB(150, 235, 160)
			else Color3.fromRGB(240, 150, 150)
	end
end

-- Buy a shop row (numeric index) or run a structured action (e.g. a sell payload table).
local function invokeTrade(payload: any)
	if not tradeRemote then
		return
	end
	local ok, result = pcall(function()
		return tradeRemote:InvokeServer(payload)
	end)
	if ok and typeof(result) == "table" then
		setStatus(result.message, result.ok)
		refreshCurrency()
		-- A sale removes an item from your bag; rebuild the list to reflect it.
		populateRows()
	end
end

-- Every Tool the player is carrying (equipped + backpack), with its merchant sell value.
local function collectSellables(): { { name: string, itemId: string?, value: number } }
	local out = {}
	local function scan(container: Instance?)
		if not container then
			return
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") then
				local itemId = child:GetAttribute("ItemId")
				local rarity = child:GetAttribute("Rarity")
				local idStr = if typeof(itemId) == "string" then itemId else nil
				table.insert(out, {
					name = child.Name,
					itemId = idStr,
					value = Weapons.sellValue(idStr, if typeof(rarity) == "number" then rarity else nil),
				})
			end
		end
	end
	scan(player.Character)
	scan(player:FindFirstChildOfClass("Backpack"))
	return out
end

local function makeSectionHeader(order: number, text: string)
	local lbl = Instance.new("TextLabel")
	lbl.Name = "Header"
	lbl.Size = UDim2.new(1, -6, 0, 24)
	lbl.LayoutOrder = order
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextSize = 14
	lbl.TextColor3 = Color3.fromRGB(150, 200, 255)
	lbl.Text = text
	lbl.Parent = scrollFrame
end

local function makeRow(order: number, text: string, bg: Color3): TextButton
	local row = Instance.new("TextButton")
	row.Name = "Row"
	row.Size = UDim2.new(1, -6, 0, 42)
	row.LayoutOrder = order
	row.BackgroundColor3 = bg
	row.Font = Enum.Font.GothamBold
	row.TextSize = 15
	row.TextColor3 = Color3.fromRGB(230, 240, 248)
	row.Text = text
	row.Parent = scrollFrame
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0, 8)
	rc.Parent = row
	return row
end

-- (Re)build the buy/craft rows and the sell rows in the shop scroll.
function populateRows()
	local scroll = scrollFrame
	if not scroll then
		return
	end
	for _, c in scroll:GetChildren() do
		if c:IsA("TextButton") or c:IsA("TextLabel") then
			c:Destroy()
		end
	end

	local order = 0

	makeSectionHeader(order, "Buy & Craft")
	order += 1
	if shopItems then
		for index, entry in shopItems do
			order += 1
			local currencyDef = Config.Currency[entry.Currency]
			local currencyName = currencyDef and currencyDef.Label or entry.Currency
			local bg = if entry.Currency == "Scrap"
				then Color3.fromRGB(30, 46, 40)
				else Color3.fromRGB(26, 42, 62)
			local row = makeRow(order, `{entry.Label}   —   {entry.Cost} {currencyName}`, bg)
			row.MouseButton1Click:Connect(function()
				invokeTrade(index)
			end)
		end
	end

	order += 1
	makeSectionHeader(order, "Sell — the merchant buys anything")
	order += 1
	local sellables = collectSellables()
	if #sellables == 0 then
		local empty = Instance.new("TextLabel")
		empty.Name = "Empty"
		empty.Size = UDim2.new(1, -6, 0, 30)
		empty.LayoutOrder = order
		empty.BackgroundTransparency = 1
		empty.Font = Enum.Font.GothamMedium
		empty.TextXAlignment = Enum.TextXAlignment.Left
		empty.TextSize = 13
		empty.TextColor3 = Color3.fromRGB(160, 175, 185)
		empty.Text = "Nothing to sell right now."
		empty.Parent = scroll
	else
		for _, item in sellables do
			order += 1
			local row = makeRow(order, `Sell {item.name}   —   +{item.value} Doubloons`, Color3.fromRGB(48, 40, 26))
			row.MouseButton1Click:Connect(function()
				invokeTrade({ action = "sell", tool = item.name, itemId = item.itemId })
			end)
		end
	end
end

local function open(shop: { any })
	close()

	local screen = Instance.new("ScreenGui")
	screen.Name = "MerchantShop"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 60
	screen.Parent = player:WaitForChild("PlayerGui")

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(420, 460)
	panel.BackgroundColor3 = Color3.fromRGB(14, 30, 44)
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = panel
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(46, 92, 168)
	stroke.Thickness = 2
	stroke.Parent = panel

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -24, 0, 34)
	title.Position = UDim2.fromOffset(12, 10)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextSize = 22
	title.TextColor3 = Color3.fromRGB(150, 200, 255)
	title.Text = "Merchant"
	title.Parent = panel

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.fromOffset(30, 30)
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -10, 0, 12)
	closeBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 34)
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Text = "X"
	closeBtn.TextColor3 = Color3.fromRGB(240, 220, 220)
	closeBtn.TextSize = 18
	closeBtn.Parent = panel
	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(0, 6)
	cc.Parent = closeBtn
	closeBtn.MouseButton1Click:Connect(close)

	currencyLabel = Instance.new("TextLabel")
	currencyLabel.Size = UDim2.new(1, -24, 0, 24)
	currencyLabel.Position = UDim2.fromOffset(12, 46)
	currencyLabel.BackgroundTransparency = 1
	currencyLabel.Font = Enum.Font.GothamMedium
	currencyLabel.TextXAlignment = Enum.TextXAlignment.Left
	currencyLabel.TextSize = 15
	currencyLabel.TextColor3 = Color3.fromRGB(255, 214, 120)
	currencyLabel.Text = currencyText()
	currencyLabel.Parent = panel

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -24, 1, -120)
	scroll.Position = UDim2.fromOffset(12, 76)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = panel
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = scroll

	scrollFrame = scroll
	shopItems = shop

	statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(1, -24, 0, 28)
	statusLabel.AnchorPoint = Vector2.new(0, 1)
	statusLabel.Position = UDim2.new(0, 12, 1, -10)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.GothamMedium
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.TextSize = 14
	statusLabel.TextColor3 = Color3.fromRGB(190, 205, 215)
	statusLabel.Text = "Buy with Doubloons, craft with Scrap, or sell anything you carry."
	statusLabel.Parent = panel

	gui = screen

	-- Build the buy + sell lists now that the scroll and status label exist.
	populateRows()

	-- Keep currency line live while the shop is open.
	player:GetAttributeChangedSignal(Config.Currency.Doubloons.Attribute):Connect(refreshCurrency)
	player:GetAttributeChangedSignal(Config.Currency.Scrap.Attribute):Connect(refreshCurrency)
end

function MerchantController.start()
	shopRemote = Remotes.waitFor("MerchantShop") :: RemoteEvent
	tradeRemote = Remotes.waitFor("MerchantTrade") :: RemoteFunction

	shopRemote.OnClientEvent:Connect(function(shop)
		if typeof(shop) == "table" then
			open(shop)
		end
	end)
end

return MerchantController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">WeatherController</string>
              <string name="Source"><![CDATA[-- Open-sea weather FX (rain, thunder, overcast grading). Lobby stays clear:
-- effects only run while the local player is in a crew (party ~= nil).
-- Harmless / cosmetic. Lighting overlays are applied locally so pier players
-- keep the untouched day/night look.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DayNight = require(Shared:WaitForChild("DayNight"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Weather = require(Shared:WaitForChild("Weather"))
local OceanConfig = require(Shared:WaitForChild("OceanConfig"))

local ClockHUD = require(script.Parent.Parent.Lobby.ClockHUD)

local WeatherController = {}

local started = false
local atSea = false
local fxFolder: Folder? = nil
local rainAnchor: Part? = nil
local rainEmitter: ParticleEmitter? = nil
local mistEmitter: ParticleEmitter? = nil
local weatherCc: ColorCorrectionEffect? = nil
local flashCc: ColorCorrectionEffect? = nil
local rainSound: Sound? = nil
local thunderSound: Sound? = nil
local windSound: Sound? = nil
local lastFlashAttr: number? = nil
local flashToken = 0
local ambienceTarget = {
	rain = 0,
	wind = 0,
}

-- Particle / ambience assets (catalog ids — no custom uploads required).
local RAIN_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"
local RAIN_SOUND_ID = "rbxassetid://151755512"
local THUNDER_SOUND_ID = "rbxassetid://166185616"
local WIND_SOUND_ID = "rbxassetid://166185967"

local function ensureFolder(): Folder
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local folder = Instance.new("Folder")
	folder.Name = "SurviveAtSeaWeatherFX"
	folder.Parent = Workspace.CurrentCamera or Workspace
	fxFolder = folder
	return folder
end

local function ensureWeatherCc(): ColorCorrectionEffect
	if weatherCc and weatherCc.Parent then
		return weatherCc
	end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SurviveAtSeaWeather"
	cc.Enabled = false
	cc.Parent = Lighting
	weatherCc = cc
	return cc
end

local function ensureFlashCc(): ColorCorrectionEffect
	if flashCc and flashCc.Parent then
		return flashCc
	end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SurviveAtSeaLightningFlash"
	cc.Enabled = false
	cc.Brightness = 0
	cc.Contrast = 0
	cc.Saturation = 0
	cc.TintColor = Color3.fromRGB(220, 230, 255)
	cc.Parent = Lighting
	flashCc = cc
	return cc
end

local function makeSound(name: string, soundId: string, looped: boolean): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Looped = looped
	sound.Volume = 0
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.Parent = SoundService
	return sound
end

local function ensureSounds()
	if not rainSound then
		rainSound = makeSound("SurviveAtSeaRain", RAIN_SOUND_ID, true)
	end
	if not windSound then
		windSound = makeSound("SurviveAtSeaWind", WIND_SOUND_ID, true)
	end
	if not thunderSound then
		thunderSound = makeSound("SurviveAtSeaThunder", THUNDER_SOUND_ID, false)
		thunderSound.Volume = 0.85
	end
end

local function ensureRainRig()
	local folder = ensureFolder()
	if rainAnchor and rainAnchor.Parent then
		return
	end

	local anchor = Instance.new("Part")
	anchor.Name = "RainEmitter"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(90, 1, 90)
	anchor.Parent = folder
	rainAnchor = anchor

	local rain = Instance.new("ParticleEmitter")
	rain.Name = "Rain"
	rain.Texture = RAIN_TEXTURE
	rain.Color = ColorSequence.new(Color3.fromRGB(190, 210, 230))
	rain.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.5, 0.08),
		NumberSequenceKeypoint.new(1, 0.04),
	})
	rain.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(0.8, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	rain.Lifetime = NumberRange.new(0.55, 0.85)
	rain.Rate = 0
	rain.Speed = NumberRange.new(42, 58)
	rain.SpreadAngle = Vector2.new(4, 4)
	rain.Drag = 0
	rain.Acceleration = Vector3.new(2, -110, 1)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.LightEmission = 0.05
	rain.LightInfluence = 0.65
	rain.LockedToPart = false
	rain.Parent = anchor
	rainEmitter = rain

	local mist = Instance.new("ParticleEmitter")
	mist.Name = "CloudMist"
	mist.Texture = RAIN_TEXTURE
	mist.Color = ColorSequence.new(Color3.fromRGB(160, 175, 190))
	mist.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 8),
		NumberSequenceKeypoint.new(1, 18),
	})
	mist.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.82),
		NumberSequenceKeypoint.new(1, 1),
	})
	mist.Lifetime = NumberRange.new(2.5, 4.5)
	mist.Rate = 0
	mist.Speed = NumberRange.new(0.2, 1.2)
	mist.SpreadAngle = Vector2.new(180, 180)
	mist.Drag = 1
	mist.Acceleration = Vector3.new(0, 0.15, 0)
	mist.EmissionDirection = Enum.NormalId.Top
	mist.LightEmission = 0.02
	mist.LightInfluence = 0.8
	mist.LockedToPart = false
	mist.Parent = anchor
	mistEmitter = mist
end

local function restoreLobbyLighting()
	-- Match ClockHUD's midday pier lock — do not leave cycle/storm fog on the lobby.
	local look = DayNight.lightingFor(1)
	Lighting.ClockTime = 12
	Lighting.FogColor = look.FogColor
	Lighting.FogStart = look.FogStart
	Lighting.FogEnd = look.FogEnd
	Lighting.Brightness = look.Brightness
	Lighting.Ambient = look.Ambient
	Lighting.OutdoorAmbient = look.OutdoorAmbient

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Density = look.AtmosphereDensity
		atmosphere.Haze = look.AtmosphereHaze
		atmosphere.Glare = look.AtmosphereGlare
		atmosphere.Color = look.AtmosphereColor
		atmosphere.Decay = look.AtmosphereDecay
	end

	local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if sunRays then
		sunRays.Intensity = look.SunRaysIntensity
	end
end

local function setAtSea(value: boolean)
	if atSea == value then
		return
	end
	atSea = value
	if not value then
		-- Hard stop — lobby must not keep rain / storm grading.
		if rainEmitter then
			rainEmitter.Rate = 0
		end
		if mistEmitter then
			mistEmitter.Rate = 0
		end
		if weatherCc then
			weatherCc.Enabled = false
		end
		if flashCc then
			flashCc.Enabled = false
			flashCc.Brightness = 0
		end
		if rainSound then
			rainSound.Volume = 0
			if rainSound.IsPlaying then
				rainSound:Stop()
			end
		end
		if windSound then
			windSound.Volume = 0
			if windSound.IsPlaying then
				windSound:Stop()
			end
		end
		ambienceTarget.rain = 0
		ambienceTarget.wind = 0
		restoreLobbyLighting()
	end
end

local function applyLightingOverlay(state: Weather.WeatherState)
	-- Skip while underwater — OceanController owns that lens.
	local cam = Workspace.CurrentCamera
	if cam and cam.CFrame.Position.Y < OceanConfig.SurfaceY - 0.15 then
		if weatherCc then
			weatherCc.Enabled = false
		end
		return
	end

	local day = if ClockHUD.isGameplayActive()
		then ClockHUD.getGameplayState()
		else DayNight.getState(Workspace:GetServerTimeNow())
	local base = DayNight.lightingFor(day.dayAmount)
	local over = Weather.lightingOverlay(state)

	Lighting.FogColor = base.FogColor:Lerp(over.FogColor, math.clamp(state.cloud * 0.9 + state.rain * 0.2, 0, 1))
	Lighting.FogStart = base.FogStart * over.FogStartMul
	Lighting.FogEnd = base.FogEnd * over.FogEndMul
	Lighting.Brightness = base.Brightness * over.BrightnessMul

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Density = math.clamp(base.AtmosphereDensity + over.AtmosphereDensityAdd, 0, 0.7)
		atmosphere.Haze = math.clamp(base.AtmosphereHaze + over.AtmosphereHazeAdd, 0, 10)
		atmosphere.Glare = base.AtmosphereGlare * over.AtmosphereGlareMul
		atmosphere.Color = base.AtmosphereColor:Lerp(Color3.fromRGB(120, 135, 150), state.cloud * 0.65)
		atmosphere.Decay = base.AtmosphereDecay:Lerp(Color3.fromRGB(40, 48, 62), state.cloud * 0.55)
	end

	local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if sunRays then
		sunRays.Intensity = base.SunRaysIntensity * over.SunRaysMul
	end

	local cc = ensureWeatherCc()
	cc.Enabled = true
	cc.TintColor = over.ColorCorrectionTint
	cc.Brightness = over.ColorCorrectionBrightnessAdd
	cc.Contrast = over.ColorCorrectionContrastAdd
	cc.Saturation = over.ColorCorrectionSaturationAdd
end

local function syncRainRig(state: Weather.WeatherState, dt: number)
	ensureRainRig()
	local cam = Workspace.CurrentCamera
	if not (cam and rainAnchor) then
		return
	end

	-- Keep a rain volume above / around the camera so drops fill the view.
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.05 then
		flat = flat.Unit
	else
		flat = Vector3.new(0, 0, -1)
	end
	local pos = cam.CFrame.Position + flat * 18 + Vector3.new(0, 28, 0)
	rainAnchor.CFrame = CFrame.new(pos)

	local rainRate = state.rain * 280
	local mistRate = state.cloud * 6 + state.rain * 4
	if rainEmitter then
		-- Ease rates so showers swell instead of popping on.
		rainEmitter.Rate = rainEmitter.Rate + (rainRate - rainEmitter.Rate) * math.clamp(dt * 1.8, 0, 1)
		rainEmitter.Acceleration = Vector3.new(3 + state.rain * 4, -100 - state.rain * 40, 2)
	end
	if mistEmitter then
		mistEmitter.Rate = mistEmitter.Rate + (mistRate - mistEmitter.Rate) * math.clamp(dt * 1.2, 0, 1)
	end
end

local function syncAmbience(state: Weather.WeatherState, dt: number)
	ensureSounds()
	ambienceTarget.rain = if state.rain > 0.05 then math.clamp(0.12 + state.rain * 0.55, 0, 0.7) else 0
	ambienceTarget.wind = math.clamp(state.cloud * 0.18 + state.rain * 0.12 + state.thunderChance * 0.1, 0, 0.35)

	if rainSound then
		local goal = ambienceTarget.rain
		rainSound.Volume += (goal - rainSound.Volume) * math.clamp(dt * 1.4, 0, 1)
		if rainSound.Volume > 0.02 and not rainSound.IsPlaying then
			rainSound:Play()
		elseif rainSound.Volume < 0.01 and rainSound.IsPlaying then
			rainSound:Stop()
		end
	end
	if windSound then
		local goal = ambienceTarget.wind
		windSound.Volume += (goal - windSound.Volume) * math.clamp(dt * 1.1, 0, 1)
		if windSound.Volume > 0.02 and not windSound.IsPlaying then
			windSound:Play()
		elseif windSound.Volume < 0.01 and windSound.IsPlaying then
			windSound:Stop()
		end
	end
end

local function playLightningFlash(intensity: number)
	flashToken += 1
	local token = flashToken
	local cc = ensureFlashCc()
	cc.Enabled = true
	cc.Brightness = 0.55 * intensity
	cc.Contrast = 0.08 * intensity
	cc.Saturation = -0.12 * intensity

	-- Brief whiteout, then a softer afterglow — reads as real lightning.
	task.spawn(function()
		task.wait(0.05)
		if token ~= flashToken then
			return
		end
		TweenService:Create(cc, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Brightness = 0.12 * intensity,
		}):Play()
		task.wait(0.22)
		if token ~= flashToken then
			return
		end
		TweenService:Create(cc, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Brightness = 0,
			Contrast = 0,
			Saturation = 0,
		}):Play()
		task.wait(0.6)
		if token == flashToken then
			cc.Enabled = false
		end
	end)

	ensureSounds()
	if thunderSound then
		-- Delay rumble slightly after the flash (sound travels).
		local delaySec = math.clamp(0.35 + (1 - intensity) * 1.6, 0.25, 2.2)
		task.delay(delaySec, function()
			if not atSea then
				return
			end
			thunderSound.PlaybackSpeed = 0.92 + math.random() * 0.16
			thunderSound.Volume = 0.45 + intensity * 0.5
			thunderSound:Play()
		end)
	end
end

local function watchPartyState()
	task.spawn(function()
		local ok, folder = pcall(function()
			return Remotes.getFolder()
		end)
		if not ok or not folder then
			return
		end
		local partyUpdated = folder:WaitForChild("PartyUpdated", 30)
		local getLobbyState = folder:WaitForChild("GetLobbyState", 30)
		if getLobbyState and getLobbyState:IsA("RemoteFunction") then
			local success, lobbyState = pcall(function()
				return getLobbyState:InvokeServer()
			end)
			if success and typeof(lobbyState) == "table" then
				setAtSea(typeof(lobbyState.party) == "table")
			end
		end
		if partyUpdated and partyUpdated:IsA("RemoteEvent") then
			partyUpdated.OnClientEvent:Connect(function(party)
				if typeof(party) == "table" and party.__openCreate then
					return
				end
				setAtSea(typeof(party) == "table")
			end)
		end
	end)
end

function WeatherController.start()
	if started then
		return
	end
	started = true

	ensureWeatherCc()
	ensureFlashCc()
	ensureSounds()
	watchPartyState()

	-- Reparent FX folder under camera when it appears.
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		if fxFolder and Workspace.CurrentCamera then
			fxFolder.Parent = Workspace.CurrentCamera
		end
	end)

	Workspace:GetAttributeChangedSignal(Weather.ATTR_FLASH):Connect(function()
		if not atSea then
			return
		end
		local flashAt = Workspace:GetAttribute(Weather.ATTR_FLASH)
		if typeof(flashAt) ~= "number" then
			return
		end
		if lastFlashAttr == flashAt then
			return
		end
		lastFlashAttr = flashAt
		local state = Weather.readStateFromWorkspace(Workspace)
		local intensity = if state then math.clamp(0.45 + state.thunderChance * 0.55, 0.4, 1) else 0.7
		playLightningFlash(intensity)
	end)

	-- Weather changes slowly, but the lighting overlay rewrites a dozen Lighting /
	-- Atmosphere properties (and scans for effects) every call — far too costly per
	-- frame. Run it and the sound ambience on a ~12 Hz tick; only the rain rig, which
	-- must track the camera, stays per-frame.
	local heavyAccum = 0
	local HEAVY_INTERVAL = 1 / 12
	RunService.RenderStepped:Connect(function(dt)
		if not atSea then
			return
		end
		local state = Weather.readStateFromWorkspace(Workspace)
		if not state then
			return
		end
		syncRainRig(state, dt)

		heavyAccum += dt
		if heavyAccum < HEAVY_INTERVAL then
			return
		end
		local step = heavyAccum
		heavyAccum = 0
		applyLightingOverlay(state)
		syncAmbience(state, step)
	end)

	print("[SurviveAtSea] Weather controller ready — open-sea only, lobby untouched")
end

return WeatherController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="56">
          <Properties>
            <string name="Name">Lobby</string>
          </Properties>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">ClockHUD</string>
              <string name="Source"><![CDATA[-- Gameplay clock lives in the crew menu (old Cast Off slot).
-- Lobby stays daytime with no clock — this module only applies lighting.
-- While on a crew, lighting follows that crew's cycle (always starts at 9:00 AM).

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local DayNight = require(Shared:WaitForChild("DayNight"))

local ClockHUD = {}

local started = false
local inGameplay = false
-- Server time when the local player's crew was created (nil in lobby).
local cycleOrigin: number? = nil

local atmosphere: Atmosphere? = nil
local sunRays: SunRaysEffect? = nil
local colorCorrection: ColorCorrectionEffect? = nil
local sky: Sky? = nil

local function ensureEffects()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	sky = Lighting:FindFirstChildOfClass("Sky")

	colorCorrection = nil
	for _, child in Lighting:GetChildren() do
		if
			child:IsA("ColorCorrectionEffect")
			and child.Name ~= "SurviveAtSeaUnderwater"
			and child.Name ~= "SurviveAtSeaWeather"
			and child.Name ~= "SurviveAtSeaLightningFlash"
		then
			colorCorrection = child
			break
		end
	end
end

local function applyLook(clockTime: number, dayAmount: number)
	ensureEffects()
	local look = DayNight.lightingFor(dayAmount)

	Lighting.ClockTime = clockTime
	Lighting.Brightness = look.Brightness
	Lighting.Ambient = look.Ambient
	Lighting.OutdoorAmbient = look.OutdoorAmbient
	Lighting.FogColor = look.FogColor
	Lighting.FogStart = look.FogStart
	Lighting.FogEnd = look.FogEnd

	if atmosphere then
		atmosphere.Density = look.AtmosphereDensity
		atmosphere.Color = look.AtmosphereColor
		atmosphere.Decay = look.AtmosphereDecay
		atmosphere.Haze = look.AtmosphereHaze
		atmosphere.Glare = look.AtmosphereGlare
	end

	if sunRays then
		sunRays.Intensity = look.SunRaysIntensity
	end

	if colorCorrection then
		colorCorrection.TintColor = look.ColorCorrectionTint
		colorCorrection.Brightness = look.ColorCorrectionBrightness
		colorCorrection.Contrast = look.ColorCorrectionContrast
		colorCorrection.Saturation = look.ColorCorrectionSaturation
	end

	if sky then
		sky.StarCount = look.StarCount
	end
end

-- Midday lobby look — pier is always bright daytime.
local function applyLobbyDay()
	applyLook(12, 1)
end

local function applyGameplayCycle()
	local state = DayNight.getState(Workspace:GetServerTimeNow(), cycleOrigin)
	applyLook(state.clockTime, state.dayAmount)
end

function ClockHUD.setGameplayActive(active: boolean, origin: number?)
	inGameplay = active
	cycleOrigin = if active then origin else nil
	if active then
		applyGameplayCycle()
	else
		applyLobbyDay()
	end
end

function ClockHUD.isGameplayActive(): boolean
	return inGameplay
end

function ClockHUD.getCycleOrigin(): number?
	return cycleOrigin
end

-- Shared day/night state for ocean fog / weather overlays while at sea.
function ClockHUD.getGameplayState(): DayNight.CycleState
	return DayNight.getState(Workspace:GetServerTimeNow(), cycleOrigin)
end

function ClockHUD.start()
	if started then
		return
	end
	started = true

	-- Default: lobby daytime until the crew menu says otherwise.
	applyLobbyDay()

	local accum = 0
	RunService.RenderStepped:Connect(function(dt)
		accum += dt
		if accum < 0.2 then
			return
		end
		accum = 0
		if inGameplay then
			applyGameplayCycle()
		else
			applyLobbyDay()
		end
	end)

	print("[SurviveAtSea] Lobby daytime lock ready (crew clocks start at 9:00 AM)")
end

return ClockHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">HelmController</string>
              <string name="Source"><![CDATA[-- Client helm: while locked at the wheel, stream look + throttle to the server.
-- Drive: W/S (computer), left-stick Y (console), small ↑/↓ arrows (mobile).
-- Mount/dismount is server-authoritative.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VRService = game:GetService("VRService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlatformInput = require(script.Parent:WaitForChild("PlatformInput"))

local HelmController = {}

local player = Players.LocalPlayer
local helming = false
local tipGui: ScreenGui? = nil
local arrowsGui: ScreenGui? = nil
local sendAccum = 0
local throttleSendAccum = 0
local lastSentThrottle = 0
local heartbeatConn: RBXScriptConnection? = nil
local jumpConn: RBXScriptConnection? = nil
local inputBeganConn: RBXScriptConnection? = nil
local inputEndedConn: RBXScriptConnection? = nil
local HelmDismountRemote: RemoteEvent? = nil
local HelmThrottleRemote: RemoteEvent? = nil
local previousCameraMode: Enum.CameraMode? = nil
local previousMinZoom: number? = nil
local previousMaxZoom: number? = nil

-- Keyboard / touch button holds
local forwardHeld = false
local backwardHeld = false
-- Touch arrow buttons (mobile)
local mobileForward = false
local mobileBackward = false

-- Leave mapping: JumpRequest covers PC / touch jump / console A.
-- ButtonB is the console/VR "back" affordance so players aren't stuck without a jump bind.
local DISMOUNT_GAMEPAD = {
	[Enum.KeyCode.ButtonB] = true,
}

local function destroyTip()
	if tipGui then
		tipGui:Destroy()
		tipGui = nil
	end
end

local function destroyArrows()
	if arrowsGui then
		arrowsGui:Destroy()
		arrowsGui = nil
	end
	mobileForward = false
	mobileBackward = false
end

local function leaveHintText(): string
	local kind = PlatformInput.getDeviceKind()
	if kind == "Console" then
		return "Look to steer  ·  Stick forward/back to sail  ·  B / Jump to leave"
	elseif kind == "VR" then
		return "Look to steer  ·  Stick to sail  ·  Jump / B to leave"
	elseif kind == "Phone" or kind == "Tablet" then
		return "Look to steer  ·  Arrows to sail  ·  Jump to leave"
	end
	return "Look to steer  ·  Hold W / S to sail  ·  Jump to leave"
end

local function showTip()
	destroyTip()
	local scale = PlatformInput.scaleForDevice()
	local kind = PlatformInput.getDeviceKind()

	local gui = Instance.new("ScreenGui")
	gui.Name = "HelmTip"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 40
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	-- VR / console need the tip in screen space; laser still hits ClickablePrompt on the wheel
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Sit above mobile jump / thumb controls; console/VR get a larger scaled bar
	local bottomPad = if kind == "Phone" or kind == "Tablet" then 88 elseif kind == "VR" then 56 else 40

	local label = Instance.new("TextLabel")
	label.Name = "Tip"
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, -bottomPad)
	label.Size = UDim2.fromOffset(math.floor(520 * scale), math.floor(54 * scale))
	label.BackgroundColor3 = Color3.fromRGB(10, 28, 42)
	label.BackgroundTransparency = 0.15
	label.Font = Config.UI.Font
	label.Text = leaveHintText()
	label.TextColor3 = Config.Theme.Foam
	label.TextScaled = true
	label.Parent = gui

	local sizeConstraint = Instance.new("UITextSizeConstraint")
	sizeConstraint.MinTextSize = 12
	sizeConstraint.MaxTextSize = if kind == "Console" or kind == "VR" then 26 else 20
	sizeConstraint.Parent = label

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Color = Config.Theme.UIAccent
	stroke.Thickness = 1.2
	stroke.Transparency = 0.35
	stroke.Parent = label

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = label

	tipGui = gui
end

local function bindArrowHold(button: GuiButton, setHeld: (boolean) -> ())
	button.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			setHeld(true)
		end
	end)
	button.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			setHeld(false)
		end
	end)
	button.MouseButton1Up:Connect(function()
		setHeld(false)
	end)
end

local function showMobileArrows()
	destroyArrows()
	local kind = PlatformInput.getDeviceKind()
	if kind ~= "Phone" and kind ~= "Tablet" then
		return
	end

	local scale = PlatformInput.scaleForDevice()
	local size = math.floor(46 * scale)
	local gap = math.floor(8 * scale)

	local gui = Instance.new("ScreenGui")
	gui.Name = "HelmDriveArrows"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 41
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Keep steering clear of the default mobile jump button on the right.
	local stack = Instance.new("Frame")
	stack.Name = "ArrowStack"
	stack.AnchorPoint = Vector2.new(0, 1)
	stack.Position = UDim2.new(0, 18, 1, -160)
	stack.Size = UDim2.fromOffset(size, size * 2 + gap)
	stack.BackgroundTransparency = 1
	stack.Parent = gui

	local function makeArrow(name: string, text: string, yOffset: number): TextButton
		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.AnchorPoint = Vector2.new(0.5, 0)
		btn.Position = UDim2.new(0.5, 0, 0, yOffset)
		btn.Size = UDim2.fromOffset(size, size)
		btn.BackgroundColor3 = Color3.fromRGB(10, 28, 42)
		btn.BackgroundTransparency = 0.12
		btn.BorderSizePixel = 0
		btn.Font = Config.UI.Font
		btn.Text = text
		btn.TextColor3 = Config.Theme.Foam
		btn.TextScaled = true
		btn.AutoButtonColor = true
		btn.Parent = stack

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = btn

		local stroke = Instance.new("UIStroke")
		stroke.Color = Config.Theme.UIAccent
		stroke.Thickness = 1.1
		stroke.Transparency = 0.3
		stroke.Parent = btn

		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 4)
		pad.PaddingRight = UDim.new(0, 4)
		pad.PaddingTop = UDim.new(0, 2)
		pad.PaddingBottom = UDim.new(0, 2)
		pad.Parent = btn

		local sizeConstraint = Instance.new("UITextSizeConstraint")
		sizeConstraint.MinTextSize = 14
		sizeConstraint.MaxTextSize = 28
		sizeConstraint.Parent = btn

		return btn
	end

	local up = makeArrow("Forward", "▲", 0)
	local down = makeArrow("Backward", "▼", size + gap)
	bindArrowHold(up, function(held)
		mobileForward = held
	end)
	bindArrowHold(down, function(held)
		mobileBackward = held
	end)

	arrowsGui = gui
end

local function currentLook(): Vector3
	-- VR: prefer headset forward so look-steer tracks the head, not a flat camera pivot
	if VRService.VREnabled then
		local ok, headCf = pcall(function()
			return VRService:GetUserCFrame(Enum.UserCFrame.Head)
		end)
		local cam = workspace.CurrentCamera
		if ok and headCf and cam then
			local worldHead = cam.CFrame * headCf
			return worldHead.LookVector
		end
	end

	local cam = workspace.CurrentCamera
	if cam then
		return cam.CFrame.LookVector
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.CFrame.LookVector
	end
	return Vector3.new(0, 0, -1)
end

local function readStickThrottle(): number
	local deadzone = Config.Helm.StickDeadzone
	local best = 0
	local bestMag = 0
	for _, gamepad in UserInputService:GetConnectedGamepads() do
		local ok, states = pcall(function()
			return UserInputService:GetGamepadState(gamepad)
		end)
		if not ok or not states then
			continue
		end
		for _, input in states do
			-- Left stick Y: up = forward (+), down = reverse (−). Roblox Thumbstick Y is up-positive.
			if input.KeyCode == Enum.KeyCode.Thumbstick1 then
				local y = input.Position.Y
				local mag = math.abs(y)
				if mag > deadzone and mag > bestMag then
					bestMag = mag
					-- Remap past deadzone into -1..1
					local sign = if y > 0 then 1 else -1
					best = sign * math.clamp((mag - deadzone) / (1 - deadzone), 0, 1)
				end
			end
		end
	end
	return best
end

local function keyboardThrottle(): number
	-- Poll keys every tick so focus/chat glitches can't leave us stuck at 0
	local forward = forwardHeld
		or UserInputService:IsKeyDown(Enum.KeyCode.W)
		or UserInputService:IsKeyDown(Enum.KeyCode.Up)
	local backward = backwardHeld
		or UserInputService:IsKeyDown(Enum.KeyCode.S)
		or UserInputService:IsKeyDown(Enum.KeyCode.Down)
	local digital = 0
	if forward then
		digital += 1
	end
	if backward then
		digital -= 1
	end
	return math.clamp(digital, -1, 1)
end

local function currentThrottle(): number
	-- Digital holds (keyboard W/S or mobile arrows) win when pressed
	local digital = keyboardThrottle()
	if mobileForward then
		digital = math.clamp(digital + 1, -1, 1)
	end
	if mobileBackward then
		digital = math.clamp(digital - 1, -1, 1)
	end
	if digital ~= 0 then
		return digital
	end

	-- Console / gamepad analog when no digital hold
	local kind = PlatformInput.getDeviceKind()
	if kind == "Console" or kind == "VR" or UserInputService.GamepadEnabled then
		return readStickThrottle()
	end

	return 0
end

local function setHelmCamera(active: boolean)
	if VRService.VREnabled then
		return
	end

	if active then
		if previousCameraMode == nil then
			previousCameraMode = player.CameraMode
			previousMinZoom = player.CameraMinZoomDistance
			previousMaxZoom = player.CameraMaxZoomDistance
		end
		-- Pull the normal Roblox camera behind and above the character. This keeps
		-- the wheel, mast, horizon, and shoreline visible while look-to-steer still
		-- reads the camera's forward direction.
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = Config.Helm.CameraDistance
		player.CameraMaxZoomDistance = Config.Helm.CameraDistance
	else
		player.CameraMode = previousCameraMode or Enum.CameraMode.LockFirstPerson
		player.CameraMinZoomDistance = previousMinZoom or 0.5
		player.CameraMaxZoomDistance = previousMaxZoom or 120
		previousCameraMode = nil
		previousMinZoom = nil
		previousMaxZoom = nil
	end
end

local function requestDismount()
	if helming and HelmDismountRemote then
		HelmDismountRemote:FireServer()
	end
end

local function pushThrottle(force: boolean?)
	if not (helming and HelmThrottleRemote) then
		return
	end
	local throttle = currentThrottle()
	if force or math.abs(throttle - lastSentThrottle) > 0.02 then
		lastSentThrottle = throttle
		HelmThrottleRemote:FireServer(throttle)
	end
end

local function stopSending()
	helming = false
	setHelmCamera(false)
	sendAccum = 0
	throttleSendAccum = 0
	lastSentThrottle = 0
	forwardHeld = false
	backwardHeld = false
	destroyTip()
	destroyArrows()
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
	if jumpConn then
		jumpConn:Disconnect()
		jumpConn = nil
	end
	if inputBeganConn then
		inputBeganConn:Disconnect()
		inputBeganConn = nil
	end
	if inputEndedConn then
		inputEndedConn:Disconnect()
		inputEndedConn = nil
	end
end

local function startSending(HelmLook: RemoteEvent)
	if helming then
		return
	end
	helming = true
	setHelmCamera(true)
	forwardHeld = false
	backwardHeld = false
	lastSentThrottle = 0
	showTip()
	showMobileArrows()
	-- Idle at mount — tell server throttle is 0 so the raft doesn't keep old state
	pushThrottle(true)

	local lookInterval = 1 / math.max(1, Config.Helm.LookSendHz)
	local throttleInterval = 1 / math.max(1, Config.Helm.ThrottleSendHz)
	heartbeatConn = RunService.Heartbeat:Connect(function(dt)
		if not helming then
			return
		end
		sendAccum += dt
		throttleSendAccum += dt
		if sendAccum >= lookInterval then
			sendAccum = 0
			HelmLook:FireServer(currentLook())
		end
		if throttleSendAccum >= throttleInterval then
			throttleSendAccum = 0
			pushThrottle(false)
		end
	end)

	-- Jump unlocks on PC / mobile jump button / console A (JumpRequest)
	jumpConn = UserInputService.JumpRequest:Connect(function()
		requestDismount()
	end)

	inputBeganConn = UserInputService.InputBegan:Connect(function(input, processed)
		if not helming then
			return
		end
		if DISMOUNT_GAMEPAD[input.KeyCode] and not processed then
			requestDismount()
			return
		end
		-- W / S drive even if chat/processed — helm owns WalkSpeed already
		if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then
			forwardHeld = true
			pushThrottle(true)
		elseif input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then
			backwardHeld = true
			pushThrottle(true)
		end
	end)

	inputEndedConn = UserInputService.InputEnded:Connect(function(input, _processed)
		if not helming then
			return
		end
		if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then
			forwardHeld = false
			pushThrottle(true)
		elseif input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then
			backwardHeld = false
			pushThrottle(true)
		end
	end)
end

function HelmController.start()
	local HelmLook = Remotes.waitFor("HelmLook")
	local HelmThrottle = Remotes.waitFor("HelmThrottle")
	local HelmState = Remotes.waitFor("HelmState")
	local HelmDismount = Remotes.waitFor("HelmDismount")
	assert(
		HelmLook:IsA("RemoteEvent")
			and HelmThrottle:IsA("RemoteEvent")
			and HelmState:IsA("RemoteEvent")
			and HelmDismount:IsA("RemoteEvent")
	)
	HelmDismountRemote = HelmDismount
	HelmThrottleRemote = HelmThrottle

	HelmState.OnClientEvent:Connect(function(active: boolean)
		if active then
			startSending(HelmLook)
		else
			stopSending()
		end
	end)

	player.CharacterAdded:Connect(function()
		if not helming then
			destroyTip()
			destroyArrows()
		end
	end)
end

return HelmController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">LobbyFX</string>
              <string name="Source"><![CDATA[-- Client-only decorative motion for the boarding lobby.
-- The server used to run a task.spawn loop per boat / gate / flag, streaming
-- anchored-part CFrame updates to every client many times a second — the main
-- source of lobby lag. Instead the geometry is tagged (see LobbyWorld.Tags) and
-- animated here, purely locally, so nothing touches the network.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local LobbyWorld = require(Shared:WaitForChild("LobbyWorld"))

local LobbyFX = {}

local TAGS = LobbyWorld.Tags
local started = false

-- Per-instance animation state keyed by the tagged instance.
type BoatEntry = { model: Model, baseCf: CFrame, offsets: { { part: BasePart, offset: CFrame } }, phase: number }
type SwayEntry = { part: BasePart, base: CFrame, phase: number }

local boats: { [Model]: BoatEntry } = {}
local gates: { [BasePart]: SwayEntry } = {}
local flags: { [BasePart]: SwayEntry } = {}

local function trackBoat(model: Model)
	if boats[model] then
		return
	end
	local bx = model:GetAttribute("BaseX")
	local by = model:GetAttribute("BaseY")
	local bz = model:GetAttribute("BaseZ")
	local yawDeg = model:GetAttribute("YawDeg")
	if typeof(bx) ~= "number" or typeof(by) ~= "number" or typeof(bz) ~= "number" or typeof(yawDeg) ~= "number" then
		return
	end

	local baseCf = CFrame.new(bx, by, bz) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local inv = baseCf:Inverse()
	local offsets = {}
	for _, child in model:GetDescendants() do
		if child:IsA("BasePart") then
			table.insert(offsets, { part = child, offset = inv * child.CFrame })
		end
	end

	boats[model] = {
		model = model,
		baseCf = baseCf,
		offsets = offsets,
		phase = yawDeg * 0.1,
	}
end

local function trackSway(store: { [BasePart]: SwayEntry }, inst: Instance)
	if not inst:IsA("BasePart") or store[inst] then
		return
	end
	local seed = inst:GetAttribute("PhaseSeed")
	store[inst] = {
		part = inst,
		base = inst.CFrame,
		phase = if typeof(seed) == "number" then seed else 0,
	}
end

local function bindTag(tag: string, onAdded: (Instance) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		onAdded(inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(onAdded)
end

function LobbyFX.start()
	if started then
		return
	end
	started = true

	bindTag(TAGS.Boat, function(inst)
		if inst:IsA("Model") then
			trackBoat(inst)
		end
	end)
	bindTag(TAGS.Gate, function(inst)
		trackSway(gates, inst)
	end)
	bindTag(TAGS.Flag, function(inst)
		trackSway(flags, inst)
	end)

	local function drop(store, key)
		store[key] = nil
	end

	-- Re-CFraming every boat/gate/flag part touches a lot of instances. The motion is
	-- slow decorative bob/sway, so a ~30 Hz tick is visually indistinguishable from
	-- per-frame while halving the CFrame writes. Accumulated dt keeps phase timing exact.
	local fxAccum = 0
	local FX_INTERVAL = 1 / 30
	RunService.Heartbeat:Connect(function(frameDt)
		fxAccum += frameDt
		if fxAccum < FX_INTERVAL then
			return
		end
		local dt = fxAccum
		fxAccum = 0

		-- Boats: gentle bob + roll around their moored pose.
		for model, entry in boats do
			if not model.Parent then
				drop(boats, model)
				continue
			end
			entry.phase += dt
			local t = entry.phase
			local bob = math.sin(t) * 0.55
			local roll = math.rad(math.sin(t * 0.7) * 3)
			local animCf = entry.baseCf
				* CFrame.new(0, bob, 0)
				* CFrame.Angles(roll, 0, 0)
			for _, item in entry.offsets do
				if item.part.Parent then
					item.part.CFrame = animCf * item.offset
				end
			end
		end

		-- Portal gates: soft yaw sway.
		for gate, entry in gates do
			if not gate.Parent then
				drop(gates, gate)
				continue
			end
			entry.phase += dt
			gate.CFrame = entry.base * CFrame.Angles(0, math.rad(math.sin(entry.phase) * 1.8), 0)
		end

		-- Flags: two-axis flutter.
		for flag, entry in flags do
			if not flag.Parent then
				drop(flags, flag)
				continue
			end
			entry.phase += dt
			flag.CFrame = entry.base
				* CFrame.Angles(0, math.rad(math.sin(entry.phase) * 6), math.rad(math.sin(entry.phase * 1.6) * 3))
		end
	end)

	print("[SurviveAtSea] Lobby FX ready — boat/gate/flag motion runs local (no lag)")
end

return LobbyFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">LobbyUI</string>
              <string name="Source"><![CDATA[-- Survive at Sea lobby HUD — ocean themed, Dead Rails-style crew boarding.
-- Built for phone, tablet, computer, console, and VR (large targets, TextScaled, gamepad).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClockHUD = require(script.Parent.ClockHUD)
local PlatformInput = require(script.Parent.PlatformInput)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local LobbyUI = {}

local state = {
	party = nil :: any,
	portals = {} :: { any },
	createPortalIndex = 1,
	selectedMax = Config.DefaultPartySize,
	device = PlatformInput.getDeviceKind(),
}

local remotes
local screenGui
local partyPanel
local createPanel
local joinPanel
local toastFrame
local clockLabel: TextLabel? = nil
local clockStroke: UIStroke? = nil
-- Top-of-panel heading, repurposed as the live voyage day counter ("Day 3").
local dayLabel: TextLabel? = nil

-- First person is the default voyage view, but Roblox captures a PC cursor while
-- it is active.  A crew dialog is a mouse / focus driven surface, so temporarily
-- opt out while it is visible and put the player straight back into first person
-- when it closes.
local menuCameraReleased = false
local MENU_INPUT_RENDER_STEP = "SurviveAtSeaMenuInput"

-- The default Roblox camera controller re-applies LockCenter after normal input
-- handlers run. Keep this one frame after the camera so an open menu always has
-- a usable cursor on PC, even though the voyage itself remains first person.
local function enforceReleasedMenuInput()
	player.CameraMode = Enum.CameraMode.Classic
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

local function setMenuCameraReleased(released: boolean)
	if menuCameraReleased == released then
		return
	end

	menuCameraReleased = released
	if released then
		enforceReleasedMenuInput()
		RunService:BindToRenderStep(MENU_INPUT_RENDER_STEP, Enum.RenderPriority.Camera.Value + 1, enforceReleasedMenuInput)
	else
		RunService:UnbindFromRenderStep(MENU_INPUT_RENDER_STEP)
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end
end

local function selectForGamepad(target: GuiObject?)
	if not PlatformInput.isGamepadPreferred() or not target then
		return
	end

	task.defer(function()
		if target.Parent and PlatformInput.isGamepadPreferred() then
			GuiService.SelectedObject = target
		end
	end)
end

-- Objective directions HUD (top-left one-liners that fade out after a while).
local objectiveFrame: CanvasGroup? = nil
-- Bumped whenever a new objective sequence starts so any in-flight sequence bows out.
local objectiveGeneration = 0
-- Which hint set is currently playing ("lobby" / "voyage") so we don't replay on every update.
local objectivePhase: string? = nil

local function corner(parent: Instance, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = parent
	return c
end

local function stroke(parent: Instance, color: Color3?, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Config.Theme.UIAccent
	s.Thickness = thickness or 1.5
	s.Transparency = 0.25
	s.Parent = parent
	return s
end

local function textLabel(props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = props.BackgroundTransparency or 1
	label.BackgroundColor3 = props.BackgroundColor3 or Config.Theme.UIPanel
	label.Size = props.Size or UDim2.fromScale(1, 0.2)
	label.Position = props.Position or UDim2.fromScale(0, 0)
	label.Font = props.Font or Config.UI.BodyFont
	label.Text = props.Text or ""
	label.TextColor3 = props.TextColor3 or Config.Theme.UIText
	label.TextScaled = true
	label.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	label.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	label.Name = props.Name or "Label"
	label.Parent = props.Parent
	if props.BackgroundTransparency ~= 1 and props.BackgroundTransparency ~= nil then
		corner(label, 10)
	end
	local sizeConstraint = Instance.new("UITextSizeConstraint")
	sizeConstraint.MaxTextSize = props.MaxTextSize or 28
	sizeConstraint.MinTextSize = 10
	sizeConstraint.Parent = label
	return label
end

local function button(props: { [string]: any }): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = props.Name or "Button"
	btn.Size = props.Size or UDim2.new(1, 0, 0, math.max(Config.UI.MinTouchTarget, 48))
	btn.Position = props.Position or UDim2.fromScale(0, 0)
	btn.BackgroundColor3 = props.BackgroundColor3 or Config.Theme.UIAccent
	btn.TextColor3 = props.TextColor3 or Config.Theme.DeepOcean
	btn.Font = Config.UI.Font
	btn.Text = props.Text or "OK"
	btn.TextScaled = true
	btn.AutoButtonColor = true
	btn.Parent = props.Parent
	corner(btn, 12)
	stroke(btn, Color3.fromRGB(255, 255, 255), 1)

	local sizeConstraint = Instance.new("UITextSizeConstraint")
	sizeConstraint.MaxTextSize = 22
	sizeConstraint.Parent = btn

	-- Console / VR / gamepad selection feedback
	btn.SelectionImageObject = nil
	btn.Activated:Connect(function()
		if props.OnClick then
			props.OnClick()
		end
	end)

	return btn
end

local function showToast(message: string, kind: string?)
	if not toastFrame then
		return
	end
	local label = toastFrame:FindFirstChild("Message") :: TextLabel
	if not label then
		return
	end

	local color = Config.Theme.UIAccent
	if kind == "error" then
		color = Config.Theme.DangerRed
	elseif kind == "success" then
		color = Color3.fromRGB(80, 200, 140)
	elseif kind == "info" then
		color = Config.Theme.Lantern
	end

	toastFrame.BackgroundColor3 = Config.Theme.UIPanel
	stroke(toastFrame, color, 2)
	label.Text = message
	toastFrame.Visible = true
	toastFrame.GroupTransparency = 0

	TweenService:Create(toastFrame, TweenInfo.new(0.2), { GroupTransparency = 0 }):Play()
	task.delay(3.2, function()
		if label.Text == message then
			local tw = TweenService:Create(toastFrame, TweenInfo.new(0.35), { GroupTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			if label.Text == message then
				toastFrame.Visible = false
			end
		end
	end)
end

-- Cycle a list of one-line objective directions through the top-left HUD.
-- Each line fades in, lingers for an adequate read, then fades out before the next.
-- A fresh call cancels any sequence still playing (bumps the generation guard).
local function playObjectives(hints: { string })
	if not objectiveFrame or #hints == 0 then
		return
	end
	local frame = objectiveFrame
	local label = frame:FindFirstChild("Message") :: TextLabel?
	if not label then
		return
	end

	local timing = Config.ObjectiveHints
	local fadeIn = timing.FadeInSeconds or 0.45
	local hold = timing.HoldSeconds or 11
	local fadeOut = timing.FadeOutSeconds or 0.6

	objectiveGeneration += 1
	local generation = objectiveGeneration

	task.spawn(function()
		for _, text in hints do
			-- Bail out immediately if a newer sequence took over.
			if generation ~= objectiveGeneration then
				return
			end

			label.Text = text
			frame.Visible = true
			frame.GroupTransparency = 1

			local fadeInTween = TweenService:Create(frame, TweenInfo.new(fadeIn), { GroupTransparency = 0 })
			fadeInTween:Play()
			fadeInTween.Completed:Wait()

			task.wait(hold)
			if generation ~= objectiveGeneration then
				return
			end

			local fadeOutTween = TweenService:Create(frame, TweenInfo.new(fadeOut), { GroupTransparency = 1 })
			fadeOutTween:Play()
			fadeOutTween.Completed:Wait()
		end

		if generation == objectiveGeneration then
			frame.Visible = false
		end
	end)
end

-- Show the right objective directions for the current phase, but only once per phase
-- change so boarding / party refreshes don't restart the sequence every update.
local function showObjectivesForPhase(phase: string)
	if objectivePhase == phase then
		return
	end
	objectivePhase = phase
	local hints = if phase == "voyage" then Config.ObjectiveHints.Voyage else Config.ObjectiveHints.Lobby
	playObjectives(hints)
end

local function refreshClockLabel()
	if not clockLabel or not partyPanel or not partyPanel.Visible then
		return
	end

	local dayState = ClockHUD.getGameplayState()
	clockLabel.Text = dayState.displayTime
	if dayLabel then
		dayLabel.Text = `Day {dayState.dayNumber}`
	end
	if dayState.phase == "Night" then
		clockLabel.TextColor3 = Color3.fromRGB(190, 210, 235)
		if clockStroke then
			clockStroke.Color = Color3.fromRGB(90, 110, 160)
		end
	else
		clockLabel.TextColor3 = Config.Theme.UIText
		if clockStroke then
			clockStroke.Color = Config.Theme.SeaTeal
		end
	end
end

local function setGameplayMode(active: boolean, cycleOrigin: number?)
	ClockHUD.setGameplayActive(active, cycleOrigin)
	if active then
		refreshClockLabel()
	end
end

local function refreshPartyPanel()
	if not partyPanel then
		return
	end

	local party = state.party
	local title = partyPanel:FindFirstChild("Title") :: TextLabel
	local members = partyPanel:FindFirstChild("Members") :: TextLabel
	local codeLabel = partyPanel:FindFirstChild("Code") :: TextLabel
	local privacyLabel = partyPanel:FindFirstChild("Privacy") :: TextLabel
	local leaveBtn = partyPanel:FindFirstChild("Leave") :: TextButton

	if typeof(party) ~= "table" or party.__openCreate then
		partyPanel.Visible = false
		setGameplayMode(false, nil)
		if joinPanel then
			joinPanel.Visible = true
		end
		-- Back on the pier: replay the lobby "how to start" directions.
		showObjectivesForPhase("lobby")
		return
	end

	partyPanel.Visible = true
	local origin = if typeof(party.cycleOrigin) == "number" then party.cycleOrigin else nil
	setGameplayMode(true, origin)
	-- On a crew and out at sea: show the voyage survival directions.
	showObjectivesForPhase("voyage")
	-- On a crew: hide the join box so the top-right is the live code
	if joinPanel then
		joinPanel.Visible = false
	end

	-- Title slot now shows the voyage day; refreshClockLabel keeps it ticking.
	-- setGameplayMode(true, origin) above already primed ClockHUD with this crew's origin.
	title.Text = `Day {ClockHUD.getGameplayState().dayNumber}`
	codeLabel.Text = party.code
	if privacyLabel then
		privacyLabel.Text = "PRIVATE · CODE ONLY"
		privacyLabel.TextColor3 = Config.Theme.Lantern
	end

	local lines = {}
	for _, member in party.members do
		local tag = if member.isHost then "★ " else "• "
		table.insert(lines, tag .. member.displayName)
	end
	members.Text = table.concat(lines, "\n") .. `\n{ #party.members }/{party.maxPlayers}`

	leaveBtn.Visible = true
	refreshClockLabel()
end

local function openCreate(portalIndex: number)
	-- A prompt and its walk trigger can report the same interaction on adjacent
	-- frames. Keep the existing dialog and selections instead of opening/resetting
	-- a second copy of the create flow.
	if createPanel and createPanel.Visible then
		return
	end
	state.createPortalIndex = portalIndex
	state.selectedMax = Config.DefaultPartySize
	if createPanel then
		createPanel.Visible = true
		setMenuCameraReleased(true)
		local sliderLabel = createPanel:FindFirstChild("MaxLabel") :: TextLabel
		if sliderLabel then
			sliderLabel.Text = `Crew size: {state.selectedMax}`
		end
		selectForGamepad(createPanel:FindFirstChild("Minus") :: GuiObject?)
	end
	if joinPanel then
		joinPanel.Visible = false
	end
end

local function buildGui()
	local scale = PlatformInput.scaleForDevice()

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SurviveAtSeaLobbyUI"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.IgnoreGuiInset = false
	screenGui.DisplayOrder = 20
	-- Compatible with VR (laser pointer) and console focus nav
	screenGui.Parent = playerGui

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = screenGui
	PlatformInput.applySafeArea(root)

	local scaler = Instance.new("UIScale")
	scaler.Scale = scale
	scaler.Parent = root

	-- No top-left brand/tagline chrome — keeps the ocean view clean

	-- Join by code (bottom-right when not already on a crew)
	joinPanel = Instance.new("Frame")
	joinPanel.Name = "JoinPanel"
	joinPanel.BackgroundColor3 = Config.Theme.UIPanel
	joinPanel.BackgroundTransparency = 0.12
	joinPanel.Size = UDim2.new(0, 260, 0, 132)
	joinPanel.Position = UDim2.new(1, -276, 1, -148)
	joinPanel.AnchorPoint = Vector2.new(0, 0)
	joinPanel.Parent = root
	corner(joinPanel, 12)
	stroke(joinPanel)

	-- Responsive: on phones, stretch join panel
	local joinConstraint = Instance.new("UISizeConstraint")
	joinConstraint.MinSize = Vector2.new(220, 120)
	joinConstraint.MaxSize = Vector2.new(360, 160)
	joinConstraint.Parent = joinPanel

	textLabel({
		Name = "JoinTitle",
		Parent = joinPanel,
		Text = "JOIN BY CODE",
		Font = Config.UI.Font,
		Size = UDim2.new(1, -20, 0, 24),
		Position = UDim2.new(0, 10, 0, 8),
		MaxTextSize = 16,
	})

	local codeBox = Instance.new("TextBox")
	codeBox.Name = "CodeBox"
	codeBox.Size = UDim2.new(1, -20, 0, 36)
	codeBox.Position = UDim2.new(0, 10, 0, 36)
	codeBox.BackgroundColor3 = Color3.fromRGB(6, 20, 32)
	codeBox.TextColor3 = Config.Theme.Foam
	codeBox.PlaceholderText = "Code (e.g. K7QM)"
	codeBox.PlaceholderColor3 = Config.Theme.UIMuted
	codeBox.Font = Config.UI.Font
	codeBox.Text = ""
	codeBox.TextScaled = true
	codeBox.ClearTextOnFocus = false
	codeBox.Parent = joinPanel
	corner(codeBox, 8)
	stroke(codeBox, Config.Theme.SeaTeal, 1)

	button({
		Name = "JoinButton",
		Parent = joinPanel,
		Text = "Join",
		Size = UDim2.new(1, -20, 0, 40),
		Position = UDim2.new(0, 10, 0, 80),
		OnClick = function()
			remotes.JoinParty:FireServer(codeBox.Text)
		end,
	})

	-- Create crew panel
	createPanel = Instance.new("Frame")
	createPanel.Name = "CreatePanel"
	createPanel.BackgroundColor3 = Config.Theme.UIPanel
	createPanel.BackgroundTransparency = 0.08
	createPanel.Size = UDim2.new(0, 360, 0, 280)
	createPanel.Position = UDim2.fromScale(0.5, 0.55)
	createPanel.AnchorPoint = Vector2.new(0.5, 0.5)
	createPanel.Visible = false
	createPanel.Parent = root
	createPanel.SelectionGroup = true
	corner(createPanel, 18)
	stroke(createPanel, Config.Theme.SeaTeal, 2)

	textLabel({
		Name = "CreateTitle",
		Parent = createPanel,
		Text = "CREATE CREW BASE",
		Font = Enum.Font.GothamBlack,
		Size = UDim2.new(1, -28, 0, 34),
		Position = UDim2.new(0, 14, 0, 14),
		MaxTextSize = 24,
	})

	textLabel({
		Name = "CreateHint",
		Parent = createPanel,
		Text = "Private crew — share your code. Size is how many can join (up to 10).",
		TextColor3 = Config.Theme.UIMuted,
		Size = UDim2.new(1, -28, 0, 36),
		Position = UDim2.new(0, 14, 0, 46),
		MaxTextSize = 14,
	})

	local maxLabel = textLabel({
		Name = "MaxLabel",
		Parent = createPanel,
		Text = `Crew size: {state.selectedMax}`,
		Size = UDim2.new(1, -28, 0, 28),
		Position = UDim2.new(0, 14, 0, 88),
		MaxTextSize = 20,
	})

	local minusButton = button({
		Name = "Minus",
		Parent = createPanel,
		Text = "−",
		Size = UDim2.new(0, 56, 0, 48),
		Position = UDim2.new(0, 14, 0, 122),
		BackgroundColor3 = Config.Theme.SeaTeal,
		TextColor3 = Config.Theme.Foam,
		OnClick = function()
			state.selectedMax = math.max(Config.MinPartySize, state.selectedMax - 1)
			maxLabel.Text = `Crew size: {state.selectedMax}`
		end,
	})

	local plusButton = button({
		Name = "Plus",
		Parent = createPanel,
		Text = "+",
		Size = UDim2.new(0, 56, 0, 48),
		Position = UDim2.new(0, 80, 0, 122),
		BackgroundColor3 = Config.Theme.SeaTeal,
		TextColor3 = Config.Theme.Foam,
		OnClick = function()
			state.selectedMax = math.min(Config.MaxPartySize, state.selectedMax + 1)
			maxLabel.Text = `Crew size: {state.selectedMax}`
		end,
	})

	local confirmCreateButton = button({
		Name = "ConfirmCreate",
		Parent = createPanel,
		Text = "Spawn Base",
		Size = UDim2.new(0.55, -10, 0, 48),
		Position = UDim2.new(0, 14, 0, 186),
		OnClick = function()
			remotes.CreateParty:FireServer(state.createPortalIndex, state.selectedMax)
			createPanel.Visible = false
			setMenuCameraReleased(false)
		end,
	})

	local cancelCreateButton = button({
		Name = "CancelCreate",
		Parent = createPanel,
		Text = "Cancel",
		Size = UDim2.new(0.45, -18, 0, 48),
		Position = UDim2.new(0.55, 4, 0, 186),
		BackgroundColor3 = Color3.fromRGB(50, 60, 70),
		TextColor3 = Config.Theme.Foam,
		OnClick = function()
			createPanel.Visible = false
			setMenuCameraReleased(false)
			if joinPanel and not state.party then
				joinPanel.Visible = true
			end
		end,
	})

	-- Explicit links make D-pad navigation reliable on every console layout,
	-- instead of relying on screen-position heuristics.
	minusButton.NextSelectionRight = plusButton
	minusButton.NextSelectionDown = confirmCreateButton
	plusButton.NextSelectionLeft = minusButton
	plusButton.NextSelectionDown = cancelCreateButton
	confirmCreateButton.NextSelectionRight = cancelCreateButton
	confirmCreateButton.NextSelectionUp = minusButton
	cancelCreateButton.NextSelectionLeft = confirmCreateButton
	cancelCreateButton.NextSelectionUp = plusButton

	createPanel.Size = UDim2.new(0, 360, 0, 250)

	-- Compact top-right crew menu (clock sits where Cast Off used to)
	partyPanel = Instance.new("Frame")
	partyPanel.Name = "PartyPanel"
	partyPanel.BackgroundColor3 = Config.Theme.UIPanel
	partyPanel.BackgroundTransparency = 0.1
	partyPanel.Size = UDim2.new(0, 156, 0, 168)
	partyPanel.Position = UDim2.new(1, -8, 0, 6)
	partyPanel.AnchorPoint = Vector2.new(1, 0)
	partyPanel.Visible = false
	partyPanel.Parent = root
	corner(partyPanel, 8)
	stroke(partyPanel, Config.Theme.Lantern, 1.1)

	-- Was the "CREW" heading; now the live in-game day counter (same font/size).
	dayLabel = textLabel({
		Name = "Title",
		Parent = partyPanel,
		Text = "Day 1",
		Font = Enum.Font.GothamBlack,
		Size = UDim2.new(1, -12, 0, 14),
		Position = UDim2.new(0, 6, 0, 4),
		MaxTextSize = 11,
	})

	textLabel({
		Name = "CodeCaption",
		Parent = partyPanel,
		Text = "CODE",
		TextColor3 = Config.Theme.UIMuted,
		Size = UDim2.new(1, -12, 0, 10),
		Position = UDim2.new(0, 6, 0, 18),
		MaxTextSize = 9,
	})

	textLabel({
		Name = "Code",
		Parent = partyPanel,
		Text = "----",
		Font = Enum.Font.GothamBlack,
		TextColor3 = Config.Theme.UIAccent,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -12, 0, 22),
		Position = UDim2.new(0, 6, 0, 28),
		MaxTextSize = 18,
	})

	textLabel({
		Name = "Privacy",
		Parent = partyPanel,
		Text = "PRIVATE · CODE ONLY",
		TextColor3 = Config.Theme.Lantern,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -12, 0, 12),
		Position = UDim2.new(0, 6, 0, 50),
		MaxTextSize = 9,
	})

	textLabel({
		Name = "Members",
		Parent = partyPanel,
		Text = "",
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, -12, 0, 36),
		Position = UDim2.new(0, 6, 0, 64),
		MaxTextSize = 11,
	})

	-- Old Cast Off slot → live day/night clock (gameplay only)
	local clockSlot = Instance.new("Frame")
	clockSlot.Name = "ClockSlot"
	clockSlot.BackgroundColor3 = Color3.fromRGB(6, 20, 32)
	clockSlot.BackgroundTransparency = 0.25
	clockSlot.Size = UDim2.new(1, -12, 0, 26)
	clockSlot.Position = UDim2.new(0, 6, 0, 104)
	clockSlot.Parent = partyPanel
	corner(clockSlot, 6)
	clockStroke = stroke(clockSlot, Config.Theme.SeaTeal, 1)

	clockLabel = textLabel({
		Name = "Clock",
		Parent = clockSlot,
		Text = "12:00 PM",
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -6, 1, -2),
		Position = UDim2.new(0, 3, 0, 1),
		MaxTextSize = 14,
	})

	button({
		Name = "Leave",
		Parent = partyPanel,
		Text = "Leave",
		Size = UDim2.new(1, -12, 0, 22),
		Position = UDim2.new(0, 6, 0, 136),
		BackgroundColor3 = Color3.fromRGB(70, 40, 45),
		TextColor3 = Config.Theme.Foam,
		OnClick = function()
			remotes.LeaveParty:FireServer()
		end,
	})

	-- Toast — pinned to the top-center of the screen so pop-up messages read clearly.
	toastFrame = Instance.new("CanvasGroup")
	toastFrame.Name = "Toast"
	toastFrame.BackgroundColor3 = Config.Theme.UIPanel
	toastFrame.Size = UDim2.new(0.5, 0, 0, 48)
	toastFrame.AnchorPoint = Vector2.new(0.5, 0)
	toastFrame.Position = UDim2.new(0.5, 0, 0.12, 0)
	toastFrame.Visible = false
	toastFrame.GroupTransparency = 1
	toastFrame.Parent = root
	corner(toastFrame, 12)

	local toastConstraint = Instance.new("UISizeConstraint")
	toastConstraint.MinSize = Vector2.new(200, 44)
	toastConstraint.MaxSize = Vector2.new(560, 64)
	toastConstraint.Parent = toastFrame

	textLabel({
		Name = "Message",
		Parent = toastFrame,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		MaxTextSize = 20,
	})

	-- Objective directions (top-center, one line, fades out after an adequate read)
	objectiveFrame = Instance.new("CanvasGroup")
	objectiveFrame.Name = "ObjectiveHint"
	objectiveFrame.BackgroundColor3 = Config.Theme.UIPanel
	objectiveFrame.BackgroundTransparency = 0.18
	objectiveFrame.Size = UDim2.new(0, 340, 0, 40)
	objectiveFrame.AnchorPoint = Vector2.new(0.5, 0)
	objectiveFrame.Position = UDim2.new(0.5, 0, 0.03, 0)
	objectiveFrame.Visible = false
	objectiveFrame.GroupTransparency = 1
	objectiveFrame.Parent = root
	corner(objectiveFrame, 10)
	stroke(objectiveFrame, Config.Theme.Lantern, 1.5)

	local objectiveConstraint = Instance.new("UISizeConstraint")
	objectiveConstraint.MinSize = Vector2.new(240, 36)
	objectiveConstraint.MaxSize = Vector2.new(380, 44)
	objectiveConstraint.Parent = objectiveFrame

	-- Lantern accent stripe down the left edge as a little "direction" marker.
	local objectiveStripe = Instance.new("Frame")
	objectiveStripe.Name = "Stripe"
	objectiveStripe.BackgroundColor3 = Config.Theme.Lantern
	objectiveStripe.BorderSizePixel = 0
	objectiveStripe.Size = UDim2.new(0, 4, 1, -12)
	objectiveStripe.Position = UDim2.new(0, 8, 0, 6)
	objectiveStripe.Parent = objectiveFrame
	corner(objectiveStripe, 2)

	local objectiveLabel = textLabel({
		Name = "Message",
		Parent = objectiveFrame,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -28, 1, -8),
		Position = UDim2.new(0, 14, 0, 4),
		MaxTextSize = 15,
	})
	-- Keep every direction on a single line; TextScaled shrinks to fit instead of wrapping.
	objectiveLabel.TextWrapped = false

	-- Layout adaptation on resize / device
	local function relayout()
		state.device = PlatformInput.getDeviceKind()
		scaler.Scale = PlatformInput.scaleForDevice()

		local cam = workspace.CurrentCamera
		local width = if cam then cam.ViewportSize.X else 1280
		if width < 700 then
			joinPanel.Size = UDim2.new(1, -24, 0, 132)
			joinPanel.Position = UDim2.new(0, 12, 1, -148)
			partyPanel.Size = UDim2.new(0, 148, 0, 168)
			partyPanel.Position = UDim2.new(1, -6, 0, 4)
			partyPanel.AnchorPoint = Vector2.new(1, 0)
			createPanel.Size = UDim2.new(1, -24, 0, 260)
		else
			joinPanel.Size = UDim2.new(0, 260, 0, 132)
			joinPanel.Position = UDim2.new(1, -276, 1, -148)
			partyPanel.Size = UDim2.new(0, 156, 0, 168)
			partyPanel.Position = UDim2.new(1, -8, 0, 6)
			partyPanel.AnchorPoint = Vector2.new(1, 0)
		end
	end

	relayout()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(relayout)
	end
	UserInputService.LastInputTypeChanged:Connect(function()
		relayout()
		-- A controller may be connected after the UI is created. Give its D-pad a
		-- deterministic starting point whenever the spawn dialog is already open.
		if createPanel and createPanel.Visible then
			selectForGamepad(createPanel:FindFirstChild("Minus") :: GuiObject?)
		end
	end)

	-- Gamepad focus defaults
	if PlatformInput.isGamepadPreferred() then
		local joinButton = joinPanel:FindFirstChild("JoinButton")
		if joinButton and joinButton:IsA("GuiButton") then
			GuiService.SelectedObject = joinButton
		end
	end
end

local function bindRemotes()
	local folder = Remotes.getFolder()
	remotes = {
		CreateParty = folder:WaitForChild("CreateParty") :: RemoteEvent,
		JoinParty = folder:WaitForChild("JoinParty") :: RemoteEvent,
		LeaveParty = folder:WaitForChild("LeaveParty") :: RemoteEvent,
		PartyUpdated = folder:WaitForChild("PartyUpdated") :: RemoteEvent,
		PortalsUpdated = folder:WaitForChild("PortalsUpdated") :: RemoteEvent,
		Toast = folder:WaitForChild("Toast") :: RemoteEvent,
		GetLobbyState = folder:WaitForChild("GetLobbyState") :: RemoteFunction,
	}

	remotes.Toast.OnClientEvent:Connect(function(message, kind)
		showToast(tostring(message), kind)
	end)

	remotes.PartyUpdated.OnClientEvent:Connect(function(party)
		if typeof(party) == "table" and party.__openCreate then
			openCreate(party.portalIndex or 1)
			return
		end
		state.party = party
		refreshPartyPanel()
	end)

	remotes.PortalsUpdated.OnClientEvent:Connect(function(portals)
		state.portals = portals
	end)

	local ok, lobbyState = pcall(function()
		return remotes.GetLobbyState:InvokeServer()
	end)
	if ok and typeof(lobbyState) == "table" then
		state.party = lobbyState.party
		state.portals = lobbyState.portals or {}
		refreshPartyPanel()
	end
end

function LobbyUI.openCreateForPortal(portalIndex: number)
	openCreate(portalIndex)
	showToast(`Portal {portalIndex} — pick crew size, then spawn. Friends join by code.`, "info")
end

function LobbyUI.start()
	buildGui()
	bindRemotes()

	-- Tick the crew-menu clock only while gameplay (on a crew) is active.
	RunService.RenderStepped:Connect(function()
		if partyPanel and partyPanel.Visible then
			refreshClockLabel()
		end
	end)

	-- Client-built portals signal create via BindableEvent
	local openEvent = ReplicatedStorage:FindFirstChild("SurviveAtSeaOpenCreate")
	if not openEvent then
		openEvent = Instance.new("BindableEvent")
		openEvent.Name = "SurviveAtSeaOpenCreate"
		openEvent.Parent = ReplicatedStorage
	end
	(openEvent :: BindableEvent).Event:Connect(function(portalIndex)
		if typeof(portalIndex) == "number" then
			LobbyUI.openCreateForPortal(portalIndex)
		end
	end)

	showToast("Walk a portal to form a private crew. Friends join with your code.", "info")

	-- Fallback: if the phase wasn't resolved from lobby state (e.g. GetLobbyState failed),
	-- kick off the lobby directions so new players always see the objective.
	if objectivePhase == nil then
		showObjectivesForPhase("lobby")
	end

	print(`[SurviveAtSea] Lobby UI ready ({state.device})`)
end

return LobbyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">OceanController</string>
              <string name="Source"><![CDATA[-- Client ocean polish: underwater lens, raft foam, and a wake when sailing.
-- Terrain water (server) owns the wave field; this layer sells the immersion.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local OceanConfig = require(Shared:WaitForChild("OceanConfig"))
local DayNight = require(Shared:WaitForChild("DayNight"))

local ClockHUD = require(script.Parent.ClockHUD)

local OceanController = {}

local SURFACE_Y = OceanConfig.SurfaceY
local TAG_FOAM = "SurviveAtSeaOceanFoam"

local underwaterCc: ColorCorrectionEffect? = nil
local underwaterActive = false
local foamByDeck: { [BasePart]: Folder } = {}
local lastDeckPos: { [BasePart]: Vector3 } = {}
local started = false

local function surfaceFogFromCycle()
	-- Lobby is always midday; only follow the cycle while on a crew.
	local dayAmount = if ClockHUD.isGameplayActive()
		then ClockHUD.getGameplayState().dayAmount
		else 1
	local look = DayNight.lightingFor(dayAmount)
	return {
		FogColor = look.FogColor,
		FogStart = look.FogStart,
		FogEnd = look.FogEnd,
	}
end

local function ensureUnderwaterFx()
	if underwaterCc and underwaterCc.Parent then
		return underwaterCc
	end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SurviveAtSeaUnderwater"
	cc.Enabled = false
	cc.TintColor = OceanConfig.Underwater.Tint
	cc.Contrast = OceanConfig.Underwater.Contrast
	cc.Saturation = OceanConfig.Underwater.Saturation
	cc.Brightness = OceanConfig.Underwater.Brightness
	cc.Parent = Lighting
	underwaterCc = cc
	return cc
end

local function setUnderwater(active: boolean)
	local cc = ensureUnderwaterFx()
	if underwaterActive == active and cc.Enabled == active then
		return
	end
	underwaterActive = active
	cc.Enabled = active
	if active then
		Lighting.FogColor = OceanConfig.Underwater.FogColor
		Lighting.FogStart = OceanConfig.Underwater.FogStart
		Lighting.FogEnd = OceanConfig.Underwater.FogEnd
	else
		-- Restore fog from the live day/night cycle, not a stale boot snapshot.
		local fog = surfaceFogFromCycle()
		Lighting.FogColor = fog.FogColor
		Lighting.FogStart = fog.FogStart
		Lighting.FogEnd = fog.FogEnd
	end
end

local function makeEmitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = props.Name or "OceanParticle"
	e.Texture = props.Texture or "rbxasset://textures/particles/smoke_main.dds"
	e.Color = props.Color or ColorSequence.new(Color3.fromRGB(230, 245, 250))
	e.Size = props.Size
		or NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.5, 1.1),
			NumberSequenceKeypoint.new(1, 0.2),
		})
	e.Transparency = props.Transparency
		or NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(0.7, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		})
	e.Lifetime = props.Lifetime or NumberRange.new(0.45, 1.1)
	e.Rate = props.Rate or 0
	e.Speed = props.Speed or NumberRange.new(0.4, 1.8)
	e.SpreadAngle = props.SpreadAngle or Vector2.new(25, 25)
	e.Drag = props.Drag or 2.5
	e.Acceleration = props.Acceleration or Vector3.new(0, -2, 0)
	e.EmissionDirection = props.EmissionDirection or Enum.NormalId.Top
	e.LightEmission = props.LightEmission or 0.15
	e.LightInfluence = props.LightInfluence or 0.55
	e.RotSpeed = props.RotSpeed or NumberRange.new(-40, 40)
	e.Rotation = NumberRange.new(0, 360)
	e.LockedToPart = false
	e.Parent = parent
	return e
end

local function attachFoamToDeck(deck: BasePart)
	if foamByDeck[deck] then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "OceanFoamFX"
	folder.Parent = deck

	local size = deck.Size
	local half = size * 0.5
	local waterlineY = SURFACE_Y - deck.Position.Y

	local edges = {
		{ Name = "FoamNorth", Local = CFrame.new(0, waterlineY, -half.Z + 0.4), Size = Vector3.new(size.X * 0.92, 0.2, 1.2) },
		{ Name = "FoamSouth", Local = CFrame.new(0, waterlineY, half.Z - 0.4), Size = Vector3.new(size.X * 0.92, 0.2, 1.2) },
		{ Name = "FoamWest", Local = CFrame.new(-half.X + 0.4, waterlineY, 0), Size = Vector3.new(1.2, 0.2, size.Z * 0.92) },
		{ Name = "FoamEast", Local = CFrame.new(half.X - 0.4, waterlineY, 0), Size = Vector3.new(1.2, 0.2, size.Z * 0.92) },
	}

	for _, edge in edges do
		local anchor = Instance.new("Part")
		anchor.Name = edge.Name
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.CastShadow = false
		anchor.Transparency = 1
		anchor.Size = edge.Size
		anchor.CFrame = deck.CFrame * edge.Local
		anchor.Parent = folder

		local foam = makeEmitter(anchor, {
			Name = "Foam",
			Rate = 10,
			Lifetime = NumberRange.new(0.55, 1.25),
			Speed = NumberRange.new(0.2, 1.1),
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.55),
				NumberSequenceKeypoint.new(0.55, 1.6),
				NumberSequenceKeypoint.new(1, 0.3),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(0.65, 0.65),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Color = ColorSequence.new(Color3.fromRGB(235, 248, 252)),
			Acceleration = Vector3.new(0, -1.2, 0),
		})
		foam:SetAttribute("BaseRate", 10)

		local mist = makeEmitter(anchor, {
			Name = "Mist",
			Rate = 3,
			Lifetime = NumberRange.new(1.2, 2.4),
			Speed = NumberRange.new(0.1, 0.5),
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1.2),
				NumberSequenceKeypoint.new(1, 3.5),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.75),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Color = ColorSequence.new(Color3.fromRGB(190, 220, 230)),
			Acceleration = Vector3.new(0, 0.4, 0),
			LightEmission = 0.05,
		})
		mist:SetAttribute("BaseRate", 3)
	end

	local bow = Instance.new("Part")
	bow.Name = "BowSpray"
	bow.Anchored = true
	bow.CanCollide = false
	bow.CanQuery = false
	bow.CanTouch = false
	bow.CastShadow = false
	bow.Transparency = 1
	bow.Size = Vector3.new(6, 0.4, 4)
	bow.CFrame = deck.CFrame * CFrame.new(0, waterlineY, -half.Z - 1.5)
	bow.Parent = folder

	local spray = makeEmitter(bow, {
		Name = "Spray",
		Rate = 0,
		Lifetime = NumberRange.new(0.35, 0.85),
		Speed = NumberRange.new(4, 12),
		SpreadAngle = Vector2.new(35, 55),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(0.4, 1.4),
			NumberSequenceKeypoint.new(1, 0.1),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(0.55, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Color = ColorSequence.new(Color3.fromRGB(245, 252, 255)),
		Acceleration = Vector3.new(0, -18, 0),
		EmissionDirection = Enum.NormalId.Front,
		LightEmission = 0.25,
	})
	spray:SetAttribute("BaseRate", 0)

	foamByDeck[deck] = folder
	lastDeckPos[deck] = deck.Position
	CollectionService:AddTag(deck, TAG_FOAM)
end

local function detachFoam(deck: BasePart)
	local folder = foamByDeck[deck]
	if folder then
		folder:Destroy()
	end
	foamByDeck[deck] = nil
	lastDeckPos[deck] = nil
end

local function findCrewDeck(): BasePart?
	local root = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if not root then
		return nil
	end
	local bases = root:FindFirstChild("StarterBases")
	if not bases then
		return nil
	end

	local player = Players.LocalPlayer
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) then
		return nil
	end

	local best: BasePart? = nil
	local bestDist = 220
	for _, model in bases:GetChildren() do
		if not model:IsA("Model") then
			continue
		end
		local deck = model.PrimaryPart or model:FindFirstChild("Deck")
		if deck and deck:IsA("BasePart") then
			local dist = (deck.Position - hrp.Position).Magnitude
			if dist < bestDist then
				bestDist = dist
				best = deck
			end
		end
	end
	return best
end

local function syncFoamAnchors(deck: BasePart, folder: Folder, speed: number)
	local size = deck.Size
	local half = size * 0.5
	local waterlineY = SURFACE_Y - deck.Position.Y

	local layout = {
		FoamNorth = CFrame.new(0, waterlineY, -half.Z + 0.4),
		FoamSouth = CFrame.new(0, waterlineY, half.Z - 0.4),
		FoamWest = CFrame.new(-half.X + 0.4, waterlineY, 0),
		FoamEast = CFrame.new(half.X - 0.4, waterlineY, 0),
		BowSpray = CFrame.new(0, waterlineY, -half.Z - 1.5),
	}

	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") then
			local localCf = layout[child.Name]
			if localCf then
				child.CFrame = deck.CFrame * localCf
			end
			for _, emitter in child:GetChildren() do
				if emitter:IsA("ParticleEmitter") then
					local base = emitter:GetAttribute("BaseRate")
					if typeof(base) ~= "number" then
						base = emitter.Rate
					end
					if emitter.Name == "Spray" then
						emitter.Rate = if speed > 6 then math.clamp(speed * 1.8, 0, 90) else 0
					else
						emitter.Rate = (base :: number) * (1 + math.clamp(speed / 40, 0, 2.5))
					end
				end
			end
		end
	end
end

function OceanController.start()
	if started then
		return
	end
	started = true

	ensureUnderwaterFx()

	RunService.RenderStepped:Connect(function()
		local cam = Workspace.CurrentCamera
		if cam then
			local under = cam.CFrame.Position.Y < SURFACE_Y - 0.15
			setUnderwater(under)
			-- Re-assert underwater fog each frame so server day/night fog updates don't punch through.
			if under then
				Lighting.FogColor = OceanConfig.Underwater.FogColor
				Lighting.FogStart = OceanConfig.Underwater.FogStart
				Lighting.FogEnd = OceanConfig.Underwater.FogEnd
			end
		end
	end)

	-- Foam / wake upkeep is expensive (scans crew decks + re-CFrames many parts), so it
	-- runs on a fixed ~15 Hz tick instead of every frame, and is skipped entirely in the
	-- lobby where there are no crew rafts to foam.
	local foamAccum = 0
	local FOAM_INTERVAL = 1 / 15
	RunService.Heartbeat:Connect(function(dt)
		if not ClockHUD.isGameplayActive() then
			-- Left the crew / on the pier: drop any lingering foam and idle.
			if next(foamByDeck) then
				for tracked in foamByDeck do
					detachFoam(tracked)
				end
			end
			foamAccum = 0
			return
		end

		foamAccum += dt
		if foamAccum < FOAM_INTERVAL then
			return
		end
		local step = foamAccum
		foamAccum = 0

		local deck = findCrewDeck()
		if deck then
			attachFoamToDeck(deck)
		end

		for tracked, folder in foamByDeck do
			if not tracked.Parent or not folder.Parent then
				detachFoam(tracked)
			end
		end

		for tracked, folder in foamByDeck do
			local prev = lastDeckPos[tracked]
			local pos = tracked.Position
			local speed = 0
			if prev and step > 0 then
				speed = (pos - prev).Magnitude / step
			end
			lastDeckPos[tracked] = pos
			syncFoamAnchors(tracked, folder, speed)
		end
	end)

	print("[SurviveAtSea] Ocean controller ready — foam, wake, underwater lens")
end

return OceanController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">PlatformInput</string>
              <string name="Source"><![CDATA[-- Cross-platform helpers for phone, tablet, computer, console, and VR.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local VRService = game:GetService("VRService")

local PlatformInput = {}

function PlatformInput.getDeviceKind(): "Phone" | "Tablet" | "Computer" | "Console" | "VR"
	if VRService.VREnabled then
		return "VR"
	end
	if GuiService:IsTenFootInterface() then
		return "Console"
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local camera = workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else Vector2.new(800, 600)
		local minSide = math.min(viewport.X, viewport.Y)
		if minSide >= 700 then
			return "Tablet"
		end
		return "Phone"
	end
	return "Computer"
end

function PlatformInput.isGamepadPreferred(): boolean
	return GuiService:IsTenFootInterface()
		or UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled
end

function PlatformInput.applySafeArea(guiObject: GuiObject)
	local insets = GuiService:GetGuiInset()
	-- Top inset already applied by ScreenGui IgnoreGuiInset=false; add side padding for notches / TV overscan.
	local padding = Instance.new("UIPadding")
	padding.Name = "SafeAreaPadding"
	padding.PaddingTop = UDim.new(0, math.max(8, insets.Y))
	padding.PaddingBottom = UDim.new(0, 12)
	padding.PaddingLeft = UDim.new(0, 12)
	padding.PaddingRight = UDim.new(0, 12)
	padding.Parent = guiObject
end

function PlatformInput.scaleForDevice(): number
	local kind = PlatformInput.getDeviceKind()
	if kind == "Phone" then
		return 1.05
	elseif kind == "Tablet" then
		return 1.0
	elseif kind == "Console" or kind == "VR" then
		return 1.15
	end
	return 1.0
end

return PlatformInput
]]></string>
