      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Armor</string>
          <string name="Source"><![CDATA[-- Shared armor definitions for Survive at Sea.
-- Single source of truth for the server (authoritative wear + damage reduction) and the
-- client HUD. Kept OUT of Config.luau on purpose (same as Weapons.luau) so the headless
-- PortalLoad test — which only loads Config / PartyCode / Types — never touches it.
--
-- Armor pieces are WORN (not held): picking one up equips it to a body slot and raises
-- the player's damage reduction. Reuses the shared rarity tiers from Weapons.luau so a
-- looted helmet reads the same grey/green/blue/purple/gold as a looted gun.
--
-- Slots: "Head" | "Body" | "Legs". One piece per slot; a better piece replaces the old
-- one in that slot. Total reduction is the sum of worn Defense values, clamped in
-- ArmorService so armor can never make you invulnerable.

local Weapons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Weapons"))

local Armor = {}

export type ArmorSlot = "Head" | "Body" | "Legs"

-- Defense is fractional incoming-damage reduction contributed by that piece (0..1).
-- A full common set ≈ 0.30, a full legendary set ≈ 0.70 (clamped by MaxReduction).
Armor.MaxReduction = 0.78

-- Reuse the weapon rarity palette so tiers look identical across all loot.
function Armor.rarityInfo(rarity: number?): { Name: string, Color: Color3 }
	return Weapons.rarityInfo(rarity)
end

Armor.List = {
	-- === Head =============================================================
	ClothHood = {
		Id = "ClothHood",
		Name = "Cloth Hood",
		Slot = "Head",
		Defense = 0.06,
		Rarity = 1,
		Color = Color3.fromRGB(120, 108, 86),
		Material = Enum.Material.Fabric,
	},
	LeatherCap = {
		Id = "LeatherCap",
		Name = "Leather Cap",
		Slot = "Head",
		Defense = 0.10,
		Rarity = 2,
		Color = Color3.fromRGB(96, 64, 38),
		Material = Enum.Material.Fabric,
	},
	IronHelm = {
		Id = "IronHelm",
		Name = "Iron Helm",
		Slot = "Head",
		Defense = 0.15,
		Rarity = 3,
		Color = Color3.fromRGB(150, 156, 164),
		Material = Enum.Material.Metal,
	},
	CorsairHelm = {
		Id = "CorsairHelm",
		Name = "Corsair Helm",
		Slot = "Head",
		Defense = 0.20,
		Rarity = 4,
		Color = Color3.fromRGB(120, 96, 176),
		Material = Enum.Material.Metal,
	},

	-- === Body =============================================================
	ClothTunic = {
		Id = "ClothTunic",
		Name = "Cloth Tunic",
		Slot = "Body",
		Defense = 0.10,
		Rarity = 1,
		Color = Color3.fromRGB(132, 120, 96),
		Material = Enum.Material.Fabric,
	},
	LeatherVest = {
		Id = "LeatherVest",
		Name = "Leather Vest",
		Slot = "Body",
		Defense = 0.16,
		Rarity = 2,
		Color = Color3.fromRGB(104, 68, 40),
		Material = Enum.Material.Fabric,
	},
	IronChestplate = {
		Id = "IronChestplate",
		Name = "Iron Chestplate",
		Slot = "Body",
		Defense = 0.24,
		Rarity = 3,
		Color = Color3.fromRGB(152, 158, 166),
		Material = Enum.Material.Metal,
	},
	CorsairCuirass = {
		Id = "CorsairCuirass",
		Name = "Corsair Cuirass",
		Slot = "Body",
		Defense = 0.32,
		Rarity = 4,
		Color = Color3.fromRGB(126, 100, 182),
		Material = Enum.Material.Metal,
	},
	WardenPlate = {
		Id = "WardenPlate",
		Name = "Warden's Plate",
		Slot = "Body",
		Defense = 0.40,
		Rarity = 5,
		Color = Color3.fromRGB(226, 176, 92),
		Material = Enum.Material.Metal,
	},

	-- === Legs =============================================================
	ClothWraps = {
		Id = "ClothWraps",
		Name = "Cloth Wraps",
		Slot = "Legs",
		Defense = 0.06,
		Rarity = 1,
		Color = Color3.fromRGB(126, 114, 90),
		Material = Enum.Material.Fabric,
	},
	LeatherGreaves = {
		Id = "LeatherGreaves",
		Name = "Leather Greaves",
		Slot = "Legs",
		Defense = 0.10,
		Rarity = 2,
		Color = Color3.fromRGB(100, 66, 40),
		Material = Enum.Material.Fabric,
	},
	IronGreaves = {
		Id = "IronGreaves",
		Name = "Iron Greaves",
		Slot = "Legs",
		Defense = 0.15,
		Rarity = 3,
		Color = Color3.fromRGB(148, 154, 162),
		Material = Enum.Material.Metal,
	},
}

-- Relative loot weights. Common cloth pieces show up the most; legendary plate is a
-- once-a-voyage prize. Weighted so armor as a whole is a meaningful but not guaranteed find.
Armor.LootWeights = {
	ClothHood = 20,
	ClothTunic = 22,
	ClothWraps = 20,
	LeatherCap = 14,
	LeatherVest = 15,
	LeatherGreaves = 13,
	IronHelm = 8,
	IronChestplate = 9,
	IronGreaves = 7,
	CorsairHelm = 4,
	CorsairCuirass = 4,
	WardenPlate = 2,
}

function Armor.get(id: string): { [string]: any }?
	return Armor.List[id]
end

-- Weighted random armor id for island loot rolls. `rng(lo, hi)` mirrors the signature
-- used by Weapons.rollLootWeapon so callers can pass the same math.random shim.
function Armor.rollLootArmor(rng: (number, number) -> number): string
	local total = 0
	for _, w in Armor.LootWeights do
		total += w
	end
	local pick = rng(1, total)
	local acc = 0
	for id, w in Armor.LootWeights do
		acc += w
		if pick <= acc then
			return id
		end
	end
	return "ClothTunic"
end

return Armor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Survive at Sea shared configuration
-- Session state is intentionally ephemeral (no DataStores / caching).

local Config = {
	GameName = "Survive at Sea",
	Tagline = "Gather your crew. Board the voyage. Survive the deep.",

	-- Crew size per private run (host picks; friends join by code).
	-- This is player capacity — NOT the pier portal count.
	MinPartySize = 1,
	MaxPartySize = 10,
	DefaultPartySize = 4,

	-- Pier boarding portals: walk-in gates that open the create flow.
	-- Exactly three atmosphere portals — reusable, not exclusive party slots / player caps.
	-- Concurrent crews scale with lobby players; each crew gets its own raft via baseSlot.
	LobbyCenter = Vector3.new(0, 4, 0),
	PortalCount = 3,
	-- Spread three portals across the pier without clipping the rails (≈±38)
	PortalSpacing = 24,

	-- Starter base: one compact square wooden raft per crew (not scaled by party size).
	-- Spawned after create/join so the portal flow lands you on your base immediately.
	-- Bases are Models with a PrimaryPart so they can be moved later (sea drift / voyage).
	StarterBase = {
		-- Fixed footprint — same for solo or full (10) crews
		-- Slightly smaller than the original 72-stud deck so the surrounding island
		-- hubs dominate the opening view while ten players still have room to move.
		SizeStuds = 64,
		Thickness = 3,
		-- Far open ocean — lobby pier is well beyond fog so it feels like a new place
		Origin = Vector3.new(0, 2.2, 3200),
		-- Spread concurrent crews along X so planks never overlap (indexed by baseSlot)
		SpacingX = 160,
		DeckClearance = 3.5,
		-- Fall into water below this Y → rescue back onto the raft
		-- Kept slightly above OceanConfig.SurfaceY so swimming terrain water still rescues.
		WaterRescueY = 1.2,
	},

	-- Starter gear: wooden club given when you board a crew raft.
	-- Melee swing: right-click (PC), RT / ButtonR2 (console), tap Attack (mobile).
	-- CanBeDropped = true so Roblox backpack drop works (Backspace / Xbox X / etc.).
	Club = {
		ToolName = "Club",
		-- Buffed starter club: hits harder, swings a touch faster, and reaches further
		-- with a wider arc so the opening weapon actually feels good to fight with.
		Damage = 30,
		SwingCooldown = 0.48,
		-- Forward reach from HumanoidRootPart for hit checks
		Range = 9,
		HitRadius = 3.8,
		-- How long the swing hit window stays open (server)
		HitWindow = 0.24,
		-- Client swing visual duration
		SwingDuration = 0.32,
		-- A solid two-handed swing shoves lighter foes back a step.
		Knockback = 14,
	},

	-- Starter raft kit: vertical steering column + upright look-steered helm wheel.
	-- Take the helm → locked standing at the wheel; look steers; W / stick / arrows drive;
	-- jump / gamepad B to unlock and step away.
	Helm = {
		-- Open-ocean sprint — the raft needs to feel FAST so the (now moderately
		-- spaced) isles are reached in a handful of seconds, not a long slog.
		SpeedStudsPerSecond = 520,
		TurnLerp = 7.5,
		-- Stand offset from deck center (aft). Y is ignored — stand sits on deck top.
		StandLocalOffset = Vector3.new(0, 0, 22),
		LookSendHz = 20,
		ThrottleSendHz = 30,
		-- Deadzone for console left-stick Y (and any analog throttle)
		StickDeadzone = 0.18,
		-- Generous for phone / VR laser / console approach
		PromptDistance = 14,
		-- Fixed third-person chase distance while driving so the wheel never fills
		-- the screen and the helmsman can see water, islands, and the raft bow.
		CameraDistance = 24,
		-- Visual: spin the wooden wheel with look yaw (matches helmsman face turn)
		WheelLookGain = 1.35,
		WheelMaxRadians = math.rad(85),
		WheelSpinLerp = 10,
	},

	-- Stationary open-sea isles. Visit → leave on the raft → sail far enough away → locked forever for that crew.
	-- Beach-vibe flats: sand ring → grass → jungle/village heart, palms everywhere.
	-- The opening set is built before boarding. The first island's beach sits directly
	-- beside the raft, while the remaining isles fill the surrounding horizon.
	Islands = {
		Thickness = 16,
		TopY = 3.4,
		-- Beyond the handcrafted opening ring, procedural cells keep the horizon full.
		-- Each cell produces one deterministic tropical isle and is only built when a
		-- crew sails close enough, so the sea can continue indefinitely without a huge
		-- up-front terrain cost.
		Endless = {
			Enabled = true,
		CellStuds = 5200,
		BuildRadiusCells = 1,
		PulseSeconds = 2.5,
			MinSizeStuds = 850,
			MaxSizeStuds = 1250,
			-- The channel is deliberately much wider than the 64-stud starter raft,
			-- leaving room to turn instead of forcing a pixel-perfect approach.
			RiverWidth = 260,
		},
		-- Distance from isle center after a visit before the isle locks. Must clear the
		-- whole sand pad of even the largest isle (radius ~900), so it's set well beyond it.
		LockoutStuds = 2000,
		-- Extra pad outside the sand when a locked crew tries to sail back in
		ApproachPadStuds = 220,
		-- Solid-shoreline collision: the complete raft footprint must remain over water.
		-- The extra hull margin keeps corners and passengers out of terrain even during a
		-- high-speed, low-frame-rate approach.
		RaftCollisionPad = 52,

		-- Legacy hostile "pirate" tuning — kept for back-compat; hostile villagers reuse it.
		Pirate = {
			Health = 40,
			Damage = 5,
			AttackCooldown = 1.15,
			ChaseSpeed = 11,
			AggroRange = 72,
		},
		Gun = {
			Damage = 28,
			Range = 220,
			Cooldown = 0.9,
		},

		-- Villagers: tribal islanders. Passive ones (blue eyes) mind their own business
		-- until struck, then defend their home. Aggressive ones (red eyes) hunt trespassers
		-- on sight. Abandoned isles have only a few feral scavengers, if any.
		Villager = {
			Passive = {
				Health = 55,
				WanderSpeed = 5.5,
				WanderRadiusFrac = 0.34, -- of island half-size
				-- When a passive villager is attacked it turns hostile to defend the isle.
				DefendOnAttack = true,
			},
			Hostile = {
				Health = 70,
				Damage = 8,
				AttackCooldown = 1.1,
				ChaseSpeed = 12,
				AggroRange = 82,
			},
			-- Feral scavengers that linger on abandoned isles (rare, weak, hostile).
			Scavenger = {
				Health = 45,
				Damage = 6,
				AttackCooldown = 1.25,
				ChaseSpeed = 10,
				AggroRange = 70,
			},
		},

		-- Merchant: blue-hatted tribal trader. NEVER hostile. Can be dragged onto and
		-- welded to your raft (reuses the loot drag/weld system) so you can carry a
		-- shop between voyages. Trade with looted Doubloons / crafting Scrap.
		Merchant = {
			Health = 120, -- cosmetic; the merchant is never targeted by combat
			GreetRange = 14,
		},

		-- Themed catalog. HUGE footprints so each isle is a real place you can walk
		-- end-to-end — full villages, sprawling towns lit up with life, thick Amazonian
		-- jungles, towering castles, and quiet abandoned ruins. Spread far apart so sailing
		-- between them is a genuine open-ocean voyage. Every isle carries loot.
		--
		--   Biome: "beach" | "palm" | "jungle" | "highland" | "volcanic" | "mountain" | "twin_peaks"
		--     beach/palm/jungle → sandy tropical isles; highland → temperate grass + pines
		--     (medieval seaside look); volcanic → tropical isle around a smoking lava cone;
		--     mountain → snow-capped peak + a freshwater lake with a waterfall off the cliff;
		--     twin_peaks → two blocky low-poly rock stacks on separate sand pads.
		--   Theme: "wild" | "fishing_village" | "village" | "town" | "stone_town"
		--        | "castle" | "abandoned"
		-- Optional per-isle flags read by VillageBuilder / IslandService:
		--   TropicalTerrace = true → terraced grass rings, stone retaining walls,
		--     spiral cliff path, stilt huts with pyramid thatch roofs over the water
		--   Church     = true → raise a stone church with a steeple, bell & cross
		--   Mansions   = <n>  → n grand multi-storey manor houses in the settlement
		--   Lit        = true → street lamps + braziers so the town glows day and night
		--   Castle     = true → build a huge castle keep (used by the "castle" theme)
		--   Docks      = <n>  → n wooden piers reaching out over the water (moored rowboats,
		--                       barrels & crates); on mountain isles the first pier is on the lake
		--   Lighthouse = true → a tall banded stone lighthouse on the shore (seaside towns)
		--   Volcano    = true → force/allow the central lava cone on a "volcanic" biome isle
		--
		-- Villagers spawn with the opening archipelago. Towns must already look inhabited
		-- from the raft; landing is not required to make their residents appear.
		Catalog = {
			-- The first playable view after boarding: a low-poly island hub inspired by
			-- the supplied reference. Every crew's raft starts in this broad river, with
			-- dense block-canopy forest, a harbour village, docks, and a mountain landmark
			-- framing the route out to sea.
			{
				Id = "arrival_hub",
				Name = "Rivergate Haven",
				Offset = Vector3.new(0, 0, 0),
				SizeStuds = 1500,
				Biome = "jungle",
				Theme = "town",
				Abandoned = false,
				Hub = true,
				SafeHarbor = true,
				Merchant = true,
				River = true,
				-- The channel runs east/west through the spawn point; 440 studs keeps
				-- concurrent 64-stud rafts comfortably inside the waterway.
				RiverAngle = 0,
				RiverWidth = 440,
				Docks = 3,
				Lighthouse = true,
				Church = true,
				Lit = true,
				Villagers = { Passive = 18, Hostile = 0 },
				Loot = { Weapons = 5, Chests = 5, Armor = 3 },
			},
			-- Twelve sculpted islands form a complete archipelago around the central
			-- voyage hub. Their 2,100-stud ring stays inside the opening 4K streaming
			-- target, so every high-detail silhouette is present and visible from the raft.
			-- The clear inner basin still gives every crew room to board and choose a route.
			{
				Id = "tide_flat",
				Name = "Greenwood Landing",
				-- Directly north of spawn: a dense old-growth forest surrounds a medieval
				-- village clearing. A navigable river cuts through the woods to the harbour;
				-- sand is limited to a narrow shoreline instead of covering the whole island.
				Offset = Vector3.new(0, 0, -2100),
				SizeStuds = 1100,
				Biome = "jungle",
				Theme = "village",
				Abandoned = false,
				Merchant = true,
				River = true,
				RiverAngle = 0,
				RiverWidth = 280,
				Docks = 2,
				Church = true,
				Lit = true,
				Villagers = { Passive = 14, Hostile = 2 },
				Loot = { Weapons = 7, Chests = 5, Armor = 3 },
			},
			{
				Id = "quiet_sand",
				Name = "Quiet Sand",
				-- A snug medieval fishing village on a temperate headland: timber cottages,
				-- fish-drying racks, a banded stone lighthouse and two piers out over the water.
				Offset = Vector3.new(1050, 0, -1819),
				SizeStuds = 1100,
				Biome = "highland",
				Theme = "fishing_village",
				Abandoned = false,
				Merchant = true,
				Lighthouse = true,
				-- A winding open harbour channel makes this one of the first
				-- proper river landfalls crews see after leaving the spawn raft.
				River = true,
				RiverAngle = 0.82,
				RiverWidth = 260,
				Docks = 2,
				Villagers = { Passive = 9, Hostile = 0 },
				Loot = { Weapons = 5, Chests = 3, Armor = 2 },
			},
			{
				Id = "smuggler_hut",
				Name = "Smuggler Hollow",
				-- A small tropical isle built around a smoking lava cone — palms, gems and a
				-- single hidden smugglers' pier.
				Offset = Vector3.new(1819, 0, -1050),
				SizeStuds = 1100,
				Biome = "volcanic",
				Theme = "village",
				Abandoned = false,
				Merchant = true,
				Volcano = true,
				Docks = 1,
				Villagers = { Passive = 8, Hostile = 3 },
				Loot = { Weapons = 6, Chests = 4, Armor = 3 },
			},
			{
				Id = "raid_cove",
				Name = "Verde Town",
				-- The flagship: a big medieval seaside town lit up with people and life — a
				-- church and grand manors at its heart, a lighthouse on the point, and three
				-- busy piers along the harbour front (the postcard "seaside village" isle).
				Offset = Vector3.new(2100, 0, 0),
				SizeStuds = 1100,
				Biome = "highland",
				Theme = "town",
				Abandoned = false,
				Merchant = true,
				Church = true,
				Mansions = 2,
				Lit = true,
				Lighthouse = true,
				-- Verde is a huge, forest-framed town split by a navigable canal.
				River = true,
				RiverAngle = 2.22,
				RiverWidth = 270,
				Docks = 3,
				-- Lively and mostly friendly — lots of townsfolk, only a small watch.
				Villagers = { Passive = 20, Hostile = 4 },
				Loot = { Weapons = 9, Chests = 7, Armor = 5 },
			},
			{
				Id = "crow_cay",
				Name = "Crow Cay",
				-- A tropical stone town clinging to the slopes of an active volcano — lava glow
				-- over cobblestone streets, a church, and two harbour piers.
				Offset = Vector3.new(1819, 0, 1050),
				SizeStuds = 1100,
				Biome = "volcanic",
				Theme = "stone_town",
				Abandoned = false,
				Merchant = true,
				Church = true,
				Mansions = 1,
				Lit = true,
				Volcano = true,
				Docks = 2,
				Villagers = { Passive = 10, Hostile = 8 },
				Loot = { Weapons = 8, Chests = 6, Armor = 4 },
			},
			{
				Id = "riverlands",
				Name = "Riverlands",
				-- A huge jungle island split by a sea-to-sea river. The channel is wide
				-- enough for the starter raft, creating a proper helm voyage inland.
				Offset = Vector3.new(1050, 0, 1819),
				SizeStuds = 1100,
				Biome = "jungle",
				Theme = "town",
				Abandoned = false,
				Merchant = true,
				River = true,
				RiverAngle = 0,
				RiverWidth = 300,
				Docks = 3,
				Lighthouse = true,
				Villagers = { Passive = 16, Hostile = 3 },
				Loot = { Weapons = 10, Chests = 8, Armor = 6 },
			},
			{
				Id = "buccaneer_flat",
				Name = "Bastion Keep",
				-- A castle on a green mountain isle: a snow-capped peak behind the keep and a
				-- glassy lake below with its own jetty.
				Offset = Vector3.new(0, 0, 2100),
				SizeStuds = 1100,
				Biome = "mountain",
				Theme = "castle",
				Abandoned = false,
				Merchant = false,
				Castle = true,
				Docks = 1,
				Villagers = { Passive = 0, Hostile = 12 }, -- castle garrison
				Loot = { Weapons = 9, Chests = 7, Armor = 5 },
			},
			{
				Id = "kings_hold",
				Name = "King's Hold",
				-- A mightier mountain-lake stronghold — a torch-lit walled keep beside a
				-- waterfall-fed lake, a lakeside jetty and a sea pier below the cliffs.
				Offset = Vector3.new(-1050, 0, 1819),
				SizeStuds = 1100,
				Biome = "mountain",
				Theme = "castle",
				Abandoned = false,
				Merchant = true,
				Castle = true,
				Lit = true,
				Docks = 2,
				Villagers = { Passive = 4, Hostile = 14 },
				Loot = { Weapons = 10, Chests = 8, Armor = 6 },
			},
			{
				Id = "drift_shack",
				Name = "Drift Shack",
				Offset = Vector3.new(-1819, 0, 1050),
				SizeStuds = 1100,
				Biome = "jungle",
				-- A whole town, long abandoned and reclaimed by the jungle (ruined houses,
				-- cold pits, a rotting pier and only a few feral scavengers left).
				Theme = "town",
				Abandoned = true,
				Merchant = false,
				-- The jungle reclaimed both banks of this old river settlement.
				River = true,
				RiverAngle = 1.38,
				RiverWidth = 270,
				Docks = 1,
				Villagers = { Passive = 0, Hostile = 3 }, -- feral scavengers
				Loot = { Weapons = 6, Chests = 5, Armor = 3 },
			},
			{
				Id = "wreck_spit",
				Name = "Wreck Spit",
				-- Northwest opening-ring isle; kept clear of its neighbours so crews can
				-- sail the channels between every island.
				-- A dead volcanic spit strewn with shipwrecks — a smoking cone and one
				-- half-collapsed pier.
				Offset = Vector3.new(-2100, 0, 0),
				SizeStuds = 1100,
				Biome = "volcanic",
				Theme = "abandoned",
				Abandoned = true,
				Merchant = false,
				Volcano = true,
				Docks = 1,
				Villagers = { Passive = 0, Hostile = 2 },
				Loot = { Weapons = 5, Chests = 4, Armor = 2 },
			},
			{
				Id = "mistwood",
				Name = "Mistwood Crossing",
				-- Layered forest hills, a broad river ravine, and a bank-side settlement
				-- inspired by the deep green forest reference.
				Offset = Vector3.new(-1819, 0, -1050),
				SizeStuds = 1100,
				Biome = "jungle",
				Theme = "village",
				Abandoned = false,
				Merchant = true,
				River = true,
				RiverAngle = 0.52,
				RiverWidth = 290,
				Docks = 2,
				Lit = true,
				Villagers = { Passive = 12, Hostile = 2 },
				Loot = { Weapons = 7, Chests = 5, Armor = 3 },
			},
			{
				Id = "lantern_port",
				Name = "Lantern Port",
				-- A dense timber harbour town with a lighthouse, church, stacked roofs,
				-- waterfront piers, and a forested ridge behind it.
				Offset = Vector3.new(-1050, 0, -1819),
				SizeStuds = 1100,
				Biome = "highland",
				Theme = "town",
				Abandoned = false,
				Merchant = true,
				Church = true,
				Mansions = 2,
				Lit = true,
				Lighthouse = true,
				Docks = 3,
				Villagers = { Passive = 18, Hostile = 3 },
				Loot = { Weapons = 9, Chests = 7, Armor = 5 },
			},
		},
	},

	-- World loot: drag (hold RMB / RT / touch) or pick up into backpack; weld to raft for shelters / light.
	Loot = {
		DragRange = 18,
		DragHoldSeconds = 0.18,
		WeldDeckRange = 22,
		MaxHeldProps = 1,
		-- Inventory pickup via ProximityPrompt (optional alongside drag)
		PickupPromptDistance = 10,
	},

	-- Player-carried currencies (tracked as Player attributes so they replicate to the
	-- owning client for the HUD). Doubloons buy finished goods from the merchant; Scrap
	-- is the crafting material you convert into ammo at the merchant.
	Currency = {
		Doubloons = { Attribute = "Doubloons", Label = "Doubloons", StartAmount = 25 },
		Scrap = { Attribute = "Scrap", Label = "Scrap", StartAmount = 10 },
	},

	-- Portal / berth accent (solid purple — no half-and-half overlays)
	Berth = {
		Purple = Color3.fromRGB(118, 72, 168),
		PurpleDeep = Color3.fromRGB(72, 42, 110),
		PurpleSoft = Color3.fromRGB(168, 132, 210),
	},

	-- Ocean theme palette
	Theme = {
		DeepOcean = Color3.fromRGB(8, 32, 58),
		SeaTeal = Color3.fromRGB(18, 110, 130),
		Foam = Color3.fromRGB(210, 235, 240),
		Driftwood = Color3.fromRGB(92, 64, 42),
		Rope = Color3.fromRGB(160, 120, 70),
		Lantern = Color3.fromRGB(255, 186, 90),
		SeaAccent = Color3.fromRGB(42, 120, 110),
		DangerRed = Color3.fromRGB(220, 70, 70),
		UIPanel = Color3.fromRGB(10, 28, 42),
		UIAccent = Color3.fromRGB(46, 180, 170),
		UIText = Color3.fromRGB(235, 248, 250),
		UIMuted = Color3.fromRGB(150, 185, 195),
	},

	-- Cross-platform UI scale targets
	UI = {
		MinTouchTarget = 48,
		SafePadding = 16,
		Font = Enum.Font.GothamBold,
		BodyFont = Enum.Font.GothamMedium,
	},

	-- Objective directions: little one-line hints that pop up in the top corner,
	-- linger for an adequate read, then fade out. Shown once per phase (lobby vs voyage)
	-- so newcomers always know what to do without cluttering the ocean view.
	ObjectiveHints = {
		-- Fade + linger timing (seconds). Each hint holds for HoldSeconds, so the whole
		-- lobby/voyage set stays on screen for roughly a minute before the last one fades.
		FadeInSeconds = 0.45,
		HoldSeconds = 11,
		FadeOutSeconds = 0.6,

		-- On the pier, before boarding a crew. One line each.
		Lobby = {
			"Walk into a glowing pier portal to start a voyage.",
			"Pick your crew size, then spawn on your own raft.",
			"Share your crew code so friends can board with you.",
		},

		-- Out at sea, once you're on a crew raft. One line each.
		Voyage = {
			"Take the helm and sail out to the distant islands.",
			"Raid island chests and pirates for guns and loot.",
			"Swing your club to fight — haul loot to build your raft.",
			"Survive the day and night out on the open sea.",
		},
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DayNight</string>
          <string name="Source"><![CDATA[-- Day / night cycle math shared by server lighting and client clock HUD.
-- Real time: 5 minutes day + 5 minutes night = 10-minute full cycle.
-- Game clock: day runs 6:00 AM → 6:00 PM, night runs 6:00 PM → 6:00 AM.
-- Crews always begin at 9:00 AM (pass cycleOrigin = create server time) —
-- the sun is already up so players spawn into clear daytime.
-- Players see a whole-hour clock (e.g. 2:00 PM); lighting still blends smoothly.

local DayNight = {}

DayNight.DaySeconds = 300
DayNight.NightSeconds = 300
DayNight.CycleSeconds = DayNight.DaySeconds + DayNight.NightSeconds

-- Game-clock endpoints (Roblox Lighting.ClockTime is 0–24)
DayNight.DayStartHour = 6
DayNight.NightStartHour = 18

-- Voyages begin at this game hour. 9:00 AM keeps the same 6→18 / 18→6 hour
-- mapping but starts crews partway into the day so the sun is already out.
DayNight.StartHour = 9

-- Map a game-clock hour (0–24) to its position within the full cycle [0, CycleSeconds).
local function cycleSecondsForHour(hour: number): number
	if hour >= DayNight.DayStartHour and hour < DayNight.NightStartHour then
		-- Daytime segment: 6 → 18 over DaySeconds
		local alpha = (hour - DayNight.DayStartHour) / 12
		return alpha * DayNight.DaySeconds
	end
	-- Nighttime segment: 18 → 6 (wraps past midnight) over NightSeconds
	local nightHour = if hour < DayNight.DayStartHour then hour + 24 else hour
	local alpha = (nightHour - DayNight.NightStartHour) / 12
	return DayNight.DaySeconds + alpha * DayNight.NightSeconds
end

-- Cycle offset applied to elapsed time so every voyage opens at StartHour.
DayNight.StartOffsetSeconds = cycleSecondsForHour(DayNight.StartHour)

export type Phase = "Day" | "Night"

export type CycleState = {
	phase: Phase,
	-- Position within the full 10-minute cycle [0, CycleSeconds)
	cycleSeconds: number,
	-- Progress within the current phase [0, 1]
	phaseAlpha: number,
	-- Roblox ClockTime hours [0, 24) — smooth for lighting
	clockTime: number,
	-- Display string like "2:00 PM" (whole hours only)
	displayTime: string,
	-- 1 = full daylight, 0 = deep night (smooth across dawn/dusk)
	dayAmount: number,
	-- Whole voyage day counter — starts at 1 (9:00 AM) and increments each cycle
	dayNumber: number,
}

-- Timer advances one game hour at a time (minutes always show :00).
local function formatClock(clockTime: number): string
	local hour24 = math.floor(clockTime % 24 + 1e-6) % 24
	local suffix = if hour24 >= 12 then "PM" else "AM"
	local hour12 = hour24 % 12
	if hour12 == 0 then
		hour12 = 12
	end
	return string.format("%d:00 %s", hour12, suffix)
end

-- Soft dayAmount for lighting blends: 1 at midday, 0 at midnight, smooth at dusk/dawn.
local function dayAmountFromClock(clockTime: number): number
	-- Peak day at 12:00, peak night at 0:00.
	-- Cosine of solar angle: noon = 1, midnight = 0.
	local angle = ((clockTime - 12) / 24) * math.pi * 2
	local solar = (math.cos(angle) + 1) * 0.5 -- 1 at noon, 0 at midnight
	-- Keep midday bright and nights clearly dark.
	return math.clamp(solar, 0, 1)
end

-- cycleOrigin: server time when the crew was created. Elapsed from origin maps
-- to cycle position so every voyage starts at 9:00 AM daytime.
-- Without origin, uses absolute server time (global fallback / lobby sync).
function DayNight.getState(serverTime: number, cycleOrigin: number?): CycleState
	local elapsed = serverTime
	if cycleOrigin ~= nil then
		elapsed = serverTime - cycleOrigin
	end
	-- Shift so elapsed = 0 lands on StartHour (9:00 AM) instead of 6:00 AM.
	elapsed += DayNight.StartOffsetSeconds

	local cycleSeconds = elapsed % DayNight.CycleSeconds
	if cycleSeconds < 0 then
		cycleSeconds += DayNight.CycleSeconds
	end

	-- Voyage day counter: every full cycle (starting at 9:00 AM) is one day.
	-- Day 1 covers the first cycle; negative elapsed (shouldn't happen) clamps to 1.
	local dayNumber = math.floor(elapsed / DayNight.CycleSeconds) + 1
	if dayNumber < 1 then
		dayNumber = 1
	end

	local phase: Phase
	local phaseAlpha: number
	local clockTime: number

	if cycleSeconds < DayNight.DaySeconds then
		phase = "Day"
		phaseAlpha = cycleSeconds / DayNight.DaySeconds
		clockTime = DayNight.DayStartHour + phaseAlpha * 12 -- 6 → 18
	else
		phase = "Night"
		phaseAlpha = (cycleSeconds - DayNight.DaySeconds) / DayNight.NightSeconds
		clockTime = DayNight.NightStartHour + phaseAlpha * 12 -- 18 → 30
		if clockTime >= 24 then
			clockTime -= 24
		end
	end

	return {
		phase = phase,
		cycleSeconds = cycleSeconds,
		phaseAlpha = phaseAlpha,
		clockTime = clockTime,
		displayTime = formatClock(clockTime),
		dayAmount = dayAmountFromClock(clockTime),
		dayNumber = dayNumber,
	}
end

-- Whole voyage day number (1-based) for a given server time / crew origin.
function DayNight.getDayNumber(serverTime: number, cycleOrigin: number?): number
	local elapsed = serverTime
	if cycleOrigin ~= nil then
		elapsed = serverTime - cycleOrigin
	end
	elapsed += DayNight.StartOffsetSeconds
	return math.max(1, math.floor(elapsed / DayNight.CycleSeconds) + 1)
end

function DayNight.formatClock(clockTime: number): string
	return formatClock(clockTime)
end

-- Lighting presets blended by dayAmount (1 = noon, 0 = midnight).
function DayNight.lightingFor(dayAmount: number): {
	Brightness: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	FogColor: Color3,
	FogStart: number,
	FogEnd: number,
	AtmosphereDensity: number,
	AtmosphereColor: Color3,
	AtmosphereDecay: Color3,
	AtmosphereHaze: number,
	AtmosphereGlare: number,
	SunRaysIntensity: number,
	ColorCorrectionTint: Color3,
	ColorCorrectionBrightness: number,
	ColorCorrectionContrast: number,
	ColorCorrectionSaturation: number,
	StarCount: number,
}
	local t = math.clamp(dayAmount, 0, 1)

	local function lerpNumber(a: number, b: number): number
		return a + (b - a) * t
	end

	local function lerpColor(a: Color3, b: Color3): Color3
		return a:Lerp(b, t)
	end

	-- Night (t=0) → Day (t=1)
	return {
		Brightness = lerpNumber(0.45, 2.7),
		Ambient = lerpColor(Color3.fromRGB(28, 34, 58), Color3.fromRGB(78, 92, 98)),
		OutdoorAmbient = lerpColor(Color3.fromRGB(36, 48, 78), Color3.fromRGB(118, 128, 132)),
		FogColor = lerpColor(Color3.fromRGB(18, 28, 52), Color3.fromRGB(130, 170, 190)),
		FogStart = lerpNumber(180, 280),
		-- Keep the entire 2,100-stud hero ring crisp from the raft. Night retains
		-- atmosphere, but never hides the island choices behind a blank horizon.
		FogEnd = lerpNumber(4200, 6500),
		AtmosphereDensity = lerpNumber(0.13, 0.035),
		AtmosphereColor = lerpColor(Color3.fromRGB(48, 62, 98), Color3.fromRGB(168, 198, 214)),
		AtmosphereDecay = lerpColor(Color3.fromRGB(12, 18, 42), Color3.fromRGB(42, 78, 108)),
		AtmosphereHaze = lerpNumber(0.8, 0.28),
		AtmosphereGlare = lerpNumber(0, 0.08),
		SunRaysIntensity = lerpNumber(0, 0.045),
		ColorCorrectionTint = lerpColor(Color3.fromRGB(170, 190, 230), Color3.fromRGB(255, 246, 236)),
		ColorCorrectionBrightness = lerpNumber(-0.06, 0.02),
		ColorCorrectionContrast = lerpNumber(0.04, 0.06),
		ColorCorrectionSaturation = lerpNumber(-0.08, 0.05),
		StarCount = math.floor(lerpNumber(3000, 400) + 0.5),
	}
end

return DayNight
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">LobbyWorld</string>
          <string name="Source"><![CDATA[-- Builds and polishes the Survive at Sea boarding ship.
-- Safe to call from server (replicates) or client (local fallback).
-- Theme: a moored pirate galleon (hull, bulwarks, masts + sails, transom
-- stern, ship's wheel) that players board from. No neon portal glows.
-- Players stay on the ship's deck (invisible barriers).

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent:WaitForChild("Config"))
local OceanConfig = require(script.Parent:WaitForChild("OceanConfig"))

local LobbyWorld = {}

-- Decorative motion (boat bob, gate sway, flag wave) is tagged here and driven
-- locally on each client by LobbyFX. Keeping it off the server means the engine
-- never streams thousands of anchored-part CFrame updates per second — the old
-- server task.spawn loops were the main source of lobby lag.
LobbyWorld.Tags = {
	Boat = "SurviveAtSeaFXBoat",
	Gate = "SurviveAtSeaFXGate",
	Flag = "SurviveAtSeaFXFlag",
}

-- Pier playable bounds (matches PierDeck at CFrame 0,2,20 size 80×140)
local PIER = {
	Center = Vector3.new(0, 2, 20),
	HalfX = 38,
	HalfZ = 68,
	DeckY = 3.5,
}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Material = props.Material or Enum.Material.WoodPlanks
	p.Color = props.Color or Config.Theme.Driftwood
	p.Size = props.Size or Vector3.new(4, 1, 4)
	p.CFrame = props.CFrame or CFrame.new()
	p.Name = props.Name or "LobbyPart"
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.Reflectance ~= nil then
		p.Reflectance = props.Reflectance
	end
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function billboard(
	adornee: BasePart,
	text: string,
	color: Color3,
	size: UDim2?,
	offsetY: number?,
	maxTextSize: number?
)
	local gui = Instance.new("BillboardGui")
	gui.Name = "LobbyBillboard"
	gui.Adornee = adornee
	gui.Size = size or UDim2.fromOffset(160, 44)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY or 6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 90
	gui.Parent = adornee

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 0.35
	label.BackgroundColor3 = Color3.fromRGB(32, 40, 44)
	label.BorderSizePixel = 0
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamMedium
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = label

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(90, 78, 58)
	stroke.Thickness = 1
	stroke.Transparency = 0.45
	stroke.Parent = label

	local constrain = Instance.new("UITextSizeConstraint")
	constrain.MaxTextSize = maxTextSize or 16
	constrain.MinTextSize = 9
	constrain.Parent = label
end

local function buildPalm(parent: Instance, position: Vector3, scale: number?)
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = "Palm"
	model.Parent = parent

	-- Slight lean + tapered trunk for a less blocky silhouette
	local lean = math.rad((math.noise(position.X * 0.07, position.Z * 0.07) - 0.5) * 14)
	part({
		Name = "TrunkLower",
		Parent = model,
		Size = Vector3.new(1.8 * s, 7 * s, 1.8 * s),
		CFrame = CFrame.new(position + Vector3.new(0, 3.5 * s, 0)) * CFrame.Angles(0, 0, lean * 0.5),
		Color = Color3.fromRGB(118, 86, 52),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	part({
		Name = "TrunkUpper",
		Parent = model,
		Size = Vector3.new(1.35 * s, 8 * s, 1.35 * s),
		CFrame = CFrame.new(position + Vector3.new(math.sin(lean) * 1.2 * s, 10.5 * s, 0))
			* CFrame.Angles(0, 0, lean),
		Color = Color3.fromRGB(102, 74, 44),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	local crown = position + Vector3.new(math.sin(lean) * 2.2 * s, 15 * s, 0)
	for i = 0, 7 do
		local yaw = math.rad(i * 45 + 8)
		local droop = -22 - (i % 3) * 6
		part({
			Name = "Frond" .. i,
			Parent = model,
			Size = Vector3.new(0.9 * s, 0.28 * s, (7.5 + (i % 3)) * s),
			CFrame = CFrame.new(crown)
				* CFrame.Angles(0, yaw, 0)
				* CFrame.Angles(math.rad(droop), 0, 0)
				* CFrame.new(0, 0, -3.2 * s),
			Color = if i % 2 == 0 then Color3.fromRGB(52, 118, 62) else Color3.fromRGB(38, 98, 50),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end

	part({
		Name = "Coconuts",
		Parent = model,
		Size = Vector3.new(1.8 * s, 1.3 * s, 1.8 * s),
		CFrame = CFrame.new(crown + Vector3.new(0, -0.6 * s, 0)),
		Color = Color3.fromRGB(86, 58, 30),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	return model
end

local function buildBoat(parent: Instance, position: Vector3, yawDegrees: number, hullColor: Color3?)
	local model = Instance.new("Model")
	model.Name = "Boat"
	model.Parent = parent

	local yaw = math.rad(yawDegrees)
	local hull = hullColor or Color3.fromRGB(150, 95, 55)

	-- Local offsets from hull center (reapplied each bob frame)
	local pieces: { { name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material } } = {
		{
			name = "Hull",
			size = Vector3.new(8, 3, 18),
			offset = CFrame.new(),
			color = hull,
			material = Enum.Material.Wood,
		},
		{
			name = "Bow",
			size = Vector3.new(6, 2.5, 6),
			offset = CFrame.new(0, 0.2, -10),
			color = hull,
			material = Enum.Material.Wood,
		},
		{
			name = "Deck",
			size = Vector3.new(6.5, 0.6, 14),
			offset = CFrame.new(0, 1.6, -1),
			color = Color3.fromRGB(170, 125, 75),
			material = Enum.Material.WoodPlanks,
		},
		{
			name = "Mast",
			size = Vector3.new(0.8, 16, 0.8),
			offset = CFrame.new(0, 9, 1),
			color = Color3.fromRGB(95, 68, 40),
			material = Enum.Material.Wood,
		},
		{
			name = "Sail",
			size = Vector3.new(0.4, 10, 8),
			offset = CFrame.new(0, 9, -1.5),
			color = Color3.fromRGB(235, 228, 210),
			material = Enum.Material.Fabric,
		},
		{
			name = "Cabin",
			size = Vector3.new(5, 3.5, 5),
			offset = CFrame.new(0, 3.5, 4),
			color = Color3.fromRGB(120, 80, 48),
			material = Enum.Material.Wood,
		},
	}

	local built: { { part: BasePart, offset: CFrame } } = {}
	for _, piece in pieces do
		local p = part({
			Name = piece.name,
			Parent = model,
			Size = piece.size,
			CFrame = CFrame.new(position) * CFrame.Angles(0, yaw, 0) * piece.offset,
			Color = piece.color,
			Material = piece.material,
			CanCollide = false,
		})
		table.insert(built, { part = p, offset = piece.offset })
	end

	-- Client-driven bob/roll (see LobbyWorld.Tags). Store the base pose so every
	-- client can reproduce the exact same gentle motion without any replication.
	model:SetAttribute("BaseX", position.X)
	model:SetAttribute("BaseY", position.Y)
	model:SetAttribute("BaseZ", position.Z)
	model:SetAttribute("YawDeg", yawDegrees)
	CollectionService:AddTag(model, LobbyWorld.Tags.Boat)

	return model
end

local function buildBarriers(root: Folder)
	local existing = root:FindFirstChild("Barriers")
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "Barriers"
	folder.Parent = root

	-- Invisible walls keep sailors on the pier (easy lobby — no swimming off)
	local wallH = 18
	local wallY = PIER.DeckY + wallH / 2
	local cx, cz = PIER.Center.X, PIER.Center.Z
	local hx, hz = PIER.HalfX, PIER.HalfZ

	local walls = {
		{ Name = "WallWest", Size = Vector3.new(2, wallH, hz * 2 + 2), Pos = Vector3.new(cx - hx, wallY, cz) },
		{ Name = "WallEast", Size = Vector3.new(2, wallH, hz * 2 + 2), Pos = Vector3.new(cx + hx, wallY, cz) },
		{ Name = "WallSouth", Size = Vector3.new(hx * 2, wallH, 2), Pos = Vector3.new(cx, wallY, cz - hz) },
		{ Name = "WallNorth", Size = Vector3.new(hx * 2, wallH, 2), Pos = Vector3.new(cx, wallY, cz + hz) },
	}

	for _, w in walls do
		part({
			Name = w.Name,
			Parent = folder,
			Size = w.Size,
			CFrame = CFrame.new(w.Pos),
			Transparency = 1,
			CanCollide = true,
			CastShadow = false,
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(255, 255, 255),
		})
	end

	-- Soft floor lip so players don't slip under rails
	part({
		Name = "DeckLip",
		Parent = folder,
		Size = Vector3.new(hx * 2 - 2, 1, hz * 2 - 2),
		CFrame = CFrame.new(cx, 1.2, cz),
		Transparency = 1,
		CanCollide = true,
		CastShadow = false,
	})
end

local function buildPortal(folder: Instance, index: number, position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Portal_" .. index
	model.Parent = folder

	local wood = Color3.fromRGB(92, 62, 40)
	local purple = Config.Berth.Purple
	local purpleDeep = Config.Berth.PurpleDeep
	local purpleSoft = Config.Berth.PurpleSoft

	-- Solid purple berth pad (no half-and-half overlays)
	local pad = part({
		Name = "Pad",
		Parent = model,
		Size = Vector3.new(14, 1.2, 14),
		CFrame = CFrame.new(position),
		Color = purpleDeep,
		Material = Enum.Material.WoodPlanks,
	})

	part({
		Name = "BerthRim",
		Parent = model,
		Size = Vector3.new(14.5, 0.35, 14.5),
		CFrame = CFrame.new(position + Vector3.new(0, 0.75, 0)),
		Color = purple,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	for _, offsetX in { -5.2, 5.2 } do
		part({
			Name = "ArchLeg",
			Parent = model,
			Size = Vector3.new(1.8, 15, 1.8),
			CFrame = CFrame.new(position + Vector3.new(offsetX, 8.5, -0.5)),
			Color = wood,
			Material = Enum.Material.Wood,
		})
	end

	part({
		Name = "ArchTop",
		Parent = model,
		Size = Vector3.new(12.4, 1.8, 1.8),
		CFrame = CFrame.new(position + Vector3.new(0, 16.5, -0.5)),
		Color = wood,
		Material = Enum.Material.Wood,
	})

	part({
		Name = "ArchBanner",
		Parent = model,
		Size = Vector3.new(11.2, 1.0, 0.3),
		CFrame = CFrame.new(position + Vector3.new(0, 15.5, 0.5)),
		Color = purple,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})

	local gate = part({
		Name = "Gate",
		Parent = model,
		Size = Vector3.new(8.2, 12, 0.45),
		CFrame = CFrame.new(position + Vector3.new(0, 8.5, -0.5)),
		Color = purpleSoft,
		Material = Enum.Material.Fabric,
		Transparency = 0.08,
		CanCollide = false,
	})

	-- Client-driven gentle sway (see LobbyWorld.Tags).
	gate:SetAttribute("PhaseSeed", index * 1.3)
	CollectionService:AddTag(gate, LobbyWorld.Tags.Gate)

	local signAnchor = part({
		Name = "SignAnchor",
		Parent = model,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position + Vector3.new(0, 19, 2.5)), -- Moved sign to front of stick
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	billboard(signAnchor, `Portal {index}`, Color3.fromRGB(255, 236, 228), UDim2.fromOffset(120, 30), 0, 14)

	local promptPart = part({
		Name = "PromptAnchor",
		Parent = model,
		Size = Vector3.new(5, 5, 5),
		CFrame = CFrame.new(position + Vector3.new(0, 3, 4)),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BoardPrompt"
	prompt.ObjectText = "Portal " .. index
	prompt.ActionText = "Create Crew"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = promptPart

	local indexValue = Instance.new("IntValue")
	indexValue.Name = "PortalIndex"
	indexValue.Value = index
	indexValue.Parent = model

	local walkTrigger = part({
		Name = "WalkTrigger",
		Parent = model,
		Size = Vector3.new(10, 13, 9),
		CFrame = CFrame.new(position + Vector3.new(0, 7.5, 0.5)),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
		Material = Enum.Material.SmoothPlastic,
	})
	walkTrigger.CanTouch = true
	walkTrigger.CanQuery = false

	model.PrimaryPart = pad
	return model
end

local function stripGlowParts(root: Folder)
	for _, desc in root:GetDescendants() do
		if desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
			desc:Destroy()
			continue
		end
		if desc:IsA("BasePart") then
			local name = desc.Name
			if name == "NeonRing" or name == "Arrow" or name:find("Neon") then
				desc:Destroy()
				continue
			end
			-- Absolutely no Neon materials in the lobby
			if desc.Material == Enum.Material.Neon or desc.Material == Enum.Material.ForceField then
				if name == "Gate" then
					desc.Material = Enum.Material.Fabric
					desc.Color = Config.Berth.PurpleSoft
					desc.Transparency = 0.08
				elseif name == "LighthouseLamp" then
					desc.Material = Enum.Material.SmoothPlastic
					desc.Color = Color3.fromRGB(245, 220, 160)
				else
					desc.Material = Enum.Material.SmoothPlastic
				end
			end
			if name == "Gate" then
				desc.Material = Enum.Material.Fabric
				desc.Color = Config.Berth.PurpleSoft
				desc.Transparency = 0.08
			end
			-- Clean up leftover half-and-half parts from older builds
			if name == "PadRed" or name == "PadBlue" or name == "GateRed" or name == "GateBlue"
				or name == "ArchBannerRed" or name == "ArchBannerBlue" or name == "BerthSeam"
			then
				desc:Destroy()
			end
		end
	end
end

local function buildCannon(parent: Instance, position: Vector3, yawDegrees: number)
	local model = Instance.new("Model")
	model.Name = "Cannon"
	model.Parent = parent

	local yaw = math.rad(yawDegrees)
	local baseCf = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	local iron = Color3.fromRGB(42, 42, 46)
	local ironDark = Color3.fromRGB(28, 28, 32)
	local wood = Color3.fromRGB(92, 64, 40)
	local woodDark = Color3.fromRGB(70, 48, 30)

	-- Naval truck carriage (two cheeks + bed)
	part({
		Name = "Bed",
		Parent = model,
		Size = Vector3.new(3.2, 0.7, 5.2),
		CFrame = baseCf * CFrame.new(0, 0.55, 0.3),
		Color = wood,
		Material = Enum.Material.Wood,
	})
	for _, side in { -1.55, 1.55 } do
		part({
			Name = "Cheek",
			Parent = model,
			Size = Vector3.new(0.55, 2.4, 5.6),
			CFrame = baseCf * CFrame.new(side, 1.5, 0.15),
			Color = woodDark,
			Material = Enum.Material.Wood,
		})
		-- Cap square
		part({
			Name = "CapSquare",
			Parent = model,
			Size = Vector3.new(0.7, 0.45, 0.9),
			CFrame = baseCf * CFrame.new(side, 2.55, -0.2),
			Color = iron,
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end

	-- Axle + trucks (wheels)
	part({
		Name = "Axle",
		Parent = model,
		Size = Vector3.new(5.2, 0.45, 0.45),
		CFrame = baseCf * CFrame.new(0, 1.05, 1.1),
		Color = ironDark,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	for _, side in { -2.35, 2.35 } do
		part({
			Name = "Truck",
			Parent = model,
			Size = Vector3.new(0.55, 2.6, 2.6),
			CFrame = baseCf * CFrame.new(side, 1.15, 1.1) * CFrame.Angles(0, 0, math.rad(90)),
			Color = woodDark,
			Material = Enum.Material.Wood,
			Shape = Enum.PartType.Cylinder,
		})
		part({
			Name = "TireBand",
			Parent = model,
			Size = Vector3.new(0.2, 2.85, 2.85),
			CFrame = baseCf * CFrame.new(side, 1.15, 1.1) * CFrame.Angles(0, 0, math.rad(90)),
			Color = iron,
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Cylinder,
			CanCollide = false,
		})
	end
	-- Smaller rear trucks
	for _, side in { -2.1, 2.1 } do
		part({
			Name = "RearTruck",
			Parent = model,
			Size = Vector3.new(0.45, 2.0, 2.0),
			CFrame = baseCf * CFrame.new(side, 0.95, -1.6) * CFrame.Angles(0, 0, math.rad(90)),
			Color = woodDark,
			Material = Enum.Material.Wood,
			Shape = Enum.PartType.Cylinder,
		})
	end

	-- Tapered barrel (cylinder axis = X, aim down local -Z)
	local elev = math.rad(-7)
	local function barrelSeg(name: string, length: number, diameter: number, z: number, y: number, color: Color3)
		part({
			Name = name,
			Parent = model,
			Size = Vector3.new(length, diameter, diameter),
			CFrame = baseCf
				* CFrame.new(0, y, z)
				* CFrame.Angles(elev, 0, 0)
				* CFrame.Angles(0, math.rad(90), 0),
			Color = color,
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Cylinder,
			CanCollide = false,
		})
	end
	barrelSeg("Breech", 2.4, 2.35, 1.4, 2.55, ironDark)
	barrelSeg("Chase", 3.4, 2.05, -0.9, 2.7, iron)
	barrelSeg("Muzzle", 2.2, 1.75, -3.5, 2.9, iron)
	barrelSeg("MuzzleSwell", 0.7, 2.05, -4.7, 3.0, ironDark)

	-- Cascabel
	part({
		Name = "Cascabel",
		Parent = model,
		Size = Vector3.new(0.9, 0.9, 0.9),
		CFrame = baseCf * CFrame.new(0, 2.45, 2.7) * CFrame.Angles(elev, 0, 0),
		Color = ironDark,
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
	})
	-- Trunnions
	part({
		Name = "Trunnions",
		Parent = model,
		Size = Vector3.new(4.2, 0.55, 0.55),
		CFrame = baseCf * CFrame.new(0, 2.55, -0.15),
		Color = iron,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	-- Quoin (elevation wedge)
	part({
		Name = "Quoin",
		Parent = model,
		Size = Vector3.new(1.4, 0.55, 1.8),
		CFrame = baseCf * CFrame.new(0, 1.85, 1.5) * CFrame.Angles(math.rad(-12), 0, 0),
		Color = wood,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	-- Loose shot beside the truck
	local ballOffsets = {
		Vector3.new(3.0, 0.7, 1.2),
		Vector3.new(3.5, 0.7, 0.6),
		Vector3.new(3.2, 0.7, 0.1),
		Vector3.new(3.25, 1.25, 0.7),
	}
	for i, off in ballOffsets do
		part({
			Name = "Shot" .. i,
			Parent = model,
			Size = Vector3.new(1.05, 1.05, 1.05),
			CFrame = baseCf * CFrame.new(off),
			Color = ironDark,
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Ball,
			CanCollide = false,
		})
	end

	return model
end

local function buildMiniIsland(parent: Instance, position: Vector3, footprint: Vector3, yawDegrees: number?)
	local yaw = math.rad(yawDegrees or 0)
	local island = Instance.new("Model")
	island.Name = "MiniIsland"
	island.Parent = parent

	local cf = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	local sx, sy, sz = footprint.X, footprint.Y, footprint.Z

	-- Submerged shelf
	part({
		Name = "ReefShelf",
		Parent = island,
		Size = Vector3.new(sx * 1.35, sy * 0.7, sz * 1.35),
		CFrame = cf * CFrame.new(0, -sy * 0.55, 0),
		Color = Color3.fromRGB(55, 85, 78),
		Material = Enum.Material.Slate,
		CanCollide = false,
	})
	-- Main sand body (slightly irregular stack)
	part({
		Name = "SandCore",
		Parent = island,
		Size = Vector3.new(sx, sy, sz),
		CFrame = cf,
		Color = Color3.fromRGB(216, 196, 155),
		Material = Enum.Material.Sand,
		CanCollide = false,
	})
	part({
		Name = "SandRise",
		Parent = island,
		Size = Vector3.new(sx * 0.62, sy * 0.55, sz * 0.7),
		CFrame = cf * CFrame.new(sx * 0.08, sy * 0.35, -sz * 0.05),
		Color = Color3.fromRGB(228, 208, 168),
		Material = Enum.Material.Sand,
		CanCollide = false,
	})
	-- Beach spit toward the pier
	part({
		Name = "Spit",
		Parent = island,
		Size = Vector3.new(sx * 0.45, sy * 0.35, sz * 0.9),
		CFrame = cf * CFrame.new(0, -sy * 0.15, sz * 0.35) * CFrame.Angles(math.rad(8), 0, 0),
		Color = Color3.fromRGB(232, 214, 175),
		Material = Enum.Material.Sand,
		CanCollide = false,
	})

	-- Scattered rocks
	local rockSpecs = {
		{ Vector3.new(sx * 0.28, sy * 0.5, sz * 0.22), CFrame.new(-sx * 0.32, sy * 0.1, sz * 0.1), Color3.fromRGB(110, 100, 88) },
		{ Vector3.new(sx * 0.2, sy * 0.4, sz * 0.18), CFrame.new(sx * 0.3, sy * 0.05, -sz * 0.15), Color3.fromRGB(95, 90, 80) },
		{ Vector3.new(sx * 0.16, sy * 0.35, sz * 0.14), CFrame.new(-sx * 0.1, sy * 0.2, -sz * 0.28), Color3.fromRGB(125, 112, 96) },
	}
	for i, rock in rockSpecs do
		part({
			Name = "Rock" .. i,
			Parent = island,
			Size = rock[1] :: Vector3,
			CFrame = cf * (rock[2] :: CFrame) * CFrame.Angles(0.2, i * 0.7, 0.15),
			Color = rock[3] :: Color3,
			Material = Enum.Material.Slate,
			CanCollide = false,
		})
	end

	-- Low scrub near palms
	part({
		Name = "Scrub",
		Parent = island,
		Size = Vector3.new(sx * 0.35, 1.2, sz * 0.3),
		CFrame = cf * CFrame.new(sx * 0.15, sy * 0.55, sz * 0.05),
		Color = Color3.fromRGB(62, 100, 55),
		Material = Enum.Material.Grass,
		CanCollide = false,
	})

	local top = position + Vector3.new(0, sy * 0.55, 0)
	local palmScale = math.clamp(0.55 + sx / 55, 0.55, 1.15)
	buildPalm(island, top + Vector3.new(-sx * 0.08, 0, 0), palmScale)
	if sx > 18 then
		buildPalm(island, top + Vector3.new(sx * 0.2, 0, sz * 0.12), palmScale * 0.78)
	end
	if sx > 26 then
		buildPalm(island, top + Vector3.new(-sx * 0.18, 0, -sz * 0.12), palmScale * 0.7)
	end

	return island
end

-- SOLAS-style lifebuoy lying flat on the deck: a smooth round tube banded
-- white/orange, wrapped with rope lashings and a drooping grab line.
local function buildFloatie(parent: Instance, position: Vector3, yawDegrees: number?, scale: number?)
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = "Floatie"
	model.Parent = parent

	local yaw = math.rad(yawDegrees or 0)
	-- Lay it flat on the deck, with a tiny natural tilt so it reads as "dropped there"
	local tilt = math.rad((math.noise(position.X * 0.11, position.Z * 0.11)) * 6)
	local baseCf = CFrame.new(position) * CFrame.Angles(0, yaw, tilt)

	local ringRadius = 2.2 * s
	local tubeDia = 0.82 * s
	local segments = 16
	local white = Color3.fromRGB(240, 238, 231)
	local orange = Color3.fromRGB(230, 92, 36)

	-- Smooth torus tube: tangential cylinder segments overlapped so the ring
	-- reads as one continuous rounded float instead of a bead necklace.
	local segLen = (2 * math.pi * ringRadius / segments) * 1.35
	for i = 0, segments - 1 do
		local ang = (i / segments) * math.pi * 2
		local localPos = Vector3.new(math.cos(ang) * ringRadius, 0, math.sin(ang) * ringRadius)
		local tangent = Vector3.new(-math.sin(ang), 0, math.cos(ang))
		-- Four painted quadrants alternate white / orange like a real lifebuoy
		local quarter = math.floor((i / segments) * 4)
		local color = if quarter % 2 == 0 then white else orange
		part({
			Name = "Tube" .. i,
			Parent = model,
			Size = Vector3.new(segLen, tubeDia, tubeDia),
			CFrame = baseCf * CFrame.fromMatrix(localPos, tangent, Vector3.yAxis),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Reflectance = 0.05,
			CanCollide = false,
			Shape = Enum.PartType.Cylinder,
		})
		-- Rounded ball caps hide the seams between straight cylinder chords.
		part({
			Name = "Joint" .. i,
			Parent = model,
			Size = Vector3.new(tubeDia, tubeDia, tubeDia),
			CFrame = baseCf * CFrame.new(localPos),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Reflectance = 0.05,
			CanCollide = false,
			Shape = Enum.PartType.Ball,
		})
	end

	-- Four rope lashings wrapped over the tube at the tie-off points.
	local rope = Color3.fromRGB(206, 186, 138)
	for i = 0, 3 do
		local ang = (i / 4) * math.pi * 2 + math.pi / 8
		local localPos = Vector3.new(math.cos(ang) * ringRadius, 0, math.sin(ang) * ringRadius)
		local tangent = Vector3.new(-math.sin(ang), 0, math.cos(ang))
		part({
			Name = "Lash" .. i,
			Parent = model,
			Size = Vector3.new(0.26 * s, tubeDia * 1.28, tubeDia * 1.28),
			CFrame = baseCf * CFrame.fromMatrix(localPos, tangent, Vector3.yAxis),
			Color = rope,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Shape = Enum.PartType.Cylinder,
		})
	end

	-- Grab line draped between the lashings, sagging outward off the ring.
	local grabRadius = ringRadius + tubeDia * 0.55
	local droopSpans = 4
	local perSpan = 2
	-- A point along the sagging span at parameter t, bulging outward at the middle.
	local function ropePoint(a0: number, a1: number, t: number): Vector3
		local a = a0 + (a1 - a0) * t
		local sag = math.sin(t * math.pi) * (0.5 * s)
		local r = grabRadius + sag
		return Vector3.new(math.cos(a) * r, -0.04 * s, math.sin(a) * r)
	end
	for span = 0, droopSpans - 1 do
		local a0 = (span / droopSpans) * math.pi * 2 + math.pi / 8
		local a1 = ((span + 1) / droopSpans) * math.pi * 2 + math.pi / 8
		for j = 0, perSpan - 1 do
			local t0 = j / perSpan
			local t1 = (j + 1) / perSpan
			local p0 = ropePoint(a0, a1, t0)
			local p1 = ropePoint(a0, a1, t1)
			local mid = (p0 + p1) * 0.5
			local dir = (p1 - p0)
			local len = dir.Magnitude
			part({
				Name = "Grab" .. span .. "_" .. j,
				Parent = model,
				Size = Vector3.new(math.max(len, 0.05), 0.16 * s, 0.16 * s),
				CFrame = baseCf * CFrame.fromMatrix(mid, dir.Unit, Vector3.yAxis),
				Color = rope,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Shape = Enum.PartType.Cylinder,
			})
		end
	end

	return model
end

-- Simple flag on a tall pole with a gentle wave.
local function buildFlag(parent: Instance, position: Vector3, yawDegrees: number?)
	local model = Instance.new("Model")
	model.Name = "Flag"
	model.Parent = parent

	local yaw = math.rad(yawDegrees or 0)
	local baseCf = CFrame.new(position) * CFrame.Angles(0, yaw, 0)

	part({
		Name = "PoleBase",
		Parent = model,
		Size = Vector3.new(2.2, 0.6, 2.2),
		CFrame = baseCf * CFrame.new(0, 0.3, 0),
		Color = Color3.fromRGB(70, 48, 30),
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	})
	part({
		Name = "Pole",
		Parent = model,
		Size = Vector3.new(0.55, 24, 0.55),
		CFrame = baseCf * CFrame.new(0, 12, 0),
		Color = Color3.fromRGB(120, 96, 62),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	part({
		Name = "Finial",
		Parent = model,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = baseCf * CFrame.new(0, 24.2, 0),
		Color = Color3.fromRGB(220, 190, 110),
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
	})

	local flag = part({
		Name = "Cloth",
		Parent = model,
		Size = Vector3.new(0.3, 4.5, 8),
		CFrame = baseCf * CFrame.new(0, 21, 4.2),
		Color = Config.Berth.Purple,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})

	-- Client-driven wave (see LobbyWorld.Tags).
	flag:SetAttribute("PhaseSeed", (position.X + position.Z) * 0.05)
	CollectionService:AddTag(flag, LobbyWorld.Tags.Flag)

	return model
end

-- Simple objective sign posted on a wooden board (readable text on the sign face).
local function buildObjectiveSign(parent: Instance, position: Vector3, yawDegrees: number?)
	local model = Instance.new("Model")
	model.Name = "ObjectiveSign"
	model.Parent = parent

	local yaw = math.rad(yawDegrees or 0)
	local baseCf = CFrame.new(position) * CFrame.Angles(0, yaw, 0)

	for _, side in { -3.2, 3.2 } do
		part({
			Name = "Post",
			Parent = model,
			Size = Vector3.new(0.7, 9, 0.7),
			CFrame = baseCf * CFrame.new(side, 4.5, 0),
			Color = Color3.fromRGB(88, 60, 36),
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end

	local board = part({
		Name = "Board",
		Parent = model,
		Size = Vector3.new(9, 5, 0.5),
		CFrame = baseCf * CFrame.new(0, 8, 0),
		Color = Color3.fromRGB(150, 110, 68),
		Material = Enum.Material.WoodPlanks,
	})

	-- Header trim strip so the sign reads clearly from the spawn
	part({
		Name = "TrimTop",
		Parent = model,
		Size = Vector3.new(9.6, 0.6, 0.7),
		CFrame = baseCf * CFrame.new(0, 10.7, 0),
		Color = Color3.fromRGB(112, 78, 46),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	local surface = Instance.new("SurfaceGui")
	surface.Name = "ObjectiveFace"
	surface.Adornee = board
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(360, 200)
	surface.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	surface.Parent = board

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(244, 234, 210)
	bg.BorderSizePixel = 0
	bg.Parent = surface

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 14)
	pad.PaddingBottom = UDim.new(0, 14)
	pad.PaddingLeft = UDim.new(0, 16)
	pad.PaddingRight = UDim.new(0, 16)
	pad.Parent = bg

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.Parent = bg

	local header = Instance.new("TextLabel")
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 44)
	header.Font = Enum.Font.GothamBold
	header.Text = "OBJECTIVE"
	header.TextColor3 = Color3.fromRGB(196, 82, 40)
	header.TextScaled = true
	header.LayoutOrder = 1
	header.Parent = bg

	local body = Instance.new("TextLabel")
	body.BackgroundTransparency = 1
	body.Size = UDim2.new(1, 0, 0, 110)
	body.Font = Enum.Font.GothamMedium
	body.Text = "Board a portal, gather your crew,\nand set sail to survive at sea."
	body.TextColor3 = Color3.fromRGB(48, 42, 34)
	body.TextWrapped = true
	body.TextScaled = true
	body.LayoutOrder = 2
	body.Parent = bg

	local bodyConstraint = Instance.new("UITextSizeConstraint")
	bodyConstraint.MaxTextSize = 26
	bodyConstraint.Parent = body

	return model
end

-- A small, eye-level placard along the walkway that spells out the objective
-- in one short paragraph. Sized so players can stroll right up and read it.
local function buildObjectiveBillboard(parent: Instance, position: Vector3, yawDegrees: number?)
	local model = Instance.new("Model")
	model.Name = "ObjectiveBillboard"
	model.Parent = parent

	local yaw = math.rad(yawDegrees or 0)
	local baseCf = CFrame.new(position) * CFrame.Angles(0, yaw, 0)

	-- Single stout post
	part({
		Name = "Post",
		Parent = model,
		Size = Vector3.new(0.5, 3.4, 0.5),
		CFrame = baseCf * CFrame.new(0, 1.7, 0),
		Color = Color3.fromRGB(88, 60, 36),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	-- Compact board tilted back a touch so it reads while walking past
	local board = part({
		Name = "Board",
		Parent = model,
		Size = Vector3.new(4.6, 2.4, 0.28),
		CFrame = baseCf * CFrame.new(0, 4, 0) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = Color3.fromRGB(150, 110, 68),
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
	})

	-- Thin frame trim around the board face
	part({
		Name = "FrameTop",
		Parent = model,
		Size = Vector3.new(5.0, 0.28, 0.34),
		CFrame = baseCf * CFrame.new(0, 5.22, 0) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = Color3.fromRGB(108, 74, 44),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	part({
		Name = "FrameBottom",
		Parent = model,
		Size = Vector3.new(5.0, 0.28, 0.34),
		CFrame = baseCf * CFrame.new(0, 2.78, 0) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = Color3.fromRGB(108, 74, 44),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	local surface = Instance.new("SurfaceGui")
	surface.Name = "ObjectiveFace"
	surface.Adornee = board
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(460, 240)
	surface.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	surface.Parent = board

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(246, 238, 216)
	bg.BorderSizePixel = 0
	bg.Parent = surface

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 18)
	pad.PaddingBottom = UDim.new(0, 18)
	pad.PaddingLeft = UDim.new(0, 22)
	pad.PaddingRight = UDim.new(0, 22)
	pad.Parent = bg

	local body = Instance.new("TextLabel")
	body.BackgroundTransparency = 1
	body.Size = UDim2.fromScale(1, 1)
	body.Font = Enum.Font.GothamMedium
	body.Text = "Gather your crew and board a portal boat. Set sail together and survive the open sea."
	body.TextColor3 = Color3.fromRGB(48, 42, 34)
	body.TextWrapped = true
	body.TextScaled = true
	body.Parent = bg

	local bodyConstraint = Instance.new("UITextSizeConstraint")
	bodyConstraint.MaxTextSize = 34
	bodyConstraint.Parent = body

	return model
end

-- A lashed-down wooden barrel (vertical cylinder with two iron hoops). The
-- body cylinder's length runs along local X, so it's rotated 90° about Z to
-- stand upright with its base flush on the planks.
local function buildBarrel(parent: Instance, position: Vector3, yawDegrees: number?)
	local model = Instance.new("Model")
	model.Name = "Barrel"
	model.Parent = parent

	local base = CFrame.new(position) * CFrame.Angles(0, math.rad(yawDegrees or 0), 0)
	part({
		Name = "Body",
		Parent = model,
		Size = Vector3.new(3.4, 2.6, 2.6),
		CFrame = base * CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(104, 70, 44),
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
	})
	for _, y in { 0.7, 2.7 } do
		part({
			Name = "Hoop",
			Parent = model,
			Size = Vector3.new(0.24, 2.78, 2.78),
			CFrame = base * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(72, 60, 50),
			Material = Enum.Material.Metal,
			CanCollide = false,
			CastShadow = false,
		})
	end
	return model
end

-- A small stack of cargo crates (a big base crate with a smaller one tilted on top).
local function buildCrateStack(parent: Instance, position: Vector3, yawDegrees: number?)
	local model = Instance.new("Model")
	model.Name = "Crates"
	model.Parent = parent

	local base = CFrame.new(position) * CFrame.Angles(0, math.rad(yawDegrees or 0), 0)
	part({
		Name = "Crate",
		Parent = model,
		Size = Vector3.new(3, 3, 3),
		CFrame = base * CFrame.new(0, 1.5, 0),
		Color = Color3.fromRGB(120, 84, 50),
		Material = Enum.Material.WoodPlanks,
	})
	part({
		Name = "Crate",
		Parent = model,
		Size = Vector3.new(1.8, 1.8, 1.8),
		CFrame = base * CFrame.new(0.5, 3.9, -0.3) * CFrame.Angles(0, math.rad(18), 0),
		Color = Color3.fromRGB(134, 96, 58),
		Material = Enum.Material.WoodPlanks,
	})
	return model
end

-- A flat coil of ship's rope resting on the planks (concentric thin discs).
local function buildRopeCoil(parent: Instance, position: Vector3)
	local model = Instance.new("Model")
	model.Name = "RopeCoil"
	model.Parent = parent

	for i = 0, 2 do
		local d = 2.6 - i * 0.7
		part({
			Name = "Coil",
			Parent = model,
			Size = Vector3.new(0.34, d, d),
			CFrame = CFrame.new(position + Vector3.new(0, 0.2 + i * 0.02, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Config.Theme.Rope,
			Material = Enum.Material.Fabric,
			Shape = Enum.PartType.Cylinder,
			CanCollide = false,
			CastShadow = false,
		})
	end
	return model
end

-- A tidy pyramid of iron cannonballs to sit beside the deck cannons.
local function buildCannonballStack(parent: Instance, position: Vector3)
	local model = Instance.new("Model")
	model.Name = "Cannonballs"
	model.Parent = parent

	local r = 0.55
	local offsets = {
		Vector3.new(-r, r, 0),
		Vector3.new(r, r, 0),
		Vector3.new(0, r, -r * 1.1),
		Vector3.new(0, r, r * 1.1),
		Vector3.new(0, r + 0.95, 0),
	}
	for _, o in offsets do
		part({
			Name = "Cannonball",
			Parent = model,
			Size = Vector3.new(1.1, 1.1, 1.1),
			CFrame = CFrame.new(position + o),
			Color = Color3.fromRGB(38, 38, 42),
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Ball,
			CanCollide = false,
			CastShadow = false,
		})
	end
	return model
end

-- A warm hanging deck lantern on a short post. A single static PointLight (no
-- per-frame updates) adds a cosy glow to the boarding deck.
local function buildDeckLantern(parent: Instance, position: Vector3)
	local model = Instance.new("Model")
	model.Name = "DeckLantern"
	model.Parent = parent

	part({
		Name = "Post",
		Parent = model,
		Size = Vector3.new(0.5, 6, 0.5),
		CFrame = CFrame.new(position + Vector3.new(0, 3, 0)),
		Color = Color3.fromRGB(74, 52, 34),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	part({
		Name = "Arm",
		Parent = model,
		Size = Vector3.new(1.7, 0.28, 0.28),
		CFrame = CFrame.new(position + Vector3.new(0.65, 6, 0)),
		Color = Color3.fromRGB(74, 52, 34),
		Material = Enum.Material.Wood,
		CanCollide = false,
		CastShadow = false,
	})
	local glass = part({
		Name = "Lantern",
		Parent = model,
		Size = Vector3.new(1.05, 1.6, 1.05),
		CFrame = CFrame.new(position + Vector3.new(1.35, 5.6, 0)),
		Color = Config.Theme.Lantern,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CastShadow = false,
	})
	local light = Instance.new("PointLight")
	light.Color = Config.Theme.Lantern
	light.Brightness = 1.4
	light.Range = 18
	light.Parent = glass
	return model
end

-- Ambient deck props — barrels, crates, coiled rope, cannonball stacks and warm
-- lanterns tucked along the rails so the boarding deck feels lived-in without
-- crowding the walkway to the portals. Everything is anchored and static.
local function buildDeckProps(parent: Instance)
	local y = PIER.DeckY

	-- Barrels grouped along the fore rails (clear of the flag at (-30,-34))
	buildBarrel(parent, Vector3.new(31, y, -20), 12)
	buildBarrel(parent, Vector3.new(33.5, y, -14), -20)
	buildBarrel(parent, Vector3.new(-34, y, 20), 8)

	-- Crate stacks tucked into the side corners
	buildCrateStack(parent, Vector3.new(-33, y, -8), 22)
	buildCrateStack(parent, Vector3.new(34, y, -2), -16)

	-- Coiled rope near the stern walkway
	buildRopeCoil(parent, Vector3.new(-22, y, 52))
	buildRopeCoil(parent, Vector3.new(20, y, 50))

	-- Cannonball pyramids beside the side cannons
	buildCannonballStack(parent, Vector3.new(27, y, 30))
	buildCannonballStack(parent, Vector3.new(-27, y, 12))

	-- Warm lanterns lighting the approach to the berths and the bow
	buildDeckLantern(parent, Vector3.new(-26, y, 58))
	buildDeckLantern(parent, Vector3.new(26, y, 58))
	buildDeckLantern(parent, Vector3.new(0, y, -40))
end

-- Deck dressing: floaties, a flag, and the objective sign on the pier.
local function buildDeckDressing(parent: Instance)
	-- Lifeguard floaties laying on the deck (clear of the berth row at z≈68)
	local floaties = {
		{ Vector3.new(-24, PIER.DeckY, -18), 20, 1.0 },
		{ Vector3.new(22, PIER.DeckY, 4), -35, 0.95 },
		{ Vector3.new(-12, PIER.DeckY, 30), 65, 1.05 },
	}
	for _, f in floaties do
		buildFloatie(parent, f[1] :: Vector3, f[2] :: number, f[3] :: number)
	end

	-- A flag near the front corner of the pier
	buildFlag(parent, Vector3.new(-30, PIER.DeckY, -34), 25)

	-- Objective board mounted along the STARBOARD (right) side of the walkway.
	-- Sitting at x≈30, its face must look back toward the deck centre (-X), i.e.
	-- yaw 90, so players read it as they head for the portals instead of it facing
	-- out over the rail. Clear of the side cannons (z≈8/42) and starboard barrels.
	buildObjectiveSign(parent, Vector3.new(30, PIER.DeckY, 16), 90)

	-- Matching walk-by placard along the PORT (left) side. At x≈-31 it must face
	-- back toward the deck centre (+X), i.e. yaw 270, so the objective reads clearly
	-- from either side of the deck.
	buildObjectiveBillboard(parent, Vector3.new(-31, PIER.DeckY, 28), 270)
end

local function buildScenery(root: Folder)
	local existing = root:FindFirstChild("Scenery")
	if existing then
		existing:Destroy()
	end

	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = root

	-- No palms on the pier deck — keep the boarding ship clear (island palms only)

	-- Deck cannons aimed OUTWARD, inset from rails so they don't clip
	local cannons = {
		{ Vector3.new(-32, PIER.DeckY, 8), -90 },
		{ Vector3.new(-32, PIER.DeckY, 42), -90 },
		{ Vector3.new(32, PIER.DeckY, 8), 90 },
		{ Vector3.new(32, PIER.DeckY, 42), 90 },
		{ Vector3.new(-16, PIER.DeckY, -36), 0 },
		{ Vector3.new(16, PIER.DeckY, -36), 0 },
	}
	for _, c in cannons do
		buildCannon(scenery, c[1] :: Vector3, c[2] :: number)
	end

	-- Boats well clear of the berth row (z≈68) — three centered portals
	local boats = {
		{ Vector3.new(-70, 1.4, 5), 25, Color3.fromRGB(160, 90, 50) },
		{ Vector3.new(-78, 1.2, 40), -15, Color3.fromRGB(70, 95, 120) },
		{ Vector3.new(72, 1.3, 8), -155, Color3.fromRGB(145, 75, 55) },
		{ Vector3.new(80, 1.2, 45), 165, Color3.fromRGB(180, 140, 70) },
		{ Vector3.new(-75, 1.1, 110), 10, Color3.fromRGB(95, 70, 45) },
		{ Vector3.new(78, 1.15, 115), -170, Color3.fromRGB(55, 85, 100) },
	}
	for _, b in boats do
		buildBoat(scenery, b[1] :: Vector3, b[2] :: number, b[3] :: Color3)
	end

	-- Mini islands in the distance (scenery only — layered sand/rock, not walkable)
	local islands = {
		{ Vector3.new(-140, -1.2, 20), Vector3.new(34, 5.5, 24), 18 },
		{ Vector3.new(145, -1.0, 45), Vector3.new(38, 6, 26), -22 },
		{ Vector3.new(-120, -1.4, -70), Vector3.new(28, 5, 20), 42 },
		{ Vector3.new(125, -1.3, -55), Vector3.new(30, 5.2, 22), -48 },
		{ Vector3.new(-155, -0.9, 95), Vector3.new(32, 5.4, 22), 10 },
		{ Vector3.new(160, -1.1, 110), Vector3.new(36, 5.8, 24), -14 },
		{ Vector3.new(-95, -1.5, 150), Vector3.new(26, 4.8, 18), 28 },
		{ Vector3.new(100, -1.4, 155), Vector3.new(27, 5, 19), -32 },
		{ Vector3.new(0, -1.6, -130), Vector3.new(42, 6.5, 28), 6 },
		{ Vector3.new(-180, -1.2, 40), Vector3.new(22, 4.5, 16), 55 },
		{ Vector3.new(185, -1.2, 25), Vector3.new(24, 4.6, 17), -40 },
		{ Vector3.new(-70, -1.8, -110), Vector3.new(20, 4.2, 15), 70 },
		{ Vector3.new(80, -1.7, -120), Vector3.new(21, 4.3, 15), -65 },
	}
	for _, isle in islands do
		buildMiniIsland(scenery, isle[1] :: Vector3, isle[2] :: Vector3, isle[3] :: number)
	end

	-- Deck props: floaties, flag, and the objective sign
	buildDeckDressing(scenery)

	-- Extra ambient dressing: barrels, crates, rope, cannonballs, warm lanterns
	buildDeckProps(scenery)
end

local function clearPathwayMarkers(root: Folder)
	-- Strip leftover path stripes, foam runways, and red buoy “blocks” near berths
	local killNames = {
		CenterPlank = true,
		GuidePlank = true,
		GuideTip = true,
		Foam = true,
		Arrow = true,
	}
	for _, child in root:GetDescendants() do
		if child:IsA("BasePart") then
			local name = child.Name
			if
				killNames[name]
				or string.sub(name, 1, 5) == "Arrow"
				or string.sub(name, 1, 4) == "Buoy"
				or string.sub(name, 1, 9) == "PlankWear"
				or name == "RopePost"
				or name == "PostWrap"
				or string.find(string.lower(name), "path", 1, true)
			then
				child:Destroy()
				continue
			end
			local size = child.Size
			local flat = size.Y <= 2.5 and (size.X >= 5 or size.Z >= 5)
			if flat and child.Parent and child.Parent.Name ~= "Barriers" and child.Name ~= "PierDeck" and child.Name ~= "Pad" then
				local c = child.Color
				local isCyan = c.G > 0.45 and c.B > 0.55 and c.R < 0.55
				local isHotRed = c.R > 0.65 and c.G < 0.4 and c.B < 0.4
				if (isCyan or isHotRed) and child.Material ~= Enum.Material.WoodPlanks then
					child:Destroy()
				end
			end
			-- Tall red buoy-like blocks near the berth row
			local pos = child.Position
			if pos.Z > 45 and pos.Z < 95 and math.abs(pos.X) < 100 then
				local c = child.Color
				local isHotRed = c.R > 0.65 and c.G < 0.45 and c.B < 0.45
				if isHotRed and child.Material == Enum.Material.SmoothPlastic and size.Y >= 4 then
					child:Destroy()
				end
			end
		end
	end
end

local function hideVoyageStagingBoat(root: Folder)
	-- Keep an invisible teleport pad for launch fallback; remove the huge visible boat
	local staging = root:FindFirstChild("VoyageStaging")
	if staging then
		staging:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "VoyageStaging"
	folder.Parent = root
	part({
		Name = "Pad",
		Parent = folder,
		Size = Vector3.new(48, 1, 48),
		CFrame = CFrame.new(0, 4, 620),
		Transparency = 1,
		CanCollide = true,
		CastShadow = false,
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 255, 255),
	})
end

local function buildDock(root: Folder)
	local dock = Instance.new("Folder")
	dock.Name = "Dock"
	dock.Parent = root

	-- ============================================================
	--  Pirate galleon "Sea Wraith" — the boarding ship.
	--  Replaces the old flat pier. The walkable deck top stays at
	--  PIER.DeckY (3.5) so spawn, portals and barriers still line up;
	--  everything else (hull, bulwarks, masts, stern) is dressed around it.
	--  Bow points toward -Z, transom (stern) toward +Z.
	-- ============================================================
	local DECK_TOP = PIER.DeckY

	-- Weathered-wood + canvas palette
	local hullWood = Color3.fromRGB(84, 56, 36)
	local hullDark = Color3.fromRGB(58, 38, 24)
	local plankWood = Color3.fromRGB(122, 86, 52)
	local plankDark = Color3.fromRGB(96, 66, 40)
	local trimWood = Color3.fromRGB(74, 50, 30)
	local sailCanvas = Color3.fromRGB(234, 226, 206)
	local sailShade = Color3.fromRGB(206, 196, 174)
	local goldCol = Color3.fromRGB(206, 168, 92)
	local ironCol = Color3.fromRGB(38, 34, 32)
	local ropeCol = Config.Theme.Rope

	local Z_BOW, Z_STERN = -58, 90

	-- Half-beam (hull half-width) as a function of length: point at the bow,
	-- full amidships, narrowing again toward the transom.
	local function halfBeamAt(z: number): number
		if z <= -50 then
			local a = math.clamp((z + 58) / 8, 0, 1)
			return 5 + a * 34
		elseif z >= 68 then
			local a = math.clamp((z - 68) / 22, 0, 1)
			return 39 - a * 15
		end
		return 39
	end

	-- Vertical cylinder helper (default cylinder axis is +X, tip it upright).
	local function cylV(name: string, pos: Vector3, height: number, dia: number, color: Color3, mat: Enum.Material, collide: boolean?)
		part({
			Name = name,
			Parent = dock,
			Size = Vector3.new(height, dia, dia),
			CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Material = mat,
			CanCollide = collide or false,
			Shape = Enum.PartType.Cylinder,
		})
	end

	-- Straight rope/spar segment between two world points (square section).
	local function ropeSeg(name: string, p0: Vector3, p1: Vector3, dia: number, color: Color3?)
		local dir = p1 - p0
		local len = dir.Magnitude
		if len < 0.05 then
			return
		end
		part({
			Name = name,
			Parent = dock,
			Size = Vector3.new(dia, dia, len),
			CFrame = CFrame.lookAt((p0 + p1) * 0.5, p1),
			Color = color or ropeCol,
			Material = Enum.Material.Fabric,
			CanCollide = false,
			CastShadow = false,
		})
	end

	-- Main walkable deck (kept named "PierDeck" for downstream polish logic).
	part({
		Name = "PierDeck",
		Parent = dock,
		Size = Vector3.new(80, 3, 140),
		CFrame = CFrame.new(0, 2, 20),
		Color = plankWood,
		Material = Enum.Material.WoodPlanks,
	})
	-- Deck seam lines for a finished, planked look.
	for _, sx in { -30, -18, -6, 6, 18, 30 } do
		part({
			Name = "DeckSeam",
			Parent = dock,
			Size = Vector3.new(0.35, 0.15, 136),
			CFrame = CFrame.new(sx, 3.55, 20),
			Color = plankDark,
			Material = Enum.Material.Wood,
			CanCollide = false,
			CastShadow = false,
		})
	end

	-- Hull: tapered planked sides + rub-rail wales, curving in plan.
	for z = Z_BOW, Z_STERN, 6 do
		local hb = halfBeamAt(z)
		local hbNext = halfBeamAt(z + 6)
		for _, s in { -1, 1 } do
			local yaw = math.atan2((hbNext - hb) * s, 6)
			-- upper strake (slight tumblehome — top leans inboard)
			part({
				Name = "HullUpper",
				Parent = dock,
				Size = Vector3.new(2.4, 7.5, 7),
				CFrame = CFrame.new(s * hb, 0.2, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(7) * s),
				Color = hullWood,
				Material = Enum.Material.Wood,
				CanCollide = false,
				CastShadow = false,
			})
			-- lower strake / turn of the bilge (rolls in toward the keel)
			part({
				Name = "HullLower",
				Parent = dock,
				Size = Vector3.new(2.2, 8, 7),
				CFrame = CFrame.new(s * hb * 0.7, -6.2, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(32) * s),
				Color = hullDark,
				Material = Enum.Material.Wood,
				CanCollide = false,
				CastShadow = false,
			})
			-- upper + lower wales (horizontal rub rails)
			part({
				Name = "Wale",
				Parent = dock,
				Size = Vector3.new(0.9, 1.1, 7),
				CFrame = CFrame.new(s * (hb + 0.4), 2.4, z) * CFrame.Angles(0, yaw, 0),
				Color = trimWood,
				Material = Enum.Material.Wood,
				CanCollide = false,
				CastShadow = false,
			})
			part({
				Name = "Wale",
				Parent = dock,
				Size = Vector3.new(0.8, 0.9, 7),
				CFrame = CFrame.new(s * (hb + 0.2), -1.6, z) * CFrame.Angles(0, yaw, 0),
				Color = trimWood,
				Material = Enum.Material.Wood,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end

	part({
		Name = "Keel",
		Parent = dock,
		Size = Vector3.new(2.6, 2.4, 150),
		CFrame = CFrame.new(0, -10.5, 16),
		Color = hullDark,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	-- Bulwarks (ship sides above the deck) + cap rail, hugging the hull curve.
	for z = Z_BOW + 2, 66, 6 do
		local hb = halfBeamAt(z)
		local hbNext = halfBeamAt(z + 6)
		for _, s in { -1, 1 } do
			local yaw = math.atan2((hbNext - hb) * s, 6)
			part({
				Name = "Bulwark",
				Parent = dock,
				Size = Vector3.new(1.3, 5.2, 7),
				CFrame = CFrame.new(s * (hb - 0.6), 6.1, z) * CFrame.Angles(0, yaw, 0),
				Color = plankWood,
				Material = Enum.Material.WoodPlanks,
				CanCollide = true,
			})
			part({
				Name = "CapRail",
				Parent = dock,
				Size = Vector3.new(2.1, 0.6, 7),
				CFrame = CFrame.new(s * (hb - 0.6), 8.9, z) * CFrame.Angles(0, yaw, 0),
				Color = trimWood,
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
		end
	end

	-- Open gun ports along the sides, lined up with the deck cannons.
	for _, gz in { 8, 42 } do
		local hb = halfBeamAt(gz)
		for _, s in { -1, 1 } do
			part({
				Name = "GunPort",
				Parent = dock,
				Size = Vector3.new(0.7, 2.2, 2.6),
				CFrame = CFrame.new(s * (hb + 0.2), 6.0, gz),
				Color = ironCol,
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
		end
	end

	-- Bow: stem post, converging prow planks, gilded figurehead, bowsprit + jib.
	part({
		Name = "Stem",
		Parent = dock,
		Size = Vector3.new(2.6, 15, 6),
		CFrame = CFrame.new(0, 1.5, -59) * CFrame.Angles(math.rad(-18), 0, 0),
		Color = hullDark,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	for _, s in { -1, 1 } do
		local p0 = Vector3.new(s * 33, 6, -50)
		local p1 = Vector3.new(0, 6, -60)
		part({
			Name = "BowPlank",
			Parent = dock,
			Size = Vector3.new(1.4, 6, (p1 - p0).Magnitude + 1),
			CFrame = CFrame.lookAt((p0 + p1) * 0.5, p1),
			Color = plankWood,
			Material = Enum.Material.WoodPlanks,
			CanCollide = false,
		})
	end
	part({
		Name = "FigureBody",
		Parent = dock,
		Size = Vector3.new(2.2, 3.2, 2.2),
		CFrame = CFrame.new(0, 2.6, -62) * CFrame.Angles(math.rad(22), 0, 0),
		Color = goldCol,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	part({
		Name = "FigureHead",
		Parent = dock,
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = CFrame.new(0, 4.6, -63),
		Color = goldCol,
		Material = Enum.Material.Metal,
		CanCollide = false,
		Shape = Enum.PartType.Ball,
	})
	for _, s in { -1, 1 } do
		part({
			Name = "FigureWing",
			Parent = dock,
			Size = Vector3.new(0.4, 1.6, 3.2),
			CFrame = CFrame.new(s * 1.3, 3.0, -62) * CFrame.Angles(0, math.rad(s * 30), math.rad(s * 18)),
			Color = goldCol,
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end
	local bowspritBase = Vector3.new(0, 7, -56)
	local bowspritTip = Vector3.new(0, 13, -74)
	part({
		Name = "Bowsprit",
		Parent = dock,
		Size = Vector3.new(1.2, 1.2, (bowspritTip - bowspritBase).Magnitude),
		CFrame = CFrame.lookAt((bowspritBase + bowspritTip) * 0.5, bowspritTip),
		Color = trimWood,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	part({
		Name = "JibSail",
		Parent = dock,
		Size = Vector3.new(0.3, 8, 10),
		CFrame = CFrame.new(0, 10, -66) * CFrame.Angles(0, math.rad(90), math.rad(20)),
		Color = sailCanvas,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})

	-- Masts: fore + main, each with square sails, a cap, and shroud rigging.
	local function buildMast(zPos: number, mastHeight: number, yards, withNest: boolean?): number
		local baseY = DECK_TOP
		local topY = baseY + mastHeight
		cylV("Mast", Vector3.new(0, baseY + mastHeight * 0.34, zPos), mastHeight * 0.68, 2.3, trimWood, Enum.Material.Wood, true)
		cylV("MastTopSeg", Vector3.new(0, baseY + mastHeight * 0.78, zPos), mastHeight * 0.48, 1.5, trimWood, Enum.Material.Wood, true)
		part({
			Name = "MastCap",
			Parent = dock,
			Size = Vector3.new(1.3, 1.3, 1.3),
			CFrame = CFrame.new(0, topY, zPos),
			Color = goldCol,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Shape = Enum.PartType.Ball,
		})

		if withNest then
			local nestY = baseY + mastHeight * 0.72
			part({ Name = "CrowsNest", Parent = dock, Size = Vector3.new(6, 0.6, 6), CFrame = CFrame.new(0, nestY, zPos), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
			for _, dz in { -3, 3 } do
				part({ Name = "CrowsNestRail", Parent = dock, Size = Vector3.new(6.2, 1.6, 0.4), CFrame = CFrame.new(0, nestY + 0.9, zPos + dz), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
			end
		end

		for _, y in yards do
			local yardY = baseY + y.h
			part({ Name = "Yard", Parent = dock, Size = Vector3.new(y.len, 0.9, 0.9), CFrame = CFrame.new(0, yardY, zPos), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false, Shape = Enum.PartType.Cylinder })
			part({ Name = "Sail", Parent = dock, Size = Vector3.new(y.sailW, y.sailH, 0.35), CFrame = CFrame.new(0, yardY - y.sailH / 2 - 0.5, zPos + 0.4) * CFrame.Angles(math.rad(-3), 0, 0), Color = sailCanvas, Material = Enum.Material.Fabric, CanCollide = false })
			part({ Name = "SailBand", Parent = dock, Size = Vector3.new(y.sailW, 1.1, 0.4), CFrame = CFrame.new(0, yardY - y.sailH + 0.6, zPos + 0.45), Color = sailShade, Material = Enum.Material.Fabric, CanCollide = false })
		end

		local hb = halfBeamAt(zPos)
		for _, s in { -1, 1 } do
			for _, dz in { -6, 0, 6 } do
				ropeSeg("Shroud", Vector3.new(0, topY - 5, zPos), Vector3.new(s * (hb - 0.8), 9, zPos + dz), 0.2)
			end
		end
		return topY
	end

	local foreTop = buildMast(-18, 42, { { h = 20, len = 34, sailW = 30, sailH = 13 }, { h = 32, len = 24, sailW = 21, sailH = 9 } }, false)
	local mainTop = buildMast(28, 50, { { h = 22, len = 40, sailW = 36, sailH = 15 }, { h = 37, len = 28, sailW = 25, sailH = 11 } }, true)

	-- Standing rigging tying bow → foremast → mainmast → stern.
	ropeSeg("Forestay", bowspritTip, Vector3.new(0, foreTop - 3, -18), 0.22)
	ropeSeg("Stay", Vector3.new(0, foreTop - 3, -18), Vector3.new(0, mainTop - 4, 28), 0.22)
	ropeSeg("Backstay", Vector3.new(0, mainTop - 4, 28), Vector3.new(0, 12, 84), 0.22)

	-- Jolly Roger flying beside the mainmast head.
	part({
		Name = "JollyRoger",
		Parent = dock,
		Size = Vector3.new(0.2, 3.6, 6),
		CFrame = CFrame.new(3.2, mainTop - 2, 28) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(20, 20, 22),
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})
	part({
		Name = "JollySkull",
		Parent = dock,
		Size = Vector3.new(0.25, 1.4, 1.4),
		CFrame = CFrame.new(3.3, mainTop - 2, 28),
		Color = Color3.fromRGB(232, 230, 224),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})

	-- Transom stern with gallery windows, name board and quarter lanterns.
	part({
		Name = "Transom",
		Parent = dock,
		Size = Vector3.new(50, 13, 3),
		CFrame = CFrame.new(0, 6.5, 90) * CFrame.Angles(math.rad(-12), 0, 0),
		Color = hullDark,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	part({
		Name = "TransomTrim",
		Parent = dock,
		Size = Vector3.new(52, 1.2, 3.4),
		CFrame = CFrame.new(0, 12.4, 89) * CFrame.Angles(math.rad(-12), 0, 0),
		Color = goldCol,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	for i = -2, 2 do
		part({
			Name = "SternWindow",
			Parent = dock,
			Size = Vector3.new(4.5, 4, 0.6),
			CFrame = CFrame.new(i * 7, 8, 91.2) * CFrame.Angles(math.rad(-12), 0, 0),
			Color = Color3.fromRGB(150, 205, 220),
			Material = Enum.Material.Glass,
			Reflectance = 0.35,
			Transparency = 0.25,
			CanCollide = false,
		})
	end
	local sternName = part({
		Name = "SternName",
		Parent = dock,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(0, 11.6, 92),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	billboard(sternName, "SEA WRAITH", goldCol, UDim2.fromOffset(220, 40), 0, 20)
	for _, s in { -1, 1 } do
		cylV("LanternPost", Vector3.new(s * 21, 12, 88), 4, 0.5, trimWood, Enum.Material.Wood)
		part({ Name = "Lantern", Parent = dock, Size = Vector3.new(2, 3, 2), CFrame = CFrame.new(s * 21, 15, 88), Color = Config.Theme.Lantern, Material = Enum.Material.SmoothPlastic, CanCollide = false })
		part({ Name = "LanternCap", Parent = dock, Size = Vector3.new(2.4, 0.8, 2.4), CFrame = CFrame.new(s * 21, 16.6, 88), Color = ironCol, Material = Enum.Material.Metal, CanCollide = false })
	end

	-- Raised quarterdeck (poop) set well behind the boarding portals (z=68,
	-- pads reach ~z=75), with the ship's wheel. Kept clear of the portal row.
	part({
		Name = "PoopDeck",
		Parent = dock,
		Size = Vector3.new(50, 1.4, 12),
		CFrame = CFrame.new(0, 5.5, 84),
		Color = plankWood,
		Material = Enum.Material.WoodPlanks,
		CanCollide = true,
	})
	part({
		Name = "PoopStep",
		Parent = dock,
		Size = Vector3.new(16, 1.2, 3),
		CFrame = CFrame.new(0, 4.5, 77.5),
		Color = plankDark,
		Material = Enum.Material.WoodPlanks,
		CanCollide = true,
	})

	local function buildWheel(center: Vector3)
		local r = 2.2
		part({ Name = "Binnacle", Parent = dock, Size = Vector3.new(2.4, 3.2, 2.4), CFrame = CFrame.new(center - Vector3.new(0, 3.4, -0.8)), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
		-- Hub (axis along the fore-aft Z so the wheel faces forward)
		part({ Name = "WheelHub", Parent = dock, Size = Vector3.new(1.1, 1.1, 1.4), CFrame = CFrame.new(center) * CFrame.Angles(0, math.rad(90), 0), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false, Shape = Enum.PartType.Cylinder })
		local seg = 10
		for i = 0, seg - 1 do
			local a0 = (i / seg) * math.pi * 2
			local a1 = ((i + 1) / seg) * math.pi * 2
			local p0 = center + Vector3.new(math.cos(a0) * r, math.sin(a0) * r, 0)
			local p1 = center + Vector3.new(math.cos(a1) * r, math.sin(a1) * r, 0)
			part({ Name = "WheelRim", Parent = dock, Size = Vector3.new(0.4, 0.4, (p1 - p0).Magnitude), CFrame = CFrame.lookAt((p0 + p1) * 0.5, p1), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
		end
		for i = 0, 5 do
			local a = (i / 6) * math.pi * 2
			local rim = center + Vector3.new(math.cos(a) * r, math.sin(a) * r, 0)
			part({ Name = "WheelSpoke", Parent = dock, Size = Vector3.new(0.35, 0.35, (rim - center).Magnitude + 0.6), CFrame = CFrame.lookAt((center + rim) * 0.5, rim), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
			local handle = center + Vector3.new(math.cos(a) * (r + 0.8), math.sin(a) * (r + 0.8), 0)
			part({ Name = "WheelHandle", Parent = dock, Size = Vector3.new(0.35, 0.35, 1.4), CFrame = CFrame.new(handle) * CFrame.Angles(0, 0, a), Color = goldCol, Material = Enum.Material.Wood, CanCollide = false })
		end
	end
	buildWheel(Vector3.new(0, 8.4, 82))

	-- Working deck dressing (replaces the old floating crate cubes).
	cylV("Capstan", Vector3.new(0, 4.6, 50), 2.6, 3, trimWood, Enum.Material.Wood, true)
	for i = 0, 3 do
		local a = (i / 4) * math.pi * 2
		part({ Name = "CapstanBar", Parent = dock, Size = Vector3.new(0.4, 0.4, 6), CFrame = CFrame.new(0, 5.4, 50) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, 3), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
	end
	-- Cargo hatch grating
	part({ Name = "Hatch", Parent = dock, Size = Vector3.new(8, 0.5, 8), CFrame = CFrame.new(-2, 3.75, 10), Color = plankDark, Material = Enum.Material.WoodPlanks, CanCollide = false })
	for i = -3, 3, 2 do
		part({ Name = "HatchBar", Parent = dock, Size = Vector3.new(0.4, 0.7, 8), CFrame = CFrame.new(-2 + i, 3.9, 10), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
		part({ Name = "HatchBar", Parent = dock, Size = Vector3.new(8, 0.7, 0.4), CFrame = CFrame.new(-2, 3.9, 10 + i), Color = trimWood, Material = Enum.Material.Wood, CanCollide = false })
	end
	-- Barrels lashed neatly against the starboard bulwark
	for i = 1, 3 do
		part({
			Name = "Barrel" .. i,
			Parent = dock,
			Size = Vector3.new(3.4, 2.8, 2.8),
			CFrame = CFrame.new(30, 5.2, -34 + i * 4) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(104, 72, 42),
			Material = Enum.Material.Wood,
			CanCollide = false,
			Shape = Enum.PartType.Cylinder,
		})
	end
	-- Coiled ropes stowed on the planks
	for _, cpos in { Vector3.new(-28, 3.9, 44), Vector3.new(26, 3.9, -6) } do
		for ring = 1, 3 do
			cylV("RopeCoil", cpos + Vector3.new(0, ring * 0.25, 0), 0.5, 2.4 - ring * 0.4, ropeCol, Enum.Material.Fabric)
		end
	end

	local title = part({
		Name = "TitleBanner",
		Parent = dock,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(0, 20, -35),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	billboard(title, "SURVIVE AT SEA\nBoarding ship", Config.Theme.Foam, UDim2.fromOffset(280, 64), 0, 22)
end

function LobbyWorld.getLobbySpawnCFrame(): CFrame
	return CFrame.new(0, 6, 0)
end

function LobbyWorld.updatePortalSign(portalModel: Model, title: string, subtitle: string, color: Color3?)
	local anchor = portalModel:FindFirstChild("SignAnchor")
	if not (anchor and anchor:IsA("BasePart")) then
		anchor = portalModel:FindFirstChild("ArchTop")
	end
	if not (anchor and anchor:IsA("BasePart")) then
		anchor = portalModel:FindFirstChild("Pad")
	end
	if not (anchor and anchor:IsA("BasePart")) then
		return
	end
	local old = anchor:FindFirstChild("LobbyBillboard")
	if old then
		old:Destroy()
	end
	-- Also clear any leftover pad-level signs from older builds
	local pad = portalModel:FindFirstChild("Pad")
	if pad and pad ~= anchor then
		local padSign = pad:FindFirstChild("LobbyBillboard")
		if padSign then
			padSign:Destroy()
		end
	end
	local line = if subtitle ~= "" then `{title}  ·  {subtitle}` else title
	local offsetY = if anchor.Name == "SignAnchor" then 0 else 3
	billboard(anchor, line, color or Color3.fromRGB(255, 236, 228), UDim2.fromOffset(150, 32), offsetY, 13)
end

-- Polish any lobby (fresh or Rojo-synced): no glows, barriers, palms, boats.
function LobbyWorld.polish(root: Folder)
	stripGlowParts(root)

	-- Flat glass ocean is a fallback only — Terrain water (OceanTerrainService) is the real sea.
	-- Keep these parts non-colliding and fully hidden so they never fight the wave field.
	local oceanDeep = root:FindFirstChild("OceanDeep")
	if oceanDeep and oceanDeep:IsA("BasePart") then
		oceanDeep.CanCollide = false
		oceanDeep.CanQuery = false
		oceanDeep.CanTouch = false
		oceanDeep.CastShadow = false
		oceanDeep.Size = Vector3.new(4000, 4, 8000)
		oceanDeep.CFrame = CFrame.new(0, OceanConfig.SurfaceY - OceanConfig.DepthStuds + 2, 2000)
		oceanDeep.Color = OceanConfig.AbyssColor
		oceanDeep.Transparency = 1
	end
	local oceanSurface = root:FindFirstChild("OceanSurface")
	if oceanSurface and oceanSurface:IsA("BasePart") then
		oceanSurface.CanCollide = false
		oceanSurface.CanQuery = false
		oceanSurface.CanTouch = false
		oceanSurface.CastShadow = false
		oceanSurface.Size = Vector3.new(4000, 2, 8000)
		oceanSurface.CFrame = CFrame.new(0, OceanConfig.SurfaceY, 2000)
		oceanSurface.Color = OceanConfig.WaterColor
		oceanSurface.Transparency = 1
		oceanSurface.Reflectance = 0
	end

	buildBarriers(root)
	buildScenery(root)
	clearPathwayMarkers(root)
	hideVoyageStagingBoat(root)

	-- Soften spawn pad into the deck (no cyan marker pad)
	local spawn = root:FindFirstChild("LobbySpawn")
	if spawn and spawn:IsA("SpawnLocation") then
		spawn.Material = Enum.Material.WoodPlanks
		spawn.BrickColor = BrickColor.new("Brown")
		spawn.Color = Color3.fromRGB(118, 80, 48)
		spawn.Transparency = 1
		spawn.Enabled = true
		spawn.Neutral = true
		spawn.Duration = 0
	end

	-- Rebuild berths at safe Config positions (never reuse clipped map coords)
	local portals = root:FindFirstChild("Portals")
	if not portals then
		portals = Instance.new("Folder")
		portals.Name = "Portals"
		portals.Parent = root
	end
	for _, model in portals:GetChildren() do
		model:Destroy()
	end
	local startX = -((Config.PortalCount - 1) * Config.PortalSpacing) / 2
	for i = 1, Config.PortalCount do
		local pos = Vector3.new(startX + (i - 1) * Config.PortalSpacing, 3.5, 68)
		buildPortal(portals, i, pos)
	end

	local dock = root:FindFirstChild("Dock")
	if dock then
		local oldTitle = dock:FindFirstChild("TitleBanner") or dock:FindFirstChild("TitleAnchor")
		if oldTitle then
			oldTitle:Destroy()
		end
		local titleAnchor = part({
			Name = "TitleBanner",
			Parent = dock,
			Size = Vector3.new(2, 2, 2),
			CFrame = CFrame.new(0, 18, -35),
			Transparency = 1,
			CanCollide = false,
			CastShadow = false,
		})
		billboard(titleAnchor, "SURVIVE AT SEA\nBoarding ship", Config.Theme.Foam, UDim2.fromOffset(280, 64), 0, 22)
	end

	print("[SurviveAtSea] Lobby polished — realistic cannons/islands, no path, no staging boat")
end

function LobbyWorld.ensure(): Folder
	local existing = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if existing and existing:IsA("Folder") then
		LobbyWorld.polish(existing)
		return existing
	end

	for _, child in Workspace:GetChildren() do
		if child:IsA("SpawnLocation") or (child:IsA("BasePart") and child.Name ~= "Terrain") then
			if child.Name ~= "SurviveAtSeaLobby" then
				child.Transparency = 1
				if child:IsA("BasePart") then
					child.CanCollide = false
				end
				if child:IsA("SpawnLocation") then
					child.Enabled = false
				end
			end
		end
	end

	local root = Instance.new("Folder")
	root.Name = "SurviveAtSeaLobby"
	root.Parent = Workspace

	part({
		Name = "OceanDeep",
		Parent = root,
		Size = Vector3.new(4000, 4, 8000),
		CFrame = CFrame.new(0, OceanConfig.SurfaceY - OceanConfig.DepthStuds + 2, 2000),
		Color = OceanConfig.AbyssColor,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 1,
		CanCollide = false,
	})

	part({
		Name = "OceanSurface",
		Parent = root,
		Size = Vector3.new(4000, 2, 8000),
		CFrame = CFrame.new(0, OceanConfig.SurfaceY, 2000),
		Color = OceanConfig.WaterColor,
		Material = Enum.Material.Glass,
		Transparency = 1,
		Reflectance = 0,
		CanCollide = false,
	})

	-- No Foam runway / colored path around the pier

	buildDock(root)

	local portalsFolder = Instance.new("Folder")
	portalsFolder.Name = "Portals"
	portalsFolder.Parent = root

	local startX = -((Config.PortalCount - 1) * Config.PortalSpacing) / 2
	for i = 1, Config.PortalCount do
		local pos = Vector3.new(startX + (i - 1) * Config.PortalSpacing, 3.5, 68)
		buildPortal(portalsFolder, i, pos)
	end

	-- Invisible launch pad only (no giant boat behind the berths)
	hideVoyageStagingBoat(root)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(0, 4.2, 0)
	spawn.Anchored = true
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Enabled = true
	spawn.Transparency = 1
	spawn.BrickColor = BrickColor.new("Brown")
	spawn.Color = Color3.fromRGB(118, 80, 48)
	spawn.Material = Enum.Material.WoodPlanks
	spawn.Parent = root

	LobbyWorld.polish(root)

	print("[SurviveAtSea] LobbyWorld.ensure built boarding pier + berths")
	return root
end

function LobbyWorld.seatCharacter(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.CFrame = LobbyWorld.getLobbySpawnCFrame()
		root.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(0, 0, 40))
	end
end

return LobbyWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">OceanConfig</string>
          <string name="Source"><![CDATA[-- Shared ocean look + streaming knobs for Survive at Sea.
-- Terrain water carries the real waves; client FX add foam / underwater feel.

local OceanConfig = {
	-- Sea surface height (studs). Deck bottoms sit just above this.
	SurfaceY = 0.4,

	-- How deep the water voxels go below the surface.
	DepthStuds = 56,

	-- Streaming chunk grid around rafts / lobby (infinite sail).
	ChunkStuds = 256,
	-- Keep this many chunks in each direction from every focus point.
	KeepRadiusChunks = 3,
	-- How often the server refreshes which chunks stay filled.
	StreamHz = 2,

	-- Engine Terrain water material (the realistic wave field). Calm rolling
	-- swells (lower speed) read as a prettier open sea than the old fast chop.
	WaterColor = Color3.fromRGB(14, 92, 116),
	WaterReflectance = 0.85,
	WaterTransparency = 0.3,
	WaterWaveSize = 0.28,
	WaterWaveSpeed = 10,

	-- Soft abyss tint under the voxels (non-colliding visual only).
	AbyssColor = Color3.fromRGB(3, 28, 48),
	AbyssTransparency = 0.12,

	-- Client underwater look when the camera dips below the surface.
	Underwater = {
		Tint = Color3.fromRGB(28, 92, 118),
		Contrast = 0.08,
		Saturation = -0.12,
		Brightness = -0.04,
		FogColor = Color3.fromRGB(18, 70, 92),
		FogStart = 8,
		FogEnd = 90,
	},
}

return OceanConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">PartyCode</string>
          <string name="Source"><![CDATA[-- Generates short, shareable party codes (Dead Rails-style).

local HttpService = game:GetService("HttpService")

local PartyCode = {}

local ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"

local function randomChar(): string
	local index = math.random(1, #ALPHABET)
	return string.sub(ALPHABET, index, index)
end

function PartyCode.generate(existing: { [string]: any }?): string
	for _ = 1, 40 do
		local code = `{randomChar()}{randomChar()}{randomChar()}{randomChar()}`
		if not existing or existing[code] == nil then
			return code
		end
	end

	-- Extremely unlikely fallback
	return string.upper(string.sub(HttpService:GenerateGUID(false), 1, 4))
end

function PartyCode.normalize(raw: string): string
	local cleaned = string.upper(string.gsub(raw, "%s+", ""))
	cleaned = string.gsub(cleaned, "[^A-Z0-9]", "")
	return cleaned
end

return PartyCode
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- RemoteEvent / RemoteFunction folder contract.
-- Server creates the folder; client waits for it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local FOLDER_NAME = "SurviveAtSeaRemotes"

function Remotes.getFolder(): Folder
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if folder and folder:IsA("Folder") then
		return folder
	end

	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, 30)
	assert(folder and folder:IsA("Folder"), "Survive at Sea remotes folder missing")
	return folder
end

function Remotes.waitFor(name: string): Instance
	local folder = Remotes.getFolder()
	local remote = folder:WaitForChild(name, 30)
	assert(remote, `Remote '{name}' missing`)
	return remote
end

function Remotes.createServerRemotes(): Folder
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not (folder and folder:IsA("Folder")) then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end

	local names = {
		"CreateParty",
		"JoinParty",
		"LeaveParty",
		"PartyUpdated",
		"PortalsUpdated",
		"Toast",
		"GetLobbyState",
		-- Helm: client sends camera look + throttle while steering; server pushes mount state
		"HelmLook",
		"HelmThrottle",
		"HelmState",
		"HelmDismount",
		-- Ranged weapon fire (pistol / revolver / rifle / shotgun / musket / bow / flintlock).
		-- Client sends aim look vector; server validates ammo + raycasts + damages.
		"ShootGun",
		-- Reload the equipped ranged weapon from carried ammo reserve.
		"WeaponReload",
		-- Fired by the server to broadcast a weapon shot so all clients can play the FX.
		"WeaponFx",
		-- Melee: client requests a swing; server validates + damages; SwingFx for other clients
		"MeleeAttack",
		"MeleeSwingFx",
		-- Loot drag / weld / place (walls, torches, planks, beds, merchant)
		"LootDragStart",
		"LootDragUpdate",
		"LootDragEnd",
		"LootWeld",
		"LootUnweld",
		"LootPlace",
		-- Merchant trading: RemoteFunction the client invokes to buy / craft; server
		-- validates currency and grants the item. MerchantShop pushes the catalog to open UI.
		"MerchantTrade",
		"MerchantShop",
	}

	for _, name in names do
		if folder:FindFirstChild(name) then
			continue
		end
		local remote: Instance
		if name == "GetLobbyState" or name == "MerchantTrade" then
			remote = Instance.new("RemoteFunction")
		else
			remote = Instance.new("RemoteEvent")
		end
		remote.Name = name
		remote.Parent = folder
	end

	return folder
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[-- Shared type aliases for Survive at Sea lobby / party flow.
-- Crews are always private — friends join with the host's code only.

export type PartyPrivacy = "Private"

export type PartyMember = {
	userId: number,
	displayName: string,
	isHost: boolean,
}

export type PartySnapshot = {
	code: string,
	hostUserId: number,
	maxPlayers: number,
	privacy: PartyPrivacy,
	members: { PartyMember },
	-- Pier portal used to open create (atmosphere only — not a capacity lock)
	portalIndex: number,
	-- Independent raft placement slot (concurrent crews are not capped by portal count)
	baseSlot: number,
	-- Workspace:GetServerTimeNow() when the crew formed — day/night always starts at 9:00 AM
	cycleOrigin: number,
	status: "Open",
}

-- Pier portals are reusable boarding gates, not exclusive party pads.
export type PublicPortalInfo = {
	portalIndex: number,
	status: "Ready",
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[-- Shared weapon / ammo definitions for Survive at Sea.
-- Single source of truth for both the server (authoritative fire + damage) and the
-- client (fire input, HUD, merchant shop). Kept OUT of Config.luau on purpose so the
-- headless PortalLoad test environment (which only loads Config/PartyCode/Types) is
-- never asked to construct weapon geometry data.
--
-- Weapon classes:
--   "melee"  — swung; hit detection in MeleeService (club spawns with you, spear looted).
--   "ranged" — fired; raycast in WeaponService. Ranged weapons consume Ammo per shot,
--              reload from carried reserve, and support multi-pellet spread (shotgun).

local Weapons = {}

-- Ammo reserves are tracked as Player attributes: "Ammo_" .. ammoId.
export type AmmoId = "Bullet" | "Shell" | "Arrow" | "Powder"

-- Loot rarity tiers. Shared by weapons AND armor (see Armor.luau) so a picked-up item's
-- floating tag / pricing reads the same colour everywhere:
--   1 Common (grey) · 2 Uncommon (green) · 3 Rare (blue) · 4 Epic (purple) · 5 Legendary (gold)
-- Common items drop the most often; each higher tier is progressively rarer.
Weapons.Rarity = {
	[0] = { Name = "Starter", Color = Color3.fromRGB(200, 205, 210) },
	[1] = { Name = "Common", Color = Color3.fromRGB(178, 186, 194) },
	[2] = { Name = "Uncommon", Color = Color3.fromRGB(108, 214, 116) },
	[3] = { Name = "Rare", Color = Color3.fromRGB(84, 168, 255) },
	[4] = { Name = "Epic", Color = Color3.fromRGB(190, 122, 255) },
	[5] = { Name = "Legendary", Color = Color3.fromRGB(255, 176, 72) },
}

function Weapons.rarityInfo(rarity: number?): { Name: string, Color: Color3 }
	return Weapons.Rarity[rarity or 1] or Weapons.Rarity[1]
end

Weapons.Ammo = {
	Bullet = { Id = "Bullet", Label = "Bullets", Attribute = "Ammo_Bullet", Max = 240 },
	Shell = { Id = "Shell", Label = "Shells", Attribute = "Ammo_Shell", Max = 120 },
	Arrow = { Id = "Arrow", Label = "Arrows", Attribute = "Ammo_Arrow", Max = 120 },
	Powder = { Id = "Powder", Label = "Powder & Ball", Attribute = "Ammo_Powder", Max = 60 },
}

-- Rarity is used both for loot weighting on islands and merchant pricing.
Weapons.List = {
	Club = {
		Id = "Club",
		Name = "Club",
		Class = "melee",
		ToolTip = "Heavy wooden club — RMB / RT / tap to swing",
		-- Buffed to match the improved starter club: hits harder, faster, wider arc.
		Damage = 30,
		Cooldown = 0.48,
		Range = 9,
		HitRadius = 3.8,
		HitWindow = 0.24,
		SwingDuration = 0.32,
		Knockback = 14,
		Rarity = 1, -- Common grey — the most abundant island loot (see LootWeights)
	},
	WarClub = {
		Id = "WarClub",
		Name = "Spiked War Club",
		Class = "melee",
		ToolTip = "Stone-spiked war club — brutal reach and knockback",
		-- A meaner club: a jagged stone head studded with spikes. Best-in-slot melee
		-- short of the spear's reach, with a strong shove on every connect.
		Damage = 44,
		Cooldown = 0.52,
		Range = 9.5,
		HitRadius = 4.0,
		HitWindow = 0.26,
		SwingDuration = 0.34,
		Knockback = 22,
		Rarity = 3,
	},
	Spear = {
		Id = "Spear",
		Name = "Fishing Spear",
		Class = "melee",
		ToolTip = "Bone-tipped spear — long reach, RMB / RT / tap to thrust",
		Damage = 34,
		Cooldown = 0.7,
		Range = 12,
		HitRadius = 2.4,
		HitWindow = 0.24,
		SwingDuration = 0.32,
		Rarity = 2,
	},
	Bow = {
		Id = "Bow",
		Name = "Hunting Bow",
		Class = "ranged",
		ToolTip = "Draw and loose — quiet, needs arrows",
		Damage = 38,
		Cooldown = 0.85,
		Range = 280,
		Ammo = "Arrow",
		MagSize = 1,
		ReloadTime = 0.0,
		Pellets = 1,
		Spread = 0.0,
		Rarity = 2,
	},
	Pistol = {
		Id = "Pistol",
		Name = "Flintlock Pistol",
		Class = "ranged",
		ToolTip = "Quick sidearm — needs bullets",
		Damage = 26,
		Cooldown = 0.5,
		Range = 230,
		Ammo = "Bullet",
		MagSize = 6,
		ReloadTime = 1.6,
		Pellets = 1,
		Spread = 0.012,
		Rarity = 2,
	},
	Revolver = {
		Id = "Revolver",
		Name = "Sea Revolver",
		Class = "ranged",
		ToolTip = "Six-shooter — punchy, needs bullets",
		Damage = 32,
		Cooldown = 0.42,
		Range = 250,
		Ammo = "Bullet",
		MagSize = 6,
		ReloadTime = 1.9,
		Pellets = 1,
		Spread = 0.016,
		Rarity = 4,
	},
	Rifle = {
		Id = "Rifle",
		Name = "Long Rifle",
		Class = "ranged",
		ToolTip = "Precise and hard-hitting at range — needs bullets",
		Damage = 48,
		Cooldown = 1.0,
		Range = 420,
		Ammo = "Bullet",
		MagSize = 5,
		ReloadTime = 2.4,
		Pellets = 1,
		Spread = 0.004,
		Rarity = 5,
	},
	Shotgun = {
		Id = "Shotgun",
		Name = "Boarding Shotgun",
		Class = "ranged",
		ToolTip = "Close-range spread — devastating up close, needs shells",
		Damage = 13,
		Cooldown = 1.05,
		Range = 100,
		Ammo = "Shell",
		MagSize = 2,
		ReloadTime = 2.2,
		Pellets = 8,
		Spread = 0.10,
		Rarity = 3,
	},
	-- (Musket below)
	Musket = {
		Id = "Musket",
		Name = "Old Musket",
		Class = "ranged",
		ToolTip = "One heavy shot, slow reload — needs powder & ball",
		Damage = 64,
		Cooldown = 1.9,
		Range = 380,
		Ammo = "Powder",
		MagSize = 1,
		ReloadTime = 2.8,
		Pellets = 1,
		Spread = 0.006,
		Rarity = 2,
	},
}

-- Weapons that can drop as island loot, with relative weights (rarer = smaller weight).
-- Clubs are Common grey and drop the most often; bows are a frequent find too. Rifles
-- are Legendary and barely ever show up.
Weapons.LootWeights = {
	Club = 46, -- Common grey — you'll find these all over the beaches
	WarClub = 12, -- Rare blue — a prized melee upgrade
	Spear = 26, -- Common melee
	Bow = 30, -- frequent find (quiet hunting)
	Pistol = 20,
	Musket = 16,
	Shotgun = 12,
	Revolver = 10,
	Rifle = 4, -- Legendary — extremely rare
}

-- Ammo bundle sizes handed out by loot / merchant.
Weapons.AmmoBundle = {
	Bullet = 12,
	Shell = 6,
	Arrow = 16, -- bows are common, so arrows come in bigger bundles
	Powder = 4,
}

-- Merchant shop: what the blue-hatted trader sells. Cost is either Doubloons (buy) or
-- Scrap (craft). The merchant is never hostile and always trades.
Weapons.Shop = {
	-- Ammo you craft from Scrap you scavenge on islands.
	{ Kind = "ammo", Ammo = "Bullet", Amount = 12, Currency = "Scrap", Cost = 4, Label = "Craft 12 Bullets" },
	{ Kind = "ammo", Ammo = "Shell", Amount = 6, Currency = "Scrap", Cost = 4, Label = "Craft 6 Shells" },
	{ Kind = "ammo", Ammo = "Arrow", Amount = 10, Currency = "Scrap", Cost = 2, Label = "Craft 10 Arrows" },
	{ Kind = "ammo", Ammo = "Powder", Amount = 4, Currency = "Scrap", Cost = 4, Label = "Craft 4 Powder & Ball" },
	-- Ammo you buy outright with Doubloons.
	{ Kind = "ammo", Ammo = "Bullet", Amount = 24, Currency = "Doubloons", Cost = 10, Label = "Buy 24 Bullets" },
	{ Kind = "ammo", Ammo = "Shell", Amount = 12, Currency = "Doubloons", Cost = 10, Label = "Buy 12 Shells" },
	-- Weapons for sale.
	{ Kind = "weapon", Weapon = "Pistol", Currency = "Doubloons", Cost = 30, Label = "Buy Flintlock Pistol" },
	{ Kind = "weapon", Weapon = "Bow", Currency = "Doubloons", Cost = 26, Label = "Buy Hunting Bow" },
	{ Kind = "weapon", Weapon = "Spear", Currency = "Doubloons", Cost = 18, Label = "Buy Fishing Spear" },
	{ Kind = "weapon", Weapon = "WarClub", Currency = "Doubloons", Cost = 40, Label = "Buy Spiked War Club" },
	{ Kind = "weapon", Weapon = "Shotgun", Currency = "Doubloons", Cost = 55, Label = "Buy Boarding Shotgun" },
	{ Kind = "weapon", Weapon = "Revolver", Currency = "Doubloons", Cost = 60, Label = "Buy Sea Revolver" },
	{ Kind = "weapon", Weapon = "Rifle", Currency = "Doubloons", Cost = 90, Label = "Buy Long Rifle" },
}

-- === Selling ==============================================================
-- The merchant buys anything you carry. Base sell value scales with rarity so a
-- legendary rifle is worth far more than a common club. Loot props (walls, torches,
-- planks, crates, beds) fetch a small flat scrap-tier value. Shared by client (price
-- preview) and server (authoritative payout) so both always agree.
Weapons.SellByRarity = {
	[0] = 3, -- Starter gear
	[1] = 4, -- Common
	[2] = 8, -- Uncommon
	[3] = 16, -- Rare
	[4] = 30, -- Epic
	[5] = 55, -- Legendary
}

-- Flat Doubloon value for salvage loot tools (Loot_Wall, Loot_Torch, ...).
Weapons.LootSellValue = 3

-- Authoritative sell price in Doubloons for an item, from what a Tool advertises via its
-- attributes. `itemId` is the Tool's "ItemId" attribute; `rarity` is optional (armor /
-- future items can pass their own tier). Returns 0 only for genuinely worthless items.
function Weapons.sellValue(itemId: string?, rarity: number?): number
	if typeof(itemId) == "string" then
		-- Looted weapons carry ItemId = "Weapon_<id>".
		local weaponId = string.match(itemId, "^Weapon_(.+)$")
		local def = weaponId and Weapons.List[weaponId]
		if def then
			return Weapons.SellByRarity[def.Rarity or 1] or 4
		end
		-- The starter club.
		if itemId == "StarterClub" then
			return Weapons.SellByRarity[0]
		end
		-- Salvage loot tools.
		if string.match(itemId, "^Loot_") then
			return Weapons.LootSellValue
		end
	end
	if typeof(rarity) == "number" then
		return Weapons.SellByRarity[rarity] or 4
	end
	-- Anything else the merchant will still take for a couple of coins.
	return 2
end

function Weapons.get(id: string): { [string]: any }?
	return Weapons.List[id]
end

function Weapons.isRanged(id: string): boolean
	local w = Weapons.List[id]
	return w ~= nil and w.Class == "ranged"
end

function Weapons.isMelee(id: string): boolean
	local w = Weapons.List[id]
	return w ~= nil and w.Class == "melee"
end

function Weapons.ammoAttribute(ammoId: string): string?
	local a = Weapons.Ammo[ammoId]
	return a and a.Attribute
end

-- Weighted random weapon id for island loot rolls.
function Weapons.rollLootWeapon(rng: (number, number) -> number): string
	local total = 0
	for _, w in Weapons.LootWeights do
		total += w
	end
	local pick = rng(1, total)
	local acc = 0
	for id, w in Weapons.LootWeights do
		acc += w
		if pick <= acc then
			return id
		end
	end
	return "Pistol"
end

return Weapons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Weather</string>
          <string name="Source"><![CDATA[-- Cosmetic open-sea weather: sunny, overcast, light rain, thunder, thunderstorm.
-- No damage — atmosphere only. Shared math for server schedule + client FX.
-- Lobby stays clear: clients apply FX only while in a crew at sea.

local Weather = {}

export type Mode = "Sunny" | "Overcast" | "LightRain" | "Thunder" | "Thunderstorm"

export type WeatherState = {
	fromMode: Mode,
	toMode: Mode,
	-- 0 = fully fromMode, 1 = fully toMode (during a hold, from==to and blend=1)
	blend: number,
	-- Effective weights after blending (for particles / sound)
	rain: number,
	cloud: number,
	thunderChance: number,
	sun: number,
	-- Session age factor [0, 1] — storms grow more likely as the voyage wears on
	voyageAge: number,
}

Weather.Modes = { "Sunny", "Overcast", "LightRain", "Thunder", "Thunderstorm" } :: { Mode }

-- Hold long enough to feel settled; short enough that the sky keeps moving.
Weather.MinHoldSeconds = 85
Weather.MaxHoldSeconds = 160
-- Crossfade between modes — gradual, never a hard cut.
Weather.MinTransitionSeconds = 22
Weather.MaxTransitionSeconds = 38

-- After this many seconds of server uptime, storm weights reach their peak.
Weather.VoyageRampSeconds = 720 -- 12 minutes

-- Workspace attribute names (server writes, clients read).
Weather.ATTR_FROM = "SurviveAtSeaWeatherFrom"
Weather.ATTR_TO = "SurviveAtSeaWeatherTo"
Weather.ATTR_BLEND = "SurviveAtSeaWeatherBlend"
Weather.ATTR_RAIN = "SurviveAtSeaWeatherRain"
Weather.ATTR_CLOUD = "SurviveAtSeaWeatherCloud"
Weather.ATTR_THUNDER = "SurviveAtSeaWeatherThunder"
Weather.ATTR_SUN = "SurviveAtSeaWeatherSun"
Weather.ATTR_VOYAGE = "SurviveAtSeaWeatherVoyage"
Weather.ATTR_FLASH = "SurviveAtSeaWeatherFlash" -- server time of last lightning strike

-- Realistic neighbor graph — weather drifts, it doesn't teleport.
local NEIGHBORS: { [Mode]: { Mode } } = {
	Sunny = { "Overcast", "Sunny" },
	Overcast = { "Sunny", "LightRain", "Thunder", "Overcast" },
	LightRain = { "Overcast", "Thunder", "Thunderstorm", "LightRain" },
	Thunder = { "Overcast", "LightRain", "Thunderstorm", "Thunder" },
	Thunderstorm = { "LightRain", "Thunder", "Thunderstorm" },
}

-- Per-mode visual targets (0–1 intensity channels).
local MODE_LOOK: { [Mode]: { rain: number, cloud: number, thunder: number, sun: number } } = {
	Sunny = { rain = 0, cloud = 0.05, thunder = 0, sun = 1 },
	Overcast = { rain = 0, cloud = 0.72, thunder = 0, sun = 0.25 },
	LightRain = { rain = 0.45, cloud = 0.82, thunder = 0.05, sun = 0.12 },
	Thunder = { rain = 0.15, cloud = 0.88, thunder = 0.55, sun = 0.08 },
	Thunderstorm = { rain = 1, cloud = 0.96, thunder = 1, sun = 0.02 },
}

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

function Weather.isMode(value: unknown): boolean
	return typeof(value) == "string"
		and (
			value == "Sunny"
			or value == "Overcast"
			or value == "LightRain"
			or value == "Thunder"
			or value == "Thunderstorm"
		)
end

function Weather.voyageAge(elapsedSeconds: number): number
	return smoothstep(math.clamp(elapsedSeconds / Weather.VoyageRampSeconds, 0, 1))
end

-- Base pick weights, then voyage age leans the sky toward wetter weather.
function Weather.weightFor(mode: Mode, voyageAge: number): number
	local early: { [Mode]: number } = {
		Sunny = 42,
		Overcast = 28,
		LightRain = 18,
		Thunder = 8,
		Thunderstorm = 4,
	}
	local late: { [Mode]: number } = {
		Sunny = 18,
		Overcast = 24,
		LightRain = 26,
		Thunder = 16,
		Thunderstorm = 16,
	}
	return lerp(early[mode], late[mode], voyageAge)
end

function Weather.pickNext(rng: Random, current: Mode, voyageAge: number): Mode
	local candidates = NEIGHBORS[current]
	local total = 0
	local weights = table.create(#candidates)
	for i, mode in candidates do
		-- Softly discourage immediate repeats of the same label during a "hold refresh".
		local w = Weather.weightFor(mode, voyageAge)
		if mode == current then
			w *= 0.35
		end
		weights[i] = w
		total += w
	end
	if total <= 0 then
		return "Overcast"
	end
	local roll = rng:NextNumber(0, total)
	local acc = 0
	for i, mode in candidates do
		acc += weights[i]
		if roll <= acc then
			return mode
		end
	end
	return candidates[#candidates]
end

function Weather.holdDuration(rng: Random): number
	return rng:NextNumber(Weather.MinHoldSeconds, Weather.MaxHoldSeconds)
end

function Weather.transitionDuration(rng: Random): number
	return rng:NextNumber(Weather.MinTransitionSeconds, Weather.MaxTransitionSeconds)
end

function Weather.channelsFor(fromMode: Mode, toMode: Mode, blend: number): {
	rain: number,
	cloud: number,
	thunder: number,
	sun: number,
}
	local t = smoothstep(blend)
	local a = MODE_LOOK[fromMode]
	local b = MODE_LOOK[toMode]
	return {
		rain = lerp(a.rain, b.rain, t),
		cloud = lerp(a.cloud, b.cloud, t),
		thunder = lerp(a.thunder, b.thunder, t),
		sun = lerp(a.sun, b.sun, t),
	}
end

function Weather.makeState(
	fromMode: Mode,
	toMode: Mode,
	blend: number,
	voyageAge: number
): WeatherState
	local ch = Weather.channelsFor(fromMode, toMode, blend)
	return {
		fromMode = fromMode,
		toMode = toMode,
		blend = math.clamp(blend, 0, 1),
		rain = ch.rain,
		cloud = ch.cloud,
		thunderChance = ch.thunder,
		sun = ch.sun,
		voyageAge = voyageAge,
	}
end

-- Lighting overlays blended on top of DayNight.lightingFor() for at-sea clients.
function Weather.lightingOverlay(state: WeatherState): {
	FogColor: Color3,
	FogStartMul: number,
	FogEndMul: number,
	AtmosphereDensityAdd: number,
	AtmosphereHazeAdd: number,
	AtmosphereGlareMul: number,
	BrightnessMul: number,
	SunRaysMul: number,
	ColorCorrectionTint: Color3,
	ColorCorrectionSaturationAdd: number,
	ColorCorrectionBrightnessAdd: number,
	ColorCorrectionContrastAdd: number,
}
	local cloud = state.cloud
	local rain = state.rain
	local sun = state.sun

	local clearFog = Color3.fromRGB(130, 170, 190)
	local stormFog = Color3.fromRGB(72, 84, 96)
	local fogColor = clearFog:Lerp(stormFog, math.clamp(cloud * 0.85 + rain * 0.25, 0, 1))

	return {
		FogColor = fogColor,
		FogStartMul = lerp(1, 0.55, cloud * 0.7 + rain * 0.3),
		FogEndMul = lerp(1, 0.48, cloud * 0.65 + rain * 0.35),
		AtmosphereDensityAdd = cloud * 0.22 + rain * 0.08,
		AtmosphereHazeAdd = cloud * 1.35 + rain * 0.4,
		AtmosphereGlareMul = lerp(1, 0.15, 1 - sun),
		BrightnessMul = lerp(0.72, 1.05, sun) * lerp(1, 0.88, rain),
		SunRaysMul = math.clamp(sun * 1.15, 0, 1),
		ColorCorrectionTint = Color3.fromRGB(255, 248, 238):Lerp(Color3.fromRGB(188, 200, 214), cloud),
		ColorCorrectionSaturationAdd = lerp(0.04, -0.16, cloud) + rain * -0.04,
		ColorCorrectionBrightnessAdd = lerp(0.02, -0.05, cloud) + rain * -0.03,
		ColorCorrectionContrastAdd = cloud * 0.04 + rain * 0.02,
	}
end

-- Mean seconds between lightning strikes at full thunderstorm intensity.
function Weather.lightningInterval(thunderChance: number): number?
	if thunderChance < 0.12 then
		return nil
	end
	-- Thunder: ~18–40s · Thunderstorm: ~4–12s (scaled by chance)
	local minGap = lerp(40, 4.5, thunderChance)
	local maxGap = lerp(70, 12, thunderChance)
	return (minGap + maxGap) * 0.5
end

function Weather.readStateFromWorkspace(workspace: Workspace): WeatherState?
	local fromMode = workspace:GetAttribute(Weather.ATTR_FROM)
	local toMode = workspace:GetAttribute(Weather.ATTR_TO)
	if not (Weather.isMode(fromMode) and Weather.isMode(toMode)) then
		return nil
	end
	local blend = workspace:GetAttribute(Weather.ATTR_BLEND)
	local rain = workspace:GetAttribute(Weather.ATTR_RAIN)
	local cloud = workspace:GetAttribute(Weather.ATTR_CLOUD)
	local thunder = workspace:GetAttribute(Weather.ATTR_THUNDER)
	local sun = workspace:GetAttribute(Weather.ATTR_SUN)
	local voyage = workspace:GetAttribute(Weather.ATTR_VOYAGE)
	if typeof(blend) ~= "number" then
		blend = 1
	end
	return {
		fromMode = fromMode :: Mode,
		toMode = toMode :: Mode,
		blend = blend,
		rain = if typeof(rain) == "number" then rain else 0,
		cloud = if typeof(cloud) == "number" then cloud else 0,
		thunderChance = if typeof(thunder) == "number" then thunder else 0,
		sun = if typeof(sun) == "number" then sun else 1,
		voyageAge = if typeof(voyage) == "number" then voyage else 0,
	}
end

return Weather
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">SurviveAtSea</string>
      </Properties>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ArmorService</string>
          <string name="Source"><![CDATA[-- Server authority for wearable armor.
--
-- Armor is WORN, not held: walking into a piece's ProximityPrompt equips it to a body
-- slot (Head / Body / Legs), welding cosmetic geometry to the character and raising the
-- player's damage reduction. One piece per slot; picking up a piece for a slot you already
-- wear swaps it.
--
-- Damage reduction is exposed two ways:
--   * Player attribute "ArmorRating" (0..MaxReduction) — replicates to the owning client
--     for the HUD.
--   * ArmorService.applyPlayerDamage(player, amount) — the single choke point every source
--     of player damage should call so armor is always respected.
--
-- Worn state survives respawns: on CharacterAdded we re-weld whatever the player had on.
-- (This is a session game with no DataStores, so armor is only lost on leave, not death.)

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Armor = require(Shared:WaitForChild("Armor"))

local ArmorToolFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("ArmorToolFactory"))

local ArmorService = {}

-- userId -> { Head = armorId?, Body = armorId?, Legs = armorId? }
ArmorService._wornByUser = {} :: { [number]: { [string]: string } }
ArmorService._Toast = nil :: RemoteEvent?
ArmorService._started = false

local function toast(player: Player, message: string, kind: string)
	if ArmorService._Toast then
		ArmorService._Toast:FireClient(player, message, kind)
	end
end

local function wornSet(userId: number): { [string]: string }
	local set = ArmorService._wornByUser[userId]
	if not set then
		set = {}
		ArmorService._wornByUser[userId] = set
	end
	return set
end

-- Sum the worn pieces' Defense, clamped so armor can never fully negate damage.
local function computeRating(userId: number): number
	local total = 0
	for _, armorId in wornSet(userId) do
		local def = Armor.get(armorId)
		if def then
			total += def.Defense or 0
		end
	end
	return math.clamp(total, 0, Armor.MaxReduction)
end

local function refreshRating(player: Player)
	player:SetAttribute("ArmorRating", computeRating(player.UserId))
end

-- Weld the geometry for every worn slot onto the (live) character.
local function applyVisuals(player: Player)
	local character = player.Character
	if not character then
		return
	end
	-- Clear any stale armor folders first so a swap / respawn never doubles up.
	for _, child in character:GetChildren() do
		if child:IsA("Folder") and string.sub(child.Name, 1, 6) == "Armor_" then
			child:Destroy()
		end
	end
	for _, armorId in wornSet(player.UserId) do
		ArmorToolFactory.wearOnCharacter(character, armorId)
	end
end

-- === Public API ==========================================================

function ArmorService.getRating(player: Player): number
	return computeRating(player.UserId)
end

-- Equip a piece (swapping whatever's in that slot). Returns true if worn.
function ArmorService.wearArmor(player: Player, armorId: string, silent: boolean?): boolean
	local def = Armor.get(armorId)
	if not def then
		return false
	end
	local set = wornSet(player.UserId)
	local prev = set[def.Slot]
	if prev == armorId then
		if not silent then
			toast(player, `Already wearing {def.Name}.`, "info")
		end
		return false
	end
	set[def.Slot] = armorId
	applyVisuals(player)
	refreshRating(player)

	if not silent then
		local rating = math.floor(computeRating(player.UserId) * 100 + 0.5)
		toast(player, `Equipped {def.Name} — {rating}% armor.`, "success")
	end
	return true
end

-- The single choke point for damaging a player: applies worn armor reduction, then hits
-- the humanoid. Returns the damage actually dealt.
function ArmorService.applyPlayerDamage(player: Player, amount: number): number
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (humanoid and humanoid.Health > 0) then
		return 0
	end
	local rating = computeRating(player.UserId)
	local dealt = math.max(0, amount * (1 - rating))
	humanoid:TakeDamage(dealt)
	return dealt
end

function ArmorService.attachPickupPrompt(model: Model)
	local primary = model.PrimaryPart or model:FindFirstChild("Primary")
	if not (primary and primary:IsA("BasePart")) then
		return
	end
	if primary:FindFirstChild("ArmorPickupPrompt") then
		return
	end
	local armorId = model:GetAttribute("ArmorId")
	local def = typeof(armorId) == "string" and Armor.get(armorId)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ArmorPickupPrompt"
	prompt.ActionText = "Wear"
	prompt.ObjectText = if def then def.Name else "Armor"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Parent = primary

	prompt.Triggered:Connect(function(player: Player)
		if typeof(armorId) ~= "string" then
			return
		end
		if ArmorService.wearArmor(player, armorId) then
			model:Destroy()
		end
	end)
end

function ArmorService.spawnArmorPickup(parent: Instance, armorId: string, cf: CFrame): Model?
	local model = ArmorToolFactory.createWorldPickup(parent, armorId, cf)
	if model then
		ArmorService.attachPickupPrompt(model)
	end
	return model
end

function ArmorService.start(remotes: { Toast: RemoteEvent })
	if ArmorService._started then
		return
	end
	ArmorService._started = true
	ArmorService._Toast = remotes.Toast

	local function hookPlayer(player: Player)
		if player:GetAttribute("ArmorRating") == nil then
			player:SetAttribute("ArmorRating", 0)
		end
		player.CharacterAdded:Connect(function()
			-- Re-weld worn armor after a respawn (defer so the rig exists first).
			task.defer(function()
				task.wait(0.2)
				if player.Parent then
					applyVisuals(player)
					refreshRating(player)
				end
			end)
		end)
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(function(player)
		ArmorService._wornByUser[player.UserId] = nil
	end)
end

return ArmorService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Survive at Sea · Server bootstrap

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

print("[SurviveAtSea] Server bootstrap starting…")

local Shared = ReplicatedStorage:WaitForChild("Shared", 30)
if not Shared then
	error("[SurviveAtSea] ReplicatedStorage.Shared missing — is Rojo connected?")
end

local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local PartyCode = require(Shared:WaitForChild("PartyCode"))
local LobbyWorld = require(Shared:WaitForChild("LobbyWorld"))

local LobbyBuilder = require(script.Parent:WaitForChild("LobbyBuilder"))
local PartyService = require(script.Parent:WaitForChild("PartyService"))
local PortalService = require(script.Parent:WaitForChild("PortalService"))
local StarterBaseService = require(script.Parent:WaitForChild("StarterBaseService"))
local HelmService = require(script.Parent:WaitForChild("HelmService"))
local IslandService = require(script.Parent:WaitForChild("IslandService"))
local WeaponService = require(script.Parent:WaitForChild("WeaponService"))
local ArmorService = require(script.Parent:WaitForChild("ArmorService"))
local MerchantService = require(script.Parent:WaitForChild("MerchantService"))
local OceanTerrainService = require(script.Parent:WaitForChild("OceanTerrainService"))
local DayNightService = require(script.Parent:WaitForChild("DayNightService"))
local WeatherService = require(script.Parent:WaitForChild("WeatherService"))
local StarterGearService = require(script.Parent:WaitForChild("StarterGearService"))
local MeleeService = require(script.Parent:WaitForChild("Combat"):WaitForChild("MeleeService"))
local LootPropService = require(script.Parent:WaitForChild("LootPropService"))

print(`[SurviveAtSea] Booting {Config.GameName} lobby…`)

-- Build/replicate dock on the server so all players share it
local lobby = LobbyWorld.ensure()
LobbyBuilder.enhanceExisting(lobby)

-- Fault isolation: a crash in any single service must never take down the
-- boarding-pier / crew-creation path wired below. (Regression guard: the huge
-- island + loot world-gen used to run BEFORE the remotes existed, so any hiccup
-- there left every portal dead.)
local function safeStart(label: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn(`[SurviveAtSea] {label} failed to start (lobby still playable):`, err)
	end
end

local remoteFolder = Remotes.createServerRemotes()
local CreateParty = remoteFolder:WaitForChild("CreateParty")
local JoinParty = remoteFolder:WaitForChild("JoinParty")
local LeaveParty = remoteFolder:WaitForChild("LeaveParty")
local PartyUpdated = remoteFolder:WaitForChild("PartyUpdated")
local PortalsUpdated = remoteFolder:WaitForChild("PortalsUpdated")
local Toast = remoteFolder:WaitForChild("Toast")
local GetLobbyState = remoteFolder:WaitForChild("GetLobbyState")
local HelmLook = remoteFolder:WaitForChild("HelmLook")
local HelmThrottle = remoteFolder:WaitForChild("HelmThrottle")
local HelmState = remoteFolder:WaitForChild("HelmState")
local HelmDismount = remoteFolder:WaitForChild("HelmDismount")
local ShootGun = remoteFolder:WaitForChild("ShootGun")
local WeaponReload = remoteFolder:WaitForChild("WeaponReload")
local WeaponFx = remoteFolder:WaitForChild("WeaponFx")
local MeleeAttack = remoteFolder:WaitForChild("MeleeAttack")
local MeleeSwingFx = remoteFolder:WaitForChild("MeleeSwingFx")
local LootDragStart = remoteFolder:WaitForChild("LootDragStart")
local LootDragUpdate = remoteFolder:WaitForChild("LootDragUpdate")
local LootDragEnd = remoteFolder:WaitForChild("LootDragEnd")
local LootWeld = remoteFolder:WaitForChild("LootWeld")
local LootUnweld = remoteFolder:WaitForChild("LootUnweld")
local LootPlace = remoteFolder:WaitForChild("LootPlace")
local MerchantTrade = remoteFolder:WaitForChild("MerchantTrade")
local MerchantShop = remoteFolder:WaitForChild("MerchantShop")

-- Boarding is never coupled to heavyweight world generation. The raft and player
-- are created immediately; the opening island ring continues preparing alongside
-- gameplay on a fresh server.
local voyageWorldReady = false

-- Shared accessors used by several services below.
local function getPartyCode(player: Player): string?
	return PartyService.getPartyCode(player)
end
local function getMemberUserIds(code: string): { number }
	return PartyService.getMemberUserIds(code)
end

-- Raft build hooks must exist before any crew spawns its plank.
StarterBaseService._onBaseBuilt = function(code, model)
	HelmService.bindBase(code, model)
end
StarterBaseService._onBaseDestroyed = function(code)
	HelmService.onBaseDestroyed(code)
	IslandService.clearCrew(code)
end

-- === Boarding-pier / crew path — wired first so portals always work, even if
-- the heavier world generation below is slow or throws. ===
PortalService.start(Toast, PartyUpdated, PortalsUpdated)

GetLobbyState.OnServerInvoke = function(player)
	return PartyService.getLobbyState(player)
end

local function createPartyForPlayer(player: Player, portalIndex: number, maxPlayers: number)
	if PartyService.isInParty(player) then
		return
	end
	local ok, message, snapshot = PartyService.createParty(player, portalIndex, maxPlayers)
	Toast:FireClient(player, message, if ok then "success" else "error")
	if ok and snapshot then
		PartyUpdated:FireClient(player, snapshot)
	end
end

CreateParty.OnServerEvent:Connect(function(player, portalIndex, maxPlayers, _privacy)
	if typeof(portalIndex) ~= "number" or typeof(maxPlayers) ~= "number" then
		Toast:FireClient(player, "Invalid boarding request.", "error")
		return
	end
	-- Crews are always private; ignore any client privacy flag.
	createPartyForPlayer(player, portalIndex, maxPlayers)
end)

JoinParty.OnServerEvent:Connect(function(player, rawCode)
	if typeof(rawCode) ~= "string" then
		Toast:FireClient(player, "Enter a crew code.", "error")
		return
	end
	local ok, message, snapshot = PartyService.joinParty(player, PartyCode.normalize(rawCode))
	Toast:FireClient(player, message, if ok then "success" else "error")
	if ok and snapshot then
		PartyUpdated:FireClient(player, snapshot)
	end
end)

LeaveParty.OnServerEvent:Connect(function(player)
	local ok, message = PartyService.leaveParty(player)
	Toast:FireClient(player, message, if ok then "info" else "error")
	if ok then
		PartyUpdated:FireClient(player, nil)
	end
end)

local function seatPlayer(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local seat = PartyService.getBaseSeatInfo(player)
	if seat then
		-- Death / respawn while on a crew → back on the raft (for now)
		StarterBaseService.teleportPlayerToBase(player, seat.baseSlot, seat.slotIndex)
		StarterGearService.ensureStarterClub(player)
	else
		LobbyWorld.seatCharacter(character)
	end
end

local function onPlayerReady(player)
	player.CharacterAdded:Connect(function(_character)
		-- Brief defer so HumanoidRootPart exists after respawn
		task.defer(function()
			seatPlayer(player)
		end)
	end)
	if player.Character then
		task.defer(function()
			seatPlayer(player)
		end)
	end

	task.defer(function()
		PortalsUpdated:FireClient(player, PartyService.getPortalInfos())
		Toast:FireClient(
			player,
			"Walk a portal to form a private crew. Friends join with your code.",
			"info"
		)
	end)
end

Players.PlayerRemoving:Connect(function(player)
	HelmService.releaseIfHelming(player)
	PartyService.onPlayerRemoving(player)
end)

for _, player in Players:GetPlayers() do
	onPlayerReady(player)
end
Players.PlayerAdded:Connect(onPlayerReady)

-- === Gameplay + world services — each fault-isolated so a failure here can
-- never break the boarding pier / crew creation wired above. ===
safeStart("DayNightService", DayNightService.start)
safeStart("WeatherService", WeatherService.start)

-- Weapons: ranged fire, ammo reserves, player currency, weapon/ammo grants + pickups.
safeStart("WeaponService", function()
	WeaponService.start({
		Toast = Toast :: RemoteEvent,
		WeaponFx = WeaponFx :: RemoteEvent,
	})
end)

-- Armor: worn damage-reduction gear looted on islands. Started BEFORE IslandService so
-- armor pickups spawned during island generation wire their prompts correctly.
safeStart("ArmorService", function()
	ArmorService.start({ Toast = Toast :: RemoteEvent })
end)

-- Merchant trading (buy with Doubloons / craft with Scrap). Started BEFORE IslandService
-- so merchants spawned during island generation register + wire correctly.
safeStart("MerchantService", function()
	MerchantService.start({
		Toast = Toast :: RemoteEvent,
		Shop = MerchantShop :: RemoteEvent,
		Trade = MerchantTrade :: RemoteFunction,
	}, function(model)
		LootPropService.registerExisting(model)
	end)
end)

-- Helm: look-steer + throttle drive, jump to unlock
safeStart("HelmService", function()
	HelmService.start(HelmState :: RemoteEvent, Toast :: RemoteEvent, getPartyCode, getMemberUserIds)
end)

HelmLook.OnServerEvent:Connect(function(player, look)
	if typeof(look) ~= "Vector3" then
		return
	end
	HelmService.setLook(player, look)
end)

HelmThrottle.OnServerEvent:Connect(function(player, throttle)
	if typeof(throttle) ~= "number" then
		return
	end
	HelmService.setThrottle(player, throttle)
end)

HelmDismount.OnServerEvent:Connect(function(player)
	if HelmService.isHelming(player) then
		HelmService.release(player, "Left the helm.")
	end
end)

ShootGun.OnServerEvent:Connect(function(player, look)
	if typeof(look) ~= "Vector3" then
		return
	end
	WeaponService.tryShoot(player, look)
end)

WeaponReload.OnServerEvent:Connect(function(player)
	WeaponService.reload(player)
end)

-- Starter club + melee (RMB / RT / mobile tap). Drop uses default Tool backpack.
safeStart("StarterGearService", function()
	StarterGearService.start(function(player)
		return PartyService.isInParty(player)
	end)
end)
safeStart("MeleeService", function()
	MeleeService.start(MeleeSwingFx :: RemoteEvent, MeleeAttack :: RemoteEvent, function(player)
		return HelmService.isHelming(player)
	end)
end)

-- World loot: drag / weld / pick up island salvage.
safeStart("LootPropService", function()
	LootPropService.start(Toast :: RemoteEvent, getPartyCode, {
		DragStart = LootDragStart :: RemoteEvent,
		DragUpdate = LootDragUpdate :: RemoteEvent,
		DragEnd = LootDragEnd :: RemoteEvent,
		WeldProp = LootWeld :: RemoteEvent,
		UnweldProp = LootUnweld :: RemoteEvent,
		PlaceLoot = LootPlace :: RemoteEvent,
	})
end)

-- Fall into water → rescued onto raft; death already uses CharacterAdded → seatPlayer
-- Skip while at the helm (stand lock owns their position)
safeStart("WaterRescue", function()
	StarterBaseService.startWaterRescue(function(player)
		return PartyService.getBaseSeatInfo(player)
	end, function(player)
		return HelmService.isHelming(player)
	end)
end)

-- Make every portal interactive immediately. Large island models are prepared in
-- a separate task so a cold server can never turn world generation into a queue
-- or wait period between clicking Spawn Base and arriving on the raft.
PortalService.setBoardingReady(true)
task.spawn(function()
	while not voyageWorldReady do
		local voyageWorldOk, voyageWorldErr = pcall(function()
			-- Water must exist before the expensive island detail pass. The ocean
			-- streamer already knows every catalog center, even before islands build.
			OceanTerrainService.start()
			IslandService.start(Toast :: RemoteEvent, getPartyCode, getMemberUserIds)
		end)
		if voyageWorldOk then
			voyageWorldReady = true
		else
			warn("[SurviveAtSea] Voyage world failed to prepare; retrying:", voyageWorldErr)
			task.wait(5)
		end
	end
end)

print(`[SurviveAtSea] Lobby ready — private crews only, max {Config.MaxPartySize} per run, portals board instantly.`)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Combat</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">MeleeService</string>
            <string name="Source"><![CDATA[-- Server-authoritative melee for the starter Club.
-- Client requests a swing; server checks equip + cooldown + range, then applies damage.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local MeleeService = {}

local lastSwingAt: { [number]: number } = {}
local MeleeSwingFx: RemoteEvent? = nil
local isHelming: ((Player) -> boolean)? = nil

local function equippedClub(player: Player): Tool?
	local character = player.Character
	if not character then
		return nil
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("MeleeWeapon") == true then
			return child
		end
	end
	return nil
end

local function rootPart(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function humanoidOf(model: Model): Humanoid?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

local function findDamageTarget(
	attacker: Player,
	origin: Vector3,
	look: Vector3,
	range: number,
	radius: number
): (Humanoid?, Model?)
	local forward = look.Unit
	local probe = origin + forward * (range * 0.55)

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = {}
	if attacker.Character then
		table.insert(exclude, attacker.Character)
	end
	overlap.FilterDescendantsInstances = exclude

	local parts = Workspace:GetPartBoundsInRadius(probe, radius + 1.5, overlap)
	local bestHumanoid: Humanoid? = nil
	local bestModel: Model? = nil
	local bestDist = math.huge

	for _, part in parts do
		local model = part:FindFirstAncestorOfClass("Model")
		if not model or model == attacker.Character then
			continue
		end
		local humanoid = humanoidOf(model)
		if not humanoid then
			continue
		end
		-- Hit island NPCs (villagers / hostile defenders / scavengers). Passive villagers
		-- flip to defenders on damage via IslandService's health watcher. The merchant has
		-- no Humanoid, so it's naturally never a valid target.
		local isNpc = model:GetAttribute("IsNpc") == true or model:GetAttribute("IsPirate") == true
		if not isNpc then
			continue
		end

		local victimRoot = model:FindFirstChild("HumanoidRootPart")
		local targetPos = if victimRoot and victimRoot:IsA("BasePart") then victimRoot.Position else part.Position
		local toTarget = targetPos - origin
		local dist = toTarget.Magnitude
		if dist > range then
			continue
		end
		-- Must be roughly in front of the attacker
		if dist > 0.5 and toTarget.Unit:Dot(forward) < 0.25 then
			continue
		end
		if dist < bestDist then
			bestDist = dist
			bestHumanoid = humanoid
			bestModel = model
		end
	end

	return bestHumanoid, bestModel
end

function MeleeService.tryAttack(player: Player): boolean
	local tool = equippedClub(player)
	if not tool then
		return false
	end

	if isHelming and isHelming(player) then
		return false
	end

	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	local root = rootPart(player)
	if not root then
		return false
	end

	-- Per-weapon tuning (spear reaches further / hits harder than the club); fall back to
	-- the club config for the starter club and any tool missing attributes.
	local function attr(name: string, fallback: number): number
		local v = tool:GetAttribute(name)
		return if typeof(v) == "number" then v else fallback
	end
	local cooldown = attr("Cooldown", Config.Club.SwingCooldown)
	local range = attr("Range", Config.Club.Range)
	local radius = attr("HitRadius", Config.Club.HitRadius)
	local hitWindow = attr("HitWindow", Config.Club.HitWindow)

	local now = Workspace:GetServerTimeNow()
	local last = lastSwingAt[player.UserId] or 0
	if now - last < cooldown then
		return false
	end
	lastSwingAt[player.UserId] = now

	-- Broadcast swing FX to nearby clients (including attacker for sync polish)
	if MeleeSwingFx then
		MeleeSwingFx:FireAllClients(player.UserId, tool.Name)
	end

	-- Brief hit window so the swing feels intentional, not instant sniper
	task.delay(hitWindow * 0.35, function()
		if not player.Parent then
			return
		end
		if equippedClub(player) ~= tool then
			return
		end
		local liveRoot = rootPart(player)
		if not liveRoot then
			return
		end
		local look = liveRoot.CFrame.LookVector
		local origin = liveRoot.Position + Vector3.new(0, 1.2, 0)
		local victimHumanoid = findDamageTarget(player, origin, look, range, radius)
		if victimHumanoid then
			local damage = tool:GetAttribute("Damage")
			if typeof(damage) ~= "number" then
				damage = Config.Club.Damage
			end
			victimHumanoid:TakeDamage(damage :: number)
		end
	end)

	return true
end

function MeleeService.start(
	swingFxRemote: RemoteEvent,
	attackRemote: RemoteEvent,
	helmingCheck: ((Player) -> boolean)?
)
	MeleeSwingFx = swingFxRemote
	isHelming = helmingCheck

	attackRemote.OnServerEvent:Connect(function(player)
		MeleeService.tryAttack(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastSwingAt[player.UserId] = nil
	end)
end

return MeleeService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">DayNightService</string>
          <string name="Source"><![CDATA[-- Publishes day / night cycle state from server time so clients stay in sync.
-- Visual lighting is client-owned: lobby stays daytime; gameplay follows each
-- crew's cycleOrigin (voyage always begins at 9:00 AM). Attributes here are a
-- global fallback for debugging — clients prefer ClockHUD.getGameplayState().

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local DayNight = require(Shared:WaitForChild("DayNight"))

local DayNightService = {}

local ATTR_CLOCK = "SurviveAtSeaClockTime"
local ATTR_DISPLAY = "SurviveAtSeaClockDisplay"
local ATTR_PHASE = "SurviveAtSeaDayPhase"
local ATTR_DAY_AMOUNT = "SurviveAtSeaDayAmount"

local started = false

local function publishState(state: DayNight.CycleState)
	Workspace:SetAttribute(ATTR_CLOCK, state.clockTime)
	Workspace:SetAttribute(ATTR_DISPLAY, state.displayTime)
	Workspace:SetAttribute(ATTR_PHASE, state.phase)
	Workspace:SetAttribute(ATTR_DAY_AMOUNT, state.dayAmount)
end

function DayNightService.start()
	if started then
		return
	end
	started = true

	publishState(DayNight.getState(Workspace:GetServerTimeNow()))

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.2 then
			return
		end
		accum = 0
		publishState(DayNight.getState(Workspace:GetServerTimeNow()))
	end)

	print("[SurviveAtSea] Day/night sync started — 5 min day / 5 min night, crews start at 9:00 AM")
end

return DayNightService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">HelmService</string>
          <string name="Source"><![CDATA[-- Helm: lock a sailor standing at the wheel, steer by look, drive with throttle
-- (W/S · stick · mobile arrows). Jump / B unlocks. Idle throttle = drift stop.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local StarterBaseService = require(script.Parent:WaitForChild("StarterBaseService"))
local IslandService = require(script.Parent:WaitForChild("IslandService"))

export type HelmSession = {
	userId: number,
	code: string,
	lookFlat: Vector3,
	-- -1..1 — forward along look, reverse opposite; 0 = hold still
	throttle: number,
	wheelSpin: number,
	savedWalkSpeed: number,
	savedJumpHeight: number,
	savedAutoRotate: boolean,
	lockToastAt: number,
	groundToastAt: number,
	connections: { RBXScriptConnection },
}

local HelmService = {}

HelmService._sessionsByUserId = {} :: { [number]: HelmSession }
HelmService._helmsmanByCode = {} :: { [string]: number }
HelmService._HelmState = nil :: RemoteEvent?
HelmService._Toast = nil :: RemoteEvent?
HelmService._getPartyCode = nil :: ((Player) -> string?)?
HelmService._getPartyMembers = nil :: ((string) -> { number })?

local function getHelmStand(code: string): BasePart?
	local model = StarterBaseService.getBaseModel(code)
	if not model then
		return nil
	end
	local kit = model:FindFirstChild("StarterKit")
	local stand = kit and kit:FindFirstChild("HelmStand")
	if stand and stand:IsA("BasePart") then
		return stand
	end
	return nil
end

local function getHelmPrompt(code: string): ProximityPrompt?
	local model = StarterBaseService.getBaseModel(code)
	if not model then
		return nil
	end
	local kit = model:FindFirstChild("StarterKit")
	local anchor = kit and kit:FindFirstChild("HelmPromptAnchor")
	local prompt = anchor and anchor:FindFirstChild("HelmPrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		return prompt
	end
	return nil
end

local function getHelmWheel(code: string): (Model?, BasePart?, CFrameValue?)
	local model = StarterBaseService.getBaseModel(code)
	if not model then
		return nil, nil, nil
	end
	local kit = model:FindFirstChild("StarterKit")
	local wheel = kit and kit:FindFirstChild("HelmWheel")
	local column = kit and kit:FindFirstChild("HelmPedestal")
	local restLocal = wheel and wheel:FindFirstChild("WheelRestLocal")
	if
		wheel
		and wheel:IsA("Model")
		and column
		and column:IsA("BasePart")
		and restLocal
		and restLocal:IsA("CFrameValue")
	then
		return wheel, column, restLocal
	end
	return nil, nil, nil
end

local function flattenLook(look: Vector3): Vector3?
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then
		return nil
	end
	return flat.Unit
end

-- Signed yaw from raft heading → look (matches the helmsman face turn)
local function lookYawError(deckForward: Vector3, look: Vector3): number
	return math.atan2(deckForward:Cross(look).Y, deckForward:Dot(look))
end

local function applyWheelSpin(code: string, spinRadians: number)
	local wheel, column, restLocal = getHelmWheel(code)
	if not (wheel and column and restLocal) then
		return
	end
	-- Cylinder axle is local X of the rest pose — spin around that axis
	wheel:PivotTo(column.CFrame * restLocal.Value * CFrame.Angles(spinRadians, 0, 0))
end

local function fireState(player: Player, active: boolean)
	if HelmService._HelmState then
		HelmService._HelmState:FireClient(player, active)
	end
end

local function toast(player: Player, message: string, kind: string)
	if HelmService._Toast then
		HelmService._Toast:FireClient(player, message, kind)
	end
end

function HelmService.release(player: Player, reason: string?)
	local session = HelmService._sessionsByUserId[player.UserId]
	if not session then
		return
	end

	HelmService._sessionsByUserId[player.UserId] = nil
	if HelmService._helmsmanByCode[session.code] == player.UserId then
		HelmService._helmsmanByCode[session.code] = nil
	end

	for _, conn in session.connections do
		conn:Disconnect()
	end

	local prompt = getHelmPrompt(session.code)
	if prompt then
		prompt.Enabled = true
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid then
		humanoid.WalkSpeed = session.savedWalkSpeed
		humanoid.JumpHeight = session.savedJumpHeight
		humanoid.AutoRotate = session.savedAutoRotate
		humanoid.PlatformStand = false
	end

	-- Hop off the wheel so the sailor clears the stand lock
	local stand = getHelmStand(session.code)
	if root and root:IsA("BasePart") then
		if stand then
			local hopCf = stand.CFrame * CFrame.new(0, 3.2, 2.5)
			root.CFrame = hopCf
		end
		root.AssemblyLinearVelocity = Vector3.new(0, 42, 0)
		root.AssemblyAngularVelocity = Vector3.zero
	end

	-- Ease the wooden wheel back to rest when leaving the helm
	session.wheelSpin = 0
	applyWheelSpin(session.code, 0)

	fireState(player, false)
	if reason then
		toast(player, reason, "info")
	end
end

function HelmService.mount(player: Player, code: string): boolean
	if HelmService._sessionsByUserId[player.UserId] then
		return false
	end
	if HelmService._helmsmanByCode[code] then
		toast(player, "Someone is already at the wheel.", "error")
		return false
	end

	local partyCode = HelmService._getPartyCode and HelmService._getPartyCode(player)
	if partyCode ~= code then
		toast(player, "That's not your crew's raft.", "error")
		return false
	end

	local stand = getHelmStand(code)
	if not stand then
		return false
	end

	local character = player.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and root:IsA("BasePart")) then
		return false
	end
	if humanoid.Health <= 0 then
		return false
	end

	local prompt = getHelmPrompt(code)
	if prompt then
		prompt.Enabled = false
	end

	local session: HelmSession = {
		userId = player.UserId,
		code = code,
		lookFlat = flattenLook(stand.CFrame.LookVector) or Vector3.new(0, 0, -1),
		throttle = 0,
		wheelSpin = 0,
		savedWalkSpeed = humanoid.WalkSpeed,
		savedJumpHeight = humanoid.JumpHeight,
		savedAutoRotate = humanoid.AutoRotate,
		lockToastAt = 0,
		groundToastAt = 0,
		connections = {},
	}

	-- Lock standing: no walk, keep jump so they can hop off
	humanoid.WalkSpeed = 0
	humanoid.AutoRotate = false
	humanoid.Sit = false
	humanoid.PlatformStand = false
	-- Ensure jump is available to exit
	if humanoid.JumpHeight < 7.2 then
		humanoid.JumpHeight = 7.2
	end

	-- Snap into the stand pose (upright, facing the wheel / bow)
	local standCf = stand.CFrame * CFrame.new(0, 3, 0)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = standCf

	HelmService._sessionsByUserId[player.UserId] = session
	HelmService._helmsmanByCode[code] = player.UserId

	table.insert(
		session.connections,
		humanoid.StateChanged:Connect(function(_old, newState)
			-- Backup unlock if JumpRequest remote is late; ignore Freefall (snap can trip it)
			if newState == Enum.HumanoidStateType.Jumping then
				HelmService.release(player, "Left the helm.")
			end
		end)
	)

	table.insert(
		session.connections,
		humanoid.Died:Connect(function()
			HelmService.release(player)
		end)
	)

	table.insert(
		session.connections,
		player.CharacterRemoving:Connect(function()
			HelmService.release(player)
		end)
	)

	fireState(player, true)
	toast(player, "At the helm — look to steer, W/S to sail the isles, jump / B to leave.", "success")
	return true
end

function HelmService.setLook(player: Player, look: Vector3)
	local session = HelmService._sessionsByUserId[player.UserId]
	if not session then
		return
	end
	local flat = flattenLook(look)
	if flat then
		session.lookFlat = flat
	end
end

function HelmService.setThrottle(player: Player, throttle: number)
	local session = HelmService._sessionsByUserId[player.UserId]
	if not session then
		return
	end
	if typeof(throttle) ~= "number" or throttle ~= throttle then
		return
	end
	session.throttle = math.clamp(throttle, -1, 1)
end

function HelmService.isHelming(player: Player): boolean
	return HelmService._sessionsByUserId[player.UserId] ~= nil
end

local function moveCrewWithDelta(code: string, delta: CFrame, helmsmanUserId: number?)
	if not HelmService._getPartyMembers then
		return
	end
	for _, userId in HelmService._getPartyMembers(code) do
		local plr = Players:GetPlayerByUserId(userId)
		if not plr then
			continue
		end
		-- Helmsman is re-snapped to the stand each frame
		if helmsmanUserId and userId == helmsmanUserId then
			continue
		end
		local character = plr.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			root.CFrame = delta * root.CFrame
		end
	end
end

local function snapHelmsmanToStand(session: HelmSession)
	local stand = getHelmStand(session.code)
	if not stand then
		return
	end
	local player = Players:GetPlayerByUserId(session.userId)
	if not player then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (root and root:IsA("BasePart") and humanoid) then
		return
	end

	-- Face the way we're sailing; stay planted on the stand
	local face = session.lookFlat
	local pos = (stand.CFrame * CFrame.new(0, 3, 0)).Position
	root.CFrame = CFrame.new(pos, pos + face)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	humanoid.WalkSpeed = 0
	humanoid.Sit = false
end

function HelmService.start(
	helmStateRemote: RemoteEvent,
	toastRemote: RemoteEvent,
	getPartyCode: (Player) -> string?,
	getPartyMembers: (string) -> { number }
)
	HelmService._HelmState = helmStateRemote
	HelmService._Toast = toastRemote
	HelmService._getPartyCode = getPartyCode
	HelmService._getPartyMembers = getPartyMembers

	RunService.Heartbeat:Connect(function(dt)
		for code, userId in HelmService._helmsmanByCode do
			local session = HelmService._sessionsByUserId[userId]
			if not session then
				HelmService._helmsmanByCode[code] = nil
				continue
			end

			local model = StarterBaseService.getBaseModel(code)
			local deck = model and (model.PrimaryPart or model:FindFirstChild("Deck"))
			if not (deck and deck:IsA("BasePart")) then
				continue
			end

			local look = session.lookFlat
			local throttle = session.throttle
			-- Treat near-zero stick noise as stop so idle stays planted
			if math.abs(throttle) < 0.04 then
				throttle = 0
			end
			local speed = Config.Helm.SpeedStudsPerSecond
			-- Positive throttle sails along look; negative reverses while still facing look
			local move = look * (speed * throttle * dt)

			local oldCf = deck.CFrame
			local desiredPos = Vector3.new(
				oldCf.Position.X + move.X,
				oldCf.Position.Y,
				oldCf.Position.Z + move.Z
			)
			-- Visit lockout: once a crew leaves an isle far enough away, the raft can't sail back
			local newPos, blockedIsle = IslandService.clampRaftPosition(session.code, oldCf.Position, desiredPos)
			if blockedIsle and throttle ~= 0 then
				local now = os.clock()
				if now - session.lockToastAt > 2.5 then
					session.lockToastAt = now
					local helmsman = Players:GetPlayerByUserId(userId)
					if helmsman then
						toast(helmsman, `{blockedIsle} won't take you back.`, "error")
					end
				end
			end

			-- Solid shoreline: you can't drive onto an isle. Sailing into one runs the raft
			-- aground and stops it at the beach; steer away to peel off.
			local groundedIsle
			newPos, groundedIsle = IslandService.collideRaft(oldCf.Position, newPos)
			if groundedIsle and throttle ~= 0 then
				local now = os.clock()
				if now - session.groundToastAt > 2.5 then
					session.groundToastAt = now
					local helmsman = Players:GetPlayerByUserId(userId)
					if helmsman then
						toast(helmsman, `Ran aground on {groundedIsle} — steer away.`, "error")
					end
				end
			end
			-- Keep deck level; yaw toward look (steer), not velocity (so reverse faces forward)
			local targetCf = CFrame.lookAt(newPos, newPos + look)
			local alpha = math.clamp(Config.Helm.TurnLerp * dt, 0, 1)
			local lerped = oldCf:Lerp(targetCf, alpha)
			local flatLook = flattenLook(lerped.LookVector) or look
			local newCf = CFrame.lookAt(
				Vector3.new(lerped.Position.X, oldCf.Position.Y, lerped.Position.Z),
				Vector3.new(lerped.Position.X, oldCf.Position.Y, lerped.Position.Z) + flatLook
			)

			if StarterBaseService.setBaseCFrame(code, newCf) then
				local delta = newCf * oldCf:Inverse()
				moveCrewWithDelta(code, delta, userId)
			end

			snapHelmsmanToStand(session)

			-- Spin the wooden wheel with look yaw (same cue as the helmsman facing turn)
			local deckForward = flattenLook(newCf.LookVector) or look
			local yawErr = lookYawError(deckForward, look)
			local targetSpin = math.clamp(
				yawErr * Config.Helm.WheelLookGain,
				-Config.Helm.WheelMaxRadians,
				Config.Helm.WheelMaxRadians
			)
			local spinAlpha = math.clamp(Config.Helm.WheelSpinLerp * dt, 0, 1)
			session.wheelSpin += (targetSpin - session.wheelSpin) * spinAlpha
			applyWheelSpin(code, session.wheelSpin)
		end
	end)
end

function HelmService.bindBase(code: string, model: Model)
	local kit = model:FindFirstChild("StarterKit")
	local anchor = kit and kit:FindFirstChild("HelmPromptAnchor")
	local prompt = anchor and anchor:FindFirstChild("HelmPrompt")
	if not (prompt and prompt:IsA("ProximityPrompt")) then
		return
	end

	prompt.Triggered:Connect(function(player: Player)
		HelmService.mount(player, code)
	end)
end

function HelmService.releaseIfHelming(player: Player)
	if HelmService._sessionsByUserId[player.UserId] then
		HelmService.release(player)
	end
end

function HelmService.onBaseDestroyed(code: string)
	local userId = HelmService._helmsmanByCode[code]
	if not userId then
		return
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		HelmService.release(player)
	else
		HelmService._helmsmanByCode[code] = nil
		HelmService._sessionsByUserId[userId] = nil
	end
end

return HelmService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">IslandService</string>
          <string name="Source"><![CDATA[-- Stationary open-sea islands: huge beach flats with grass / jungle / palms,
-- detachable house walls + scattered loot, optional raid houses + chasing pirates.
-- Visit lockout: step on an isle, leave on the raft, sail LockoutStuds away → can't return.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local OceanConfig = require(Shared:WaitForChild("OceanConfig"))
local LobbyWorld = require(Shared:WaitForChild("LobbyWorld"))
local Weapons = require(Shared:WaitForChild("Weapons"))
local Armor = require(Shared:WaitForChild("Armor"))

local StarterBaseService = require(script.Parent:WaitForChild("StarterBaseService"))
local LootPropFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("LootPropFactory"))
local NpcFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("NpcFactory"))
local VillageBuilder = require(script.Parent:WaitForChild("VillageBuilder"))
local MerchantService = require(script.Parent:WaitForChild("MerchantService"))
local WeaponService = require(script.Parent:WaitForChild("WeaponService"))
local ArmorService = require(script.Parent:WaitForChild("ArmorService"))

export type IslandRecord = {
	id: string,
	name: string,
	center: Vector3,
	size: number,
	topY: number,
	thickness: number,
	theme: string,
	abandoned: boolean,
	biome: string,
	model: Model,
	label: TextLabel?,
	npcs: { Model },
	-- A channel cut all the way through a large island. The helm uses this to allow
	-- boats through the river rather than treating the whole island as solid shore.
	river: { cframe: CFrame, width: number, length: number }?,
	-- Spawn plan retained for deterministic population and testability.
	villagerPlan: {
		spots: { Vector3 },
		passive: number,
		hostile: number,
		abandoned: boolean,
	}?,
	populated: boolean?,
	-- The arrival hub contains the crew spawn channel. It is deliberately excluded
	-- from the circular shore guard because crews begin inside that waterway.
	safeHarbor: boolean?,
}

type CrewIslandState = {
	visited: boolean,
	locked: boolean,
	notifiedLock: boolean,
	notifiedVisit: boolean,
}

type DockCollider = {
	cframe: CFrame,
	size: Vector3,
	islandName: string,
}

type NpcRuntime = {
	model: Model,
	humanoid: Humanoid?,
	islandId: string,
	hostile: boolean,
	attackAccum: number,
	wanderAccum: number,
	homePos: Vector3,
	targetPos: Vector3?,
	alive: boolean,
}

local IslandService = {}

IslandService._islands = {} :: { IslandRecord }
IslandService._byId = {} :: { [string]: IslandRecord }
IslandService._crewState = {} :: { [string]: { [string]: CrewIslandState } }
IslandService._npcs = {} :: { NpcRuntime }
-- Helm travel is kinematic (the raft is PivotTo'd), so it does not receive normal
-- physics contacts.  Keep a tiny collision representation for the solid dock decks.
IslandService._dockColliders = {} :: { DockCollider }
IslandService._Toast = nil :: RemoteEvent?
IslandService._getPartyCode = nil :: ((Player) -> string?)?
IslandService._getMemberUserIds = nil :: ((string) -> { number })?
IslandService._started = false
IslandService._starting = false
IslandService._folder = nil :: Folder?
IslandService._endlessQueued = {} :: { [string]: boolean }
IslandService._endlessBuildActive = false

local function lobbyRoot(): Folder
	local root = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if root and root:IsA("Folder") then
		return root
	end
	return LobbyWorld.ensure()
end

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "IslandPart"
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Material = props.Material or Enum.Material.Sand
	p.Color = props.Color or Color3.fromRGB(220, 200, 158)
	p.Size = props.Size or Vector3.new(4, 1, 4)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	-- Decorative scatter parts default to NO shadow. With ShadowMap + thousands of props
	-- per isle, per-part shadow casting was the single biggest GPU cost. Terrain/sun
	-- shadows (GlobalShadows) still ground the world; individual props opt in only if
	-- they explicitly pass CastShadow = true.
	p.CastShadow = props.CastShadow == true
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function flatDistance(a: Vector3, b: Vector3): number
	local dx = a.X - b.X
	local dz = a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Shared wood colours for docks, boardwalks and stilt decks.
local DOCK_PLANK = Color3.fromRGB(122, 86, 52)
local DOCK_POST = Color3.fromRGB(84, 58, 36)

local function worldCenterForOffset(offset: Vector3, topY: number, thickness: number): Vector3
	local origin = Config.StarterBase.Origin
	return Vector3.new(origin.X + offset.X, topY - thickness * 0.5, origin.Z + offset.Z)
end

-- Reserve the opening-island folder without drawing placeholder land. The old
-- cylinder previews were visible as flat sand/grass disks while the real islands
-- loaded, which made the finished world look broken and hid its sculpted coastline.
local function ensureOpeningPreviews(folder: Folder)
	local previews = folder:FindFirstChild("OpeningPreviews")
	if not previews then
		previews = Instance.new("Folder")
		previews.Name = "OpeningPreviews"
		previews.Parent = folder
	end
end

local function ensureCrewState(code: string, islandId: string): CrewIslandState
	local byIsle = IslandService._crewState[code]
	if not byIsle then
		byIsle = {}
		IslandService._crewState[code] = byIsle
	end
	local state = byIsle[islandId]
	if not state then
		state = {
			visited = false,
			locked = false,
			notifiedLock = false,
			notifiedVisit = false,
		}
		byIsle[islandId] = state
	end
	return state
end

local function buildPalm(model: Model, topY: number, x: number, z: number, scale: number?)
	local s = scale or (0.85 + math.random() * 0.45)
	local trunkH = (10 + math.random() * 5) * s
	local lean = math.rad((math.random() - 0.5) * 16)
	local trunk = makePart({
		Name = "PalmTrunk",
		Parent = model,
		Size = Vector3.new(0.95 * s, trunkH, 0.95 * s),
		CFrame = CFrame.new(x, topY + trunkH * 0.5, z) * CFrame.Angles(0, math.rad(math.random(0, 360)), lean),
		Color = Color3.fromRGB(92, 64, 38),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	local frondColors = {
		Color3.fromRGB(48, 118, 62),
		Color3.fromRGB(42, 108, 55),
		Color3.fromRGB(56, 132, 70),
		Color3.fromRGB(38, 98, 52),
	}
	for i = 0, 4 do
		local yaw = math.rad(i * 72 + math.random(-12, 12))
		local pitch = math.rad(8 + math.random() * 18)
		makePart({
			Name = `PalmFrond_{i}`,
			Parent = model,
			Size = Vector3.new((6.5 + math.random() * 2.5) * s, 0.32 * s, (1.6 + math.random() * 0.6) * s),
			CFrame = trunk.CFrame
				* CFrame.new(0, trunkH * 0.46, 0)
				* CFrame.Angles(pitch, yaw, math.rad((math.random() - 0.5) * 12)),
			Color = frondColors[(i % #frondColors) + 1],
			Material = Enum.Material.Grass,
			CanCollide = false,
			-- Fronds are small and everywhere; skipping their shadows is a big perf win.
			CastShadow = false,
		})
	end
	-- Coconuts cluster
	if math.random() < 0.55 then
		makePart({
			Name = "Coconuts",
			Parent = model,
			Size = Vector3.new(1.1 * s, 1.0 * s, 1.1 * s),
			CFrame = trunk.CFrame * CFrame.new(0.35 * s, trunkH * 0.42, 0.1 * s),
			Color = Color3.fromRGB(72, 48, 28),
			Material = Enum.Material.Wood,
			CanCollide = false,
			CastShadow = false,
			Shape = Enum.PartType.Ball,
		})
	end
end

-- Classic "ball on a stick" tree — dark green sphere canopy on a simple trunk.
local function buildBallTree(model: Model, topY: number, x: number, z: number, scale: number?)
	local s = scale or (0.85 + math.random() * 0.35)
	local trunkH = (7 + math.random() * 4) * s
	makePart({
		Name = "BallTrunk",
		Parent = model,
		Size = Vector3.new(0.7 * s, trunkH, 0.7 * s),
		CFrame = CFrame.new(x, topY + trunkH * 0.5, z),
		Color = Color3.fromRGB(78, 54, 32),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	local canopy = (4.5 + math.random() * 1.8) * s
	makePart({
		Name = "BallCanopy",
		Parent = model,
		Size = Vector3.new(canopy, canopy, canopy),
		CFrame = CFrame.new(x, topY + trunkH + canopy * 0.28, z),
		Color = Color3.fromRGB(34, 96, 46),
		Material = Enum.Material.Grass,
		CanCollide = false,
		Shape = Enum.PartType.Ball,
	})
end

-- Chunky broadleaf tree used as the common visual language around every settlement.
-- The separate, offset canopy blocks intentionally match the low-poly forest silhouette
-- from the island reference instead of reading as round Roblox "lollipop" trees.
local function buildVillageForestTree(model: Model, topY: number, x: number, z: number, scale: number?)
	local s = scale or (0.95 + math.random() * 0.55)
	local trunkH = (24 + math.random() * 18) * s
	local trunkCf = CFrame.new(x, topY + trunkH * 0.5, z)
	makePart({
		Name = "ForestTrunk",
		Parent = model,
		Size = Vector3.new(2.1 * s, trunkH, 2.1 * s),
		CFrame = trunkCf,
		Color = Color3.fromRGB(116, 76, 43),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	for branch = 1, 3 do
		local yaw = math.rad((branch - 1) * 120 + math.random(-18, 18))
		local length = (8 + math.random() * 5) * s
		makePart({
			Name = "ForestBranch",
			Parent = model,
			Size = Vector3.new(1.25 * s, 1.25 * s, length),
			CFrame = trunkCf * CFrame.new(0, trunkH * 0.23, 0) * CFrame.Angles(math.rad(-38), yaw, 0) * CFrame.new(0, 0, -length * 0.34),
			Color = Color3.fromRGB(116, 76, 43),
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end
	local greens = { Color3.fromRGB(30, 112, 47), Color3.fromRGB(42, 137, 57), Color3.fromRGB(52, 150, 62) }
	local canopyY = topY + trunkH + 1.5 * s
	for i = 1, 5 do
		local a = (i - 1) * (math.pi * 2 / 5)
		local radius = i == 5 and 0 or 6.2 * s
		local cube = (i == 5 and 13.5 or 10.5) * s
		makePart({
			Name = "ForestCanopyBlock",
			Parent = model,
			Size = Vector3.new(cube, cube * (0.72 + math.random() * 0.18), cube),
			CFrame = CFrame.new(x + math.cos(a) * radius, canopyY + (i == 5 and 2.2 * s or math.random(-1, 1) * s), z + math.sin(a) * radius)
				* CFrame.Angles(0, math.rad(math.random(0, 45)), 0),
			Color = greens[((i - 1) % #greens) + 1],
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
end

-- Tall tiered canopy used between the spreading broadleaf trees. Alternating these
-- silhouettes reproduces the reference forest's deep layers instead of making every
-- tree the same five-block crown.
local function buildTieredForestTree(model: Model, topY: number, x: number, z: number, scale: number?)
	local s = scale or (0.9 + math.random() * 0.5)
	local trunkH = (32 + math.random() * 22) * s
	makePart({
		Name = "TieredForestTrunk",
		Parent = model,
		Size = Vector3.new(2.2 * s, trunkH, 2.2 * s),
		CFrame = CFrame.new(x, topY + trunkH * 0.5, z),
		Color = Color3.fromRGB(92, 60, 38),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	local greens = {
		Color3.fromRGB(24, 94, 39),
		Color3.fromRGB(31, 118, 47),
		Color3.fromRGB(42, 139, 54),
	}
	for tier = 1, 5 do
		local width = (18 - tier * 2.1) * s
		local y = topY + trunkH * 0.4 + tier * 5.2 * s
		makePart({
			Name = "TieredCanopy",
			Parent = model,
			Size = Vector3.new(width, 4.2 * s, width),
			CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(tier * 13), 0),
			Color = greens[((tier - 1) % #greens) + 1],
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
end

local function terrainSurfaceY(x: number, z: number, fallbackY: number): number?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Workspace.Terrain }
	params.IgnoreWater = true
	local result = Workspace:Raycast(
		Vector3.new(x, fallbackY + 280, z),
		Vector3.new(0, -420, 0),
		params
	)
	if not result or result.Material == Enum.Material.Water then
		return nil
	end
	-- A placement must have dry terrain clearly above the sea. This is the final guard
	-- against trees, shrubs, loot, and shoreline clutter appearing on open water.
	if result.Position.Y <= OceanConfig.SurfaceY + 0.65 then
		return nil
	end
	return result.Position.Y
end

-- A dense outer woodland keeps the view from each village framed by hills and trees,
-- while leaving the centre open for streets, houses, and safe player movement.
local function scatterSettlementForest(
	model: Model,
	center: Vector3,
	size: number,
	topY: number,
	features: { [string]: any }?
)
	local half = size * 0.5
	local count = math.clamp(math.floor(size / 16), 64, 110)
	local river = features and features.river
	for _ = 1, count do
		local a = math.random() * math.pi * 2
		local r = half * (0.68 + math.random() * 0.22)
		local x = center.X + math.cos(a) * r
		local z = center.Z + math.sin(a) * r
		-- Keep the navigable waterway clear: floating forest props make a river feel
		-- broken and can block the raft even though the terrain channel is open.
		if river then
			local yaw = math.atan2(math.cos(river.angle), math.sin(river.angle))
			local localPos = (CFrame.new(center.X, 0, center.Z) * CFrame.Angles(0, yaw, 0))
				:PointToObjectSpace(Vector3.new(x, 0, z))
			if math.abs(localPos.X) < river.width * 0.5 + 14 then
				continue
			end
		end
		local groundY = terrainSurfaceY(x, z, topY)
		if not groundY then
			continue
		end
		if math.random() < 0.3 then
			buildTieredForestTree(model, groundY, x, z)
		else
			buildVillageForestTree(model, groundY, x, z)
		end
	end
end

-- Four WedgeParts meeting at the peak — reads as a pyramid thatch roof.
local function buildPyramidRoof(parent: Instance, cf: CFrame, footprint: number, color: Color3)
	local h = footprint * 0.42
	local half = footprint * 0.5
	for i = 0, 3 do
		local yaw = math.rad(i * 90)
		local wedge = Instance.new("WedgePart")
		wedge.Name = "PyramidRoof"
		wedge.Anchored = true
		wedge.CanCollide = true
		wedge.CastShadow = true
		wedge.Material = Enum.Material.Grass
		wedge.Color = color
		wedge.Size = Vector3.new(footprint, h, half)
		wedge.CFrame = cf * CFrame.Angles(0, yaw, 0) * CFrame.new(0, h * 0.5, half * 0.5)
		wedge.TopSurface = Enum.SurfaceType.Smooth
		wedge.BottomSurface = Enum.SurfaceType.Smooth
		wedge.Parent = parent
	end
end

local STILT_WALL = Color3.fromRGB(148, 158, 110)
local STILT_ROOF = Color3.fromRGB(186, 148, 72)
local STILT_WOOD = Color3.fromRGB(110, 78, 48)
local TERRACE_STONE = Color3.fromRGB(168, 170, 172)

-- Open-window hut on stilts over the water (or a summit pavilion when overLand).
local function buildStiltHut(
	model: Model,
	pos: Vector3,
	surfaceY: number,
	yaw: number,
	opts: { [string]: any }?
)
	local o = opts or {}
	local s = (o.scale :: number?) or 1
	local overLand = o.overLand == true
	local hut = Instance.new("Model")
	hut.Name = if overLand then "SummitPavilion" else "StiltHut"
	hut.Parent = model

	local w, d, wallH = 14 * s, 12 * s, 7 * s
	local deckY = if overLand then pos.Y else (surfaceY + 5.5 * s)
	local floorCf = CFrame.new(pos.X, deckY, pos.Z) * CFrame.Angles(0, yaw, 0)

	if not overLand then
		local pileBot = surfaceY - 8
		local pileH = deckY - pileBot
		local pileY = (deckY + pileBot) * 0.5
		for _, ox in { -w * 0.42, w * 0.42 } do
			for _, oz in { -d * 0.42, d * 0.42 } do
				local p = floorCf * CFrame.new(ox, 0, oz)
				makePart({
					Name = "Stilt",
					Parent = hut,
					Size = Vector3.new(1.1 * s, pileH, 1.1 * s),
					CFrame = CFrame.new(p.X, pileY, p.Z),
					Color = STILT_WOOD,
					Material = Enum.Material.Wood,
					CastShadow = true,
				})
			end
		end
	end

	makePart({
		Name = "HutFloor",
		Parent = hut,
		Size = Vector3.new(w, 0.6 * s, d),
		CFrame = floorCf,
		Color = DOCK_PLANK,
		Material = Enum.Material.WoodPlanks,
		CastShadow = true,
	})

	-- Four walls with a big open window in each face.
	local walls = {
		{ offset = CFrame.new(0, wallH * 0.5, -d * 0.5), size = Vector3.new(w, wallH, 0.55 * s), win = "z" },
		{ offset = CFrame.new(0, wallH * 0.5, d * 0.5), size = Vector3.new(w, wallH, 0.55 * s), win = "z" },
		{ offset = CFrame.new(-w * 0.5, wallH * 0.5, 0), size = Vector3.new(0.55 * s, wallH, d), win = "x" },
		{ offset = CFrame.new(w * 0.5, wallH * 0.5, 0), size = Vector3.new(0.55 * s, wallH, d), win = "x" },
	}
	for i, wall in walls do
		local along = if wall.win == "z" then wall.size.X else wall.size.Z
		local side = along * 0.22
		local winW = along * 0.46
		local sillH = wallH * 0.28
		local headH = wallH * 0.22
		if wall.win == "z" then
			makePart({
				Name = `WallL_{i}`,
				Parent = hut,
				Size = Vector3.new(side, wallH, wall.size.Z),
				CFrame = floorCf * wall.offset * CFrame.new(-(winW * 0.5 + side * 0.5), 0, 0),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = `WallR_{i}`,
				Parent = hut,
				Size = Vector3.new(side, wallH, wall.size.Z),
				CFrame = floorCf * wall.offset * CFrame.new(winW * 0.5 + side * 0.5, 0, 0),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = `WallSill_{i}`,
				Parent = hut,
				Size = Vector3.new(winW, sillH, wall.size.Z),
				CFrame = floorCf * wall.offset * CFrame.new(0, -wallH * 0.5 + sillH * 0.5, 0),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = `WallHead_{i}`,
				Parent = hut,
				Size = Vector3.new(winW, headH, wall.size.Z),
				CFrame = floorCf * wall.offset * CFrame.new(0, wallH * 0.5 - headH * 0.5, 0),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
		else
			makePart({
				Name = `WallL_{i}`,
				Parent = hut,
				Size = Vector3.new(wall.size.X, wallH, side),
				CFrame = floorCf * wall.offset * CFrame.new(0, 0, -(winW * 0.5 + side * 0.5)),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = `WallR_{i}`,
				Parent = hut,
				Size = Vector3.new(wall.size.X, wallH, side),
				CFrame = floorCf * wall.offset * CFrame.new(0, 0, winW * 0.5 + side * 0.5),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = `WallSill_{i}`,
				Parent = hut,
				Size = Vector3.new(wall.size.X, sillH, winW),
				CFrame = floorCf * wall.offset * CFrame.new(0, -wallH * 0.5 + sillH * 0.5, 0),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = `WallHead_{i}`,
				Parent = hut,
				Size = Vector3.new(wall.size.X, headH, winW),
				CFrame = floorCf * wall.offset * CFrame.new(0, wallH * 0.5 - headH * 0.5, 0),
				Color = STILT_WALL,
				Material = Enum.Material.Wood,
			})
		end
	end

	buildPyramidRoof(hut, floorCf * CFrame.new(0, wallH + 0.15 * s, 0), math.max(w, d) + 2.5 * s, STILT_ROOF)
	return Vector3.new(pos.X, deckY, pos.Z)
end

-- Straight wooden boardwalk between two deck points (stilts + planks + rails).
local function buildBoardwalk(model: Model, from: Vector3, to: Vector3, surfaceY: number, width: number?)
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local length = flat.Magnitude
	if length < 4 then
		return
	end
	local w = width or 5.5
	local deckY = (from.Y + to.Y) * 0.5
	local mid = Vector3.new((from.X + to.X) * 0.5, deckY, (from.Z + to.Z) * 0.5)
	local yaw = math.atan2(flat.X, flat.Z)
	local cf = CFrame.new(mid) * CFrame.Angles(0, yaw, 0)

	makePart({
		Name = "BoardwalkDeck",
		Parent = model,
		Size = Vector3.new(w, 0.45, length),
		CFrame = cf,
		Color = DOCK_PLANK,
		Material = Enum.Material.WoodPlanks,
		CastShadow = true,
	})

	local pileBot = surfaceY - 6
	local pileH = deckY - 0.2 - pileBot
	local pileY = (deckY - 0.2 + pileBot) * 0.5
	local posts = math.max(2, math.floor(length / 10))
	for i = 0, posts do
		local along = -length * 0.5 + (i / posts) * length
		for _, sx in { -w * 0.5 + 0.55, w * 0.5 - 0.55 } do
			local p = cf * CFrame.new(sx, 0, along)
			makePart({
				Name = "BoardwalkPiling",
				Parent = model,
				Size = Vector3.new(0.75, pileH, 0.75),
				CFrame = CFrame.new(p.X, pileY, p.Z),
				Color = DOCK_POST,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = "BoardwalkRailPost",
				Parent = model,
				Size = Vector3.new(0.35, 2.1, 0.35),
				CFrame = cf * CFrame.new(sx, 1.2, along),
				Color = DOCK_POST,
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
		end
	end
	for _, sx in { -w * 0.5 + 0.55, w * 0.5 - 0.55 } do
		makePart({
			Name = "BoardwalkRail",
			Parent = model,
			Size = Vector3.new(0.3, 0.3, length),
			CFrame = cf * CFrame.new(sx, 2.2, 0),
			Color = DOCK_PLANK,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end
end

local function buildRetainingRing(
	model: Model,
	cx: number,
	cz: number,
	radius: number,
	yBottom: number,
	height: number
)
	local segs = math.max(18, math.floor(radius / 10))
	local chord = (2 * math.pi * radius) / segs + 0.6
	for i = 0, segs - 1 do
		local a = (i / segs) * math.pi * 2
		local x = cx + math.cos(a) * radius
		local z = cz + math.sin(a) * radius
		makePart({
			Name = "RetainingWall",
			Parent = model,
			Size = Vector3.new(chord, height, 1.4),
			CFrame = CFrame.new(x, yBottom + height * 0.5, z) * CFrame.Angles(0, -a, 0),
			Color = TERRACE_STONE,
			Material = Enum.Material.Concrete,
			CastShadow = true,
		})
	end
end

-- Spiral walkway climbing the central cliff.
local function buildSpiralPath(
	model: Model,
	cx: number,
	cz: number,
	cliffR: number,
	y0: number,
	y1: number
)
	local turns = 2.15
	local steps = 30
	for i = 0, steps - 1 do
		local t = i / steps
		local a = t * math.pi * 2 * turns
		local y = y0 + (y1 - y0) * t
		local r = cliffR + 7
		local x = cx + math.cos(a) * r
		local z = cz + math.sin(a) * r
		makePart({
			Name = "SpiralStep",
			Parent = model,
			Size = Vector3.new(8, 1.15, 5.2),
			CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, -a + math.rad(90), math.rad(-6)),
			Color = Color3.fromRGB(96, 98, 102),
			Material = Enum.Material.Rock,
			CastShadow = true,
		})
	end
end

-- A tiny splash of tropical colour — cheap, shadowless flowers for nicer beaches.
local function buildFlower(model: Model, topY: number, x: number, z: number)
	local palette = {
		Color3.fromRGB(240, 96, 120),
		Color3.fromRGB(255, 186, 72),
		Color3.fromRGB(210, 120, 240),
		Color3.fromRGB(255, 240, 150),
	}
	makePart({
		Name = "Flower",
		Parent = model,
		Size = Vector3.new(0.7, 0.7, 0.7),
		CFrame = CFrame.new(x, topY + 0.5, z),
		Color = palette[math.random(1, #palette)],
		Material = Enum.Material.Neon,
		CanCollide = false,
		CastShadow = false,
		Shape = Enum.PartType.Ball,
	})
end

local function buildBush(model: Model, topY: number, x: number, z: number, jungle: boolean)
	local h = if jungle then 2.8 + math.random() * 2.2 else 1.4 + math.random() * 1.2
	local w = if jungle then 4.5 + math.random() * 2.5 else 2.8 + math.random() * 1.6
	makePart({
		Name = "Bush",
		Parent = model,
		Size = Vector3.new(w, h, w * (0.75 + math.random() * 0.35)),
		CFrame = CFrame.new(x, topY + h * 0.45, z),
		Color = if jungle then Color3.fromRGB(28, 78, 38) else Color3.fromRGB(52, 118, 58),
		Material = Enum.Material.Grass,
		CanCollide = false,
		CastShadow = false,
		Shape = Enum.PartType.Ball,
	})
end

local function buildGrassTuft(model: Model, topY: number, x: number, z: number)
	makePart({
		Name = "GrassTuft",
		Parent = model,
		Size = Vector3.new(1.6 + math.random(), 1.1 + math.random() * 0.8, 0.35),
		CFrame = CFrame.new(x, topY + 0.7, z) * CFrame.Angles(0, math.rad(math.random(0, 360)), math.rad((math.random() - 0.5) * 20)),
		Color = Color3.fromRGB(68, 140, 62),
		Material = Enum.Material.Grass,
		CanCollide = false,
		CastShadow = false,
	})
end

local function buildJungleTree(model: Model, topY: number, x: number, z: number)
	local trunkH = 14 + math.random() * 8
	local trunk = makePart({
		Name = "JungleTrunk",
		Parent = model,
		Size = Vector3.new(1.4, trunkH, 1.4),
		CFrame = CFrame.new(x, topY + trunkH * 0.5, z),
		Color = Color3.fromRGB(62, 44, 28),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	for i = 0, 2 do
		makePart({
			Name = `Canopy_{i}`,
			Parent = model,
			Size = Vector3.new(8 + math.random() * 4, 4 + math.random() * 2, 8 + math.random() * 4),
			CFrame = trunk.CFrame * CFrame.new((math.random() - 0.5) * 2, trunkH * 0.42 + i * 1.2, (math.random() - 0.5) * 2),
			Color = Color3.fromRGB(24 + i * 8, 72 + i * 10, 34 + i * 6),
			Material = Enum.Material.Grass,
			CanCollide = false,
			-- Only the lowest canopy blob casts shadow; upper blobs skip it (perf).
			CastShadow = i == 0,
			Shape = Enum.PartType.Ball,
		})
	end
end

-- A towering buttressed rainforest giant (kapok / ceiba) — the Amazon canopy centrepiece.
-- Massive trunk with flaring root buttresses and a broad, layered canopy.
local function buildGiantTree(model: Model, topY: number, x: number, z: number)
	local trunkH = 30 + math.random() * 18
	local trunk = makePart({
		Name = "GiantTrunk",
		Parent = model,
		Size = Vector3.new(3.4, trunkH, 3.4),
		CFrame = CFrame.new(x, topY + trunkH * 0.5, z),
		Color = Color3.fromRGB(112, 86, 60),
		Material = Enum.Material.Wood,
		CanCollide = true,
	})
	-- Flaring root buttresses around the base.
	for i = 0, 4 do
		local a = math.rad(i * 72 + math.random(-10, 10))
		makePart({
			Name = `Buttress_{i}`,
			Parent = model,
			Size = Vector3.new(1.2, 6 + math.random() * 2, 3.2),
			CFrame = CFrame.new(x + math.cos(a) * 2.2, topY + 2.5, z + math.sin(a) * 2.2)
				* CFrame.Angles(0, -a, math.rad(16)),
			Color = Color3.fromRGB(98, 74, 50),
			Material = Enum.Material.Wood,
			CanCollide = false,
			CastShadow = false,
		})
	end
	-- Broad, layered emergent canopy.
	for i = 0, 3 do
		makePart({
			Name = `GiantCanopy_{i}`,
			Parent = model,
			Size = Vector3.new(20 - i * 3, 5 + math.random() * 2, 20 - i * 3),
			CFrame = trunk.CFrame * CFrame.new((math.random() - 0.5) * 3, trunkH * 0.42 + i * 3.4, (math.random() - 0.5) * 3),
			Color = Color3.fromRGB(22 + i * 6, 74 + i * 10, 32 + i * 6),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			CastShadow = i == 0,
			Shape = Enum.PartType.Ball,
		})
	end
end

-- Low broad rainforest ferns / undergrowth fronds — thick green floor cover.
local function buildFern(model: Model, topY: number, x: number, z: number)
	local blades = math.random(3, 5)
	for i = 1, blades do
		local a = math.rad((i / blades) * 360 + math.random(-20, 20))
		makePart({
			Name = "Fern",
			Parent = model,
			Size = Vector3.new(2.6 + math.random() * 1.4, 0.28, 0.9 + math.random() * 0.5),
			CFrame = CFrame.new(x, topY + 0.7, z)
				* CFrame.Angles(0, a, math.rad(22 + math.random() * 14)),
			Color = Color3.fromRGB(34, 98, 44),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

-- A climbable jungle vine: a TrussPart (auto-climbable by Humanoids) dressed with a couple
-- of leafy strips, giving players a real way to scale the isle's rocky peaks and cliffs.
local function buildClimbVine(model: Model, topY: number, x: number, z: number, height: number)
	local truss = Instance.new("TrussPart")
	truss.Name = "ClimbVine"
	truss.Anchored = true
	truss.CanCollide = true
	truss.Color = Color3.fromRGB(64, 88, 42)
	truss.Material = Enum.Material.Grass
	truss.Size = Vector3.new(2, height, 2)
	truss.CFrame = CFrame.new(x, topY + height * 0.5, z)
	truss.CastShadow = false
	truss.Parent = model
	-- Leafy dressing so it reads as a hanging vine, not scaffolding.
	for i = 0, 2 do
		makePart({
			Name = `VineLeaf_{i}`,
			Parent = model,
			Size = Vector3.new(1.4, 1.2, 0.3),
			CFrame = CFrame.new(x + (i - 1) * 0.7, topY + height * (0.3 + i * 0.25), z - 1.1)
				* CFrame.Angles(0, math.rad(math.random(0, 360)), 0),
			Color = Color3.fromRGB(40, 104, 46),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

local function buildRock(model: Model, topY: number, x: number, z: number, scale: number?)
	local s = scale or (1 + math.random() * 1.7)
	local g = 92 + math.random(0, 34)
	local rockColor = Color3.fromRGB(g, g + 5, g + 12)
	-- A boulder is a small cluster of overlapping tilted blocks so it reads as weathered stone
	for _ = 1, math.random(2, 4) do
		local rs = s * (0.55 + math.random() * 0.75)
		makePart({
			Name = "Rock",
			Parent = model,
			Size = Vector3.new(2.6 * rs, 2.1 * rs, 2.4 * rs),
			CFrame = CFrame.new(x + (math.random() - 0.5) * 2.2 * s, topY + 0.65 * rs, z + (math.random() - 0.5) * 2.2 * s)
				* CFrame.Angles(
					math.rad(math.random(-18, 18)),
					math.rad(math.random(0, 360)),
					math.rad(math.random(-18, 18))
				),
			Color = rockColor,
			Material = Enum.Material.Slate,
			CanCollide = true,
		})
	end
end

local function buildDriftwood(model: Model, topY: number, x: number, z: number)
	local len = 5 + math.random() * 5
	local yaw = math.rad(math.random(0, 360))
	local log = makePart({
		Name = "Driftwood",
		Parent = model,
		Size = Vector3.new(len, 1.15, 1.15),
		CFrame = CFrame.new(x, topY + 0.5, z) * CFrame.Angles(0, yaw, math.rad((math.random() - 0.5) * 12)),
		Color = Color3.fromRGB(122, 98, 74),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	log.Shape = Enum.PartType.Cylinder
	-- A stub branch for a gnarled, beached look
	if math.random() < 0.5 then
		local branch = makePart({
			Name = "DriftwoodBranch",
			Parent = model,
			Size = Vector3.new(len * 0.4, 0.7, 0.7),
			CFrame = log.CFrame * CFrame.new(len * 0.15, 0.3, 0) * CFrame.Angles(0, math.rad(50), 0),
			Color = Color3.fromRGB(112, 90, 68),
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
		branch.Shape = Enum.PartType.Cylinder
	end
end

-- Low rounded grass/sand mound — gentle rolling terrain so the flat isn't dead flat
local function buildDune(model: Model, topY: number, x: number, z: number, grass: boolean)
	local w = 8 + math.random() * 10
	local h = 1.6 + math.random() * 2.4
	makePart({
		Name = "Dune",
		Parent = model,
		Size = Vector3.new(w, h * 2, w * (0.8 + math.random() * 0.4)),
		-- Half-buried ball so only a smooth rise shows above the sand
		CFrame = CFrame.new(x, topY - h * 0.5, z),
		Color = if grass then Color3.fromRGB(74, 138, 66) else Color3.fromRGB(224, 204, 160),
		Material = if grass then Enum.Material.Grass else Enum.Material.Sand,
		CanCollide = false,
		CastShadow = false,
		Shape = Enum.PartType.Ball,
	})
end

-- A conifer/pine — the signature tree of temperate "highland" and cold "mountain" isles.
-- Brown trunk with 3 stacked green cones; on mountain isles the tip gets a snowy cap.
local function buildPine(model: Model, topY: number, x: number, z: number, snowy: boolean?, scale: number?)
	local s = scale or (0.85 + math.random() * 0.5)
	local trunkH = (5 + math.random() * 3) * s
	makePart({
		Name = "PineTrunk",
		Parent = model,
		Size = Vector3.new(1.1 * s, trunkH, 1.1 * s),
		CFrame = CFrame.new(x, topY + trunkH * 0.5, z),
		Color = Color3.fromRGB(84, 58, 36),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	local tiers = 3
	local tierH = 5 * s
	for i = 0, tiers - 1 do
		local w = (8 - i * 2.2) * s
		makePart({
			Name = `PineTier_{i}`,
			Parent = model,
			Size = Vector3.new(w, tierH, w),
			CFrame = CFrame.new(x, topY + trunkH + i * tierH * 0.62 + tierH * 0.4, z),
			Color = Color3.fromRGB(30 + i * 6, 82 + i * 8, 44 + i * 4),
			Material = Enum.Material.Grass,
			CanCollide = false,
			CastShadow = i == 0,
		})
	end
	-- Snowy cap tip for cold isles.
	if snowy then
		makePart({
			Name = "PineSnow",
			Parent = model,
			Size = Vector3.new(2.4 * s, 1.6 * s, 2.4 * s),
			CFrame = CFrame.new(x, topY + trunkH + tiers * tierH * 0.62 + 0.4, z),
			Color = Color3.fromRGB(238, 244, 250),
			Material = Enum.Material.Snow,
			CanCollide = false,
			CastShadow = false,
			Shape = Enum.PartType.Ball,
		})
	end
end

-- A cluster of glowing emerald crystals poking out of the ground — the loot-y "green
-- gems" seen on tropical + mountain isles. Cheap, shadowless Neon shards.
local function buildGem(model: Model, topY: number, x: number, z: number)
	local shards = math.random(2, 4)
	for i = 1, shards do
		local h = 1.4 + math.random() * 2.2
		local a = math.rad(math.random(0, 360))
		local off = i == 1 and 0 or (0.6 + math.random() * 1.0)
		local gx = x + math.cos(a) * off
		local gz = z + math.sin(a) * off
		makePart({
			Name = "Gem",
			Parent = model,
			Size = Vector3.new(0.9, h, 0.9),
			CFrame = CFrame.new(gx, topY + h * 0.4, gz)
				* CFrame.Angles(math.rad((math.random() - 0.5) * 26), a, math.rad((math.random() - 0.5) * 26)),
			Color = Color3.fromRGB(70, 220, 130),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

local function scatterVegetation(model: Model, center: Vector3, size: number, topY: number, biome: string, features: { [string]: any }?)
	local half = size * 0.5
	local beachBand = half * 0.78 -- outer ring stays sandier; vegetation denser inward

	-- Feature exclusion: never scatter flora inside a lake, on top of a volcano cone, or
	-- on a mountain peak — those get their own treatment. Returns true if (x,z) is blocked.
	local feat = features or {}
	local function blocked(x: number, z: number): boolean
		local river = feat.river
		if river then
			local yaw = math.atan2(math.cos(river.angle), math.sin(river.angle))
			local localPos = (CFrame.new(center.X, 0, center.Z) * CFrame.Angles(0, yaw, 0))
				:PointToObjectSpace(Vector3.new(x, 0, z))
			if math.abs(localPos.X) < river.width * 0.5 + 10 and math.abs(localPos.Z) < river.length * 0.5 + 8 then
				return true
			end
		end
		local lake = feat.lake
		if lake then
			local dx, dz = x - lake.pos.X, z - lake.pos.Z
			if dx * dx + dz * dz < (lake.radius + 6) * (lake.radius + 6) then
				return true
			end
		end
		local volcano = feat.volcano
		if volcano then
			local dx, dz = x - volcano.pos.X, z - volcano.pos.Z
			if dx * dx + dz * dz < (volcano.baseR + 4) * (volcano.baseR + 4) then
				return true
			end
		end
		local peak = feat.peak
		if peak then
			local dx, dz = x - peak.pos.X, z - peak.pos.Z
			if dx * dx + dz * dz < (peak.baseR + 4) * (peak.baseR + 4) then
				return true
			end
		end
		local tt = feat.tropicalTerrace
		if tt then
			local dx, dz = x - tt.cx, z - tt.cz
			if dx * dx + dz * dz < (tt.cliffR + 10) * (tt.cliffR + 10) then
				return true
			end
		end
		return false
	end
	local function dryGroundY(x: number, z: number): number?
		if blocked(x, z) then
			return nil
		end
		return terrainSurfaceY(x, z, topY)
	end

	-- Which flora suits this biome. Tropical isles get palms; temperate highlands and cold
	-- mountains get pines instead; volcanic + mountain isles also grow loot-y gem clusters.
	local hasPalms = biome ~= "highland" and biome ~= "mountain"
	local hasPines = biome == "highland" or biome == "mountain"
	local hasGems = biome == "volcanic" or biome == "mountain"
	local snowy = biome == "mountain"

	-- Density divisors are tuned so isles stay lush and explorable while keeping the
	-- per-isle part count LOW (island area grows with the square of the radius, and a
	-- fast raft streams several isles' worth of parts in quickly — a big divisor keeps
	-- the approach smooth and lag-free instead of dumping thousands of parts at once).
	if hasPalms then
		local palmCount = math.floor(size / 28)
		if biome == "beach" then
			palmCount = math.floor(size / 32)
		elseif biome == "jungle" then
			palmCount = math.floor(size / 28)
		end
		for _ = 1, palmCount do
			local angle = math.random() * math.pi * 2
			-- Prefer shoreline palms for beach vibe
			local r = half * (0.55 + math.random() * 0.38)
			if biome == "jungle" and math.random() < 0.35 then
				r = half * (0.15 + math.random() * 0.4)
			end
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildPalm(model, groundY, x, z)
		end
	end

	-- Conifer forest for highland / mountain isles.
	if hasPines then
		local pineCount = if biome == "mountain" then math.floor(size / 26) else math.floor(size / 22)
		for _ = 1, pineCount do
			local angle = math.random() * math.pi * 2
			local r = half * (0.18 + math.random() * 0.68)
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildPine(model, groundY, x, z, snowy)
		end
	end

	-- Glowing emerald gem clusters (tropical volcanic + mountain isles).
	if hasGems then
		local gemCount = math.clamp(math.floor(size / 90), 3, 14)
		for _ = 1, gemCount do
			local angle = math.random() * math.pi * 2
			local r = half * (0.2 + math.random() * 0.66)
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildGem(model, groundY, x, z)
		end
	end

	local bushCount = math.floor(size / 22)
	for _ = 1, bushCount do
		local angle = math.random() * math.pi * 2
		local r = half * (0.12 + math.random() * 0.7)
		if r > beachBand and biome == "beach" then
			continue
		end
		local x = center.X + math.cos(angle) * r
		local z = center.Z + math.sin(angle) * r
		local groundY = dryGroundY(x, z)
		if not groundY then
			continue
		end
		buildBush(model, groundY, x, z, biome == "jungle")
	end

	local tuftCount = math.floor(size / 17)
	for _ = 1, tuftCount do
		local angle = math.random() * math.pi * 2
		local r = half * (0.2 + math.random() * 0.65)
		local x = center.X + math.cos(angle) * r
		local z = center.Z + math.sin(angle) * r
		local groundY = dryGroundY(x, z)
		if not groundY then
			continue
		end
		buildGrassTuft(model, groundY, x, z)
	end

	-- Broadleaf trees for jungle / palm / volcanic isles (volcanic isles are lush tropical
	-- slopes around a bare cone).
	local leafy = biome == "jungle" or biome == "palm" or biome == "volcanic"
	if leafy then
		local treeCount = if biome == "jungle" then math.floor(size / 42) else math.floor(size / 60)
		for _ = 1, treeCount do
			local angle = math.random() * math.pi * 2
			-- Keep the very center clear for the hill/village heart, then spread trees
			-- across most of the interior so a huge jungle isle is dense to explore.
			local r = half * (0.22 + math.random() * 0.6)
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildJungleTree(model, groundY, x, z)
		end
	end

	-- Amazon rainforest layer: buttressed canopy giants, thick ferns on the floor, and
	-- climbable vines out on the peaks so the relief is scalable ("places to climb").
	-- Denser on jungle isles, a lighter touch on palm / volcanic isles.
	if leafy then
		local giantCount = if biome == "jungle" then math.floor(size / 120) else math.floor(size / 220)
		for _ = 1, giantCount do
			local angle = math.random() * math.pi * 2
			local r = half * (0.25 + math.random() * 0.5)
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildGiantTree(model, groundY, x, z)
		end

		local fernCount = if biome == "jungle" then math.floor(size / 18) else math.floor(size / 32)
		for _ = 1, fernCount do
			local angle = math.random() * math.pi * 2
			local r = half * (0.15 + math.random() * 0.7)
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildFern(model, groundY, x, z)
		end

		local vineCount = math.clamp(math.floor(size / 160), 2, 7)
		for _ = 1, vineCount do
			local angle = math.random() * math.pi * 2
			local r = half * (0.62 + math.random() * 0.28)
			local h = 24 + math.random() * 18
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildClimbVine(model, groundY, x, z, h)
		end
	end

	-- Rolling dunes across the interior — breaks up the flat with gentle rises
	local duneCount = math.floor(size / 64)
	for _ = 1, duneCount do
		local angle = math.random() * math.pi * 2
		local r = half * (0.2 + math.random() * 0.62)
		local x = center.X + math.cos(angle) * r
		local z = center.Z + math.sin(angle) * r
		local groundY = dryGroundY(x, z)
		if not groundY then
			continue
		end
		buildDune(model, groundY, x, z, math.random() < 0.6)
	end

	-- Rock outcrops — a few inland, more clustered near the shoreline
	local rockCount = math.floor(size / 96)
	for _ = 1, rockCount do
		local angle = math.random() * math.pi * 2
		local r = half * (0.35 + math.random() * 0.55)
		local x = center.X + math.cos(angle) * r
		local z = center.Z + math.sin(angle) * r
		local groundY = dryGroundY(x, z)
		if not groundY then
			continue
		end
		buildRock(model, groundY, x, z)
	end

	-- Weathered driftwood logs washed up along the beach ring
	local driftCount = math.clamp(math.floor(size / 70), 2, 6)
	for _ = 1, driftCount do
		local angle = math.random() * math.pi * 2
		local r = half * (0.72 + math.random() * 0.2)
		local x = center.X + math.cos(angle) * r
		local z = center.Z + math.sin(angle) * r
		local groundY = dryGroundY(x, z)
		if groundY then
			buildDriftwood(model, groundY, x, z)
		end
	end

	-- Scattered flowers for colour (shadowless, so nearly free). Tropical + temperate only.
	if biome ~= "mountain" then
		local flowerCount = math.floor(size / 46)
		for _ = 1, flowerCount do
			local angle = math.random() * math.pi * 2
			local r = half * (0.18 + math.random() * 0.62)
			local x = center.X + math.cos(angle) * r
			local z = center.Z + math.sin(angle) * r
			local groundY = dryGroundY(x, z)
			if not groundY then
				continue
			end
			buildFlower(model, groundY, x, z)
		end
	end
end

local function scatterLooseLoot(model: Model, center: Vector3, size: number, topY: number, islandId: string)
	local half = size * 0.5
	local lootFolder = Instance.new("Folder")
	lootFolder.Name = "IsleLoot"
	lootFolder.Parent = model

	-- Torches stuck in the sand / grass
	local torchCount = math.clamp(math.floor(size / 55), 2, 5)
	for i = 1, torchCount do
		local angle = (i / torchCount) * math.pi * 2 + math.random() * 0.4
		local r = half * (0.25 + math.random() * 0.45)
		local cf = CFrame.new(center.X + math.cos(angle) * r, topY + 1.7, center.Z + math.sin(angle) * r)
		local torch = LootPropFactory.createTorchWorld(lootFolder, cf)
		torch:SetAttribute("IslandId", islandId)
	end

	-- Salvage planks & crates along the beach ring
	local plankCount = math.clamp(math.floor(size / 40), 3, 8)
	for i = 1, plankCount do
		local angle = math.random() * math.pi * 2
		local r = half * (0.62 + math.random() * 0.28)
		local yaw = math.rad(math.random(0, 360))
		local cf = CFrame.new(center.X + math.cos(angle) * r, topY + 0.35, center.Z + math.sin(angle) * r)
			* CFrame.Angles(0, yaw, math.rad((math.random() - 0.5) * 8))
		local plank = LootPropFactory.createPlankWorld(lootFolder, cf)
		plank:SetAttribute("IslandId", islandId)
	end

	local crateCount = math.clamp(math.floor(size / 70), 1, 4)
	for i = 1, crateCount do
		local angle = math.random() * math.pi * 2
		local r = half * (0.2 + math.random() * 0.5)
		local cf = CFrame.new(center.X + math.cos(angle) * r, topY + 1.2, center.Z + math.sin(angle) * r)
		local crate = LootPropFactory.createCrateWorld(lootFolder, cf)
		crate:SetAttribute("IslandId", islandId)
	end
end

-- When any villager on an isle is attacked, the whole village turns out to defend it:
-- passive islanders flip to red-eyed hostile defenders and hunt the attacker.
local function defendIsland(islandId: string)
	for _, rt in IslandService._npcs do
		if rt.islandId == islandId and rt.alive and not rt.hostile then
			rt.hostile = true
			rt.model:SetAttribute("Hostile", true)
			rt.model:SetAttribute("IsPirate", true)
			NpcFactory.makeHostileLook(rt.model)
		end
	end
end

-- Spawn a single villager NPC. kind: "passive" | "hostile" | "scavenger".
local function spawnVillager(island: IslandRecord, cf: CFrame, kind: string): Model
	local cfg = Config.Islands.Villager
	local hostile = kind ~= "passive"
	local health = cfg.Passive.Health
	if kind == "hostile" then
		health = cfg.Hostile.Health
	elseif kind == "scavenger" then
		health = cfg.Scavenger.Health
	end

	local model, humanoid = NpcFactory.createVillager(island.model, cf, {
		hostile = hostile,
		scavenger = kind == "scavenger",
		islandId = island.id,
		health = health,
	})

	local runtime: NpcRuntime = {
		model = model,
		humanoid = humanoid,
		islandId = island.id,
		hostile = hostile,
		attackAccum = 0,
		wanderAccum = math.random() * 2,
		homePos = cf.Position,
		targetPos = nil,
		alive = true,
	}

	-- Passive villagers defend their home the moment they take a hit.
	if kind == "passive" and cfg.Passive.DefendOnAttack then
		local prevHealth = humanoid.Health
		humanoid.HealthChanged:Connect(function(h)
			if h < prevHealth and runtime.alive then
				defendIsland(island.id)
			end
			prevHealth = h
		end)
	end

	humanoid.Died:Connect(function()
		runtime.alive = false
	end)

	table.insert(island.npcs, model)
	table.insert(IslandService._npcs, runtime)
	return model
end

-- Bring an island's people to life during world generation. Idempotent so retries and
-- future streaming passes cannot duplicate a settlement's residents.
local function populateIsland(record: IslandRecord)
	if record.populated then
		return
	end
	record.populated = true

	local plan = record.villagerPlan
	if not plan then
		return
	end

	local spots = plan.spots
	local spotCount = math.max(#spots, 1)
	local center, topY = record.center, record.topY
	local function spotAt(i: number): CFrame
		local base = spots[((i - 1) % spotCount) + 1] or Vector3.new(center.X, topY + 2.5, center.Z)
		local jitter = Vector3.new((math.random() - 0.5) * 8, 0, (math.random() - 0.5) * 8)
		local pos = base + jitter
		return CFrame.new(Vector3.new(pos.X, topY + 2.5, pos.Z))
	end

	if plan.abandoned then
		-- Rare feral scavengers only.
		for i = 1, plan.hostile do
			spawnVillager(record, spotAt(i), "scavenger")
		end
	else
		for i = 1, plan.passive do
			spawnVillager(record, spotAt(i), "passive")
		end
		for i = 1, plan.hostile do
			spawnVillager(record, spotAt(i + 3), "hostile")
		end
	end
end

-- Stable per-isle seed from its id so an island's terrain is identical every build
-- (deterministic) but distinct from every other island.
local function seedFromId(id: string): number
	local h = 2166136261
	for i = 1, #id do
		h = (h * 31 + string.byte(id, i)) % 2147483647
	end
	return h
end

-- Lay an angular ridge from low ground toward a raised spine. Tilted voxel slabs give
-- the shoreline and hills planar low-poly faces rather than the hemispherical silhouette
-- produced by stacking FillBall calls.
local function fillFacetedRidge(
	terrain: Terrain,
	origin: Vector3,
	yaw: number,
	length: number,
	width: number,
	rise: number,
	material: Enum.Material
)
	local segments = 5
	local segmentLength = length / segments
	for segment = 1, segments do
		local t0 = (segment - 1) / segments
		local t1 = segment / segments
		local t = (t0 + t1) * 0.5
		local distance = (t - 0.5) * length
		local sectionRise = rise * t
		local sectionWidth = width * (1 - t * 0.42)
		local thickness = math.max(10, width * (0.34 - t * 0.08))
		local pitch = -math.atan2(rise / segments, segmentLength)
		local center = Vector3.new(
			origin.X + math.cos(yaw) * distance,
			origin.Y + sectionRise - thickness * 0.38,
			origin.Z + math.sin(yaw) * distance
		)
		terrain:FillBlock(
			CFrame.new(center) * CFrame.Angles(0, -yaw + math.pi * 0.5, pitch),
			Vector3.new(sectionLength + 4, thickness, sectionWidth),
			material
		)
	end
end

-- Enhanced terrain generation with compact village foundations and faceted relief.
local function generateIslandTerrain(
	id: string,
	center: Vector3,
	topY: number,
	size: number,
	biome: string,
	theme: string,
	features: { [string]: any }
)
	local Terrain = Workspace.Terrain
	local rng = Random.new(seedFromId(id))
	local cx, cz = center.X, center.Z
	local half = size * 0.5
	local surfaceY = OceanConfig.SurfaceY
	local isTown = theme == "town" or theme == "stone_town"
	local hasVillage = theme ~= "wild" and theme ~= "abandoned"

	local grassMat = if biome == "jungle" or biome == "volcanic"
		then Enum.Material.LeafyGrass
		else Enum.Material.Grass
	local sandMat = Enum.Material.Sand

	-- Solid land column from a submerged base up to a flat top face at `topAt`.
	local baseBottom = surfaceY - 40
	local function landColumn(px: number, pz: number, radius: number, topAt: number, material: Enum.Material)
		local h = topAt - baseBottom
		if h <= 0 then
			return
		end
		Terrain:FillCylinder(CFrame.new(px, (topAt + baseBottom) * 0.5, pz), h, radius, material)
	end

	-- Keep only a compact settlement core buildable. Everything beyond the town square
	-- is raised, sloped, or terraced so the silhouette matches the reference islands.
	if hasVillage then
		local villageFoundationRadius = half * (if isTown then 0.27 else 0.22)
		landColumn(cx, cz, villageFoundationRadius, topY + 0.5, grassMat)
	end

	-- 1) A submerged sand shelf supports an irregular grassy landmass. Sand remains a
	-- narrow waterline detail rather than becoming the visible island surface.
	landColumn(cx, cz, half * 0.68, surfaceY + 0.8, sandMat)
	landColumn(cx, cz, half * 0.52, topY + 2, grassMat)
	local lobes = rng:NextInteger(8, 12)
	for i = 1, lobes do
		local a = (i / lobes) * math.pi * 2 + rng:NextNumber(-0.55, 0.55)
		local dist = half * rng:NextNumber(0.24, 0.55)
		local lobeR = half * rng:NextNumber(0.18, 0.34)
		-- Keep every lobe inside the isle circle so the raft's shoreline collision is clean.
		if dist + lobeR > half * 0.98 then
			lobeR = math.max(half * 0.18, half * 0.98 - dist)
		end
		-- Avoid placing lobes too close to village centers
		if hasVillage then
			local lobeCenter = Vector3.new(cx + math.cos(a) * dist, topY, cz + math.sin(a) * dist)
			local distToVillage = (lobeCenter - center).Magnitude
			if distToVillage < half * 0.45 then
				continue  -- Skip this lobe to keep village area clear
			end
		end
		local lobeTop = topY + rng:NextNumber(5, 22)
		landColumn(cx + math.cos(a) * dist, cz + math.sin(a) * dist, lobeR, lobeTop, grassMat)
	end

	-- 2) A modest grass cap supports only the central streets. Angular ridge fans carry
	-- the terrain toward the forest without a giant flat disc or rounded dome.
	local capTop = topY + (if hasVillage then 0.2 else 0.3)
	local capBottom = topY - 3.5
	local capH = capTop - capBottom
	local capY = (capTop + capBottom) * 0.5
	local capRadius = if hasVillage then half * (if isTown then 0.30 else 0.25) else half * 0.28

	Terrain:FillCylinder(CFrame.new(cx, capY, cz), capH, capRadius, grassMat)

	local shoulderCount = if hasVillage then 20 else 16
	for i = 1, shoulderCount do
		local a = (i / shoulderCount) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local d = half * rng:NextNumber(0.28, 0.76)
		local r = half * rng:NextNumber(0.10, 0.18)
		local rise = rng:NextNumber(18, 54)
		local px = cx + math.cos(a) * d
		local pz = cz + math.sin(a) * d
		-- Overlapping tilted slabs create climbable planar slopes, broken ridgelines,
		-- and shallow valleys while keeping the low-poly silhouette from the references.
		fillFacetedRidge(
			Terrain,
			Vector3.new(px, topY - r * 0.12, pz),
			a + rng:NextNumber(-0.35, 0.35),
			r * rng:NextNumber(1.8, 2.7),
			r * rng:NextNumber(1.25, 1.8),
			rise,
			if biome == "jungle" then Enum.Material.LeafyGrass else grassMat
		)
	end

	-- 3) Enhanced biome relief with village-friendly positioning
	local rockMat = Enum.Material.Rock

	if biome == "volcanic" and features.volcano then
		local v = features.volcano
		-- Position volcano away from village center for better layouts
		local steps = 12
		for s = 0, steps do
			local t = s / steps
			local y = topY + v.height * t
			local r = v.baseR * (1 - t * 0.82)
			if t > 0.9 then
				r = math.max(r, v.craterR + 3)
			end
			local mat = if t < 0.18 then grassMat elseif t > 0.62 then Enum.Material.Basalt else rockMat
			Terrain:FillBall(Vector3.new(v.pos.X, y, v.pos.Z), math.max(r, v.craterR + 2), mat)
		end
		-- Hollow out the summit crater
		local rimY = topY + v.height
		Terrain:FillCylinder(CFrame.new(v.pos.X, rimY - 4, v.pos.Z), 14, v.craterR, Enum.Material.Air)

		-- Reduced tropical hillocks to avoid village interference
		for i = 1, rng:NextInteger(1, 2) do
			local a = rng:NextNumber(0, math.pi * 2)
			local d = half * rng:NextNumber(0.7, 0.9)  -- Push further from center
			local hx, hz = cx + math.cos(a) * d, cz + math.sin(a) * d

			-- Check distance from village if applicable
			if hasVillage and (Vector3.new(hx, topY, hz) - center).Magnitude < half * 0.5 then
				continue
			end

			for s = 0, 4 do
				local t = s / 4
				Terrain:FillBall(Vector3.new(hx, topY + 14 * t, hz), math.max(half * 0.09 * (1 - t * 0.7), 3), grassMat)
			end
		end

	elseif biome == "mountain" then
		-- Mountain peak positioned for scenic backdrop
		local pk = features.peak
		if pk then
			local steps = 12
			for s = 0, steps do
				local t = s / steps
				local y = topY + pk.height * t
				local r = pk.baseR * (1 - t * 0.78)
				local mat = if t > 0.72 then Enum.Material.Snow elseif t > 0.3 then rockMat else grassMat
				Terrain:FillBall(Vector3.new(pk.pos.X, y, pk.pos.Z), math.max(r, 3), mat)
			end
		end

		-- Strategic hummock placement for medieval castle/village aesthetic
		for i = 1, rng:NextInteger(1, 3) do
			local a = rng:NextNumber(0, math.pi * 2)
			local d = half * rng:NextNumber(0.6, 0.9)  -- Keep away from village center
			local hx, hz = cx + math.cos(a) * d, cz + math.sin(a) * d

			-- Avoid village area
			if hasVillage and (Vector3.new(hx, topY, hz) - center).Magnitude < half * 0.4 then
				continue
			end

			for s = 0, 4 do
				local t = s / 4
				Terrain:FillBall(Vector3.new(hx, topY + 20 * t, hz), math.max(half * 0.12 * (1 - t * 0.7), 3), grassMat)
			end
		end

		-- Lake positioned for castle/village water feature
		local lake = features.lake
		if lake then
			local clearTop = topY + 6
			local clearH = clearTop - lake.bedY
			Terrain:FillCylinder(
				CFrame.new(lake.pos.X, (clearTop + lake.bedY) * 0.5, lake.pos.Z),
				clearH,
				lake.radius,
				Enum.Material.Air
			)
			local waterH = lake.surfaceY - lake.bedY
			Terrain:FillCylinder(
				CFrame.new(lake.pos.X, (lake.surfaceY + lake.bedY) * 0.5, lake.pos.Z),
				waterH,
				lake.radius - 1,
				Enum.Material.Water
			)
		end
	elseif features.tropicalTerrace then
		-- Stacked grassy terraces + a central rocky cliff (low-poly tropical look).
		local tt = features.tropicalTerrace
		landColumn(cx, cz, tt.midR, tt.midY, grassMat)
		landColumn(cx, cz, tt.topR, tt.topY, grassMat)
		local cliffSteps = 10
		for s = 0, cliffSteps do
			local t = s / cliffSteps
			local y = topY + (tt.cliffTop - topY) * t
			local r = tt.cliffR * (1 - t * 0.22)
			Terrain:FillBall(Vector3.new(cx, y, cz), math.max(r, 5), rockMat)
		end
		-- Flat grassy summit pad on the cliff.
		Terrain:FillCylinder(
			CFrame.new(cx, tt.cliffTop - 0.5, cz),
			3.5,
			tt.cliffR * 0.78,
			grassMat
		)
	else
		-- Enhanced relief for other biomes with village considerations
		local peakExtra, hillCount
		if biome == "jungle" then
			peakExtra, hillCount = rng:NextNumber(34, 66), rng:NextInteger(1, 2)  -- Fewer hills for villages
		elseif biome == "palm" then
			peakExtra, hillCount = rng:NextNumber(16, 32), rng:NextInteger(0, 1)
		elseif biome == "highland" then
			peakExtra, hillCount = rng:NextNumber(20, 40), rng:NextInteger(1, 2)
		else
			peakExtra, hillCount = rng:NextNumber(5, 13), rng:NextInteger(0, 1)
		end

		-- Push hills to outer bands to preserve village flatness
		local hillBandMin = if isTown then 0.88 else (if hasVillage then 0.75 else 0.6)
		local hillBandMax = 0.94
		local hillRock = if biome == "jungle" then Enum.Material.Rock else grassMat

		for i = 1, hillCount do
			local a = rng:NextNumber(0, math.pi * 2)
			local d = half * rng:NextNumber(hillBandMin, hillBandMax)
			local hx, hz = cx + math.cos(a) * d, cz + math.sin(a) * d
			local baseR = half * (if isTown then rng:NextNumber(0.05, 0.09) else rng:NextNumber(0.08, 0.15))

			-- Ensure hills don't interfere with village layout
			if hasVillage and (Vector3.new(hx, topY, hz) - center).Magnitude < half * 0.5 then
				continue
			end

			fillFacetedRidge(
				Terrain,
				Vector3.new(hx, topY, hz),
				a + rng:NextNumber(-0.4, 0.4),
				baseR * 2.4,
				baseR * 1.8,
				peakExtra,
				hillRock
			)
		end
	end

	-- 4) Refined coastal rock placement for better harbor/dock access
	local knobs = rng:NextInteger(2, 5)  -- Fewer rocks for cleaner shorelines
	for i = 1, knobs do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = half * rng:NextNumber(0.95, 1.05)

		-- Avoid dock areas if this island has docks
		local skipKnob = false
		if features.docks then
			for _, dock in features.docks do
				local angleDiff = math.abs(math.atan2(
					math.sin(a - dock.angle),
					math.cos(a - dock.angle)
				))
				if angleDiff < math.rad(45) then
					skipKnob = true
					break
				end
			end
		end

		if not skipKnob then
			Terrain:FillBall(
				Vector3.new(cx + math.cos(a) * d, surfaceY - 0.5, cz + math.sin(a) * d),
				rng:NextNumber(2, 5),  -- Smaller rocks
				Enum.Material.Rock
			)
		end
	end

	-- Every settlement gets a few broad, climbable hills around its outer woodland.
	-- They are deliberately kept beyond the street clearing so town paths remain usable.
	if hasVillage then
		for i = 1, 8 do
			local a = (i / 8) * math.pi * 2 + rng:NextNumber(-0.28, 0.28)
			local d = half * rng:NextNumber(0.58, 0.84)
			local radius = half * rng:NextNumber(0.09, 0.16)
			local rise = rng:NextNumber(20, 48)
			fillFacetedRidge(
				Terrain,
				Vector3.new(cx + math.cos(a) * d, topY, cz + math.sin(a) * d),
				a + rng:NextNumber(-0.3, 0.3),
				radius * 2.6,
				radius * 1.9,
				rise,
				if biome == "jungle" then Enum.Material.LeafyGrass else grassMat
			)
		end
	end

	-- Carve a navigable sea-level river after all landforms are placed. It runs from
	-- coast to coast, so a crew can enter the island, steer through it, and leave again.
	local river = features.river
	if river then
		local yaw = math.atan2(math.cos(river.angle), math.sin(river.angle))
		local riverCf = CFrame.new(cx, 0, cz) * CFrame.Angles(0, yaw, 0)
		local clearTop = math.max(topY + 90, surfaceY + 18)
		local clearBottom = surfaceY - 42
		Terrain:FillBlock(
			riverCf * CFrame.new(0, (clearTop + clearBottom) * 0.5, 0),
			Vector3.new(river.width, clearTop - clearBottom, river.length),
			Enum.Material.Air
		)
		Terrain:FillBlock(
			riverCf * CFrame.new(0, (surfaceY - 16) * 0.5, 0),
			Vector3.new(river.width - 5, surfaceY + 16, river.length + 12),
			Enum.Material.Water
		)

		-- Broken rock walls and raised grassy shoulders give the channel the wooded
		-- ravine profile from the reference. They remain outside the raft-safe width.
		local bankOffset = river.width * 0.5 + 18
		local segments = 18
		for i = 1, segments do
			local along = -river.length * 0.42 + (i - 1) * (river.length * 0.84 / (segments - 1))
			for _, side in { -1, 1 } do
				local jitter = rng:NextNumber(-8, 8)
				local localBank = Vector3.new(side * (bankOffset + jitter), topY + 2, along)
				local bank = riverCf:PointToWorldSpace(localBank)
				Terrain:FillBall(bank, rng:NextNumber(10, 18), Enum.Material.Rock)
				local shoulder = riverCf:PointToWorldSpace(
					Vector3.new(side * (bankOffset + 28), topY + rng:NextNumber(8, 18), along)
				)
				Terrain:FillBall(shoulder, rng:NextNumber(22, 38), grassMat)
			end
		end
	end
end

-- =====================================================================================
-- Signature landform effects + shoreline structures (docks, lighthouses, boats)
-- =====================================================================================

-- A short wooden barrel standing on end (dock / harbour clutter).
local function buildBarrel(model: Model, pos: Vector3)
	makePart({
		Name = "Barrel",
		Parent = model,
		Size = Vector3.new(2.4, 1.9, 1.9),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(112, 76, 44),
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	})
	makePart({
		Name = "BarrelBand",
		Parent = model,
		Size = Vector3.new(2.5, 2.0, 0.6),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(60, 44, 30),
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	})
end

-- A little open rowboat that floats on the water beside a dock (or lies beached/broken
-- on an abandoned isle). `cf` sits at the waterline; `broken` tilts + darkens it.
local function buildRowboat(model: Model, cf: CFrame, broken: boolean?)
	local hull = Color3.fromRGB(104, 72, 42)
	if broken then
		hull = Color3.fromRGB(78, 60, 44)
		cf = cf * CFrame.Angles(math.rad(12), 0, math.rad(18))
	end
	local boat = Instance.new("Model")
	boat.Name = if broken then "Shipwreck" else "Rowboat"
	boat.Parent = model
	local function part(name, size, off, color)
		return makePart({
			Name = name,
			Parent = boat,
			Size = size,
			CFrame = cf * off,
			Color = color or hull,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end
	part("Floor", Vector3.new(4.6, 0.4, 10), CFrame.new(0, 0.2, 0))
	part("SideL", Vector3.new(0.4, 1.6, 10), CFrame.new(-2.3, 0.9, 0) * CFrame.Angles(0, 0, math.rad(-12)))
	part("SideR", Vector3.new(0.4, 1.6, 10), CFrame.new(2.3, 0.9, 0) * CFrame.Angles(0, 0, math.rad(12)))
	part("Bow", Vector3.new(4.4, 1.6, 1.4), CFrame.new(0, 0.9, -5) * CFrame.Angles(math.rad(20), 0, 0))
	part("Stern", Vector3.new(4.4, 1.6, 1.2), CFrame.new(0, 0.9, 5))
	if not broken then
		part("Bench", Vector3.new(4.2, 0.35, 1.3), CFrame.new(0, 1.4, 0))
		part("Oar", Vector3.new(0.3, 0.3, 6), CFrame.new(2.7, 1.6, 0) * CFrame.Angles(math.rad(6), math.rad(18), 0), Color3.fromRGB(122, 90, 58))
	end
	local prim = boat:FindFirstChild("Floor")
	if prim and prim:IsA("BasePart") then
		boat.PrimaryPart = prim
	end
end

-- A wooden pier reaching out over the water: plank walkway on pilings, side rails, a wider
-- T-head at the end, and a little harbour clutter (barrels + a draggable crate). Optionally
-- moors a rowboat alongside the head. `origin` is the body the dock reaches out from (the
-- island for a sea dock, or the lake centre for a lake dock).
local function buildDock(
	model: Model,
	origin: Vector3,
	surfaceY: number,
	angle: number,
	startR: number,
	endR: number,
	opts: { [string]: any }?
)
	opts = opts or {}
	local o = opts :: { [string]: any }
	local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local yaw = math.atan2(dir.X, dir.Z)
	local length = math.abs(endR - startR)
	if length < 6 then
		return
	end
	local midR = (startR + endR) * 0.5
	local width = (o.width :: number?) or 7
	local deckY = (o.deckY :: number?) or (surfaceY + 1.4)
	local base = Vector3.new(origin.X + dir.X * midR, deckY, origin.Z + dir.Z * midR)
	local cf = CFrame.new(base) * CFrame.Angles(0, yaw, 0)

	makePart({
		Name = "DockDeck",
		Parent = model,
		Size = Vector3.new(width, 0.5, length),
		CFrame = cf,
		Color = DOCK_PLANK,
		Material = Enum.Material.WoodPlanks,
	})
	table.insert(IslandService._dockColliders, {
		cframe = cf,
		size = Vector3.new(width, 0.5, length),
		islandName = (o.islandName :: string?) or "the dock",
	})

	-- Pilings + short rail posts down both sides.
	local pileTop = deckY - 0.2
	local pileBot = surfaceY - 6
	local pileH = pileTop - pileBot
	local pileY = (pileTop + pileBot) * 0.5
	local posts = math.max(2, math.floor(length / 8))
	for i = 0, posts do
		local along = -length * 0.5 + (i / posts) * length
		for _, sx in { -width * 0.5 + 0.7, width * 0.5 - 0.7 } do
			local p = cf * CFrame.new(sx, 0, along)
			makePart({
				Name = "DockPiling",
				Parent = model,
				Size = Vector3.new(0.9, pileH, 0.9),
				CFrame = CFrame.new(p.X, pileY, p.Z),
				Color = DOCK_POST,
				Material = Enum.Material.Wood,
			})
			makePart({
				Name = "RailPost",
				Parent = model,
				Size = Vector3.new(0.4, 2.4, 0.4),
				CFrame = cf * CFrame.new(sx, 1.4, along),
				Color = DOCK_POST,
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
		end
	end
	-- Continuous top rails.
	for _, sx in { -width * 0.5 + 0.7, width * 0.5 - 0.7 } do
		makePart({
			Name = "DockRail",
			Parent = model,
			Size = Vector3.new(0.35, 0.35, length),
			CFrame = cf * CFrame.new(sx, 2.5, 0),
			Color = DOCK_PLANK,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end

	-- Wider T-head platform at the far (water) end.
	local headSign = if endR >= startR then 1 else -1
	local headCf = cf * CFrame.new(0, 0, headSign * (length * 0.5 - 3))
	makePart({
		Name = "DockHead",
		Parent = model,
		Size = Vector3.new(width + 7, 0.5, 6.5),
		CFrame = headCf,
		Color = DOCK_PLANK,
		Material = Enum.Material.WoodPlanks,
	})
	table.insert(IslandService._dockColliders, {
		cframe = headCf,
		size = Vector3.new(width + 7, 0.5, 6.5),
		islandName = (o.islandName :: string?) or "the dock",
	})

	-- Harbour clutter near the land end: a couple of barrels + a draggable crate.
	local landCf = cf * CFrame.new(0, 0, -headSign * (length * 0.5 - 3.5))
	buildBarrel(model, (landCf * CFrame.new(width * 0.5 - 1.2, 0.25, 0)).Position)
	if math.random() < 0.7 then
		buildBarrel(model, (landCf * CFrame.new(width * 0.5 - 2.6, 0.25, 1.4)).Position)
	end
	if o.islandId then
		local crate = LootPropFactory.createCrateWorld(model, landCf * CFrame.new(-width * 0.5 + 1.4, 1.2, 0))
		crate:SetAttribute("IslandId", o.islandId)
	end

	-- Moor a rowboat alongside the head.
	if o.rowboat ~= false then
		local boatCf = headCf * CFrame.new(width * 0.5 + 4, surfaceY - deckY + 0.4, 0) * CFrame.Angles(0, math.rad(90), 0)
		buildRowboat(model, boatCf)
	end
end

-- Enhanced lighthouse with improved banded stone appearance matching reference images
local function buildLighthouse(model: Model, topY: number, x: number, z: number)
	local lh = Instance.new("Model")
	lh.Name = "Lighthouse"
	lh.Parent = model
	local baseY = topY
	local towerH = 42  -- Taller for more impressive silhouette

	-- Enhanced rocky foundation with more detail
	makePart({
		Name = "LHFoundation",
		Parent = lh,
		Size = Vector3.new(15, 5, 15),
		CFrame = CFrame.new(x, baseY + 1.5, z),
		Color = Color3.fromRGB(105, 102, 98),
		Material = Enum.Material.Rock,
		Shape = Enum.PartType.Cylinder,
	}).CFrame = CFrame.new(x, baseY + 1.5, z) * CFrame.Angles(0, 0, math.rad(90))

	-- Stone base platform
	makePart({
		Name = "LHBasePlatform",
		Parent = lh,
		Size = Vector3.new(11, 2, 11),
		CFrame = CFrame.new(x, baseY + 4, z),
		Color = Color3.fromRGB(135, 132, 128),
		Material = Enum.Material.Cobblestone,
	})

	-- Enhanced tapered banded tower with more distinctive stripes
	local segs = 8  -- More segments for finer banding
	local LIGHTHOUSE_WHITE = Color3.fromRGB(248, 248, 245)
	local LIGHTHOUSE_RED = Color3.fromRGB(165, 42, 38)
	local LIGHTHOUSE_STONE = Color3.fromRGB(140, 135, 130)

	for i = 0, segs - 1 do
		local segH = towerH / segs
		local r = 6.2 - i * 0.4  -- Slightly wider base, more gradual taper
		local y = baseY + 5 + segH * (i + 0.5)

		-- Alternating white and red bands
		local bandColor = if i % 2 == 0 then LIGHTHOUSE_WHITE else LIGHTHOUSE_RED
		local bandMaterial = if i % 2 == 0 then Enum.Material.SmoothPlastic else Enum.Material.SmoothPlastic

		makePart({
			Name = `LHSeg_{i}`,
			Parent = lh,
			Size = Vector3.new(segH + 0.2, r * 2, r * 2),
			CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)),
			Color = bandColor,
			Material = bandMaterial,
			Shape = Enum.PartType.Cylinder,
		})

		-- Add horizontal divider lines between segments
		if i > 0 then
			makePart({
				Name = `LHDivider_{i}`,
				Parent = lh,
				Size = Vector3.new(0.3, (r + 0.2) * 2, (r + 0.2) * 2),
				CFrame = CFrame.new(x, y - segH * 0.5, z) * CFrame.Angles(0, 0, math.rad(90)),
				Color = LIGHTHOUSE_STONE,
				Material = Enum.Material.Concrete,
				Shape = Enum.PartType.Cylinder,
				CanCollide = false,
			})
		end
	end

	local topOfTower = baseY + 5 + towerH

	-- Enhanced gallery deck with railings
	makePart({
		Name = "LHGallery",
		Parent = lh,
		Size = Vector3.new(1.2, 9.5, 9.5),
		CFrame = CFrame.new(x, topOfTower + 0.6, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(75, 78, 85),
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Cylinder,
	})

	-- Gallery railing posts
	for i = 0, 7 do
		local angle = (i / 8) * math.pi * 2
		local railX = x + math.cos(angle) * 4.2
		local railZ = z + math.sin(angle) * 4.2
		makePart({
			Name = "GalleryPost",
			Parent = lh,
			Size = Vector3.new(0.3, 2.5, 0.3),
			CFrame = CFrame.new(railX, topOfTower + 1.8, railZ),
			Color = Color3.fromRGB(75, 78, 85),
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end

	-- Top railing ring
	makePart({
		Name = "GalleryRail",
		Parent = lh,
		Size = Vector3.new(0.4, 8.8, 8.8),
		CFrame = CFrame.new(x, topOfTower + 3, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(75, 78, 85),
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	})

	-- Enhanced lantern room with detailed frame structure
	local lanternBase = makePart({
		Name = "LHLanternBase",
		Parent = lh,
		Size = Vector3.new(1.5, 6.5, 6.5),
		CFrame = CFrame.new(x, topOfTower + 4.2, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(75, 78, 85),
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Cylinder,
	})

	-- Glowing lantern room glass
	local lantern = makePart({
		Name = "LHLantern",
		Parent = lh,
		Size = Vector3.new(3.8, 5.8, 5.8),
		CFrame = CFrame.new(x, topOfTower + 4.2, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 235, 180),
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
		Transparency = 0.15,
	})

	-- Lantern room frame segments (vertical mullions)
	for i = 0, 5 do
		local angle = (i / 6) * math.pi * 2
		local frameX = x + math.cos(angle) * 2.9
		local frameZ = z + math.sin(angle) * 2.9
		makePart({
			Name = "LanternFrame",
			Parent = lh,
			Size = Vector3.new(0.2, 4, 0.5),
			CFrame = CFrame.new(frameX, topOfTower + 4.2, frameZ),
			Color = Color3.fromRGB(45, 48, 55),
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end

	-- Enhanced light source
	local light = Instance.new("PointLight")
	light.Brightness = 5.5
	light.Range = 120
	light.Color = Color3.fromRGB(255, 240, 180)
	light.Shadows = false
	light.Parent = lantern

	-- Beacon effect (spot light for extra range)
	local beacon = Instance.new("SpotLight")
	beacon.Brightness = 3.5
	beacon.Range = 200
	beacon.Angle = 45
	beacon.Color = Color3.fromRGB(255, 240, 180)
	beacon.Face = Enum.NormalId.Top
	beacon.Shadows = false
	beacon.Parent = lantern

	-- Enhanced conical roof with weathered copper appearance
	makePart({
		Name = "LHCap",
		Parent = lh,
		Size = Vector3.new(4.5, 7, 7),
		CFrame = CFrame.new(x, topOfTower + 8.2, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(95, 115, 105),  -- Weathered copper green
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Cylinder,
	})

	-- Roof finial
	makePart({
		Name = "LHFinial",
		Parent = lh,
		Size = Vector3.new(1.2, 0.8, 0.8),
		CFrame = CFrame.new(x, topOfTower + 11.8, z),
		Color = Color3.fromRGB(65, 68, 75),
		Material = Enum.Material.Metal,
	})

	-- Enhanced spiral staircase (external)
	local stairCount = 12
	for i = 0, stairCount - 1 do
		local stepAngle = (i / stairCount) * math.pi * 4  -- Two full rotations
		local stepRadius = 6.8
		local stepY = baseY + 5 + (i / stairCount) * (towerH - 5)
		local stepX = x + math.cos(stepAngle) * stepRadius
		local stepZ = z + math.sin(stepAngle) * stepRadius

		-- Step platform
		makePart({
			Name = "LHStep",
			Parent = lh,
			Size = Vector3.new(2.5, 0.3, 1.2),
			CFrame = CFrame.lookAt(Vector3.new(stepX, stepY, stepZ), Vector3.new(x, stepY, z)),
			Color = Color3.fromRGB(75, 78, 85),
			Material = Enum.Material.Metal,
		})

		-- Step railing
		makePart({
			Name = "StepRail",
			Parent = lh,
			Size = Vector3.new(0.2, 1.5, 2.8),
			CFrame = CFrame.lookAt(Vector3.new(stepX, stepY + 0.75, stepZ), Vector3.new(x, stepY + 0.75, z)) * CFrame.new(1.3, 0, 0),
			Color = Color3.fromRGB(75, 78, 85),
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end

	-- Door at base
	makePart({
		Name = "LHDoor",
		Parent = lh,
		Size = Vector3.new(0.3, 3.5, 2),
		CFrame = CFrame.new(x + 5.5, baseY + 6.5, z),
		Color = Color3.fromRGB(85, 55, 35),
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
end

-- Fill a volcano crater with glowing lava, embers, smoke and a warm glow, plus a couple of
-- cooled lava streaks running down the cone. `pos` is the cone centre, `rimY` the summit.
local function buildLavaCrater(model: Model, pos: Vector3, craterR: number, rimY: number, baseR: number, topY: number)
	local lava = makePart({
		Name = "Lava",
		Parent = model,
		Size = Vector3.new(1.4, (craterR - 1) * 2, (craterR - 1) * 2),
		CFrame = CFrame.new(pos.X, rimY - 3.5, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 104, 28),
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	})
	local fire = Instance.new("Fire")
	fire.Size = 30
	fire.Heat = 18
	fire.Color = Color3.fromRGB(255, 128, 40)
	fire.SecondaryColor = Color3.fromRGB(120, 30, 10)
	fire.Parent = lava
	local smoke = Instance.new("Smoke")
	smoke.Size = 10
	smoke.Opacity = 0.4
	smoke.RiseVelocity = 12
	smoke.Color = Color3.fromRGB(70, 66, 62)
	smoke.Parent = lava
	local light = Instance.new("PointLight")
	light.Brightness = 5
	light.Range = 80
	light.Color = Color3.fromRGB(255, 130, 50)
	light.Shadows = false
	light.Parent = lava
	-- Glowing lava streaks down the flanks.
	for i = 1, 3 do
		local a = math.rad(i * 120 + math.random(-25, 25))
		local dx, dz = math.cos(a), math.sin(a)
		makePart({
			Name = `LavaStreak_{i}`,
			Parent = model,
			Size = Vector3.new(2.2, rimY - topY - 6, 1.2),
			CFrame = CFrame.new(pos.X + dx * baseR * 0.5, topY + (rimY - topY) * 0.5, pos.Z + dz * baseR * 0.5)
				* CFrame.Angles(0, -a, math.rad(14)),
			Color = Color3.fromRGB(226, 72, 24),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

-- A translucent waterfall sheet with a foamy splash pool + drifting mist, cascading from
-- `topPos` down to `bottomY`. Used off the mountain isle's peak-side cliff.
local function buildWaterfall(model: Model, topPos: Vector3, bottomY: number)
	local h = math.max(topPos.Y - bottomY, 8)
	for i = -1, 1 do
		makePart({
			Name = "Waterfall",
			Parent = model,
			Size = Vector3.new(6, h, 1.4),
			CFrame = CFrame.new(topPos.X + i * 5.5, (topPos.Y + bottomY) * 0.5, topPos.Z) * CFrame.Angles(math.rad(4), 0, 0),
			Color = Color3.fromRGB(222, 240, 250),
			Material = Enum.Material.Glass,
			Transparency = 0.32,
			CanCollide = false,
			CastShadow = false,
		})
	end
	local splash = makePart({
		Name = "WaterfallSplash",
		Parent = model,
		Size = Vector3.new(20, 2, 8),
		CFrame = CFrame.new(topPos.X, bottomY + 1, topPos.Z),
		Color = Color3.fromRGB(230, 244, 252),
		Material = Enum.Material.Foil,
		Transparency = 0.3,
		CanCollide = false,
		CastShadow = false,
		Shape = Enum.PartType.Ball,
	})
	local mist = Instance.new("Smoke")
	mist.Size = 8
	mist.Opacity = 0.18
	mist.RiseVelocity = 3
	mist.Color = Color3.fromRGB(235, 245, 250)
	mist.Parent = splash
end

-- Broad, readable walking trails tie the settlement, docks, riverbanks and signature
-- landmark together. The reference islands are dense, but never feel like random props:
-- every important place is connected by a visible path with shrubs and flowers along it.
local function buildScenicTrail(
	model: Model,
	fromPos: Vector3,
	toPos: Vector3,
	topY: number,
	biome: string,
	seed: number
)
	local delta = Vector3.new(toPos.X - fromPos.X, 0, toPos.Z - fromPos.Z)
	local distance = delta.Magnitude
	if distance < 12 then
		return
	end
	local direction = delta.Unit
	local side = Vector3.new(-direction.Z, 0, direction.X)
	local segments = math.clamp(math.ceil(distance / 13), 3, 48)
	local rng = Random.new(seed)
	for i = 1, segments do
		local t = (i - 0.5) / segments
		local wander = math.sin(t * math.pi * 3 + seed * 0.01) * 3.2
		local pos = fromPos:Lerp(toPos, t) + side * wander
		local nextPos = pos + direction
		makePart({
			Name = "ScenicPath",
			Parent = model,
			Size = Vector3.new(9, 0.35, distance / segments + 1.5),
			CFrame = CFrame.lookAt(Vector3.new(pos.X, topY + 0.2, pos.Z), Vector3.new(nextPos.X, topY + 0.2, nextPos.Z)),
			Color = if biome == "volcanic" then Color3.fromRGB(82, 72, 65) else Color3.fromRGB(126, 106, 72),
			Material = if biome == "volcanic" then Enum.Material.Slate else Enum.Material.Ground,
			CanCollide = false,
			CastShadow = false,
		})
		-- Alternate planted edges so the trail reads clearly without becoming a wall.
		if i % 2 == 0 then
			local edge = if i % 4 == 0 then 1 else -1
			local plantPos = pos + side * edge * rng:NextNumber(6.5, 9)
			buildBush(model, topY, plantPos.X, plantPos.Z, biome == "jungle")
			if i % 4 == 0 then
				buildFlower(model, topY, plantPos.X + side.X * 2, plantPos.Z + side.Z * 2)
			end
		end
	end
end

local function buildIslandTrailNetwork(
	model: Model,
	center: Vector3,
	size: number,
	topY: number,
	biome: string,
	features: { [string]: any }
)
	local half = size * 0.5
	local targets = {}
	for _, dock in features.docks do
		if dock.target ~= "lake" then
			table.insert(targets, center + Vector3.new(math.cos(dock.angle) * half * 0.76, 0, math.sin(dock.angle) * half * 0.76))
		end
	end
	if features.volcano then
		local v = features.volcano
		table.insert(targets, center:Lerp(Vector3.new(v.pos.X, topY, v.pos.Z), 0.72))
	end
	if features.peak then
		local p = features.peak
		table.insert(targets, center:Lerp(Vector3.new(p.pos.X, topY, p.pos.Z), 0.62))
	end
	if features.lake then
		local lake = features.lake
		table.insert(targets, center:Lerp(Vector3.new(lake.pos.X, topY, lake.pos.Z), 0.82))
	end
	if features.river then
		table.insert(targets, center + Vector3.new(half * 0.42, 0, 0))
	end
	for i, target in targets do
		buildScenicTrail(model, center, target, topY, biome, seedFromId(model.Name) + i * 97)
	end
end

-- Mountain hubs use the same cheerful skyline landmark as the NewHub reference.
local function buildHotAirBalloon(model: Model, position: Vector3, color: Color3, scale: number)
	local balloon = Instance.new("Model")
	balloon.Name = "HotAirBalloon"
	balloon.Parent = model
	local envelope = makePart({
		Name = "Envelope",
		Parent = balloon,
		Size = Vector3.new(18 * scale, 23 * scale, 18 * scale),
		CFrame = CFrame.new(position),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		CastShadow = true,
	})
	makePart({
		Name = "EnvelopeBand",
		Parent = balloon,
		Size = Vector3.new(18.4 * scale, 3.2 * scale, 18.4 * scale),
		CFrame = envelope.CFrame,
		Color = Color3.fromRGB(248, 177, 48),
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		CastShadow = false,
	})
	local basketPos = position - Vector3.new(0, 17 * scale, 0)
	makePart({
		Name = "Basket",
		Parent = balloon,
		Size = Vector3.new(5 * scale, 4 * scale, 5 * scale),
		CFrame = CFrame.new(basketPos),
		Color = Color3.fromRGB(105, 70, 38),
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
	})
	for _, x in { -2, 2 } do
		for _, z in { -2, 2 } do
			makePart({
				Name = "BalloonRope",
				Parent = balloon,
				Size = Vector3.new(0.22 * scale, 12 * scale, 0.22 * scale),
				CFrame = CFrame.new(position.X + x * scale, position.Y - 11 * scale, position.Z + z * scale),
				Color = Color3.fromRGB(65, 48, 32),
				Material = Enum.Material.Fabric,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
end

-- Precompute the deterministic geometry of an island's signature features (volcano cone,
-- mountain peak + lake, dock directions, lighthouse). Computed ONCE per isle and shared by
-- both the terrain sculptor and the decorative pass so they agree on exact positions.
local function planIslandFeatures(
	id: string,
	center: Vector3,
	topY: number,
	size: number,
	biome: string,
	entry: { [string]: any }
): { [string]: any }
	local rng = Random.new(seedFromId(id) * 3 + 17)
	local half = size * 0.5
	local features: { [string]: any } = { docks = {} }

	if biome == "volcanic" and entry.Volcano ~= false then
		-- Rise the cone on the "back" flank (−Z-ish) so the town core, harbour front
		-- (+Z) and the merchant/campfire keep flat ground — the village then climbs the
		-- lower slopes just like the reference tropical isle.
		local vAngle = math.pi * 1.5 + rng:NextNumber(-0.4, 0.4)
		features.volcano = {
			pos = Vector3.new(center.X + math.cos(vAngle) * half * 0.5, center.Y, center.Z + math.sin(vAngle) * half * 0.5),
			baseR = half * 0.32,
			height = rng:NextNumber(135, 180),
			craterR = half * 0.08,
			angle = vAngle,
		}
	end

	if biome == "mountain" then
		local peakAngle = rng:NextNumber(0, math.pi * 2)
		features.peak = {
			pos = Vector3.new(center.X + math.cos(peakAngle) * half * 0.74, topY, center.Z + math.sin(peakAngle) * half * 0.74),
			baseR = half * 0.24,
			height = rng:NextNumber(150, 210),
			angle = peakAngle,
		}
		local lakeAngle = peakAngle + math.pi
		features.lake = {
			pos = Vector3.new(center.X + math.cos(lakeAngle) * half * 0.52, topY, center.Z + math.sin(lakeAngle) * half * 0.52),
			radius = half * 0.17,
			surfaceY = topY - 1.2,
			bedY = topY - 12,
			angle = lakeAngle,
		}
	end

	-- Twin Peaks: two blocky rock stacks on separate sand pads with open water between.
	if biome == "twin_peaks" then
		local axis = rng:NextNumber(-0.25, 0.25)
		local sep = half * 0.3
		local padR = half * 0.22
		local rockFoot = padR * 0.78
		local rockH = math.clamp(size * 0.09, 88, 130)
		features.peaks = {
			{
				pos = Vector3.new(center.X - sep, center.Y, center.Z + sep * axis),
				padR = padR,
				padW = padR * 2.15,
				padD = padR * 1.85,
				rockFoot = rockFoot,
				rockH = rockH * rng:NextNumber(0.92, 1.05),
				angle = math.pi, -- outward (−X)
			},
			{
				pos = Vector3.new(center.X + sep, center.Y, center.Z - sep * axis),
				padR = padR * rng:NextNumber(0.92, 1.05),
				padW = padR * 2.05,
				padD = padR * 1.75,
				rockFoot = rockFoot * 0.92,
				rockH = rockH * rng:NextNumber(0.85, 0.98),
				angle = 0, -- outward (+X)
			},
		}
	end

	-- Low-poly tropical terrace isle (Palm Terrace): stacked grass rings, stone walls,
	-- spiral cliff, and stilt huts over the water on the harbour side.
	if entry.TropicalTerrace == true then
		features.tropicalTerrace = {
			cx = center.X,
			cz = center.Z,
			midR = half * 0.48,
			midY = topY + 9,
			topR = half * 0.26,
			topY = topY + 20,
			cliffR = half * 0.13,
			cliffTop = topY + 34,
		}
	end

	-- Large river islands have a sea-to-sea channel, wide enough for the starter raft.
	-- Keep this deterministic so the carved terrain and helm collision agree exactly.
	if entry.River == true then
		local angle = tonumber(entry.RiverAngle) or rng:NextNumber(0, math.pi * 2)
		features.river = {
			angle = angle,
			width = tonumber(entry.RiverWidth) or math.max(110, size * 0.07),
			length = size * 1.16,
		}
	end

	-- Dock directions: evenly spaced around the coast, biased away from the tall side
	-- (peak / volcano) so a pier never tries to climb the mountain.
	local dcount = tonumber(entry.Docks) or 0
	if dcount > 0 then
		local baseA = rng:NextNumber(0, math.pi * 2)
		if features.peak then
			baseA = features.peak.angle + math.pi -- start opposite the peak
		elseif features.volcano then
			baseA = features.volcano.angle + math.pi * 0.5
		elseif features.peaks and features.peaks[1] then
			-- Twin Peaks: pier reaches out from the left sand pad into open water.
			baseA = features.peaks[1].angle
		elseif features.tropicalTerrace then
			-- Keep the pier on the +Z-ish harbour side so stilts cluster near it.
			baseA = math.pi * 0.5
		end
		for i = 1, dcount do
			local a = baseA + (i - 1) * (math.pi * 2 / dcount) * 0.55
			table.insert(features.docks, { angle = a, target = "sea" })
		end
		-- On mountain isles the first pier reaches out over the lake instead of the sea.
		if biome == "mountain" and features.lake then
			features.docks[1].target = "lake"
		end
	end

	if entry.Lighthouse == true then
		local a = if #features.docks > 0 then features.docks[1].angle + 0.5 else 0.8
		if features.docks[1] and features.docks[1].target == "lake" and #features.docks > 1 then
			a = features.docks[2].angle + 0.5
		end
		features.lighthouse = { angle = a }
	end

	return features
end

-- =====================================================================================
-- Twin Peaks biome — low-poly dual rock stacks on separate sand pads
-- (matches the postcard "two blocky isles + sagging span" look).
-- =====================================================================================

local TWIN_SAND = Color3.fromRGB(234, 226, 207)
local TWIN_ROCK = Color3.fromRGB(85, 85, 85)
local TWIN_ROCK_LIT = Color3.fromRGB(98, 98, 102)
local TWIN_LEAF = Color3.fromRGB(46, 139, 87)
local TWIN_LEAF_DARK = Color3.fromRGB(36, 118, 72)
local TWIN_TRUNK = Color3.fromRGB(92, 64, 38)

-- Clumpy low-poly canopy tree: thin trunk + clustered leaf balls (the "broccoli" tree).
local function buildClumpTree(model: Model, baseY: number, x: number, z: number, scale: number?)
	local s = scale or (0.9 + math.random() * 0.55)
	local trunkH = (9 + math.random() * 5) * s
	local trunkR = 1.15 * s
	-- Cylinder length is Size.X; rotate 90° about Z so the trunk stands upright.
	makePart({
		Name = "ClumpTrunk",
		Parent = model,
		Size = Vector3.new(trunkH, trunkR, trunkR),
		CFrame = CFrame.new(x, baseY + trunkH * 0.5, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = TWIN_TRUNK,
		Material = Enum.Material.Wood,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
	})
	local canopyY = baseY + trunkH
	local blobs = {
		{ 0, 0, 5.5 },
		{ 2.2, 1.0, 4.2 },
		{ -2.0, 0.6, 4.0 },
		{ 0.4, 2.4, 3.6 },
		{ -1.2, -1.6, 3.8 },
	}
	for i, b in blobs do
		local r = b[3] * s
		makePart({
			Name = `ClumpLeaf_{i}`,
			Parent = model,
			Size = Vector3.new(r, r, r),
			CFrame = CFrame.new(x + b[1] * s, canopyY + b[2] * s, z + (i % 2 == 0 and 0.6 or -0.4) * s),
			Color = if i % 2 == 0 then TWIN_LEAF else TWIN_LEAF_DARK,
			Material = Enum.Material.Grass,
			CanCollide = false,
			CastShadow = i == 1,
			Shape = Enum.PartType.Ball,
		})
	end
end

-- Stacked rectangular rock mass — stair-step / jagged low-poly cliff like the reference.
local function buildBlockyRockStack(
	model: Model,
	rng: Random,
	baseCenter: Vector3,
	baseY: number,
	footprint: number,
	height: number,
	side: number
): Vector3
	-- Returns the top plateau center for trees and lookout props.
	local tiers = rng:NextInteger(6, 8)
	local topPos = baseCenter + Vector3.new(0, height, 0)
	for t = 0, tiers - 1 do
		local frac = t / (tiers - 1)
		local y0 = baseY + height * (t / tiers)
		local y1 = baseY + height * ((t + 1) / tiers)
		local midY = (y0 + y1) * 0.5
		local tierH = math.max(y1 - y0, 4)
		-- Shrink + offset each tier for the stair-step silhouette.
		local w = footprint * (1 - frac * 0.62) * rng:NextNumber(0.88, 1.06)
		local d = footprint * (1 - frac * 0.58) * rng:NextNumber(0.82, 1.04)
		local ox = side * footprint * 0.04 * (1 - frac) + rng:NextNumber(-w * 0.06, w * 0.06)
		local oz = rng:NextNumber(-d * 0.08, d * 0.08)
		local col = if t % 2 == 0 then TWIN_ROCK else TWIN_ROCK_LIT
		makePart({
			Name = `RockTier_{t}`,
			Parent = model,
			Size = Vector3.new(w, tierH + 0.4, d),
			CFrame = CFrame.new(baseCenter.X + ox, midY, baseCenter.Z + oz)
				* CFrame.Angles(0, math.rad(rng:NextNumber(-8, 8)), 0),
			Color = col,
			Material = Enum.Material.Slate,
			CanCollide = true,
			CastShadow = true,
		})
		-- Extra jutting blocks for a jagged, modular read.
		local juts = rng:NextInteger(1, 3)
		for j = 1, juts do
			local jw = w * rng:NextNumber(0.28, 0.48)
			local jh = tierH * rng:NextNumber(0.55, 1.1)
			local jd = d * rng:NextNumber(0.28, 0.45)
			local ja = rng:NextNumber(0, math.pi * 2)
			local jr = (math.min(w, d) * 0.42) * rng:NextNumber(0.7, 1.05)
			makePart({
				Name = `RockJut_{t}_{j}`,
				Parent = model,
				Size = Vector3.new(jw, jh, jd),
				CFrame = CFrame.new(
					baseCenter.X + ox + math.cos(ja) * jr,
					midY + rng:NextNumber(-tierH * 0.15, tierH * 0.2),
					baseCenter.Z + oz + math.sin(ja) * jr
				) * CFrame.Angles(0, ja, 0),
				Color = col,
				Material = Enum.Material.Slate,
				CanCollide = true,
				CastShadow = false,
			})
		end
		if t == tiers - 1 then
			topPos = Vector3.new(baseCenter.X + ox, y1, baseCenter.Z + oz)
		end
	end

	-- Climbable vine/truss on the outer face so players can reach the lookout.
	local climbH = height * 0.92
	local truss = Instance.new("TrussPart")
	truss.Name = "PeakClimb"
	truss.Anchored = true
	truss.CanCollide = true
	truss.Color = Color3.fromRGB(64, 88, 42)
	truss.Material = Enum.Material.Grass
	truss.Size = Vector3.new(2, climbH, 2)
	truss.CFrame = CFrame.new(baseCenter.X + side * footprint * 0.42, baseY + climbH * 0.5, baseCenter.Z)
	truss.CastShadow = false
	truss.Parent = model

	return topPos
end

-- Flat sandy rectangular pad (the pale base under each rock stack in the reference).
local function buildSandPad(model: Model, center: Vector3, topY: number, width: number, depth: number)
	makePart({
		Name = "SandPad",
		Parent = model,
		Size = Vector3.new(width, 3.2, depth),
		CFrame = CFrame.new(center.X, topY - 0.4, center.Z),
		Color = TWIN_SAND,
		Material = Enum.Material.Sand,
		CanCollide = true,
		CastShadow = true,
	})
	-- Slightly larger submerged shelf so the pad reads as rising from the sea.
	makePart({
		Name = "SandShelf",
		Parent = model,
		Size = Vector3.new(width * 1.08, 2.4, depth * 1.08),
		CFrame = CFrame.new(center.X, topY - 2.6, center.Z),
		Color = Color3.fromRGB(214, 204, 178),
		Material = Enum.Material.Sand,
		CanCollide = true,
		CastShadow = false,
	})
end

-- Terrain under twin peaks: two sandy columns + a thin shoal between them (raft collision
-- still uses the enclosing SizeStuds circle from paintTerrain).
local function generateTwinPeaksTerrain(
	id: string,
	center: Vector3,
	topY: number,
	size: number,
	features: { [string]: any }
)
	local Terrain = Workspace.Terrain
	local rng = Random.new(seedFromId(id))
	local half = size * 0.5
	local surfaceY = OceanConfig.SurfaceY
	local sandMat = Enum.Material.Sand
	local baseBottom = surfaceY - 40

	local peaks = features.peaks
	if not peaks then
		return
	end

	local function sandColumn(px: number, pz: number, radius: number)
		local h = topY - baseBottom
		Terrain:FillCylinder(CFrame.new(px, (topY + baseBottom) * 0.5, pz), h, radius, sandMat)
	end

	for _, peak in peaks do
		sandColumn(peak.pos.X, peak.pos.Z, peak.padR * 0.72)
		-- Soft irregular lobes around each pad.
		for _ = 1, 3 do
			local a = rng:NextNumber(0, math.pi * 2)
			local d = peak.padR * rng:NextNumber(0.15, 0.4)
			sandColumn(peak.pos.X + math.cos(a) * d, peak.pos.Z + math.sin(a) * d, peak.padR * rng:NextNumber(0.28, 0.42))
		end
	end

	-- Thin submerged shoal through the open-water gap.
	if #peaks >= 2 then
		local a, b = peaks[1].pos, peaks[2].pos
		local mid = (a + b) * 0.5
		local span = (Vector3.new(a.X - b.X, 0, a.Z - b.Z)).Magnitude
		local yaw = math.atan2(b.X - a.X, b.Z - a.Z)
		Terrain:FillBlock(
			CFrame.new(mid.X, (topY - 1 + baseBottom) * 0.5, mid.Z) * CFrame.Angles(0, yaw, 0),
			Vector3.new(half * 0.1, topY - 1 - baseBottom, math.max(span * 0.45, 40)),
			sandMat
		)
	end

	-- A few reef knobs off the coast.
	for _ = 1, rng:NextInteger(3, 5) do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = half * rng:NextNumber(0.88, 1.02)
		Terrain:FillBall(
			Vector3.new(center.X + math.cos(a) * d, surfaceY - 0.5, center.Z + math.sin(a) * d),
			rng:NextNumber(3, 7),
			Enum.Material.Rock
		)
	end
end

-- Parts pass: sand pads, blocky rock stacks, clump trees, and palms.
local function decorateTwinPeaks(
	model: Model,
	center: Vector3,
	topY: number,
	size: number,
	features: { [string]: any }
)
	local rng = Random.new(seedFromId((model:GetAttribute("IslandId") :: string?) or "twin") * 5 + 11)
	local peaks = features.peaks
	if not peaks or #peaks < 2 then
		return
	end

	local tops: { Vector3 } = {}
	for i, peak in peaks do
		local side = if i == 1 then -1 else 1
		buildSandPad(model, peak.pos, topY, peak.padW, peak.padD)
		local top = buildBlockyRockStack(model, rng, peak.pos, topY, peak.rockFoot, peak.rockH, side)
		table.insert(tops, top)

		-- Clumpy canopy trees on the upper plateaus.
		local treeCount = rng:NextInteger(3, 5)
		for t = 1, treeCount do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = peak.rockFoot * rng:NextNumber(0.05, 0.22)
			buildClumpTree(model, top.Y, top.X + math.cos(a) * r, top.Z + math.sin(a) * r, rng:NextNumber(0.85, 1.25))
		end

		-- Palm trees on the sandy pad (around the rock foot).
		local palmCount = rng:NextInteger(4, 7)
		for _ = 1, palmCount do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = peak.padR * rng:NextNumber(0.55, 0.92)
			local px = peak.pos.X + math.cos(a) * r
			local pz = peak.pos.Z + math.sin(a) * r
			-- Keep palms off the rock footprint.
			if (Vector3.new(px - peak.pos.X, 0, pz - peak.pos.Z)).Magnitude > peak.rockFoot * 0.48 then
				buildPalm(model, topY, px, pz, rng:NextNumber(0.8, 1.15))
			end
		end
	end

	-- Keep the water gap between summits completely open; traversal is by boat.

	-- A couple of shoreline rocks for scale.
	local half = size * 0.5
	for _ = 1, 5 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = half * rng:NextNumber(0.72, 0.92)
		buildRock(model, topY, center.X + math.cos(a) * r, center.Z + math.sin(a) * r, rng:NextNumber(1.2, 2.2))
	end
end

-- Decorative + structural pass run after terrain + vegetation: crater lava, waterfalls,
-- docks/piers, a lighthouse, moored + beached boats. Everything here is Parts parented to
-- the island model (terrain is already sculpted). Positions come from planIslandFeatures.
local function decorateTropicalTerrace(
	model: Model,
	size: number,
	topY: number,
	surfaceY: number,
	features: { [string]: any }
)
	local tt = features.tropicalTerrace
	if not tt then
		return
	end
	local half = size * 0.5
	local cx, cz = tt.cx, tt.cz

	-- Stone retaining walls at each grassy terrace rim.
	buildRetainingRing(model, cx, cz, tt.midR + 1.2, topY - 0.5, tt.midY - topY + 1.2)
	buildRetainingRing(model, cx, cz, tt.topR + 1.0, tt.midY - 0.5, tt.topY - tt.midY + 1.0)

	-- Spiral path up the central cliff to the summit pad.
	buildSpiralPath(model, cx, cz, tt.cliffR, tt.topY + 1, tt.cliffTop - 1)

	-- Short stair ramps from beach → mid terrace and mid → upper (harbour-facing).
	local harbourA = if #features.docks > 0 then features.docks[1].angle else math.pi * 0.5
	for _, ramp in {
		{ r0 = half * 0.72, r1 = tt.midR - 4, y0 = topY + 0.4, y1 = tt.midY + 0.4, w = 10 },
		{ r0 = tt.midR - 2, r1 = tt.topR - 3, y0 = tt.midY + 0.4, y1 = tt.topY + 0.4, w = 8 },
	} do
		local steps = 8
		for i = 0, steps - 1 do
			local t = i / steps
			local r = ramp.r0 + (ramp.r1 - ramp.r0) * t
			local y = ramp.y0 + (ramp.y1 - ramp.y0) * t
			local x = cx + math.cos(harbourA) * r
			local z = cz + math.sin(harbourA) * r
			makePart({
				Name = "TerraceStep",
				Parent = model,
				Size = Vector3.new(ramp.w, 1.1, 5.5),
				CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, -harbourA + math.rad(90), 0),
				Color = TERRACE_STONE,
				Material = Enum.Material.Concrete,
				CastShadow = true,
			})
		end
	end

	-- Ball-on-stick trees in neat rows along the grassy terrace edges.
	for _, ring in {
		{ r = tt.midR - 8, y = tt.midY, count = 14, scale = 1.05 },
		{ r = tt.topR - 6, y = tt.topY, count = 8, scale = 0.9 },
	} do
		for i = 0, ring.count - 1 do
			local a = (i / ring.count) * math.pi * 2 + 0.15
			-- Leave a gap at the harbour stair.
			local delta = math.abs(((a - harbourA + math.pi) % (math.pi * 2)) - math.pi)
			if delta > 0.35 then
				buildBallTree(model, ring.y, cx + math.cos(a) * ring.r, cz + math.sin(a) * ring.r, ring.scale)
			end
		end
	end

	-- Three stilt huts over the water near the pier, linked by boardwalks.
	local hutAngles = { harbourA - 0.7, harbourA - 0.28, harbourA + 0.22 }
	local hutRadii = { half * 1.06, half * 1.1, half * 1.05 }
	local hutDecks = {}
	for i, a in hutAngles do
		local r = hutRadii[i]
		local pos = Vector3.new(cx + math.cos(a) * r, 0, cz + math.sin(a) * r)
		local scale = if i == 2 then 1.05 else 0.92
		hutDecks[i] = buildStiltHut(model, pos, surfaceY, a + math.pi, { scale = scale })
	end
	-- Boardwalks: hut ↔ hut, and a spur from the middle hut toward the beach.
	buildBoardwalk(model, hutDecks[1], hutDecks[2], surfaceY, 5.2)
	buildBoardwalk(model, hutDecks[2], hutDecks[3], surfaceY, 5.2)
	local shore = Vector3.new(
		cx + math.cos(harbourA - 0.28) * half * 0.86,
		hutDecks[2].Y,
		cz + math.sin(harbourA - 0.28) * half * 0.86
	)
	buildBoardwalk(model, hutDecks[2], shore, surfaceY, 5.0)

	-- Larger pavilion on the cliff summit.
	buildStiltHut(
		model,
		Vector3.new(cx, tt.cliffTop + 0.4, cz),
		surfaceY,
		harbourA,
		{ scale = 1.35, overLand = true }
	)
end

local function decorateShore(
	model: Model,
	center: Vector3,
	size: number,
	topY: number,
	biome: string,
	entry: { [string]: any },
	features: { [string]: any }
)
	local half = size * 0.5
	local surfaceY = OceanConfig.SurfaceY
	local islandId = entry.Id

	-- Volcano lava + smoke.
	if features.volcano then
		local v = features.volcano
		buildLavaCrater(model, v.pos, v.craterR, topY + v.height, v.baseR, topY)
	end

	-- Mountain waterfall off the peak-side cliff.
	if features.peak then
		local pk = features.peak
		local wx = center.X + math.cos(pk.angle) * half * 0.98
		local wz = center.Z + math.sin(pk.angle) * half * 0.98
		buildWaterfall(model, Vector3.new(wx, topY + 22, wz), surfaceY)
	end

	buildIslandTrailNetwork(model, center, size, topY, biome, features)

	if features.peak then
		local pk = features.peak
		buildHotAirBalloon(
			model,
			Vector3.new(center.X - math.cos(pk.angle) * half * 0.25, topY + pk.height * 0.92, center.Z - math.sin(pk.angle) * half * 0.25),
			Color3.fromRGB(220, 52, 32),
			0.85
		)
		buildHotAirBalloon(
			model,
			Vector3.new(center.X + math.sin(pk.angle) * half * 0.38, topY + pk.height * 0.66, center.Z - math.cos(pk.angle) * half * 0.38),
			Color3.fromRGB(232, 92, 30),
			0.68
		)
	end

	-- Docks / piers.
	for _, dock in features.docks do
		if dock.target == "lake" and features.lake then
			local lake = features.lake
			-- Reach out from the settlement-facing shore across the lake.
			local toCenter = math.atan2(center.Z - lake.pos.Z, center.X - lake.pos.X)
			buildDock(model, lake.pos, lake.surfaceY, toCenter, lake.radius + 1, lake.radius * 0.18, {
				islandId = islandId,
				deckY = lake.surfaceY + 1.2,
				width = 6,
				rowboat = true,
			})
			-- A rowboat drifting on the lake.
			local bx = lake.pos.X + math.cos(toCenter + 1.2) * lake.radius * 0.4
			local bz = lake.pos.Z + math.sin(toCenter + 1.2) * lake.radius * 0.4
			buildRowboat(model, CFrame.new(bx, lake.surfaceY + 0.4, bz) * CFrame.Angles(0, toCenter, 0))
		else
			local startR = half * 0.8
			-- Twin Peaks: pier starts at the outer edge of a sand pad, not mid-channel.
			if biome == "twin_peaks" and features.peaks and #features.peaks > 0 then
				local peak = features.peaks[1]
				local peakDist = flatDistance(peak.pos, center)
				startR = peakDist + peak.padR * 0.82
			end
			local endR = half + Config.Islands.RaftCollisionPad + 30
			buildDock(model, center, surfaceY, dock.angle, startR, endR, {
				islandId = islandId,
				rowboat = true,
			})
		end
	end

	-- Low-poly tropical terrace props (stilts, walls, spiral, ball trees).
	if features.tropicalTerrace then
		decorateTropicalTerrace(model, size, topY, surfaceY, features)
	end

	-- Lighthouse on the shore of medieval seaside isles.
	if features.lighthouse then
		local a = features.lighthouse.angle
		local lx = center.X + math.cos(a) * half * 0.72
		local lz = center.Z + math.sin(a) * half * 0.72
		buildLighthouse(model, topY, lx, lz)
	end

	-- A beached shipwreck on abandoned isles (washed-up wreck to poke around in).
	if entry.Abandoned == true then
		local a = math.random() * math.pi * 2
		local r = half * 0.82
		buildRowboat(model, CFrame.new(center.X + math.cos(a) * r, topY + 0.6, center.Z + math.sin(a) * r) * CFrame.Angles(0, a, 0), true)
	end
end

-- The fixed arrival isle needs a few hand-authored landmarks so the first view reads
-- as a real low-poly hub rather than another randomly populated destination. The
-- crossing stays high enough for a raft to pass beneath; it is a pedestrian landmark,
-- not a river blocker.
local function decorateArrivalHub(model: Model, center: Vector3, topY: number, features: { [string]: any })
	local river = features.river
	if not river then
		return
	end
	local width = river.width
	local bridgeX = center.X + 120
	local bridgeY = topY + 13
	local stone = Color3.fromRGB(112, 116, 108)
	local darkStone = Color3.fromRGB(72, 78, 74)

	-- Broad arched-looking deck across the channel, with its supports planted well
	-- beyond the navigable water. The wood rail inserts echo the harbour reference.
	makePart({
		Name = "HubCrossingDeck",
		Parent = model,
		Size = Vector3.new(22, 2.4, width + 52),
		CFrame = CFrame.new(bridgeX, bridgeY, center.Z),
		Color = stone,
		Material = Enum.Material.Cobblestone,
		CastShadow = true,
	})
	for _, z in { -(width * 0.5 + 16), width * 0.5 + 16 } do
		makePart({
			Name = "HubCrossingAbutment",
			Parent = model,
			Size = Vector3.new(18, bridgeY - OceanConfig.SurfaceY + 2, 14),
			CFrame = CFrame.new(bridgeX, (bridgeY + OceanConfig.SurfaceY - 2) * 0.5, center.Z + z),
			Color = darkStone,
			Material = Enum.Material.Rock,
			CastShadow = true,
		})
	end
	for _, z in { -width * 0.34, width * 0.34 } do
		makePart({
			Name = "HubBridgeRail",
			Parent = model,
			Size = Vector3.new(1.1, 3.2, width * 0.26),
			CFrame = CFrame.new(bridgeX - 9, bridgeY + 2, center.Z + z),
			Color = DOCK_POST,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
		makePart({
			Name = "HubBridgeRail",
			Parent = model,
			Size = Vector3.new(1.1, 3.2, width * 0.26),
			CFrame = CFrame.new(bridgeX + 9, bridgeY + 2, center.Z + z),
			Color = DOCK_POST,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end

	-- A rocky rainforest peak on the northern bank supplies the unmistakable skyline
	-- from the hub reference without covering the river spawn or settlement paths.
	local peak = Vector3.new(center.X - 300, topY, center.Z - width * 0.5 - 150)
	for ridge = 1, 8 do
		local angle = (ridge / 8) * math.pi * 2
		local length = 185 + (ridge % 3) * 14
		local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
		fillFacetedRidge(
			Workspace.Terrain,
			peak + outward * (length * 0.5),
			angle + math.pi,
			length,
			58 + (ridge % 2) * 14,
			175 + (ridge % 3) * 12,
			if ridge % 3 == 0 then Enum.Material.LeafyGrass else Enum.Material.Rock
		)
	end
	buildHotAirBalloon(model, peak + Vector3.new(56, 170, 38), Color3.fromRGB(214, 60, 36), 0.8)
end

local function buildFlatIsland(entry: { [string]: any }, folder: Folder): IslandRecord
	local thickness = Config.Islands.Thickness
	local topY = Config.Islands.TopY
	local size = entry.SizeStuds
	local biome = entry.Biome or "beach"
	local center = worldCenterForOffset(entry.Offset, topY, thickness)

	local model = Instance.new("Model")
	model.Name = `Isle_{entry.Id}`
	model:SetAttribute("IslandId", entry.Id)
	model:SetAttribute("Biome", biome)
	model.Parent = folder

	-- The isle body is real Roblox voxel Terrain now (not Parts). Keep a tiny invisible
	-- anchor so the Model still has a stable PrimaryPart for any code that references it.
	local anchor = makePart({
		Name = "IsleAnchor",
		Parent = model,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(center.X, topY, center.Z),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	model.PrimaryPart = anchor

	-- Precompute this isle's signature landforms + shoreline layout so the terrain sculptor
	-- and the decorative pass agree on exact positions (volcano, lake, docks, lighthouse,
	-- twin-peak pads).
	local features = planIslandFeatures(entry.Id, center, topY, size, biome, entry)

	if biome == "twin_peaks" then
		-- Low-poly dual stacks: sand pads + blocky rocks + clump trees.
		-- Skip the organic disc / scatter vegetation so the gap between peaks stays open sea.
		generateTwinPeaksTerrain(entry.Id, center, topY, size, features)
		decorateTwinPeaks(model, center, topY, size, features)
	else
		-- Carve the organic, biome-specific terrain island (beaches, grass/jungle/highland
		-- interior, hills, rocky peaks, volcanic cones, snow peaks + lakes). Seeded per isle
		-- so every island's shape is different.
		generateIslandTerrain(entry.Id, center, topY, size, biome, entry.Theme or "wild", features)
		scatterVegetation(model, center, size, topY, biome, features)
		-- Settlement woodland belongs only on the normal terrain isles. Twin Peaks keeps
		-- its open-water gap clear for sailing.
		if (entry.Theme or "village") ~= "wild" then
			scatterSettlementForest(model, center, size, topY, features)
		end
	end
	scatterLooseLoot(model, center, size, topY, entry.Id)

	-- Docks / piers, lighthouse, crater lava, waterfalls, moored + beached boats.
	decorateShore(model, center, size, topY, biome, entry, features)
	if entry.Hub == true then
		decorateArrivalHub(model, center, topY, features)
	end

	local marker = makePart({
		Name = "IsleMarker",
		Parent = model,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center.X, topY + (if biome == "twin_peaks" then 140 else 18), center.Z),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	-- Island name billboard removed - names only show in popups now
	-- local gui = Instance.new("BillboardGui")
	-- gui.Name = "IsleBillboard"
	-- gui.Adornee = marker
	-- gui.Size = UDim2.fromOffset(200, 44)
	-- gui.AlwaysOnTop = true
	-- gui.MaxDistance = 900
	-- gui.Parent = marker

	-- local label = Instance.new("TextLabel")
	-- label.Name = "Label"
	-- label.BackgroundTransparency = 0.28
	-- label.BackgroundColor3 = Color3.fromRGB(18, 36, 48)
	-- label.Size = UDim2.fromScale(1, 1)
	-- label.Font = Enum.Font.GothamBold
	-- label.TextScaled = true
	-- label.TextColor3 = Config.Theme.Foam
	-- label.Text = string.upper(entry.Name)
	-- label.Parent = gui

	-- local corner = Instance.new("UICorner")
	-- corner.CornerRadius = UDim.new(0, 8)
	-- corner.Parent = label

	local theme = entry.Theme or "wild"
	local record: IslandRecord = {
		id = entry.Id,
		name = entry.Name,
		center = center,
		size = size,
		topY = topY,
		thickness = thickness,
		theme = theme,
		abandoned = entry.Abandoned == true,
		biome = biome,
		model = model,
		label = nil, -- No longer displaying island names in-game
		npcs = {},
		safeHarbor = entry.SafeHarbor == true,
	}
	if features.river then
		local river = features.river
		local yaw = math.atan2(math.cos(river.angle), math.sin(river.angle))
		record.river = {
			cframe = CFrame.new(center.X, 0, center.Z) * CFrame.Angles(0, yaw, 0),
			width = river.width,
			length = river.length,
		}
	end

	local villagerCfg = entry.Villagers or { Passive = 0, Hostile = 0 }

	if theme == "wild" then
		-- No village — just a little scattered weapon loot on the wild isle.
		local weaponCount = (entry.Loot and entry.Loot.Weapons) or 0
		for _ = 1, weaponCount do
			local a = math.random() * math.pi * 2
			local r = size * (0.2 + math.random() * 0.24)
			local weaponId = Weapons.rollLootWeapon(function(lo, hi)
				return math.random(lo, hi)
			end)
			local cf = CFrame.new(center.X + math.cos(a) * r, topY + 0.5, center.Z + math.sin(a) * r)
				* CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
			WeaponService.spawnWeaponPickup(model, weaponId, cf)
		end
		-- A scrap of armor may wash up on wild isles too.
		local armorCount = (entry.Loot and entry.Loot.Armor) or 0
		for _ = 1, armorCount do
			local a = math.random() * math.pi * 2
			local r = size * (0.2 + math.random() * 0.24)
			local armorId = Armor.rollLootArmor(function(lo, hi)
				return math.random(lo, hi)
			end)
			local cf = CFrame.new(center.X + math.cos(a) * r, topY + 0.5, center.Z + math.sin(a) * r)
			ArmorService.spawnArmorPickup(model, armorId, cf)
		end
	else
		-- Build the themed village (houses, beds, torches, fences, campfire, chests, loot).
		local deps = {
			toast = function(player: Player, message: string, kind: string)
				if IslandService._Toast then
					IslandService._Toast:FireClient(player, message, kind)
				end
			end,
			getPartyCode = function(player: Player)
				return IslandService._getPartyCode and IslandService._getPartyCode(player)
			end,
			isLocked = function(code: string, islandId: string)
				return IslandService.isLockedForCrew(code, islandId)
			end,
			-- Armor hooks so village chests can grant armor and stands can spawn worn loot.
			wearArmor = function(player: Player, armorId: string)
				return ArmorService.wearArmor(player, armorId)
			end,
			spawnArmorPickup = function(parent: Instance, armorId: string, cf: CFrame)
				return ArmorService.spawnArmorPickup(parent, armorId, cf)
			end,
		}
		local layout = VillageBuilder.build(model, center, size, topY, entry, deps)

		record.villagerPlan = {
			spots = layout.villagerSpots,
			passive = (villagerCfg.Passive or 0),
			hostile = (villagerCfg.Hostile or 0),
			abandoned = record.abandoned,
		}
		-- Populate immediately so the settlements are visibly alive from the spawn raft.
		populateIsland(record)

		-- The blue-hatted merchant (never hostile, draggable / weldable to your raft) is
		-- part of the scenery, so it's placed right away — trade is always available.
		if entry.Merchant == true then
			local m = layout.merchantSpot
			MerchantService.spawnMerchant(model, CFrame.new(m), entry.Id)
		end
	end

	return record
end

-- The opening ring is handcrafted, but the rest of the ocean is a deterministic grid of
-- tropical islands.  We generate a cell only as a crew gets close to it; that makes the
-- map genuinely endless without paying to create a continent at server boot.
local function endlessEntryForCell(cellX: number, cellZ: number): { [string]: any }
	local cfg = Config.Islands.Endless
	local id = `endless_{cellX}_{cellZ}`
	local rng = Random.new(seedFromId(id))
	local cell = cfg.CellStuds
	local origin = Config.StarterBase.Origin
	local jitter = cell * 0.12
	local centerX = origin.X + (cellX + 0.5) * cell + rng:NextNumber(-jitter, jitter)
	local centerZ = origin.Z + (cellZ + 0.5) * cell + rng:NextNumber(-jitter, jitter)
	local volcanic = rng:NextNumber() < 0.34
	return {
		Id = id,
		Name = if volcanic then "Emberwater Atoll" else "Verdant River Atoll",
		Offset = Vector3.new(centerX - origin.X, 0, centerZ - origin.Z),
		SizeStuds = rng:NextInteger(cfg.MinSizeStuds, cfg.MaxSizeStuds),
		Biome = if volcanic then "volcanic" else (if rng:NextNumber() < 0.56 then "jungle" else "palm"),
		Theme = "wild",
		Volcano = volcanic,
		River = true,
		RiverAngle = rng:NextNumber(0, math.pi * 2),
		RiverWidth = cfg.RiverWidth,
		Docks = 1,
		Loot = { Weapons = 2, Chests = 1, Armor = 1 },
		Villagers = { Passive = 0, Hostile = 0 },
	}
end

local function isEndlessCellClear(entry: { [string]: any }): boolean
	local center = worldCenterForOffset(entry.Offset, Config.Islands.TopY, Config.Islands.Thickness)
	local clearance = entry.SizeStuds * 0.5 + 780
	for _, isle in IslandService._islands do
		if flatDistance(center, isle.center) < clearance + isle.size * 0.5 then
			return false
		end
	end
	return true
end

local function buildQueuedEndlessIsland(entry: { [string]: any })
	local folder = IslandService._folder
	if not folder or IslandService._byId[entry.Id] then
		return
	end
	local record = buildFlatIsland(entry, folder)
	table.insert(IslandService._islands, record)
	IslandService._byId[record.id] = record

	-- The normal boot pass registers loot after all handcrafted islands are made. Dynamic
	-- islands need the same registration immediately so their salvage remains draggable.
	local LootPropService = require(script.Parent:WaitForChild("LootPropService"))
	for _, desc in record.model:GetDescendants() do
		if desc:IsA("Model") and desc:GetAttribute("IsLootProp") == true then
			LootPropService.registerExisting(desc)
		end
	end
	IslandService.paintTerrain()
end

local function queueEndlessIslandsNearRafts()
	local cfg = Config.Islands.Endless
	if cfg.Enabled ~= true or IslandService._endlessBuildActive then
		return
	end
	local origin = Config.StarterBase.Origin
	local cell = cfg.CellStuds
	local candidates: { { x: number, z: number, distance: number } } = {}
	local seen: { [string]: boolean } = {}
	for _, raft in StarterBaseService._basesByCode do
		local deck = raft.PrimaryPart or raft:FindFirstChild("Deck")
		if not (deck and deck:IsA("BasePart")) then
			continue
		end
		local cx = math.floor((deck.Position.X - origin.X) / cell)
		local cz = math.floor((deck.Position.Z - origin.Z) / cell)
		for dx = -cfg.BuildRadiusCells, cfg.BuildRadiusCells do
			for dz = -cfg.BuildRadiusCells, cfg.BuildRadiusCells do
				local x, z = cx + dx, cz + dz
				local key = `{x},{z}`
				if not seen[key] then
					seen[key] = true
					table.insert(candidates, { x = x, z = z, distance = dx * dx + dz * dz })
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.distance < b.distance
	end)

	for _, candidate in candidates do
		local entry = endlessEntryForCell(candidate.x, candidate.z)
		if not IslandService._byId[entry.Id] and not IslandService._endlessQueued[entry.Id] and isEndlessCellClear(entry) then
			IslandService._endlessQueued[entry.Id] = true
			IslandService._endlessBuildActive = true
			task.spawn(function()
				local ok, err = pcall(buildQueuedEndlessIsland, entry)
				if not ok then
					warn(`[SurviveAtSea] Endless island {entry.Id} failed:`, err)
				end
				IslandService._endlessQueued[entry.Id] = nil
				IslandService._endlessBuildActive = false
			end)
			return
		end
	end
end

function IslandService.getWorldCenters(): { Vector3 }
	local centers = {}
	for _, isle in IslandService._islands do
		table.insert(centers, isle.center)
	end
	if #centers == 0 then
		-- Before ensure(): still give ocean streamer a hint from catalog
		for _, entry in Config.Islands.Catalog do
			table.insert(
				centers,
				worldCenterForOffset(entry.Offset, Config.Islands.TopY, Config.Islands.Thickness)
			)
		end
	end
	return centers
end

-- Back-compat for older callers
function IslandService.getWorldCenter(): Vector3
	local centers = IslandService.getWorldCenters()
	return centers[1] or Config.StarterBase.Origin
end

function IslandService.paintTerrain()
	-- Isle bodies are sculpted ONCE as organic voxel Terrain in buildFlatIsland. Because
	-- that land lives above the sea surface, the ocean water streamer (which only fills
	-- below the surface) never touches it. This pass just re-asserts the SUBMERGED sand
	-- base each stream cycle so the water filler can't leave a hole under an isle. It
	-- stops well below the surface, so it never flattens the above-water terrain shape.
	local Terrain = Workspace.Terrain
	local surfaceY = OceanConfig.SurfaceY
	local baseTop = surfaceY - 1.5
	local baseBottom = surfaceY - 40
	local baseH = baseTop - baseBottom
	local baseY = (baseTop + baseBottom) * 0.5
	for _, isle in IslandService._islands do
		Terrain:FillCylinder(
			CFrame.new(isle.center.X, baseY, isle.center.Z),
			baseH,
			isle.size * 0.5 + 8,
			Enum.Material.Sand
		)
	end
end

function IslandService.isLockedForCrew(code: string, islandId: string): boolean
	local byIsle = IslandService._crewState[code]
	local state = byIsle and byIsle[islandId]
	return state ~= nil and state.locked == true
end

-- Returns true when the horizontal movement segment enters a circle. Checking the whole
-- segment (rather than only its destination) closes the gap a fast raft could otherwise
-- skip through during a slow server frame.
local function segmentHitsCircle(fromPos: Vector3, toPos: Vector3, center: Vector3, radius: number): boolean
	local start = Vector3.new(fromPos.X - center.X, 0, fromPos.Z - center.Z)
	if start.Magnitude <= radius then
		return true
	end
	local delta = Vector3.new(toPos.X - fromPos.X, 0, toPos.Z - fromPos.Z)
	local lengthSq = delta:Dot(delta)
	if lengthSq < 0.0001 then
		return false
	end
	local t = math.clamp(-start:Dot(delta) / lengthSq, 0, 1)
	return (start + delta * t).Magnitude <= radius
end

-- The raft moves as a kinematic model, so it needs a cheap 2D swept collision test for
-- dock decks too. Expand the oriented dock rectangle by the raft's collision padding,
-- then use a slab intersection against the attempted movement segment.
local function segmentHitsDock(fromPos: Vector3, toPos: Vector3, dock: DockCollider): boolean
	local start = dock.cframe:PointToObjectSpace(fromPos)
	local finish = dock.cframe:PointToObjectSpace(toPos)
	local delta = finish - start
	local pad = Config.Islands.RaftCollisionPad
	local halfX = dock.size.X * 0.5 + pad
	local halfZ = dock.size.Z * 0.5 + pad
	local enter, exit = 0, 1

	for _, axis in { "X", "Z" } do
		local origin = if axis == "X" then start.X else start.Z
		local direction = if axis == "X" then delta.X else delta.Z
		local half = if axis == "X" then halfX else halfZ
		if math.abs(direction) < 0.0001 then
			if math.abs(origin) > half then
				return false
			end
		else
			local near = (-half - origin) / direction
			local far = (half - origin) / direction
			if near > far then
				near, far = far, near
			end
			enter = math.max(enter, near)
			exit = math.min(exit, far)
			if enter > exit then
				return false
			end
		end
	end

	return exit >= 0 and enter <= 1
end

-- Solid shoreline and dock collision. Rafts are watercraft: their complete footprint
-- stays outside every island envelope, without river/channel exceptions that can be
-- abused to cut through land at high speed.
function IslandService.collideRaft(fromPos: Vector3, toPos: Vector3): (Vector3, string?)
	for _, isle in IslandService._islands do
		-- Crews are initially placed inside Rivergate's carved central channel. The
		-- hub's real terrain banks still provide visual boundaries; omit only its
		-- broad circular guard so the raft can leave the starting waterway.
		if isle.safeHarbor then
			continue
		end
		local minDist = isle.size * 0.5 + Config.Islands.RaftCollisionPad
		if segmentHitsCircle(fromPos, toPos, isle.center, minDist) then
			return fromPos, isle.name
		end
	end

	for _, dock in IslandService._dockColliders do
		if segmentHitsDock(fromPos, toPos, dock) then
			return fromPos, dock.islandName
		end
	end

	return toPos, nil
end

-- Keep rafts outside locked isles (can't sail back after leaving far enough away).
function IslandService.clampRaftPosition(code: string, fromPos: Vector3, toPos: Vector3): (Vector3, string?)
	local result = toPos
	local blockedName: string? = nil

	for _, isle in IslandService._islands do
		if not IslandService.isLockedForCrew(code, isle.id) then
			continue
		end
		local minDist = isle.size * 0.5 + Config.Islands.ApproachPadStuds
		local dist = flatDistance(result, isle.center)
		if dist >= minDist then
			continue
		end

		-- Push out along the approach vector; if coming from outside, stop at the ring
		local fromDist = flatDistance(fromPos, isle.center)
		local outward = Vector3.new(result.X - isle.center.X, 0, result.Z - isle.center.Z)
		if outward.Magnitude < 0.05 then
			outward = Vector3.new(fromPos.X - isle.center.X, 0, fromPos.Z - isle.center.Z)
		end
		if outward.Magnitude < 0.05 then
			outward = Vector3.new(1, 0, 0)
		end
		outward = outward.Unit
		local ringPos = Vector3.new(
			isle.center.X + outward.X * minDist,
			result.Y,
			isle.center.Z + outward.Z * minDist
		)
		-- Prefer staying outside if we started outside
		if fromDist >= minDist then
			result = Vector3.new(fromPos.X, result.Y, fromPos.Z)
		else
			result = ringPos
		end
		blockedName = isle.name
	end

	return result, blockedName
end

local function pointOnIsland(pos: Vector3, isle: IslandRecord): boolean
	-- Anywhere from just below the shore up to the top of the tallest terrain peak counts
	-- as "on the isle" (volcano cones + snow peaks can rise ~200+ studs above the plateau).
	if pos.Y < isle.topY - 8 or pos.Y > isle.topY + 260 then
		return false
	end
	return flatDistance(pos, isle.center) <= isle.size * 0.5 + 3
end

local function toastCrew(code: string, message: string, kind: string)
	if not (IslandService._Toast and IslandService._getMemberUserIds) then
		return
	end
	for _, userId in IslandService._getMemberUserIds(code) do
		local plr = Players:GetPlayerByUserId(userId)
		if plr then
			IslandService._Toast:FireClient(plr, message, kind)
		end
	end
end

local function updateVisitLockouts()
	if not IslandService._getMemberUserIds then
		return
	end

	-- Gather active crew codes from live rafts
	local codes: { string } = {}
	local seen: { [string]: boolean } = {}
	for code, _ in StarterBaseService._basesByCode do
		if not seen[code] then
			seen[code] = true
			table.insert(codes, code)
		end
	end

	for _, code in codes do
		local members = IslandService._getMemberUserIds(code)
		local raft = StarterBaseService.getBaseModel(code)
		local deck = raft and (raft.PrimaryPart or raft:FindFirstChild("Deck"))
		local raftPos = if deck and deck:IsA("BasePart") then deck.Position else nil

		for _, isle in IslandService._islands do
			local state = ensureCrewState(code, isle.id)
			if state.locked then
				continue
			end

			local anyoneOn = false
			for _, userId in members do
				local plr = Players:GetPlayerByUserId(userId)
				local root = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") and pointOnIsland(root.Position, isle) then
					anyoneOn = true
					break
				end
			end

			if anyoneOn then
				state.visited = true
				if not state.notifiedVisit then
					state.notifiedVisit = true
					toastCrew(code, `Visited {isle.name} — leave & sail far away and you can't return.`, "info")
				end
				continue
			end

			if not state.visited then
				continue
			end

			-- Visited and everyone off the sand — lock when raft (or crew) is far enough
			local farEnough = false
			if raftPos then
				farEnough = flatDistance(raftPos, isle.center) >= Config.Islands.LockoutStuds
			else
				-- Fallback: all members far
				farEnough = true
				for _, userId in members do
					local plr = Players:GetPlayerByUserId(userId)
					local root = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
					if root and root:IsA("BasePart") then
						if flatDistance(root.Position, isle.center) < Config.Islands.LockoutStuds then
							farEnough = false
							break
						end
					end
				end
			end

			if farEnough then
				state.locked = true
				if not state.notifiedLock then
					state.notifiedLock = true
					toastCrew(code, `{isle.name} is behind you — that isle won't take your crew back.`, "info")
				end
			end
		end
	end
end

-- Rigid-move an anchored NPC model so its root lands at `nextPos` facing `lookAt`.
local function moveNpc(model: Model, root: BasePart, nextPos: Vector3, lookAt: Vector3)
	local newCf = CFrame.lookAt(nextPos, Vector3.new(lookAt.X, nextPos.Y, lookAt.Z))
	local delta = newCf * root.CFrame:Inverse()
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.CFrame = delta * desc.CFrame
		end
	end
end

local function updateNpcs(dt: number)
	local vcfg = Config.Islands.Villager
	for _, runtime in IslandService._npcs do
		if not runtime.alive then
			continue
		end
		local model = runtime.model
		if not model.Parent then
			runtime.alive = false
			continue
		end
		local humanoid = runtime.humanoid or model:FindFirstChildOfClass("Humanoid")
		local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
		if not (humanoid and root and root:IsA("BasePart")) then
			runtime.alive = false
			continue
		end
		if humanoid.Health <= 0 then
			runtime.alive = false
			continue
		end

		local isle = IslandService._byId[runtime.islandId]
		if not isle then
			continue
		end

		if runtime.hostile then
			-- Aggressive defender: chase the nearest player near the isle, then strike.
			local combat = if runtime.model:GetAttribute("NpcKind") == "villager"
					and runtime.model.Name == "Scavenger"
				then vcfg.Scavenger
				else vcfg.Hostile

			local bestPlayer: Player? = nil
			local bestDist = combat.AggroRange
			local bestPos: Vector3? = nil
			for _, plr in Players:GetPlayers() do
				local character = plr.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				local hum = character and character:FindFirstChildOfClass("Humanoid")
				if not (hrp and hrp:IsA("BasePart") and hum and hum.Health > 0) then
					continue
				end
				if flatDistance(hrp.Position, isle.center) > isle.size * 0.5 + 18 then
					continue
				end
				local d = flatDistance(hrp.Position, root.Position)
				if d < bestDist then
					bestDist = d
					bestPlayer = plr
					bestPos = hrp.Position
				end
			end

			if not (bestPlayer and bestPos) then
				continue
			end

			local toTarget = Vector3.new(bestPos.X - root.Position.X, 0, bestPos.Z - root.Position.Z)
			if toTarget.Magnitude > 0.15 then
				local step = math.min(combat.ChaseSpeed * dt, toTarget.Magnitude)
				local nextPos = root.Position + toTarget.Unit * step
				local fromCenter = Vector3.new(nextPos.X - isle.center.X, 0, nextPos.Z - isle.center.Z)
				local maxR = isle.size * 0.48
				if fromCenter.Magnitude > maxR then
					fromCenter = fromCenter.Unit * maxR
					nextPos = Vector3.new(isle.center.X + fromCenter.X, isle.topY + 2.5, isle.center.Z + fromCenter.Z)
				else
					nextPos = Vector3.new(nextPos.X, isle.topY + 2.5, nextPos.Z)
				end
				moveNpc(model, root, nextPos, bestPos)
			end

			runtime.attackAccum += dt
			if runtime.attackAccum >= combat.AttackCooldown and bestDist <= 3.8 then
				runtime.attackAccum = 0
				-- Route through ArmorService so worn armor reduces the hit.
				ArmorService.applyPlayerDamage(bestPlayer, combat.Damage)
			end
		else
			-- Passive islander: idle wander around their home within the village.
			runtime.wanderAccum -= dt
			if runtime.wanderAccum <= 0 or not runtime.targetPos then
				runtime.wanderAccum = 2.5 + math.random() * 3.5
				local wr = isle.size * 0.5 * vcfg.Passive.WanderRadiusFrac
				local a = math.random() * math.pi * 2
				local r = math.random() * wr
				runtime.targetPos = runtime.homePos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			end
			local target = runtime.targetPos :: Vector3
			local toTarget = Vector3.new(target.X - root.Position.X, 0, target.Z - root.Position.Z)
			if toTarget.Magnitude > 0.6 then
				local step = math.min(vcfg.Passive.WanderSpeed * dt, toTarget.Magnitude)
				local nextPos = root.Position + toTarget.Unit * step
				nextPos = Vector3.new(nextPos.X, isle.topY + 2.5, nextPos.Z)
				moveNpc(model, root, nextPos, target)
			end
		end
	end
end

function IslandService.clearCrew(code: string)
	IslandService._crewState[code] = nil
end

function IslandService.ensure(): Folder
	local folder = lobbyRoot():FindFirstChild("DriveIslands")
	if folder and folder:IsA("Folder") and #IslandService._islands >= #Config.Islands.Catalog then
		IslandService._folder = folder
		IslandService.paintTerrain()
		return folder
	end

	if not (folder and folder:IsA("Folder")) then
		folder = Instance.new("Folder")
		folder.Name = "DriveIslands"
		folder.Parent = lobbyRoot()
	end
	if IslandService._folder ~= folder then
		IslandService._folder = folder
		table.clear(IslandService._islands)
		table.clear(IslandService._byId)
		table.clear(IslandService._npcs)
		table.clear(IslandService._dockColliders)
		table.clear(IslandService._endlessQueued)
	end
	ensureOpeningPreviews(folder)

	local failures = {}
	for i, entry in Config.Islands.Catalog do
		if not IslandService._byId[entry.Id] then
			-- Clean up a model left half-built by an earlier attempt, then continue
			-- with every other catalog island even if this one has a bad feature.
			local partial = folder:FindFirstChild(`Isle_{entry.Id}`)
			if partial then
				partial:Destroy()
			end
			local ok, recordOrError = pcall(buildFlatIsland, entry, folder)
			if ok then
				local record = recordOrError :: IslandRecord
				table.insert(IslandService._islands, record)
				IslandService._byId[record.id] = record
				local previews = folder:FindFirstChild("OpeningPreviews")
				local preview = previews and previews:FindFirstChild(`Preview_{entry.Id}`)
				if preview then
					preview:Destroy()
				end
			else
				table.insert(failures, `{entry.Id}: {recordOrError}`)
				warn(`[SurviveAtSea] Island {entry.Id} failed; continuing with the remaining islands:`, recordOrError)
			end
		end
		-- These flats are huge (thousands of parts each). Yield between isles so a
		-- cold boot can't exhaust the script execution budget building them all at
		-- once. Successful islands remain in place if a later island needs a retry.
		if i < #Config.Islands.Catalog then
			task.wait()
		end
	end

	-- Register every loot model so drag / weld / pickup remotes can find them
	local LootPropService = require(script.Parent:WaitForChild("LootPropService"))
	for _, desc in folder:GetDescendants() do
		if desc:IsA("Model") and desc:GetAttribute("IsLootProp") == true then
			LootPropService.registerExisting(desc)
		end
	end

	IslandService.paintTerrain()
	if #failures > 0 then
		error(`{#failures} voyage island(s) still need retry: {table.concat(failures, " | ")}`)
	end
	print(`[SurviveAtSea] {#IslandService._islands} populated sculpted isles ready (irregular coasts, elevated ridges, beaches, jungle, villages/towns, loot, solid raft shorelines)`)
	return folder
end

function IslandService.start(
	toastRemote: RemoteEvent,
	getPartyCode: (Player) -> string?,
	getMemberUserIds: (string) -> { number }
)
	if IslandService._started or IslandService._starting then
		return
	end
	IslandService._starting = true
	IslandService._Toast = toastRemote
	IslandService._getPartyCode = getPartyCode
	IslandService._getMemberUserIds = getMemberUserIds

	-- Keep startup retryable.  A failed partial build must not leave the portal
	-- flow permanently waiting on an IslandService marked as started.
	local ok, err = pcall(IslandService.ensure)
	IslandService._starting = false
	if not ok then
		error(err)
	end
	IslandService._started = true

	-- The NPC AI pass is O(NPCs x players) and used to run every Heartbeat (60 Hz) even
	-- with nobody online. Run it on a fixed ~15 Hz tick, feeding it the accumulated dt so
	-- movement stays time-correct, and skip it entirely when no players are present.
	local npcAccum = 0
	local NPC_INTERVAL = 1 / 15
	local lockAccum = 0
	local endlessAccum = 0
	RunService.Heartbeat:Connect(function(dt)
		npcAccum += dt
		if npcAccum >= NPC_INTERVAL then
			local step = npcAccum
			npcAccum = 0
			if #Players:GetPlayers() > 0 then
				updateNpcs(step)
			end
		end

		lockAccum += dt
		if lockAccum >= 0.2 then
			lockAccum = 0
			updateVisitLockouts()
		end

		endlessAccum += dt
		if endlessAccum >= Config.Islands.Endless.PulseSeconds then
			endlessAccum = 0
			queueEndlessIslandsNearRafts()
		end
	end)
end

return IslandService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Items</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ArmorToolFactory</string>
            <string name="Source"><![CDATA[-- Builds armor world pickups (a looted piece resting on a small stand with a rarity tag)
-- and the parts that get welded onto a character when a piece is worn.
--
-- Worn armor is cosmetic geometry welded to the character's real body parts (Head /
-- Torso-or-UpperTorso / legs). ArmorService owns the equip logic + damage reduction; this
-- factory only produces geometry so the visuals stay in one place.

local Armor = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Armor"))

local ArmorToolFactory = {}

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "ArmorPart"
	p.Anchored = if props.Anchored == nil then false else props.Anchored
	p.CanCollide = false
	p.CanQuery = if props.CanQuery == nil then true else props.CanQuery
	p.CanTouch = false
	p.Massless = true
	p.Material = props.Material or Enum.Material.Metal
	p.Color = props.Color or Color3.fromRGB(150, 156, 164)
	p.Size = props.Size or Vector3.new(1, 1, 1)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	p.Parent = props.Parent
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

-- Find the best anchor part on a character for each slot, tolerant of R6 and R15 rigs.
local function anchorForSlot(character: Model, slot: string): BasePart?
	if slot == "Head" then
		local head = character:FindFirstChild("Head")
		return if head and head:IsA("BasePart") then head else nil
	elseif slot == "Body" then
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		return if torso and torso:IsA("BasePart") then torso else nil
	elseif slot == "Legs" then
		-- Prefer a centred hip/torso anchor so the wrap sits at the waist, not on one leg.
		local leg = character:FindFirstChild("LowerTorso")
			or character:FindFirstChild("Torso")
			or character:FindFirstChild("LeftUpperLeg")
			or character:FindFirstChild("Left Leg")
		return if leg and leg:IsA("BasePart") then leg else nil
	end
	return nil
end

-- === Worn geometry per slot ==============================================

local function buildHeadPiece(folder: Folder, anchor: BasePart, def: { [string]: any })
	local shell = makePart({
		Name = "Helm",
		Parent = folder,
		Size = anchor.Size * Vector3.new(1.16, 0.78, 1.16),
		Color = def.Color,
		Material = def.Material,
		CFrame = anchor.CFrame * CFrame.new(0, 0.18, 0),
	})
	weld(anchor, shell)
	-- Iron/plate pieces get a nose guard so metal helms read differently from cloth hoods.
	if def.Material == Enum.Material.Metal then
		local guard = makePart({
			Name = "NoseGuard",
			Parent = folder,
			Size = Vector3.new(0.18, 0.7, 0.2),
			Color = def.Color,
			Material = def.Material,
			CFrame = anchor.CFrame * CFrame.new(0, 0.02, -anchor.Size.Z * 0.55),
		})
		weld(anchor, guard)
	end
end

local function buildBodyPiece(folder: Folder, anchor: BasePart, def: { [string]: any })
	local plate = makePart({
		Name = "Chestplate",
		Parent = folder,
		Size = anchor.Size * Vector3.new(1.14, 1.02, 1.2),
		Color = def.Color,
		Material = def.Material,
		CFrame = anchor.CFrame,
	})
	weld(anchor, plate)
	-- Pauldrons for metal body armor so it reads as heavy plate.
	if def.Material == Enum.Material.Metal then
		for i = -1, 1, 2 do
			local pauldron = makePart({
				Name = "Pauldron",
				Parent = folder,
				Size = Vector3.new(anchor.Size.X * 0.34, anchor.Size.Y * 0.34, anchor.Size.Z * 0.9),
				Color = def.Color,
				Material = def.Material,
				Shape = Enum.PartType.Ball,
				CFrame = anchor.CFrame * CFrame.new(i * anchor.Size.X * 0.62, anchor.Size.Y * 0.42, 0),
			})
			weld(anchor, pauldron)
		end
	end
end

local function buildLegsPiece(folder: Folder, anchor: BasePart, def: { [string]: any })
	-- A belt/skirt wrap at the hips reads on both R6 and R15 without per-limb welds.
	local wrap = makePart({
		Name = "Greaves",
		Parent = folder,
		Size = Vector3.new(anchor.Size.X * 1.2, math.max(anchor.Size.Y * 0.5, 0.9), anchor.Size.Z * 1.2),
		Color = def.Color,
		Material = def.Material,
		CFrame = anchor.CFrame * CFrame.new(0, -anchor.Size.Y * 0.2, 0),
	})
	weld(anchor, wrap)
end

-- Public: weld a piece's geometry onto a character. Returns the created Folder (parented
-- to the character) or nil if the character has no anchor for that slot yet.
function ArmorToolFactory.wearOnCharacter(character: Model, armorId: string): Folder?
	local def = Armor.get(armorId)
	if not def then
		return nil
	end
	local anchor = anchorForSlot(character, def.Slot)
	if not anchor then
		return nil
	end

	local folder = Instance.new("Folder")
	folder.Name = "Armor_" .. def.Slot
	folder:SetAttribute("ArmorId", armorId)
	folder.Parent = character

	if def.Slot == "Head" then
		buildHeadPiece(folder, anchor, def)
	elseif def.Slot == "Body" then
		buildBodyPiece(folder, anchor, def)
	else
		buildLegsPiece(folder, anchor, def)
	end

	return folder
end

-- Public: a world pickup — an anchored piece on a small stand with a rarity-coloured tag.
-- ArmorService attaches the "Wear" ProximityPrompt and handles the grant.
function ArmorToolFactory.createWorldPickup(parent: Instance, armorId: string, cf: CFrame): Model?
	local def = Armor.get(armorId)
	if not def then
		return nil
	end
	local rarity = Armor.rarityInfo(def.Rarity)

	local model = Instance.new("Model")
	model.Name = "ArmorPickup_" .. armorId
	model:SetAttribute("ArmorPickup", true)
	model:SetAttribute("ArmorId", armorId)
	model.Parent = parent

	local base = makePart({
		Name = "Primary",
		Parent = model,
		Anchored = true,
		Size = Vector3.new(2.4, 0.4, 1.4),
		Color = Color3.fromRGB(74, 52, 30),
		Material = Enum.Material.WoodPlanks,
		CFrame = cf,
	})
	model.PrimaryPart = base

	-- A simple floating display of the piece above the stand.
	local display = makePart({
		Name = "Display",
		Parent = model,
		Anchored = true,
		Size = if def.Slot == "Head" then Vector3.new(1.3, 1.1, 1.3)
			elseif def.Slot == "Legs" then Vector3.new(1.9, 1.0, 1.3)
			else Vector3.new(2.0, 2.0, 1.2),
		Color = def.Color,
		Material = def.Material,
		Shape = if def.Slot == "Head" then Enum.PartType.Ball else Enum.PartType.Block,
		CFrame = cf * CFrame.new(0, 1.7, 0),
	})
	if def.Slot == "Head" and def.Material == Enum.Material.Metal then
		local guard = makePart({
			Name = "DisplayGuard",
			Parent = model,
			Anchored = true,
			Size = Vector3.new(0.2, 0.8, 0.22),
			Color = def.Color,
			Material = def.Material,
			CFrame = display.CFrame * CFrame.new(0, -0.1, -0.7),
		})
		weld(display, guard)
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PickupTag"
	billboard.Size = UDim2.fromOffset(172, 44)
	billboard.StudsOffset = Vector3.new(0, 3.0, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 90
	billboard.Adornee = base
	billboard.Parent = base

	local tag = Instance.new("TextLabel")
	tag.BackgroundTransparency = 0.32
	tag.BackgroundColor3 = Color3.fromRGB(18, 30, 40)
	tag.Size = UDim2.fromScale(1, 1)
	tag.Font = Enum.Font.GothamBold
	tag.TextScaled = true
	tag.TextColor3 = Color3.fromRGB(245, 248, 250)
	tag.Text = def.Name
	tag.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = tag
	local stroke = Instance.new("UIStroke")
	stroke.Color = rarity.Color
	stroke.Thickness = 2.5
	stroke.Parent = tag
	local tier = Instance.new("TextLabel")
	tier.Name = "Tier"
	tier.BackgroundTransparency = 1
	tier.Size = UDim2.new(1, 0, 0.32, 0)
	tier.Position = UDim2.fromScale(0, 0.02)
	tier.Font = Enum.Font.GothamBold
	tier.TextScaled = true
	tier.TextColor3 = rarity.Color
	tier.Text = `{rarity.Name} Armor`
	tier.Parent = tag

	local glow = Instance.new("PointLight")
	glow.Color = rarity.Color
	glow.Brightness = if (def.Rarity or 1) >= 4 then 2.2 else 1.1
	glow.Range = if (def.Rarity or 1) >= 4 then 16 else 10
	glow.Parent = base

	return model
end

return ArmorToolFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ClubToolFactory</string>
            <string name="Source"><![CDATA[-- Builds a realistic wooden starter Club Tool.
-- CanBeDropped = true so default backpack drop works (Backspace / Xbox X / mobile drop).

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local ClubToolFactory = {}

local WOOD = Color3.fromRGB(118, 82, 48)
local WOOD_DARK = Color3.fromRGB(78, 52, 30)
local WOOD_LIGHT = Color3.fromRGB(148, 108, 68)
local BARK = Color3.fromRGB(62, 44, 28)
local GRIP_WRAP = Color3.fromRGB(74, 48, 30) -- dark leather binding
local IRON = Color3.fromRGB(96, 100, 108)
local STONE_SPIKE = Color3.fromRGB(206, 200, 186)

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function part(props: {
	Name: string,
	Parent: Instance,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
}): Part
	local p = Instance.new("Part")
	p.Name = props.Name
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = true
	p.CanTouch = false
	p.Massless = true
	p.Material = props.Material or Enum.Material.Wood
	p.Color = props.Color
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = true
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

-- Handle is a short block (Roblox grip convention). Visual shaft + head weld to it.
-- Club extends +Y from the grip toward a heavy striking head.
function ClubToolFactory.create(): Tool
	local tool = Instance.new("Tool")
	tool.Name = Config.Club.ToolName
	tool.ToolTip = "Wooden club — RMB / RT / tap to swing"
	tool.RequiresHandle = true
	tool.CanBeDropped = true
	tool.ManualActivationOnly = true -- custom melee input owns activation
	tool.Enabled = true
	tool:SetAttribute("ItemId", "StarterClub")
	tool:SetAttribute("MeleeWeapon", true)
	tool:SetAttribute("Damage", Config.Club.Damage)
	-- Slight forward/down hold so the club reads naturally in-hand
	tool.Grip = CFrame.new(0, -0.2, -0.15) * CFrame.Angles(math.rad(15), 0, math.rad(10))

	local handle = part({
		Name = "Handle",
		Parent = tool,
		Size = Vector3.new(0.32, 1.05, 0.32),
		CFrame = CFrame.new(),
		Color = GRIP_WRAP,
		Material = Enum.Material.Fabric, -- wrapped leather grip
	})

	-- Leather grip wraps (axis along X by default → rotate to run along grip Y)
	for i = 0, 2 do
		local ring = part({
			Name = `GripRing_{i}`,
			Parent = tool,
			Size = Vector3.new(0.16, 0.42, 0.42),
			CFrame = CFrame.new(0, -0.32 + i * 0.26, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = GRIP_WRAP,
			Material = Enum.Material.Fabric,
			Shape = Enum.PartType.Cylinder,
		})
		weld(handle, ring)
	end

	local shaft = part({
		Name = "Shaft",
		Parent = tool,
		-- Cylinder length is Size.X; rotated 90° about Z so it runs along grip +Y
		Size = Vector3.new(2.35, 0.34, 0.34),
		CFrame = CFrame.new(0, 1.55, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
	})
	weld(handle, shaft)

	local midKnot = part({
		Name = "MidKnot",
		Parent = tool,
		Size = Vector3.new(0.3, 0.48, 0.48),
		CFrame = CFrame.new(0, 2.35, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = WOOD_LIGHT,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
	})
	weld(handle, midKnot)

	local headCore = part({
		Name = "ClubHead",
		Parent = tool,
		Size = Vector3.new(1.35, 1.55, 1.35),
		CFrame = CFrame.new(0, 3.55, 0),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Ball,
	})
	weld(handle, headCore)

	local headCap = part({
		Name = "ClubHeadCap",
		Parent = tool,
		Size = Vector3.new(1.05, 1.05, 1.05),
		CFrame = CFrame.new(0, 4.15, 0),
		Color = BARK,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Ball,
	})
	weld(handle, headCap)

	-- Iron reinforcement bands hammered around the striking head — reads as a real,
	-- battle-worn weapon rather than a plain stick.
	for i, y in { 3.15, 3.95 } do
		local band = part({
			Name = `IronBand_{i}`,
			Parent = tool,
			Size = Vector3.new(0.22, 1.5, 1.5),
			CFrame = CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = IRON,
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Cylinder,
		})
		weld(handle, band)
	end

	-- A ring of short stone spikes driven into the head for extra bite. Each is a cylinder
	-- (length along local X) rotated about Y so its point juts radially outward.
	local headY = 3.55
	for i = 0, 5 do
		local a = i * (math.pi / 3)
		local spike = part({
			Name = `Spike_{i}`,
			Parent = tool,
			Size = Vector3.new(0.9, 0.26, 0.26),
			CFrame = CFrame.new(math.cos(a) * 1.0, headY, math.sin(a) * 1.0)
				* CFrame.Angles(0, -a, 0),
			Color = STONE_SPIKE,
			Material = Enum.Material.Slate,
			Shape = Enum.PartType.Cylinder,
		})
		weld(handle, spike)
	end

	local nubOffsets = {
		CFrame.new(0.55, 3.45, 0.2),
		CFrame.new(-0.5, 3.65, -0.25),
		CFrame.new(0.15, 3.3, -0.55),
		CFrame.new(-0.2, 3.85, 0.5),
	}
	for i, cf in nubOffsets do
		local nub = part({
			Name = `BarkNub_{i}`,
			Parent = tool,
			Size = Vector3.new(0.35, 0.4, 0.35),
			CFrame = cf,
			Color = BARK,
			Material = Enum.Material.Wood,
			Shape = Enum.PartType.Ball,
		})
		weld(handle, nub)
	end

	local pommel = part({
		Name = "Pommel",
		Parent = tool,
		Size = Vector3.new(0.5, 0.35, 0.5),
		CFrame = CFrame.new(0, -0.7, 0),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Ball,
	})
	weld(handle, pommel)

	return tool
end

return ClubToolFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">LootPropFactory</string>
            <string name="Source"><![CDATA[-- Builds world loot props (walls, torches, planks) and backpack Tools from the same kinds.
-- World props stay Anchored so raft shiftModel / island flats stay consistent.

local HttpService = game:GetService("HttpService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local LootPropFactory = {}

export type LootKind = "Wall" | "Torch" | "Plank" | "Crate" | "Bed"

local BED_FRAME = Color3.fromRGB(96, 66, 40)
local BED_SHEET = Color3.fromRGB(206, 198, 176)
local BED_PILLOW = Color3.fromRGB(224, 220, 206)

local WOOD = Color3.fromRGB(128, 92, 58)
local WOOD_DARK = Color3.fromRGB(78, 52, 30)
local WOOD_LIGHT = Color3.fromRGB(148, 108, 68)
local TORCH_HANDLE = Color3.fromRGB(92, 64, 38)
local TORCH_WRAP = Color3.fromRGB(160, 120, 70)

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "PropPart"
	p.Anchored = if props.Anchored == nil then true else props.Anchored
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.CanQuery = if props.CanQuery == nil then true else props.CanQuery
	p.CanTouch = if props.CanTouch == nil then false else props.CanTouch
	p.Massless = props.Massless == true
	p.Material = props.Material or Enum.Material.Wood
	p.Color = props.Color or WOOD
	p.Size = props.Size or Vector3.new(1, 1, 1)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	-- Loot props (walls, planks, crates, beds, torches) are numerous — especially the
	-- 5 salvage walls per village house. Default them to no shadow; sun/terrain shadows
	-- via GlobalShadows still apply.
	p.CastShadow = props.CastShadow == true
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function tagProp(model: Model, kind: LootKind, propId: string?)
	local id = propId or HttpService:GenerateGUID(false)
	model:SetAttribute("IsLootProp", true)
	model:SetAttribute("LootKind", kind)
	model:SetAttribute("PropId", id)
	model:SetAttribute("Draggable", true)
	model:SetAttribute("Weldable", true)
	model:SetAttribute("Welded", false)
	model:SetAttribute("GrabbedBy", 0)
	return id
end

-- Tag an externally-built model (e.g. the merchant NPC) as a draggable / weldable loot
-- prop so it flows through the existing drag / weld system. `opts.noPickup` blocks the
-- backpack pickup prompt (you can't pocket a person).
function LootPropFactory.tagAsProp(model: Model, kind: string, opts: { [string]: any }?): string
	local id = (opts and opts.propId) or HttpService:GenerateGUID(false)
	model:SetAttribute("IsLootProp", true)
	model:SetAttribute("LootKind", kind)
	model:SetAttribute("PropId", id)
	model:SetAttribute("Draggable", true)
	model:SetAttribute("Weldable", true)
	model:SetAttribute("Welded", false)
	model:SetAttribute("GrabbedBy", 0)
	if opts and opts.noPickup then
		model:SetAttribute("NoPickup", true)
	end
	return id
end

local function attachFlame(holder: BasePart)
	-- Classic Roblox Fire + warm PointLight for night sailing
	local fire = Instance.new("Fire")
	fire.Name = "TorchFlame"
	fire.Size = 3.2
	fire.Heat = 8
	fire.Color = Color3.fromRGB(255, 140, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 120)
	fire.Parent = holder

	local light = Instance.new("PointLight")
	light.Name = "TorchLight"
	light.Brightness = 2.4
	light.Range = 24
	light.Color = Color3.fromRGB(255, 186, 90)
	-- Shadow-casting dynamic lights are extremely expensive and torches are everywhere
	-- (houses, village posts, island scatter). Keep the warm glow, drop the shadow pass.
	light.Shadows = false
	light.Parent = holder

	return fire, light
end

function LootPropFactory.createTorchWorld(parent: Instance, cf: CFrame, propId: string?): Model
	local model = Instance.new("Model")
	model.Name = "LootTorch"
	model.Parent = parent

	local pole = makePart({
		Name = "Primary",
		Parent = model,
		Size = Vector3.new(0.45, 3.4, 0.45),
		CFrame = cf,
		Color = TORCH_HANDLE,
		Material = Enum.Material.Wood,
	})
	model.PrimaryPart = pole

	makePart({
		Name = "Wrap",
		Parent = model,
		Size = Vector3.new(0.7, 0.55, 0.7),
		CFrame = cf * CFrame.new(0, 1.35, 0),
		Color = TORCH_WRAP,
		Material = Enum.Material.Fabric,
	})

	local head = makePart({
		Name = "FlameHolder",
		Parent = model,
		Size = Vector3.new(0.55, 0.45, 0.55),
		CFrame = cf * CFrame.new(0, 1.75, 0),
		Color = Color3.fromRGB(48, 36, 28),
		Material = Enum.Material.Slate,
	})
	attachFlame(head)

	tagProp(model, "Torch", propId)
	model:SetAttribute("ProvidesLight", true)
	return model
end

function LootPropFactory.createWallWorld(parent: Instance, size: Vector3, cf: CFrame, propId: string?): Model
	local model = Instance.new("Model")
	model.Name = "LootWall"
	model.Parent = parent

	local wall = makePart({
		Name = "Primary",
		Parent = model,
		Size = size,
		CFrame = cf,
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	model.PrimaryPart = wall

	-- Subtle plank seams so walls read as salvage timber
	local seamCount = math.clamp(math.floor(size.Y / 2.2), 1, 4)
	for i = 1, seamCount do
		local t = (i / (seamCount + 1)) - 0.5
		makePart({
			Name = `Seam_{i}`,
			Parent = model,
			Size = Vector3.new(size.X * 0.92, 0.12, size.Z + 0.08),
			CFrame = cf * CFrame.new(0, t * size.Y, 0),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end

	tagProp(model, "Wall", propId)
	return model
end

function LootPropFactory.createPlankWorld(parent: Instance, cf: CFrame, propId: string?): Model
	local model = Instance.new("Model")
	model.Name = "LootPlank"
	model.Parent = parent

	local plank = makePart({
		Name = "Primary",
		Parent = model,
		Size = Vector3.new(6.5, 0.45, 1.4),
		CFrame = cf,
		Color = WOOD_LIGHT,
		Material = Enum.Material.WoodPlanks,
	})
	model.PrimaryPart = plank
	tagProp(model, "Plank", propId)
	return model
end

function LootPropFactory.createCrateWorld(parent: Instance, cf: CFrame, propId: string?): Model
	local model = Instance.new("Model")
	model.Name = "LootCrate"
	model.Parent = parent

	local box = makePart({
		Name = "Primary",
		Parent = model,
		Size = Vector3.new(2.4, 2.2, 2.4),
		CFrame = cf,
		Color = Color3.fromRGB(110, 78, 48),
		Material = Enum.Material.Wood,
	})
	model.PrimaryPart = box
	makePart({
		Name = "Lid",
		Parent = model,
		Size = Vector3.new(2.55, 0.35, 2.55),
		CFrame = cf * CFrame.new(0, 1.25, 0),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
	})
	tagProp(model, "Crate", propId)
	return model
end

function LootPropFactory.createBedWorld(parent: Instance, cf: CFrame, propId: string?): Model
	local model = Instance.new("Model")
	model.Name = "LootBed"
	model.Parent = parent

	local frame = makePart({
		Name = "Primary",
		Parent = model,
		Size = Vector3.new(3.4, 0.7, 6.4),
		CFrame = cf,
		Color = BED_FRAME,
		Material = Enum.Material.Wood,
	})
	model.PrimaryPart = frame

	makePart({
		Name = "Mattress",
		Parent = model,
		Size = Vector3.new(3.1, 0.6, 5.6),
		CFrame = cf * CFrame.new(0, 0.6, 0),
		Color = BED_SHEET,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})
	makePart({
		Name = "Pillow",
		Parent = model,
		Size = Vector3.new(2.6, 0.5, 1.2),
		CFrame = cf * CFrame.new(0, 1.0, -2.2),
		Color = BED_PILLOW,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})
	makePart({
		Name = "Headboard",
		Parent = model,
		Size = Vector3.new(3.4, 1.6, 0.4),
		CFrame = cf * CFrame.new(0, 0.8, -3.1),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	tagProp(model, "Bed", propId)
	return model
end

local function toolPart(props: { [string]: any }): Part
	props.Anchored = false
	props.CanCollide = false
	props.Massless = true
	return makePart(props)
end

function LootPropFactory.createTool(kind: LootKind): Tool
	local tool = Instance.new("Tool")
	tool.RequiresHandle = true
	tool.CanBeDropped = true
	tool.ManualActivationOnly = true
	tool:SetAttribute("IsLootTool", true)
	tool:SetAttribute("LootKind", kind)
	tool:SetAttribute("ItemId", `Loot_{kind}`)

	if kind == "Torch" then
		tool.Name = "Torch"
		tool.ToolTip = "Flaming torch — place / weld for light"
		tool.Grip = CFrame.new(0, -0.4, -0.1) * CFrame.Angles(math.rad(20), 0, 0)

		local handle = toolPart({
			Name = "Handle",
			Parent = tool,
			Size = Vector3.new(0.35, 1.2, 0.35),
			CFrame = CFrame.new(),
			Color = TORCH_HANDLE,
			Material = Enum.Material.Wood,
		})
		local head = toolPart({
			Name = "FlameHolder",
			Parent = tool,
			Size = Vector3.new(0.45, 0.4, 0.45),
			CFrame = CFrame.new(0, 0.85, 0),
			Color = Color3.fromRGB(48, 36, 28),
			Material = Enum.Material.Slate,
		})
		weld(handle, head)
		attachFlame(head)
	elseif kind == "Wall" then
		tool.Name = "Wall Panel"
		tool.ToolTip = "Salvaged wall — drag onto your raft for a shelter"
		tool.Grip = CFrame.new(0, -0.5, 1.2) * CFrame.Angles(0, math.rad(90), 0)
		local handle = toolPart({
			Name = "Handle",
			Parent = tool,
			Size = Vector3.new(0.4, 1.1, 0.4),
			CFrame = CFrame.new(),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
		local panel = toolPart({
			Name = "Panel",
			Parent = tool,
			Size = Vector3.new(3.2, 2.6, 0.35),
			CFrame = CFrame.new(0, 1.4, -0.2),
			Color = WOOD,
			Material = Enum.Material.Wood,
		})
		weld(handle, panel)
	elseif kind == "Plank" then
		tool.Name = "Plank"
		tool.ToolTip = "Timber plank — build with it on your raft"
		tool.Grip = CFrame.new(0, -0.2, 0.6)
		local handle = toolPart({
			Name = "Handle",
			Parent = tool,
			Size = Vector3.new(0.35, 0.9, 0.35),
			CFrame = CFrame.new(),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
		local plank = toolPart({
			Name = "Plank",
			Parent = tool,
			Size = Vector3.new(4.2, 0.3, 0.9),
			CFrame = CFrame.new(0, 0.6, -0.4),
			Color = WOOD_LIGHT,
			Material = Enum.Material.WoodPlanks,
		})
		weld(handle, plank)
	elseif kind == "Bed" then
		tool.Name = "Bed Roll"
		tool.ToolTip = "Villager bed — drag / place it on your raft to rest"
		tool.Grip = CFrame.new(0, -0.4, 0)
		local handle = toolPart({
			Name = "Handle",
			Parent = tool,
			Size = Vector3.new(1.4, 0.5, 2.6),
			CFrame = CFrame.new(),
			Color = BED_FRAME,
			Material = Enum.Material.Wood,
		})
		local roll = toolPart({
			Name = "Roll",
			Parent = tool,
			Size = Vector3.new(1.3, 0.5, 2.4),
			CFrame = CFrame.new(0, 0.5, 0),
			Color = BED_SHEET,
			Material = Enum.Material.Fabric,
		})
		weld(handle, roll)
	else
		tool.Name = "Crate"
		tool.ToolTip = "Salvage crate"
		tool.Grip = CFrame.new(0, -0.6, -0.4)
		local handle = toolPart({
			Name = "Handle",
			Parent = tool,
			Size = Vector3.new(0.4, 0.8, 0.4),
			CFrame = CFrame.new(),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
		local box = toolPart({
			Name = "Box",
			Parent = tool,
			Size = Vector3.new(1.6, 1.4, 1.6),
			CFrame = CFrame.new(0, 1.0, 0),
			Color = Color3.fromRGB(110, 78, 48),
			Material = Enum.Material.Wood,
		})
		weld(handle, box)
	end

	return tool
end

function LootPropFactory.spawnFromKind(kind: LootKind, parent: Instance, cf: CFrame, propId: string?): Model
	if kind == "Torch" then
		return LootPropFactory.createTorchWorld(parent, cf, propId)
	elseif kind == "Wall" then
		return LootPropFactory.createWallWorld(parent, Vector3.new(8, 7, 0.7), cf, propId)
	elseif kind == "Plank" then
		return LootPropFactory.createPlankWorld(parent, cf, propId)
	elseif kind == "Bed" then
		return LootPropFactory.createBedWorld(parent, cf, propId)
	end
	return LootPropFactory.createCrateWorld(parent, cf, propId)
end

function LootPropFactory.attachPickupPrompt(model: Model)
	-- Some draggable props (the merchant) can never be pocketed into a backpack.
	if model:GetAttribute("NoPickup") == true then
		return
	end
	local primary = model.PrimaryPart
	if not primary then
		return
	end
	local existing = primary:FindFirstChild("LootPickupPrompt")
	if existing then
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LootPickupPrompt"
	prompt.ActionText = "Pick Up"
	prompt.ObjectText = model.Name:gsub("Loot", ""):gsub("^%s+", "")
	local kind = model:GetAttribute("LootKind")
	if typeof(kind) == "string" then
		prompt.ObjectText = kind
	end
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = Config.Loot.PickupPromptDistance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Parent = primary
end

function LootPropFactory.attachWeldPrompt(model: Model)
	local primary = model.PrimaryPart
	if not primary then
		return
	end
	local existing = primary:FindFirstChild("LootWeldPrompt")
	if existing then
		existing:Destroy()
	end

	local welded = model:GetAttribute("Welded") == true
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LootWeldPrompt"
	prompt.ActionText = if welded then "Unweld" else "Weld"
	prompt.ObjectText = if welded then "Detach from raft" else "Attach to raft"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.X
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.UIOffset = Vector2.new(0, -28)
	prompt.Parent = primary
end

return LootPropFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">NpcFactory</string>
            <string name="Source"><![CDATA[-- Builds island NPC models: tribal villagers (passive blue-eyed / aggressive red-eyed)
-- and the blue-hatted merchant. All NPC parts are Anchored — the island AI drives them
-- by CFrame (matching the existing pirate movement), so no physics humanoids to fight.
--
-- Attributes contract (read by IslandService AI / combat services):
--   IsNpc=true, NpcKind="villager"|"merchant", IslandId, Hostile(bool)
--   Villagers carry a Humanoid so they can take damage / die.
--   The merchant has NO Humanoid (never targeted by combat) and is tagged as a loot prop
--   elsewhere so it can be dragged / welded to a raft.

local NpcFactory = {}

local SKIN = Color3.fromRGB(196, 150, 108)
local SKIN_DARK = Color3.fromRGB(150, 108, 74)
local TRIBAL_TAN = Color3.fromRGB(150, 120, 80)
local TRIBAL_RED = Color3.fromRGB(150, 58, 46) -- aggressive war paint / gear
local WRAP_BROWN = Color3.fromRGB(96, 70, 44)
local MERCHANT_BLUE = Color3.fromRGB(46, 92, 168)
local MERCHANT_BLUE_DEEP = Color3.fromRGB(30, 62, 128)
local EYE_BLUE = Color3.fromRGB(90, 180, 255)
local EYE_RED = Color3.fromRGB(255, 60, 50)

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "NpcPart"
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then false else props.CanCollide
	p.CanQuery = if props.CanQuery == nil then true else props.CanQuery
	p.Material = props.Material or Enum.Material.Fabric
	p.Color = props.Color or SKIN
	p.Size = props.Size or Vector3.new(1, 1, 1)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	p.Parent = props.Parent
	return p
end

local function billboardTag(root: BasePart, text: string, color: Color3)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NpcTag"
	billboard.Size = UDim2.fromOffset(96, 24)
	billboard.StudsOffset = Vector3.new(0, 3.4, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 100
	billboard.Adornee = root
	billboard.Parent = root

	local tag = Instance.new("TextLabel")
	tag.Name = "Label"
	tag.BackgroundTransparency = 1
	tag.Size = UDim2.fromScale(1, 1)
	tag.Font = Enum.Font.GothamBold
	tag.TextScaled = true
	tag.TextColor3 = color
	tag.Text = text
	tag.Parent = billboard
	return tag
end

-- Shared humanoid-ish body. Returns the model + head reference so callers can restyle eyes.
local function buildBody(parent: Instance, cf: CFrame, gearColor: Color3): (Model, BasePart, BasePart)
	local model = Instance.new("Model")
	model.Parent = parent

	local root = makePart({
		Name = "HumanoidRootPart",
		Parent = model,
		Size = Vector3.new(2, 2, 1),
		CFrame = cf,
		Color = gearColor,
		CanCollide = true,
	})
	model.PrimaryPart = root

	makePart({
		Name = "Torso",
		Parent = model,
		Size = Vector3.new(2.1, 2.1, 1.1),
		CFrame = root.CFrame * CFrame.new(0, 0.1, 0),
		Color = gearColor,
	})
	-- Tribal skirt / loincloth (sits at the hips over the tops of the legs)
	makePart({
		Name = "Skirt",
		Parent = model,
		Size = Vector3.new(2.2, 1.1, 1.2),
		CFrame = root.CFrame * CFrame.new(0, -0.75, 0),
		Color = WRAP_BROWN,
	})
	-- Arms
	for i = -1, 1, 2 do
		makePart({
			Name = "Arm",
			Parent = model,
			Size = Vector3.new(0.7, 2.0, 0.7),
			CFrame = root.CFrame * CFrame.new(i * 1.45, 0.05, 0),
			Color = SKIN,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	-- Legs. Positioned so the feet bottom sits 2.5 studs below the root — with the
	-- island spawn placing the root at topY + 2.5, that plants the feet exactly on
	-- the ground instead of sinking the villager into it.
	for i = -1, 1, 2 do
		makePart({
			Name = "Leg",
			Parent = model,
			Size = Vector3.new(0.9, 2.0, 0.95),
			CFrame = root.CFrame * CFrame.new(i * 0.5, -1.5, 0),
			Color = SKIN_DARK,
			Material = Enum.Material.SmoothPlastic,
		})
	end

	-- Head top lands 2.5 studs above the root, giving the rig an overall height of
	-- ~5 studs (feet at -2.5, head top at +2.5): the same regular Roblox character
	-- height that PlayerAppearance.server.luau enforces for every player.
	local head = makePart({
		Name = "Head",
		Parent = model,
		Size = Vector3.new(1.25, 1.25, 1.25),
		CFrame = root.CFrame * CFrame.new(0, 1.875, 0),
		Color = SKIN,
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Ball,
	})
	return model, root, head
end

local function attachEyes(model: Model, head: BasePart, eyeColor: Color3)
	-- Remove any prior eyes (used when flipping passive -> hostile)
	for _, d in model:GetChildren() do
		if d.Name == "Eye" then
			d:Destroy()
		end
	end
	for i = -1, 1, 2 do
		local eye = makePart({
			Name = "Eye",
			Parent = model,
			Size = Vector3.new(0.22, 0.22, 0.14),
			CFrame = head.CFrame * CFrame.new(i * 0.28, 0.08, -0.6),
			Color = eyeColor,
			Material = Enum.Material.Neon,
			CastShadow = false,
		})
		local light = Instance.new("PointLight")
		light.Brightness = 0.6
		light.Range = 5
		light.Color = eyeColor
		light.Parent = eye
	end
end

-- opts: { hostile: boolean, scavenger: boolean?, islandId: string, name: string?, health: number }
function NpcFactory.createVillager(parent: Instance, cf: CFrame, opts: { [string]: any }): (Model, Humanoid)
	local hostile = opts.hostile == true
	local gearColor = if hostile then TRIBAL_RED else TRIBAL_TAN
	local model, root, head = buildBody(parent, cf, gearColor)
	model.Name = if opts.scavenger then "Scavenger" elseif hostile then "Warrior" else "Villager"
	model:SetAttribute("IsNpc", true)
	model:SetAttribute("NpcKind", "villager")
	model:SetAttribute("Hostile", hostile)
	if opts.islandId then
		model:SetAttribute("IslandId", opts.islandId)
	end
	-- Legacy flag so existing gun/ melee "IsPirate" checks still hit hostile islanders.
	if hostile then
		model:SetAttribute("IsPirate", true)
	end

	-- War paint stripe for hostile warriors so they read differently at a glance.
	if hostile and not opts.scavenger then
		makePart({
			Name = "WarPaint",
			Parent = model,
			Size = Vector3.new(1.3, 0.18, 1.3),
			CFrame = head.CFrame * CFrame.new(0, 0.1, 0),
			Color = Color3.fromRGB(210, 60, 50),
			Material = Enum.Material.SmoothPlastic,
		})
	end

	attachEyes(model, head, if hostile then EYE_RED else EYE_BLUE)

	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.MaxHealth = opts.health or 55
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = 0
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Subject
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	humanoid.Parent = model

	local tagColor = if hostile then EYE_RED else EYE_BLUE
	local tagText = if opts.scavenger then "Scavenger" elseif hostile then "Warrior" else "Villager"
	billboardTag(root, tagText, tagColor)

	humanoid.Died:Connect(function()
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.CanCollide = false
			end
		end
		task.delay(3, function()
			if model.Parent then
				model:Destroy()
			end
		end)
	end)

	return model, humanoid
end

-- Turn a passive villager hostile (defend the isle when attacked): red eyes + war gear.
function NpcFactory.makeHostileLook(model: Model)
	local head = model:FindFirstChild("Head")
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and (p.Name == "Torso" or p.Name == "HumanoidRootPart") then
			p.Color = TRIBAL_RED
		end
	end
	if head and head:IsA("BasePart") then
		attachEyes(model, head, EYE_RED)
	end
	local tag = model:FindFirstChild("NpcTag")
	local label = tag and tag:FindFirstChild("Label")
	if label and label:IsA("TextLabel") then
		label.Text = "Defender"
		label.TextColor3 = EYE_RED
	end
end

-- The blue-hatted tribal merchant. Never hostile, no Humanoid combat.
function NpcFactory.createMerchant(parent: Instance, cf: CFrame, opts: { [string]: any }?): (Model, BasePart)
	local model, root, head = buildBody(parent, cf, MERCHANT_BLUE)
	model.Name = "Merchant"
	model:SetAttribute("IsNpc", true)
	model:SetAttribute("NpcKind", "merchant")
	model:SetAttribute("Hostile", false)
	if opts and opts.islandId then
		model:SetAttribute("IslandId", opts.islandId)
	end

	-- Blue tribal sash across the torso
	makePart({
		Name = "Sash",
		Parent = model,
		Size = Vector3.new(2.2, 0.5, 1.2),
		CFrame = root.CFrame * CFrame.new(0, 0.4, 0) * CFrame.Angles(0, 0, math.rad(20)),
		Color = MERCHANT_BLUE_DEEP,
	})

	-- Distinctive blue hat (brim + crown) so the merchant is unmistakable.
	makePart({
		Name = "HatBrim",
		Parent = model,
		Size = Vector3.new(1.9, 0.18, 1.9),
		CFrame = head.CFrame * CFrame.new(0, 0.62, 0),
		Color = MERCHANT_BLUE,
		Material = Enum.Material.Fabric,
		Shape = Enum.PartType.Cylinder,
	})
	makePart({
		Name = "HatCrown",
		Parent = model,
		Size = Vector3.new(1.15, 0.9, 1.15),
		CFrame = head.CFrame * CFrame.new(0, 1.0, 0),
		Color = MERCHANT_BLUE_DEEP,
		Material = Enum.Material.Fabric,
	})

	-- Friendly blue eyes
	attachEyes(model, head, EYE_BLUE)

	billboardTag(root, "Merchant", Color3.fromRGB(120, 190, 255))

	return model, root
end

return NpcFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WeaponToolFactory</string>
            <string name="Source"><![CDATA[-- Builds weapon Tools (melee + ranged) and their world-loot pickup models from the
-- shared Weapons catalog. One factory so the tool a player picks up is always the same
-- one the merchant sells and the loot roller drops.
--
-- Tool attributes contract (read by MeleeService / WeaponService / client controllers):
--   Melee : MeleeWeapon=true, WeaponId, Damage, Range, HitRadius, HitWindow, SwingDuration
--   Ranged: Ranged=true, WeaponId, Ammo, MagSize, Loaded (current chamber/mag count)

local Weapons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Weapons"))

local WeaponToolFactory = {}

local WOOD = Color3.fromRGB(96, 66, 40)
local WOOD_DARK = Color3.fromRGB(66, 44, 26)
local WOOD_LIGHT = Color3.fromRGB(150, 112, 70)
local METAL = Color3.fromRGB(96, 102, 110)
local METAL_DARK = Color3.fromRGB(48, 50, 56)
local BRASS = Color3.fromRGB(196, 156, 84)
local BONE = Color3.fromRGB(222, 214, 186)
local ROPE = Color3.fromRGB(158, 120, 72)
local BOWSTRING = Color3.fromRGB(232, 230, 214)

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "Part"
	p.Anchored = if props.Anchored == nil then false else props.Anchored
	p.CanCollide = if props.CanCollide == nil then false else props.CanCollide
	p.CanQuery = if props.CanQuery == nil then true else props.CanQuery
	p.CanTouch = false
	p.Massless = if props.Massless == nil then true else props.Massless
	p.Material = props.Material or Enum.Material.Wood
	p.Color = props.Color or WOOD
	p.Size = props.Size or Vector3.new(1, 1, 1)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	p.Parent = props.Parent
	return p
end

-- === Geometry builders (attached to a Tool via its Handle) ===============

local function buildClub(tool: Tool)
	-- Gnarled driftwood club: wrapped grip, tapering shaft, heavy knotted head with bark nubs.
	tool.Grip = CFrame.new(0, -0.2, -0.15) * CFrame.Angles(math.rad(15), 0, math.rad(10))

	local handle = part({
		Name = "Handle",
		Parent = tool,
		Size = Vector3.new(0.34, 1.05, 0.34),
		Color = Color3.fromRGB(96, 72, 42),
		Material = Enum.Material.Wood,
	})
	for i = 0, 2 do
		local ring = part({
			Name = `GripWrap_{i}`,
			Parent = tool,
			Size = Vector3.new(0.18, 0.42, 0.42),
			Color = ROPE,
			Material = Enum.Material.Fabric,
			Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(0, -0.32 + i * 0.26, 0) * CFrame.Angles(0, 0, math.rad(90)),
		})
		weld(handle, ring)
	end

	local shaft = part({
		Name = "Shaft",
		Parent = tool,
		Size = Vector3.new(2.35, 0.36, 0.36),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(0, 1.55, 0) * CFrame.Angles(0, 0, math.rad(90)),
	})
	weld(handle, shaft)

	local head = part({
		Name = "ClubHead",
		Parent = tool,
		Size = Vector3.new(1.4, 1.6, 1.4),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Ball,
		CFrame = CFrame.new(0, 3.55, 0),
	})
	weld(handle, head)

	local nubOffsets = {
		CFrame.new(0.58, 3.45, 0.22),
		CFrame.new(-0.52, 3.68, -0.26),
		CFrame.new(0.16, 3.3, -0.58),
		CFrame.new(-0.22, 3.9, 0.52),
	}
	for i, cf in nubOffsets do
		local nub = part({
			Name = `BarkNub_{i}`,
			Parent = tool,
			Size = Vector3.new(0.36, 0.42, 0.36),
			Color = Color3.fromRGB(62, 44, 28),
			Material = Enum.Material.Wood,
			Shape = Enum.PartType.Ball,
			CFrame = cf,
		})
		weld(handle, nub)
	end

	local pommel = part({
		Name = "Pommel",
		Parent = tool,
		Size = Vector3.new(0.5, 0.36, 0.5),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Ball,
		CFrame = CFrame.new(0, -0.7, 0),
	})
	weld(handle, pommel)
end

local function buildWarClub(tool: Tool)
	-- Heavier cousin of the club: a thick haft topped with a jagged stone head bristling
	-- with spikes and bound with iron bands. Reads clearly as an upgrade in the hand.
	local STONE = Color3.fromRGB(120, 122, 126)
	local STONE_LIGHT = Color3.fromRGB(198, 194, 182)
	local IRON = Color3.fromRGB(92, 96, 104)

	tool.Grip = CFrame.new(0, -0.2, -0.15) * CFrame.Angles(math.rad(15), 0, math.rad(10))

	local handle = part({
		Name = "Handle",
		Parent = tool,
		Size = Vector3.new(0.4, 1.15, 0.4),
		Color = Color3.fromRGB(70, 46, 28),
		Material = Enum.Material.Fabric, -- leather-wrapped grip
	})

	local shaft = part({
		Name = "Shaft",
		Parent = tool,
		Size = Vector3.new(2.7, 0.44, 0.44),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(0, 1.75, 0) * CFrame.Angles(0, 0, math.rad(90)),
	})
	weld(handle, shaft)

	-- Iron collar where the head meets the haft.
	local collar = part({
		Name = "Collar",
		Parent = tool,
		Size = Vector3.new(0.3, 0.9, 0.9),
		Color = IRON,
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(0, 3.0, 0) * CFrame.Angles(0, 0, math.rad(90)),
	})
	weld(handle, collar)

	-- Jagged stone head (a couple of overlapping tilted blocks so it looks rough-hewn).
	local head = part({
		Name = "StoneHead",
		Parent = tool,
		Size = Vector3.new(1.7, 1.8, 1.7),
		Color = STONE,
		Material = Enum.Material.Slate,
		CFrame = CFrame.new(0, 3.9, 0) * CFrame.Angles(math.rad(12), math.rad(20), math.rad(8)),
	})
	weld(handle, head)
	local shard = part({
		Name = "StoneShard",
		Parent = tool,
		Size = Vector3.new(1.2, 1.3, 1.2),
		Color = STONE_LIGHT,
		Material = Enum.Material.Slate,
		CFrame = CFrame.new(0.35, 4.25, -0.25) * CFrame.Angles(math.rad(-18), math.rad(40), math.rad(14)),
	})
	weld(handle, shard)

	-- Ring of long spikes radiating out of the head.
	for i = 0, 5 do
		local a = i * (math.pi / 3)
		local spike = part({
			Name = `Spike_{i}`,
			Parent = tool,
			Size = Vector3.new(1.3, 0.32, 0.32),
			Color = STONE_LIGHT,
			Material = Enum.Material.Slate,
			Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(math.cos(a) * 1.15, 3.9, math.sin(a) * 1.15) * CFrame.Angles(0, -a, 0),
		})
		weld(handle, spike)
	end
	-- A crowning spike on top.
	local crown = part({
		Name = "CrownSpike",
		Parent = tool,
		Size = Vector3.new(0.34, 1.3, 0.34),
		Color = STONE_LIGHT,
		Material = Enum.Material.Slate,
		CFrame = CFrame.new(0, 4.9, 0),
	})
	weld(handle, crown)
end

local function buildSpear(tool: Tool)
	tool.Grip = CFrame.new(0, -0.2, 0.4) * CFrame.Angles(math.rad(90), 0, 0)
	local handle = part({
		Name = "Handle",
		Parent = tool,
		Size = Vector3.new(0.28, 0.28, 6.2),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.Angles(0, math.rad(90), 0),
	})
	local tip = part({
		Name = "Tip",
		Parent = tool,
		Size = Vector3.new(0.5, 0.5, 1.5),
		Color = BONE,
		Material = Enum.Material.Slate,
		CFrame = CFrame.new(0, 0, -3.4),
	})
	weld(handle, tip)
	-- Barbs swept back from the point so the head reads as a bone fishing spear.
	for i = -1, 1, 2 do
		local barb = part({
			Name = "Barb",
			Parent = tool,
			Size = Vector3.new(0.16, 0.16, 0.9),
			Color = BONE,
			Material = Enum.Material.Slate,
			CFrame = CFrame.new(i * 0.3, 0, -3.1) * CFrame.Angles(math.rad(28), math.rad(i * 30), 0),
		})
		weld(handle, barb)
	end
	for i = -1, 1, 2 do
		local lash = part({
			Name = "Lashing",
			Parent = tool,
			Size = Vector3.new(0.34, 0.34, 0.18),
			Color = ROPE,
			Material = Enum.Material.Fabric,
			Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(0, 0, -2.5 + i * 0.35) * CFrame.Angles(0, math.rad(90), 0),
		})
		weld(handle, lash)
	end
end

local function buildBow(tool: Tool)
	tool.Grip = CFrame.new(0, 0, 0.2) * CFrame.Angles(0, math.rad(90), math.rad(90))
	local handle = part({
		Name = "Handle",
		Parent = tool,
		Size = Vector3.new(0.35, 1.4, 0.5),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
	})
	for i = -1, 1, 2 do
		local limb = part({
			Name = "Limb",
			Parent = tool,
			Size = Vector3.new(0.3, 1.7, 0.4),
			Color = WOOD_LIGHT,
			Material = Enum.Material.Wood,
			CFrame = CFrame.new(0, i * 1.4, 0) * CFrame.Angles(math.rad(i * 26), 0, 0),
		})
		weld(handle, limb)
	end
	local string_ = part({
		Name = "String",
		Parent = tool,
		Size = Vector3.new(0.06, 4.1, 0.06),
		Color = BOWSTRING,
		Material = Enum.Material.Fabric,
		CFrame = CFrame.new(-0.5, 0, 0),
	})
	weld(handle, string_)
	-- Leather grip wrap on the riser
	local grip = part({
		Name = "GripWrap",
		Parent = tool,
		Size = Vector3.new(0.42, 0.9, 0.58),
		Color = Color3.fromRGB(70, 46, 28),
		Material = Enum.Material.Fabric,
		CFrame = CFrame.new(0, 0, 0),
	})
	weld(handle, grip)
	-- A nocked arrow so the bow reads clearly in hand.
	local shaft = part({
		Name = "ArrowShaft",
		Parent = tool,
		Size = Vector3.new(0.1, 0.1, 3.4),
		Color = Color3.fromRGB(150, 116, 74),
		Material = Enum.Material.Wood,
		CFrame = CFrame.new(-0.35, 0, -1.3),
	})
	weld(handle, shaft)
	local arrowTip = part({
		Name = "ArrowTip",
		Parent = tool,
		Size = Vector3.new(0.2, 0.2, 0.5),
		Color = METAL,
		Material = Enum.Material.Metal,
		CFrame = CFrame.new(-0.35, 0, -3.1),
	})
	weld(handle, arrowTip)
	for i = -1, 1, 2 do
		local fletch = part({
			Name = "Fletch",
			Parent = tool,
			Size = Vector3.new(0.04, 0.34, 0.5),
			Color = Color3.fromRGB(210, 70, 60),
			Material = Enum.Material.Fabric,
			CFrame = CFrame.new(-0.35, 0, 0.3) * CFrame.Angles(0, 0, math.rad(i * 45)),
		})
		weld(handle, fletch)
	end
end

local function buildFirearm(tool: Tool, kind: string)
	tool.Grip = CFrame.new(0, -0.3, -0.2) * CFrame.Angles(0, math.rad(0), 0)

	local stockLen = if kind == "Rifle" or kind == "Musket" then 2.1 elseif kind == "Shotgun" then 1.6 else 0.0
	local barrelLen = if kind == "Rifle" then 2.6
		elseif kind == "Musket" then 2.8
		elseif kind == "Shotgun" then 1.9
		elseif kind == "Revolver" then 0.9
		else 1.1

	local handle = part({
		Name = "Handle",
		Parent = tool,
		Size = Vector3.new(0.34, 0.9, 0.45),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		CFrame = CFrame.Angles(math.rad(18), 0, 0),
	})

	local body = part({
		Name = "Body",
		Parent = tool,
		Size = Vector3.new(0.3, 0.42, 1.0),
		Color = METAL_DARK,
		Material = Enum.Material.Metal,
		CFrame = handle.CFrame * CFrame.new(0, 0.55, -0.45),
	})
	weld(handle, body)

	local barrel = part({
		Name = "Barrel",
		Parent = tool,
		Size = Vector3.new(0.24, 0.24, barrelLen),
		Color = METAL,
		Material = Enum.Material.Metal,
		Shape = Enum.PartType.Cylinder,
		CFrame = body.CFrame * CFrame.new(0, 0.06, -(barrelLen * 0.5 + 0.4)) * CFrame.Angles(0, math.rad(90), 0),
	})
	weld(handle, barrel)

	if stockLen > 0 then
		local stock = part({
			Name = "Stock",
			Parent = tool,
			Size = Vector3.new(0.3, 0.55, stockLen),
			Color = WOOD,
			Material = Enum.Material.Wood,
			CFrame = body.CFrame * CFrame.new(0, -0.05, stockLen * 0.5 + 0.3),
		})
		weld(handle, stock)
	end

	if kind == "Revolver" then
		local cyl = part({
			Name = "Cylinder",
			Parent = tool,
			Size = Vector3.new(0.42, 0.42, 0.5),
			Color = METAL,
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Cylinder,
			CFrame = body.CFrame * CFrame.new(0, 0.05, -0.2) * CFrame.Angles(0, math.rad(90), 0),
		})
		weld(handle, cyl)
	end

	-- Shared iron/brass furniture so every firearm reads as a real gun, not a block:
	-- trigger guard, trigger, hammer, and a front-sight bead at the muzzle.
	local guard = part({
		Name = "TriggerGuard",
		Parent = tool,
		Size = Vector3.new(0.12, 0.42, 0.5),
		Color = BRASS,
		Material = Enum.Material.Metal,
		CFrame = body.CFrame * CFrame.new(0, -0.28, 0.02),
	})
	weld(handle, guard)
	local trigger = part({
		Name = "Trigger",
		Parent = tool,
		Size = Vector3.new(0.08, 0.26, 0.1),
		Color = METAL_DARK,
		Material = Enum.Material.Metal,
		CFrame = body.CFrame * CFrame.new(0, -0.16, 0.02),
	})
	weld(handle, trigger)
	local hammer = part({
		Name = "Hammer",
		Parent = tool,
		Size = Vector3.new(0.12, 0.3, 0.16),
		Color = METAL_DARK,
		Material = Enum.Material.Metal,
		CFrame = body.CFrame * CFrame.new(0, 0.24, 0.36) * CFrame.Angles(math.rad(-24), 0, 0),
	})
	weld(handle, hammer)
	local sight = part({
		Name = "FrontSight",
		Parent = tool,
		Size = Vector3.new(0.06, 0.16, 0.06),
		Color = BRASS,
		Material = Enum.Material.Metal,
		CFrame = barrel.CFrame * CFrame.new(0, 0, barrelLen * 0.42) * CFrame.Angles(0, math.rad(-90), 0)
			* CFrame.new(0, 0.14, 0),
	})
	weld(handle, sight)
end

-- === Public API ==========================================================

function WeaponToolFactory.createTool(weaponId: string): Tool?
	local def = Weapons.get(weaponId)
	if not def then
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.ToolTip = def.ToolTip
	tool.RequiresHandle = true
	tool.CanBeDropped = true
	tool:SetAttribute("WeaponId", weaponId)
	tool:SetAttribute("ItemId", "Weapon_" .. weaponId)

	if def.Class == "melee" then
		tool.ManualActivationOnly = true -- custom melee input owns activation
		tool:SetAttribute("MeleeWeapon", true)
		tool:SetAttribute("Damage", def.Damage)
		tool:SetAttribute("Range", def.Range)
		tool:SetAttribute("HitRadius", def.HitRadius)
		tool:SetAttribute("HitWindow", def.HitWindow)
		tool:SetAttribute("Cooldown", def.Cooldown)
		tool:SetAttribute("SwingDuration", def.SwingDuration)
		if weaponId == "Spear" then
			buildSpear(tool)
		elseif weaponId == "Club" then
			buildClub(tool)
		elseif weaponId == "WarClub" then
			buildWarClub(tool)
		else
			-- fallback melee handle
			part({ Name = "Handle", Parent = tool, Size = Vector3.new(0.4, 3, 0.4), Color = WOOD })
		end
	else
		tool:SetAttribute("Ranged", true)
		tool:SetAttribute("Ammo", def.Ammo)
		tool:SetAttribute("MagSize", def.MagSize)
		tool:SetAttribute("Loaded", def.MagSize) -- starts loaded
		if weaponId == "Bow" then
			buildBow(tool)
		else
			buildFirearm(tool, weaponId)
		end
	end

	return tool
end

-- A world pickup: an anchored model resting in the world with a floating name tag.
-- WeaponService attaches the "Pick Up" ProximityPrompt and handles the grant.
function WeaponToolFactory.createWorldPickup(parent: Instance, weaponId: string, cf: CFrame): Model?
	local def = Weapons.get(weaponId)
	if not def then
		return nil
	end

	local model = Instance.new("Model")
	model.Name = "WeaponPickup_" .. weaponId
	model:SetAttribute("WeaponPickup", true)
	model:SetAttribute("WeaponId", weaponId)
	model.Parent = parent

	-- A small display stand so the weapon reads as lootable, not scenery.
	local base = part({
		Name = "Primary",
		Parent = model,
		Anchored = true,
		CanCollide = false,
		Massless = false,
		Size = Vector3.new(2.6, 0.4, 1.2),
		Color = WOOD_DARK,
		Material = Enum.Material.WoodPlanks,
		CFrame = cf,
	})
	model.PrimaryPart = base

	-- Build the weapon tool geometry into a throwaway tool, then reparent + anchor its
	-- parts onto the stand so we don't duplicate all the geometry code.
	local display = WeaponToolFactory.createTool(weaponId)
	if display then
		local handle = display:FindFirstChild("Handle")
		local rest = cf * CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90))
		if handle and handle:IsA("BasePart") then
			local delta = rest * handle.CFrame:Inverse()
			for _, d in display:GetChildren() do
				if d:IsA("BasePart") then
					d.CFrame = delta * d.CFrame
					d.Anchored = true
					d.CanCollide = false
					d.Massless = false
					d.Parent = model
				end
			end
		end
		display:Destroy()
	end

	local rarity = Weapons.rarityInfo(def.Rarity)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PickupTag"
	billboard.Size = UDim2.fromOffset(168, 44)
	billboard.StudsOffset = Vector3.new(0, 2.6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 90
	billboard.Adornee = base
	billboard.Parent = base

	local tag = Instance.new("TextLabel")
	tag.BackgroundTransparency = 0.32
	tag.BackgroundColor3 = Color3.fromRGB(18, 30, 40)
	tag.Size = UDim2.fromScale(1, 1)
	tag.Font = Enum.Font.GothamBold
	tag.TextScaled = true
	tag.TextColor3 = Color3.fromRGB(245, 248, 250)
	tag.Text = def.Name
	tag.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = tag
	-- Rarity-coloured outline + a small tier label so grey/green/blue/etc. read at a glance.
	local stroke = Instance.new("UIStroke")
	stroke.Color = rarity.Color
	stroke.Thickness = 2.5
	stroke.Parent = tag
	local tier = Instance.new("TextLabel")
	tier.Name = "Tier"
	tier.BackgroundTransparency = 1
	tier.Size = UDim2.new(1, 0, 0.32, 0)
	tier.Position = UDim2.fromScale(0, 0.02)
	tier.Font = Enum.Font.GothamBold
	tier.TextScaled = true
	tier.TextColor3 = rarity.Color
	tier.Text = rarity.Name
	tier.Parent = tag

	-- A soft rarity glow on the stand so the drop's tier reads even before you see the tag.
	local glow = Instance.new("PointLight")
	glow.Color = rarity.Color
	glow.Brightness = if (def.Rarity or 1) >= 4 then 2.2 else 1.1
	glow.Range = if (def.Rarity or 1) >= 4 then 16 else 10
	glow.Parent = base

	return model
end

return WeaponToolFactory
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[-- Server helpers around the shared LobbyWorld boarding pier.
-- Geometry + polish live in Shared.LobbyWorld so client fallback stays in sync.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local LobbyWorld = require(Shared:WaitForChild("LobbyWorld"))

local LobbyBuilder = {}

local function safeLighting()
	local ok, err = pcall(function()
		-- Baseline lighting shell — client ClockHUD owns ClockTime / brightness after boot.
		Lighting.GlobalShadows = true
		-- ShadowMap reads Terrain water reflections much better than Voxel
		pcall(function()
			Lighting.Technology = Enum.Technology.ShadowMap
		end)
		-- Specular + diffuse up so Terrain water and the ship's wood/canvas pick
		-- up richer sky / sun reflections for a nicer overall look.
		Lighting.EnvironmentDiffuseScale = 0.75
		Lighting.EnvironmentSpecularScale = 1

		for _, child in Lighting:GetChildren() do
			if child:IsA("Atmosphere") or child:IsA("BloomEffect") or child:IsA("ColorCorrectionEffect") or child:IsA("SunRaysEffect") then
				child:Destroy()
			end
		end

		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.12
		atmosphere.Offset = 0.22
		atmosphere.Color = Color3.fromRGB(168, 198, 214)
		atmosphere.Decay = Color3.fromRGB(42, 78, 108)
		atmosphere.Glare = 0.08
		atmosphere.Haze = 0.55
		atmosphere.Parent = Lighting

		-- Soft sun glitter across the wave field (kept subtle — no neon bloom)
		local sunRays = Instance.new("SunRaysEffect")
		sunRays.Intensity = 0.045
		sunRays.Spread = 0.55
		sunRays.Parent = Lighting

		local sky = Lighting:FindFirstChildOfClass("Sky")
		if not sky then
			sky = Instance.new("Sky")
			sky.Parent = Lighting
		end
		sky.CelestialBodiesShown = true
		sky.StarCount = 600
		sky.SunAngularSize = 20
		sky.MoonAngularSize = 11

		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "SurviveAtSeaDayNight"
		cc.TintColor = Color3.fromRGB(255, 246, 236)
		cc.Contrast = 0.06
		cc.Saturation = 0.05
		cc.Brightness = 0.02
		cc.Parent = Lighting
	end)
	if not ok then
		warn("[SurviveAtSea] Lighting setup failed (lobby still builds):", err)
	end
end

local function clearWorkspaceClutter()
	for _, name in { "Baseplate", "SpawnLocation", "Terrain" } do
		local inst = Workspace:FindFirstChild(name)
		if inst and not inst:IsA("Terrain") then
			inst:Destroy()
		end
	end

	for _, child in Workspace:GetChildren() do
		if child:IsA("BasePart") or child:IsA("Model") or child:IsA("Folder") then
			if child.Name ~= "SurviveAtSeaLobby" and child.Name ~= "Camera" and child.Name ~= "Terrain" then
				local isCharacter = false
				for _, plr in Players:GetPlayers() do
					if plr.Character == child then
						isCharacter = true
						break
					end
				end
				if not isCharacter then
					child:Destroy()
				end
			end
		end
	end
end

function LobbyBuilder.enhanceExisting(root: Folder)
	safeLighting()
	LobbyWorld.polish(root)
	print("[SurviveAtSea] Enhanced existing lobby map")
end

function LobbyBuilder.build(): Folder
	local existing = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if existing then
		existing:Destroy()
	end

	clearWorkspaceClutter()
	safeLighting()
	local root = LobbyWorld.ensure()
	print("[SurviveAtSea] Lobby geometry built — pier +", Config.PortalCount, "boarding portals")
	return root
end

function LobbyBuilder.updatePortalSign(portalModel: Model, title: string, subtitle: string, color: Color3?)
	LobbyWorld.updatePortalSign(portalModel, title, subtitle, color)
end

function LobbyBuilder.getPortalModel(index: number): Model?
	local root = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if not root then
		return nil
	end
	local portals = root:FindFirstChild("Portals")
	if not portals then
		return nil
	end
	local model = portals:FindFirstChild("Portal_" .. index)
	if model and model:IsA("Model") then
		return model
	end
	return nil
end

function LobbyBuilder.getVoyageSpawnCFrame(): CFrame
	return CFrame.new(0, 6, 620)
end

function LobbyBuilder.getLobbySpawnCFrame(): CFrame
	return LobbyWorld.getLobbySpawnCFrame()
end

function LobbyBuilder.teleportPlayerToLobby(player: Player)
	local character = player.Character
	if not character then
		return
	end
	LobbyWorld.seatCharacter(character)
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">LootPropService</string>
          <string name="Source"><![CDATA[-- Server authority for loot props: drag, drop, inventory pickup, weld / unweld to crew rafts.
-- Welded props parent under the raft Model so StarterBaseService.shiftModel moves them with the deck.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local LobbyWorld = require(Shared:WaitForChild("LobbyWorld"))

local LootPropFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("LootPropFactory"))
local StarterBaseService = require(script.Parent:WaitForChild("StarterBaseService"))

local LootPropService = {}

LootPropService._propsById = {} :: { [string]: Model }
LootPropService._grabByUser = {} :: { [number]: string }
LootPropService._Toast = nil :: RemoteEvent?
LootPropService._getPartyCode = nil :: ((Player) -> string?)?
LootPropService._started = false

local function lobbyRoot(): Folder
	local root = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if root and root:IsA("Folder") then
		return root
	end
	return LobbyWorld.ensure()
end

local function worldLootFolder(): Folder
	local root = lobbyRoot()
	local folder = root:FindFirstChild("WorldLoot")
	if folder and folder:IsA("Folder") then
		return folder
	end
	folder = Instance.new("Folder")
	folder.Name = "WorldLoot"
	folder.Parent = root
	return folder
end

local function toast(player: Player, message: string, kind: string)
	if LootPropService._Toast then
		LootPropService._Toast:FireClient(player, message, kind)
	end
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function registerProp(model: Model)
	local id = model:GetAttribute("PropId")
	if typeof(id) ~= "string" then
		return
	end
	LootPropService._propsById[id] = model
	model.Destroying:Connect(function()
		if LootPropService._propsById[id] == model then
			LootPropService._propsById[id] = nil
		end
	end)
end

local function setModelCFrame(model: Model, cf: CFrame)
	local primary = model.PrimaryPart
	if not primary then
		return
	end
	local delta = cf * primary.CFrame:Inverse()
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.CFrame = delta * desc.CFrame
			desc.Anchored = true
			desc.AssemblyLinearVelocity = Vector3.zero
			desc.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function findCrewRaftNear(player: Player, pos: Vector3): (Model?, BasePart?)
	local code = LootPropService._getPartyCode and LootPropService._getPartyCode(player)
	if not code then
		return nil, nil
	end
	local raft = StarterBaseService.getBaseModel(code)
	if not raft then
		return nil, nil
	end
	local deck = raft.PrimaryPart or raft:FindFirstChild("Deck")
	if not (deck and deck:IsA("BasePart")) then
		return nil, nil
	end
	local flat = Vector3.new(pos.X - deck.Position.X, 0, pos.Z - deck.Position.Z)
	local half = math.max(deck.Size.X, deck.Size.Z) * 0.5 + Config.Loot.WeldDeckRange * 0.35
	if flat.Magnitude > half then
		return nil, nil
	end
	return raft, deck
end

local function refreshPrompts(model: Model)
	LootPropFactory.attachPickupPrompt(model)
	LootPropFactory.attachWeldPrompt(model)
end

local function wirePromptTriggers(model: Model)
	local primary = model.PrimaryPart
	if not primary then
		return
	end

	local pickup = primary:FindFirstChild("LootPickupPrompt")
	if pickup and pickup:IsA("ProximityPrompt") and not pickup:GetAttribute("Wired") then
		pickup:SetAttribute("Wired", true)
		pickup.Triggered:Connect(function(player: Player)
			LootPropService.tryPickup(player, model)
		end)
	end

	local weldPrompt = primary:FindFirstChild("LootWeldPrompt")
	if weldPrompt and weldPrompt:IsA("ProximityPrompt") and not weldPrompt:GetAttribute("Wired") then
		weldPrompt:SetAttribute("Wired", true)
		weldPrompt.Triggered:Connect(function(player: Player)
			if model:GetAttribute("Welded") == true then
				LootPropService.tryUnweld(player, model)
			else
				LootPropService.tryWeld(player, model)
			end
		end)
	end
end

local function wireProp(model: Model)
	if model:GetAttribute("LootWired") == true then
		refreshPrompts(model)
		wirePromptTriggers(model)
		return
	end
	model:SetAttribute("LootWired", true)
	registerProp(model)
	refreshPrompts(model)
	wirePromptTriggers(model)
end

function LootPropService.registerExisting(model: Model)
	if model:GetAttribute("IsLootProp") ~= true then
		return
	end
	wireProp(model)
end

function LootPropService.spawnKind(kind: string, parent: Instance?, cf: CFrame, welded: boolean?): Model
	local folder = parent or worldLootFolder()
	local model = LootPropFactory.spawnFromKind(kind :: any, folder, cf)
	if welded then
		model:SetAttribute("Welded", true)
	end
	wireProp(model)
	return model
end

function LootPropService.attachStarterTorch(raft: Model, deck: BasePart)
	-- One flaming torch already welded near the bow for night light
	local topY = deck.Position.Y + deck.Size.Y * 0.5
	local bow = deck.CFrame * CFrame.new(-18, 0, -deck.Size.Z * 0.32)
	local torchCf = CFrame.new(bow.Position.X, topY + 1.7, bow.Position.Z)

	local kit = raft:FindFirstChild("StarterKit")
	local parent = if kit then kit else raft
	local torch = LootPropFactory.createTorchWorld(parent, torchCf)
	torch.Name = "StarterTorch"
	torch:SetAttribute("Welded", true)
	torch:SetAttribute("StarterTorch", true)
	wireProp(torch)
	return torch
end

function LootPropService.tryPickup(player: Player, model: Model): boolean
	if model:GetAttribute("IsLootProp") ~= true then
		return false
	end
	-- The merchant (and any NoPickup prop) can be dragged / welded but never pocketed.
	if model:GetAttribute("NoPickup") == true then
		return false
	end
	if model:GetAttribute("GrabbedBy") ~= 0 and model:GetAttribute("GrabbedBy") ~= player.UserId then
		toast(player, "Someone else has that.", "error")
		return false
	end

	local root = getRoot(player)
	local primary = model.PrimaryPart
	if not (root and primary) then
		return false
	end
	if (root.Position - primary.Position).Magnitude > Config.Loot.PickupPromptDistance + 6 then
		toast(player, "Too far to pick up.", "error")
		return false
	end

	local kind = model:GetAttribute("LootKind")
	if typeof(kind) ~= "string" then
		return false
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false
	end

	-- Clear grab if this player was dragging it
	if LootPropService._grabByUser[player.UserId] == model:GetAttribute("PropId") then
		LootPropService._grabByUser[player.UserId] = nil
		model:SetAttribute("GrabbedBy", 0)
	end

	local tool = LootPropFactory.createTool(kind :: any)
	tool.Parent = backpack
	model:Destroy()
	toast(player, `Picked up {kind}.`, "success")
	return true
end

function LootPropService.tryWeld(player: Player, model: Model): boolean
	if model:GetAttribute("Weldable") ~= true then
		return false
	end
	if model:GetAttribute("Welded") == true then
		toast(player, "Already welded.", "info")
		return false
	end
	if model:GetAttribute("GrabbedBy") ~= 0 and model:GetAttribute("GrabbedBy") ~= player.UserId then
		return false
	end

	local primary = model.PrimaryPart
	if not primary then
		return false
	end

	local raft, deck = findCrewRaftNear(player, primary.Position)
	if not (raft and deck) then
		toast(player, "Bring it onto your raft to weld.", "error")
		return false
	end

	-- Snap lightly onto deck surface if floating too high / low
	local topY = deck.Position.Y + deck.Size.Y * 0.5
	local cf = primary.CFrame
	if math.abs(cf.Position.Y - (topY + primary.Size.Y * 0.5)) > 8 then
		cf = CFrame.new(cf.Position.X, topY + primary.Size.Y * 0.5 + 0.1, cf.Position.Z) * (cf - cf.Position)
		setModelCFrame(model, cf)
	end

	model.Parent = raft
	model:SetAttribute("Welded", true)
	model:SetAttribute("GrabbedBy", 0)
	if LootPropService._grabByUser[player.UserId] == model:GetAttribute("PropId") then
		LootPropService._grabByUser[player.UserId] = nil
	end
	refreshPrompts(model)
	wirePromptTriggers(model)
	toast(player, "Welded to the raft.", "success")
	return true
end

function LootPropService.tryUnweld(player: Player, model: Model): boolean
	if model:GetAttribute("Welded") ~= true then
		return false
	end
	local code = LootPropService._getPartyCode and LootPropService._getPartyCode(player)
	if not code then
		return false
	end
	local raft = StarterBaseService.getBaseModel(code)
	if not raft or not model:IsDescendantOf(raft) then
		toast(player, "That's not on your raft.", "error")
		return false
	end

	model.Parent = worldLootFolder()
	model:SetAttribute("Welded", false)
	refreshPrompts(model)
	wirePromptTriggers(model)
	toast(player, "Unwelded — drag it wherever you want.", "info")
	return true
end

function LootPropService.beginDrag(player: Player, propId: string): boolean
	if typeof(propId) ~= "string" then
		return false
	end
	local model = LootPropService._propsById[propId]
	if not model or not model.Parent then
		return false
	end
	if model:GetAttribute("Draggable") ~= true then
		return false
	end

	local held = LootPropService._grabByUser[player.UserId]
	if held and held ~= propId then
		toast(player, "Drop what you're holding first.", "error")
		return false
	end

	local grabbedBy = model:GetAttribute("GrabbedBy")
	if typeof(grabbedBy) == "number" and grabbedBy ~= 0 and grabbedBy ~= player.UserId then
		toast(player, "Someone else is dragging that.", "error")
		return false
	end

	local root = getRoot(player)
	local primary = model.PrimaryPart
	if not (root and primary) then
		return false
	end
	if (root.Position - primary.Position).Magnitude > Config.Loot.DragRange + 8 then
		return false
	end

	-- Auto-unweld when you start dragging a welded piece; always lift into WorldLoot while free
	if model:GetAttribute("Welded") == true then
		local code = LootPropService._getPartyCode and LootPropService._getPartyCode(player)
		local raft = code and StarterBaseService.getBaseModel(code)
		if raft and model:IsDescendantOf(raft) then
			model.Parent = worldLootFolder()
			model:SetAttribute("Welded", false)
			refreshPrompts(model)
			wirePromptTriggers(model)
		else
			toast(player, "Can't take that off another crew's raft.", "error")
			return false
		end
	elseif not model:IsDescendantOf(worldLootFolder()) then
		model.Parent = worldLootFolder()
	end

	LootPropService._grabByUser[player.UserId] = propId
	model:SetAttribute("GrabbedBy", player.UserId)
	-- Soften collision while dragging so it doesn't shove the player
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.CanCollide = false
		end
	end
	return true
end

function LootPropService.updateDrag(player: Player, propId: string, cf: CFrame): boolean
	if typeof(propId) ~= "string" or typeof(cf) ~= "CFrame" then
		return false
	end
	if LootPropService._grabByUser[player.UserId] ~= propId then
		return false
	end
	local model = LootPropService._propsById[propId]
	if not model or model:GetAttribute("GrabbedBy") ~= player.UserId then
		return false
	end

	local root = getRoot(player)
	if not root then
		return false
	end

	-- Clamp so you can't fling loot across the map
	local pos = cf.Position
	local to = pos - root.Position
	local maxR = Config.Loot.DragRange + 4
	if to.Magnitude > maxR then
		pos = root.Position + to.Unit * maxR
		cf = CFrame.new(pos) * (cf - cf.Position)
	end
	-- Keep above water a bit
	local minY = Config.StarterBase.WaterRescueY + 1.5
	if cf.Position.Y < minY then
		cf = CFrame.new(cf.Position.X, minY, cf.Position.Z) * (cf - cf.Position)
	end

	setModelCFrame(model, cf)
	return true
end

function LootPropService.endDrag(player: Player, propId: string?): boolean
	local id = propId or LootPropService._grabByUser[player.UserId]
	if typeof(id) ~= "string" then
		return false
	end
	if LootPropService._grabByUser[player.UserId] ~= id then
		return false
	end

	local model = LootPropService._propsById[id]
	LootPropService._grabByUser[player.UserId] = nil
	if not model then
		return false
	end
	model:SetAttribute("GrabbedBy", 0)

	local kind = model:GetAttribute("LootKind")
	local restoreCollide = kind ~= "Torch" -- torches stay non-blocking-ish; walls need collide
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			if kind == "Torch" then
				desc.CanCollide = desc.Name == "Primary"
			elseif kind == "Plank" then
				desc.CanCollide = desc.Name == "Primary"
			else
				desc.CanCollide = restoreCollide or desc.Name == "Primary"
			end
			if desc.Name ~= "Primary" and (kind == "Wall" or kind == "Crate") then
				desc.CanCollide = false
			end
		end
	end
	if model.PrimaryPart then
		model.PrimaryPart.CanCollide = true
	end

	-- Auto-suggest weld if dropped on your raft
	local primary = model.PrimaryPart
	if primary then
		local raft = findCrewRaftNear(player, primary.Position)
		if raft then
			toast(player, "On your raft — press X / use Weld to attach.", "info")
		end
	end
	return true
end

function LootPropService.tryPlaceFromTool(player: Player, look: Vector3): boolean
	local character = player.Character
	if not character then
		return false
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if not (tool and tool:GetAttribute("IsLootTool") == true) then
		return false
	end
	local kind = tool:GetAttribute("LootKind")
	if typeof(kind) ~= "string" then
		return false
	end
	local root = getRoot(player)
	if not root then
		return false
	end

	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then
		flat = root.CFrame.LookVector
		flat = Vector3.new(flat.X, 0, flat.Z)
	end
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit

	local placePos = root.Position + flat * 6 + Vector3.new(0, 1.5, 0)
	local cf = CFrame.lookAt(placePos, placePos + flat)
	local model = LootPropService.spawnKind(kind, worldLootFolder(), cf, false)
	tool:Destroy()
	toast(player, `Placed {kind}. Hold RMB / RT to drag it.`, "success")
	return true
end

function LootPropService.start(
	toastRemote: RemoteEvent,
	getPartyCode: (Player) -> string?,
	remotes: {
		DragStart: RemoteEvent,
		DragUpdate: RemoteEvent,
		DragEnd: RemoteEvent,
		WeldProp: RemoteEvent,
		UnweldProp: RemoteEvent,
		PlaceLoot: RemoteEvent,
	}
)
	if LootPropService._started then
		return
	end
	LootPropService._started = true
	LootPropService._Toast = toastRemote
	LootPropService._getPartyCode = getPartyCode

	worldLootFolder()

	remotes.DragStart.OnServerEvent:Connect(function(player, propId)
		LootPropService.beginDrag(player, propId)
	end)
	remotes.DragUpdate.OnServerEvent:Connect(function(player, propId, cf)
		LootPropService.updateDrag(player, propId, cf)
	end)
	remotes.DragEnd.OnServerEvent:Connect(function(player, propId)
		LootPropService.endDrag(player, propId)
	end)
	remotes.WeldProp.OnServerEvent:Connect(function(player, propId)
		if typeof(propId) ~= "string" then
			return
		end
		local model = LootPropService._propsById[propId]
		if model then
			LootPropService.tryWeld(player, model)
		end
	end)
	remotes.UnweldProp.OnServerEvent:Connect(function(player, propId)
		if typeof(propId) ~= "string" then
			return
		end
		local model = LootPropService._propsById[propId]
		if model then
			LootPropService.tryUnweld(player, model)
		end
	end)
	remotes.PlaceLoot.OnServerEvent:Connect(function(player, look)
		if typeof(look) ~= "Vector3" then
			return
		end
		LootPropService.tryPlaceFromTool(player, look)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local id = LootPropService._grabByUser[player.UserId]
		if id then
			LootPropService.endDrag(player, id)
		end
	end)
end

return LootPropService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">MerchantService</string>
          <string name="Source"><![CDATA[-- The blue-hatted tribal merchant. NEVER hostile. Spawns on inhabited villages, is
-- registered as a draggable / weldable loot prop (so you can haul it onto your raft and
-- weld it), and runs a trade shop: buy weapons / ammo with looted Doubloons, or craft
-- ammo from scavenged Scrap.
--
-- Trade flow:
--   * A ProximityPrompt on the merchant fires MerchantShop:FireClient(player, shop) to
--     open the client shop UI.
--   * The client invokes MerchantTrade (RemoteFunction) with a shop index; the server
--     validates proximity + currency and grants the item.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local NpcFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("NpcFactory"))
local LootPropFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("LootPropFactory"))
local WeaponService = require(script.Parent:WaitForChild("WeaponService"))

local MerchantService = {}

MerchantService._merchants = {} :: { Model }
MerchantService._Toast = nil :: RemoteEvent?
MerchantService._Shop = nil :: RemoteEvent?
MerchantService._registerProp = nil :: ((Model) -> ())?
MerchantService._started = false

local function toast(player: Player, message: string, kind: string)
	if MerchantService._Toast then
		MerchantService._Toast:FireClient(player, message, kind)
	end
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root :: BasePart
	end
	return nil
end

local function nearestMerchantDistance(player: Player): number
	local root = getRoot(player)
	if not root then
		return math.huge
	end
	local best = math.huge
	for _, m in MerchantService._merchants do
		if not m.Parent then
			continue
		end
		local primary = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
		if primary and primary:IsA("BasePart") then
			local d = (primary.Position - root.Position).Magnitude
			if d < best then
				best = d
			end
		end
	end
	return best
end

function MerchantService.spawnMerchant(parent: Instance, cf: CFrame, islandId: string?): Model
	local model, root = NpcFactory.createMerchant(parent, cf, { islandId = islandId })

	-- Make the merchant a draggable / weldable prop (but never pocketable).
	LootPropFactory.tagAsProp(model, "Merchant", { noPickup = true })
	if MerchantService._registerProp then
		MerchantService._registerProp(model)
	end

	-- Trade prompt (E). Sits alongside the weld prompt (X) added by the loot system.
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TradePrompt"
	prompt.ActionText = "Trade"
	prompt.ObjectText = "Merchant"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = Config.Islands.Merchant.GreetRange
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Parent = root

	prompt.Triggered:Connect(function(player: Player)
		if MerchantService._Shop then
			MerchantService._Shop:FireClient(player, Weapons.Shop)
		end
		toast(player, "The merchant nods. Trade Doubloons or craft with Scrap.", "info")
	end)

	table.insert(MerchantService._merchants, model)
	model.Destroying:Connect(function()
		for i, m in MerchantService._merchants do
			if m == model then
				table.remove(MerchantService._merchants, i)
				break
			end
		end
	end)

	return model
end

-- Find a Tool the player is carrying to sell — by exact ItemId when known, else by name.
-- Checks the equipped tool (Character) first, then the Backpack.
local function findSellTool(player: Player, toolName: string?, itemId: string?): Tool?
	local function scan(container: Instance?): Tool?
		if not container then
			return nil
		end
		if itemId then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("ItemId") == itemId then
					return child
				end
			end
		end
		if toolName then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child.Name == toolName then
					return child
				end
			end
		end
		return nil
	end
	return scan(player.Character) or scan(player:FindFirstChildOfClass("Backpack"))
end

-- Sell anything you carry. The merchant buys any Tool for Doubloons, priced by rarity
-- (see Weapons.sellValue): looted weapons are worth more the rarer they are, salvage loot
-- tools fetch a few coins. The item is consumed on sale.
function MerchantService.handleSell(player: Player, payload: { [string]: any }): { ok: boolean, message: string }
	if nearestMerchantDistance(player) > Config.Islands.Merchant.GreetRange + 12 then
		return { ok = false, message = "Get closer to a merchant to trade." }
	end

	local toolName = if typeof(payload.tool) == "string" then payload.tool else nil
	local itemId = if typeof(payload.itemId) == "string" then payload.itemId else nil
	local tool = findSellTool(player, toolName, itemId)
	if not tool then
		return { ok = false, message = "You aren't carrying that item." }
	end

	local value = Weapons.sellValue(tool:GetAttribute("ItemId"), tool:GetAttribute("Rarity"))
	local soldName = tool.Name
	tool:Destroy()
	WeaponService.addCurrency(player, "Doubloons", value)
	return { ok = true, message = `Sold {soldName} for {value} Doubloons.` }
end

function MerchantService.handleTrade(player: Player, index: any): { ok: boolean, message: string }
	-- Table payloads are structured actions (e.g. selling). Numbers are shop-row buys.
	if typeof(index) == "table" then
		if index.action == "sell" then
			return MerchantService.handleSell(player, index)
		end
		return { ok = false, message = "Invalid trade." }
	end
	if typeof(index) ~= "number" then
		return { ok = false, message = "Invalid trade." }
	end
	local entry = Weapons.Shop[index]
	if not entry then
		return { ok = false, message = "That item isn't for sale." }
	end

	-- Must be near a merchant (on an isle) or a merchant welded to your raft.
	if nearestMerchantDistance(player) > Config.Islands.Merchant.GreetRange + 12 then
		return { ok = false, message = "Get closer to a merchant to trade." }
	end

	local currencyId = entry.Currency
	local cost = entry.Cost or 0

	-- Weapons: reject up front if already carried (don't spend then refund).
	if entry.Kind == "weapon" then
		local def = Weapons.get(entry.Weapon)
		if not def then
			return { ok = false, message = "Unknown weapon." }
		end
	end

	if WeaponService.getCurrency(player, currencyId) < cost then
		local label = Config.Currency[currencyId] and Config.Currency[currencyId].Label or currencyId
		return { ok = false, message = `Not enough {label}.` }
	end

	if entry.Kind == "ammo" then
		if not WeaponService.spendCurrency(player, currencyId, cost) then
			return { ok = false, message = "Trade failed." }
		end
		WeaponService.giveAmmo(player, entry.Ammo, entry.Amount)
		local label = Weapons.Ammo[entry.Ammo] and Weapons.Ammo[entry.Ammo].Label or entry.Ammo
		return { ok = true, message = `Got {entry.Amount} {label}.` }
	elseif entry.Kind == "weapon" then
		-- Try to grant first (giveWeapon rejects duplicates) then charge.
		local granted = WeaponService.giveWeapon(player, entry.Weapon, true)
		if not granted then
			return { ok = false, message = "You already carry that weapon." }
		end
		if not WeaponService.spendCurrency(player, currencyId, cost) then
			return { ok = false, message = "Trade failed." }
		end
		local def = Weapons.get(entry.Weapon)
		-- Throw in a little ammo with a purchased gun.
		if def and def.Class == "ranged" and def.Ammo then
			WeaponService.giveAmmo(player, def.Ammo, Weapons.AmmoBundle[def.Ammo] or 6)
		end
		return { ok = true, message = `Bought {def and def.Name or entry.Weapon}.` }
	end

	return { ok = false, message = "Nothing happened." }
end

function MerchantService.start(remotes: {
	Toast: RemoteEvent,
	Shop: RemoteEvent,
	Trade: RemoteFunction,
}, registerProp: (Model) -> ())
	if MerchantService._started then
		return
	end
	MerchantService._started = true
	MerchantService._Toast = remotes.Toast
	MerchantService._Shop = remotes.Shop
	MerchantService._registerProp = registerProp

	remotes.Trade.OnServerInvoke = function(player, index)
		return MerchantService.handleTrade(player, index)
	end

	Players.PlayerRemoving:Connect(function() end)
end

return MerchantService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">OceanTerrainService</string>
          <string name="Source"><![CDATA[-- Streams Roblox Terrain water around the lobby pier and every sailing raft.
-- Engine water gives real waves / reflection; chunks keep the infinite ocean cheap.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local OceanConfig = require(Shared:WaitForChild("OceanConfig"))

local StarterBaseService = require(script.Parent:WaitForChild("StarterBaseService"))
local IslandService = require(script.Parent:WaitForChild("IslandService"))

local OceanTerrainService = {}

local CHUNK = OceanConfig.ChunkStuds
local RADIUS = OceanConfig.KeepRadiusChunks
local DEPTH = OceanConfig.DepthStuds
local SURFACE_Y = OceanConfig.SurfaceY

-- chunkKey -> true while filled with water
local activeChunks: { [string]: boolean } = {}
local started = false

local function terrain(): Terrain
	return Workspace.Terrain
end

local function applyWaterMaterial()
	local t = terrain()
	t.WaterColor = OceanConfig.WaterColor
	t.WaterReflectance = OceanConfig.WaterReflectance
	t.WaterTransparency = OceanConfig.WaterTransparency
	t.WaterWaveSize = OceanConfig.WaterWaveSize
	t.WaterWaveSpeed = OceanConfig.WaterWaveSpeed
end

local function chunkKey(cx: number, cz: number): string
	return `{cx},{cz}`
end

local function worldToChunk(x: number, z: number): (number, number)
	return math.floor(x / CHUNK), math.floor(z / CHUNK)
end

local function fillChunk(cx: number, cz: number): boolean
	local key = chunkKey(cx, cz)
	if activeChunks[key] then
		return false
	end

	local centerX = cx * CHUNK + CHUNK * 0.5
	local centerZ = cz * CHUNK + CHUNK * 0.5
	local centerY = SURFACE_Y - DEPTH * 0.5
	terrain():FillBlock(
		CFrame.new(centerX, centerY, centerZ),
		Vector3.new(CHUNK, DEPTH, CHUNK),
		Enum.Material.Water
	)
	activeChunks[key] = true
	return true
end

local function clearChunk(cx: number, cz: number)
	local key = chunkKey(cx, cz)
	if not activeChunks[key] then
		return
	end

	local centerX = cx * CHUNK + CHUNK * 0.5
	local centerZ = cz * CHUNK + CHUNK * 0.5
	local centerY = SURFACE_Y - DEPTH * 0.5
	terrain():FillBlock(
		CFrame.new(centerX, centerY, centerZ),
		Vector3.new(CHUNK, DEPTH, CHUNK),
		Enum.Material.Air
	)
	activeChunks[key] = nil
end

local function ensureAround(x: number, z: number, wanted: { [string]: boolean }): boolean
	local cx, cz = worldToChunk(x, z)
	local changed = false
	for dx = -RADIUS, RADIUS do
		for dz = -RADIUS, RADIUS do
			local nx, nz = cx + dx, cz + dz
			local key = chunkKey(nx, nz)
			wanted[key] = true
			if fillChunk(nx, nz) then
				changed = true
			end
		end
	end
	return changed
end

local function collectFocusPoints(): { Vector3 }
	local points = {
		Vector3.new(0, SURFACE_Y, 40), -- boarding pier
		Config.StarterBase.Origin,
	}

	for _, center in IslandService.getWorldCenters() do
		table.insert(points, center)
	end

	for _, model in StarterBaseService._basesByCode do
		local deck = model.PrimaryPart or model:FindFirstChild("Deck")
		if deck and deck:IsA("BasePart") then
			table.insert(points, deck.Position)
		end
	end

	return points
end

local function streamOnce(): boolean
	local changed = false
	local wanted: { [string]: boolean } = {}
	for _, pos in collectFocusPoints() do
		if ensureAround(pos.X, pos.Z, wanted) then
			changed = true
		end
	end

	local stale: { string } = {}
	for key, _ in activeChunks do
		if not wanted[key] then
			table.insert(stale, key)
		end
	end
	for _, key in stale do
		local cxStr, czStr = string.match(key, "^(%-?%d+),(%-?%d+)$")
		if cxStr and czStr then
			clearChunk(tonumber(cxStr) :: number, tonumber(czStr) :: number)
			changed = true
		end
	end

	-- Re-paint sand only when the water field actually changed this cycle. FillCylinder
	-- is a voxel write per isle, so doing it every tick (when nothing moved) was pure
	-- server-side terrain churn — the main streaming lag source.
	if changed then
		IslandService.paintTerrain()
	end

	return changed
end

-- Hide legacy flat-glass ocean parts so Terrain water is the visible sea.
local function hideLegacyOceanParts()
	local root = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if not (root and root:IsA("Folder")) then
		return
	end

	for _, name in { "OceanSurface", "OceanDeep" } do
		local part = root:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Transparency = 1
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
		end
	end

	local bases = root:FindFirstChild("StarterBases")
	if not bases then
		return
	end
	for _, model in bases:GetChildren() do
		if not model:IsA("Model") then
			continue
		end
		for _, name in { "LocalSea", "LocalSeaDeep" } do
			local part = model:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				part.Transparency = 1
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.CastShadow = false
			end
		end
	end
end

function OceanTerrainService.start()
	if started then
		return
	end
	started = true

	applyWaterMaterial()
	hideLegacyOceanParts()
	streamOnce()

	local accum = 0
	local interval = 1 / math.max(OceanConfig.StreamHz, 0.5)
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < interval then
			return
		end
		accum = 0
		-- Only re-hide legacy ocean parts when the water field changed (e.g. a new
		-- starter base introduced a fresh focus point). On steady state nothing moves,
		-- so we skip both the descendant scan and the terrain repaint entirely.
		if streamOnce() then
			hideLegacyOceanParts()
		end
	end)

	print("[SurviveAtSea] Ocean terrain streaming online — realistic waves enabled")
end

return OceanTerrainService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">PartyService</string>
          <string name="Source"><![CDATA[-- Ephemeral party / game-state service.
-- No DataStore or MemoryStore caching — parties live only while this lobby server does.
--
-- Flow:
--   1. Walk a pier portal → pick crew size → form a private crew
--   2. Spawn onto ONE huge square wooden plank (starter base)
--   3. Top-right HUD shows the join code; friends join by code only
--
-- Rules:
--   • Every crew is private — join is code-only (never walk-in onto an occupied crew)
--   • Pier portals are reusable boarding gates, not exclusive party pads
--   • Player capacity is host-chosen maxPlayers (1–MaxPartySize), independent of portal count
--   • Concurrent crews use independent baseSlot raft placement (not capped by PortalCount)

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PartyCode = require(Shared:WaitForChild("PartyCode"))
local Types = require(Shared:WaitForChild("Types"))

local StarterBaseService = require(script.Parent:WaitForChild("StarterBaseService"))
local StarterGearService = require(script.Parent:WaitForChild("StarterGearService"))

type PartyPrivacy = Types.PartyPrivacy
type PartySnapshot = Types.PartySnapshot
type PartyMember = Types.PartyMember
type PublicPortalInfo = Types.PublicPortalInfo

export type PartyRecord = {
	code: string,
	hostUserId: number,
	maxPlayers: number,
	privacy: PartyPrivacy,
	portalIndex: number,
	baseSlot: number,
	-- Server time when crew was created — voyage day/night starts at 9:00 AM from this origin
	cycleOrigin: number,
	memberUserIds: { number },
	status: "Open",
}

local PartyService = {}
PartyService._partiesByCode = {} :: { [string]: PartyRecord }
PartyService._playerToCode = {} :: { [number]: string }
PartyService._onChanged = nil :: ((PartySnapshot?, { PublicPortalInfo }) -> ())?

local function setVoyageActive(player: Player, active: boolean)
	-- Replicated state used by client-only gameplay UI.  Lobby players must never
	-- see voyage actions such as drag, weld, or attack.
	player:SetAttribute("VoyageActive", active)
end

local function displayNameFor(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	if player then
		return player.DisplayName
	end
	return `Crew_{userId}`
end

local function memberSlot(party: PartyRecord, userId: number): number
	for index, id in party.memberUserIds do
		if id == userId then
			return index
		end
	end
	return #party.memberUserIds
end

local function allocateBaseSlot(): number
	local used: { [number]: boolean } = {}
	for _, party in PartyService._partiesByCode do
		used[party.baseSlot] = true
	end
	local slot = 1
	while used[slot] do
		slot += 1
	end
	return slot
end

local function toSnapshot(party: PartyRecord): PartySnapshot
	local members: { PartyMember } = {}
	for _, userId in party.memberUserIds do
		table.insert(members, {
			userId = userId,
			displayName = displayNameFor(userId),
			isHost = userId == party.hostUserId,
		})
	end

	return {
		code = party.code,
		hostUserId = party.hostUserId,
		maxPlayers = party.maxPlayers,
		privacy = party.privacy,
		members = members,
		portalIndex = party.portalIndex,
		baseSlot = party.baseSlot,
		cycleOrigin = party.cycleOrigin,
		status = party.status,
	}
end

local function buildPortalInfos(): { PublicPortalInfo }
	local infos = {}
	for i = 1, Config.PortalCount do
		table.insert(infos, {
			portalIndex = i,
			status = "Ready",
		})
	end
	return infos
end

local function notify(party: PartyRecord?)
	if PartyService._onChanged then
		PartyService._onChanged(if party then toSnapshot(party) else nil, buildPortalInfos())
	end
end

local function seatOnBase(player: Player, party: PartyRecord)
	StarterBaseService.ensureBase(party.code, party.baseSlot)
	StarterBaseService.teleportPlayerToBase(player, party.baseSlot, memberSlot(party, player.UserId))
	-- Voyage starter kit: wooden club (droppable melee)
	StarterGearService.ensureStarterClub(player)
end

local function removePlayerFromCurrentParty(userId: number)
	local code = PartyService._playerToCode[userId]
	if not code then
		return
	end

	local party = PartyService._partiesByCode[code]
	PartyService._playerToCode[userId] = nil
	if not party then
		return
	end

	-- Drop the wheel before teleporting home
	local leavingPlayer = Players:GetPlayerByUserId(userId)
	if leavingPlayer then
		local HelmService = require(script.Parent:WaitForChild("HelmService"))
		HelmService.releaseIfHelming(leavingPlayer)
	end

	local remaining = {}
	for _, id in party.memberUserIds do
		if id ~= userId then
			table.insert(remaining, id)
		end
	end
	party.memberUserIds = remaining

	if leavingPlayer then
		setVoyageActive(leavingPlayer, false)
		StarterGearService.clearStarterClub(leavingPlayer)
		StarterBaseService.teleportPlayerToLobby(leavingPlayer)
	end

	if #remaining == 0 then
		StarterBaseService.destroyBase(code)
		PartyService._partiesByCode[code] = nil
		notify(nil)
		return
	end

	if party.hostUserId == userId then
		party.hostUserId = remaining[1]
	end

	notify(party)
end

function PartyService.setChangedCallback(callback: (PartySnapshot?, { PublicPortalInfo }) -> ())
	PartyService._onChanged = callback
end

function PartyService.getPartyCode(player: Player): string?
	return PartyService._playerToCode[player.UserId]
end

function PartyService.getMemberUserIds(code: string): { number }
	local party = PartyService._partiesByCode[code]
	if not party then
		return {}
	end
	return party.memberUserIds
end

function PartyService.getSnapshotForPlayer(player: Player): PartySnapshot?
	local code = PartyService._playerToCode[player.UserId]
	if not code then
		return nil
	end
	local party = PartyService._partiesByCode[code]
	if not party then
		return nil
	end
	return toSnapshot(party)
end

function PartyService.isInParty(player: Player): boolean
	return PartyService._playerToCode[player.UserId] ~= nil
end

function PartyService.getPortalInfos(): { PublicPortalInfo }
	return buildPortalInfos()
end

function PartyService.getLobbyState(player: Player): { party: PartySnapshot?, portals: { PublicPortalInfo } }
	return {
		party = PartyService.getSnapshotForPlayer(player),
		portals = buildPortalInfos(),
	}
end

function PartyService.getBaseSeatInfo(player: Player): { baseSlot: number, slotIndex: number }?
	local code = PartyService._playerToCode[player.UserId]
	if not code then
		return nil
	end
	local party = PartyService._partiesByCode[code]
	if not party then
		return nil
	end
	return {
		baseSlot = party.baseSlot,
		slotIndex = memberSlot(party, player.UserId),
	}
end

function PartyService.createParty(
	player: Player,
	portalIndex: number,
	maxPlayers: number
): (boolean, string, PartySnapshot?)
	if PartyService._playerToCode[player.UserId] then
		return false, "Leave your current crew before creating another.", nil
	end

	if portalIndex < 1 or portalIndex > Config.PortalCount then
		return false, "That boarding portal doesn't exist.", nil
	end

	maxPlayers = math.clamp(math.floor(maxPlayers), Config.MinPartySize, Config.MaxPartySize)

	local code = PartyCode.generate(PartyService._partiesByCode)
	local baseSlot = allocateBaseSlot()
	local party: PartyRecord = {
		code = code,
		hostUserId = player.UserId,
		maxPlayers = maxPlayers,
		privacy = "Private",
		portalIndex = portalIndex,
		baseSlot = baseSlot,
		-- Day/night elapsed from this origin so every crew wakes at 9:00 AM.
		cycleOrigin = Workspace:GetServerTimeNow(),
		memberUserIds = { player.UserId },
		status = "Open",
	}

	PartyService._partiesByCode[code] = party
	PartyService._playerToCode[player.UserId] = code

	local okBuild, buildErr = pcall(function()
		StarterBaseService.ensureBase(code, baseSlot)
		seatOnBase(player, party)
	end)
	if not okBuild then
		-- Roll back so the player isn't stuck "on a crew" with dead portals.
		PartyService._playerToCode[player.UserId] = nil
		PartyService._partiesByCode[code] = nil
		warn("[SurviveAtSea] createParty base failed:", buildErr)
		return false, "Couldn't spawn your plank — try another portal.", nil
	end

	local snapshot = toSnapshot(party)
	setVoyageActive(player, true)
	notify(party)
	return true, "Private crew ready — share your code so friends can join.", snapshot
end

function PartyService.joinParty(player: Player, rawCode: string): (boolean, string, PartySnapshot?)
	if PartyService._playerToCode[player.UserId] then
		return false, "You're already on a crew.", nil
	end

	local code = PartyCode.normalize(rawCode)
	if #code < 4 then
		return false, "Enter a valid crew code.", nil
	end

	local party = PartyService._partiesByCode[code]
	if not party then
		return false, "No crew found with that code.", nil
	end

	if party.status ~= "Open" then
		return false, "That crew isn't accepting joins right now.", nil
	end

	if #party.memberUserIds >= party.maxPlayers then
		return false, `That crew is full ({party.maxPlayers}/{party.maxPlayers}).`, nil
	end

	table.insert(party.memberUserIds, player.UserId)
	PartyService._playerToCode[player.UserId] = code

	StarterBaseService.ensureBase(party.code, party.baseSlot)
	seatOnBase(player, party)

	local snapshot = toSnapshot(party)
	setVoyageActive(player, true)
	notify(party)
	return true, "You joined the crew base!", snapshot
end

function PartyService.leaveParty(player: Player): (boolean, string)
	if not PartyService._playerToCode[player.UserId] then
		return false, "You're not on a crew."
	end
	removePlayerFromCurrentParty(player.UserId)
	return true, "Left the crew — back on the pier."
end

function PartyService.onPlayerRemoving(player: Player)
	removePlayerFromCurrentParty(player.UserId)
end

return PartyService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="37">
        <Properties>
          <string name="Name">PlayerAppearance</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Keep every sailor at the standard Roblox R15 body scale.  Account avatar
-- settings can otherwise make a player much shorter or taller than the island
-- villagers, and can put their camera inside the helm wheel.

local Players = game:GetService("Players")

local STANDARD_SCALES = {
	BodyDepthScale = 1,
	BodyHeightScale = 1,
	BodyWidthScale = 1,
	HeadScale = 1,
	BodyTypeScale = 0,
	ProportionScale = 0,
}

local function setStandardCharacterScale(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not (humanoid and humanoid:IsA("Humanoid")) then
		return
	end

	-- R6 avatars do not expose scale values and are already the normal Roblox
	-- height. R15 values may arrive just after the Humanoid, so wait briefly for
	-- each one rather than assuming the character's initial descendants are final.
	for name, value in STANDARD_SCALES do
		local scale = humanoid:FindFirstChild(name) or humanoid:WaitForChild(name, 3)
		if scale and scale:IsA("NumberValue") then
			scale.Value = value
		end
	end
end

local function connectPlayer(player: Player)
	player.CharacterAdded:Connect(setStandardCharacterScale)
	if player.Character then
		task.spawn(setStandardCharacterScale, player.Character)
	end
end

Players.PlayerAdded:Connect(connectPlayer)
for _, player in Players:GetPlayers() do
	connectPlayer(player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">PortalService</string>
          <string name="Source"><![CDATA[-- Wires pier portal proximity prompts + walk-in triggers.
-- Portals are reusable boarding gates: they open create, never walk-join a crew.
-- Friends always join via code.
--
-- Resilient to Rojo live-sync / LobbyWorld.polish replacing Portals models or the
-- whole SurviveAtSeaLobby folder after boot (old ChildAdded connections go dead).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local LobbyBuilder = require(script.Parent.LobbyBuilder)
local PartyService = require(script.Parent.PartyService)

local PortalService = {}

local touchDebounce: { [string]: boolean } = {}
local wiredModels: { [Model]: boolean } = {}
local folderConnections: { RBXScriptConnection } = {}
local lobbyConnections: { RBXScriptConnection } = {}
local started = false
local boardingReady = true
local toastRemote: RemoteEvent? = nil
local partyUpdatedRemote: RemoteEvent? = nil
local portalsUpdatedRemote: RemoteEvent? = nil

local function disconnectAll(connections: { RBXScriptConnection })
	for _, conn in connections do
		conn:Disconnect()
	end
	table.clear(connections)
end

local function refreshPortalVisuals(portals)
	for _, info in portals do
		local model = LobbyBuilder.getPortalModel(info.portalIndex)
		if not model then
			continue
		end

		local promptAnchor = model:FindFirstChild("PromptAnchor")
		local prompt = promptAnchor and promptAnchor:FindFirstChild("BoardPrompt")

		LobbyBuilder.updatePortalSign(
			model,
			`Portal {info.portalIndex}`,
			"Form a private crew · friends join by code",
			Config.Theme.Foam
		)
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.ActionText = "Create Crew"
			prompt.ObjectText = `Portal {info.portalIndex}`
			prompt.Enabled = boardingReady
		end
	end
end

function PortalService.setBoardingReady(ready: boolean)
	boardingReady = ready
	refreshPortalVisuals(PartyService.getPortalInfos())
end

local function handlePortalUse(player: Player, portalIndex: number)
	local toast = toastRemote
	local partyUpdated = partyUpdatedRemote
	if not (toast and partyUpdated) then
		return
	end

	if PartyService.isInParty(player) then
		toast:FireClient(player, "You're already on a crew — share your code from the HUD.", "info")
		return
	end

	local key = `{player.UserId}:{portalIndex}`
	if touchDebounce[key] then
		return
	end
	touchDebounce[key] = true
	task.delay(0.75, function()
		touchDebounce[key] = nil
	end)

	toast:FireClient(player, "Pick crew size, then spawn on your plank. Friends join by code.", "info")
	partyUpdated:FireClient(player, {
		__openCreate = true,
		portalIndex = portalIndex,
	})
end

-- Map JSON may omit WalkTrigger; polish rebuilds usually add it, but Rojo can
-- re-sync the map afterward. Guarantee a touch volume so walk-in keeps working.
local function ensureWalkTrigger(model: Model): BasePart?
	local existing = model:FindFirstChild("WalkTrigger")
	if existing and existing:IsA("BasePart") then
		existing.CanCollide = false
		existing.CanTouch = true
		existing.CanQuery = false
		existing.Transparency = 1
		return existing
	end

	local pad = model:FindFirstChild("Pad")
	local anchor = if pad and pad:IsA("BasePart") then pad else model.PrimaryPart
	if not (anchor and anchor:IsA("BasePart")) then
		return nil
	end

	local trigger = Instance.new("Part")
	trigger.Name = "WalkTrigger"
	trigger.Anchored = true
	trigger.CanCollide = false
	trigger.CanTouch = true
	trigger.CanQuery = false
	trigger.CastShadow = false
	trigger.Transparency = 1
	trigger.Material = Enum.Material.SmoothPlastic
	trigger.Size = Vector3.new(10, 13, 9)
	trigger.CFrame = anchor.CFrame * CFrame.new(0, 7.5 - anchor.Size.Y * 0.5, 0.5)
	trigger.Parent = model
	return trigger
end

local function wirePortalModel(model: Model)
	if wiredModels[model] then
		return
	end

	local indexValue = model:FindFirstChild("PortalIndex")
	local promptAnchor = model:FindFirstChild("PromptAnchor")
	local prompt = promptAnchor and promptAnchor:FindFirstChild("BoardPrompt")
	if not (indexValue and indexValue:IsA("IntValue")) then
		return
	end

	local portalIndex = indexValue.Value
	wiredModels[model] = true

	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Triggered:Connect(function(player: Player)
			handlePortalUse(player, portalIndex)
		end)
	end

	local walkTrigger = ensureWalkTrigger(model)
	if walkTrigger then
		walkTrigger.Touched:Connect(function(hit: BasePart)
			local character = hit.Parent
			if not character then
				return
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then
				return
			end
			local player = Players:GetPlayerFromCharacter(character)
			if not player then
				return
			end

			handlePortalUse(player, portalIndex)
		end)
	end
end

local function wirePortalsFolder(portalsFolder: Instance)
	disconnectAll(folderConnections)

	-- Drop wiring bookkeeping for models that were destroyed/replaced
	for model, _ in wiredModels do
		if not model.Parent then
			wiredModels[model] = nil
		end
	end

	for _, child in portalsFolder:GetChildren() do
		if child:IsA("Model") then
			wirePortalModel(child)
		end
	end

	table.insert(
		folderConnections,
		portalsFolder.ChildAdded:Connect(function(child)
			if child:IsA("Model") then
				task.defer(function()
					wirePortalModel(child)
				end)
			end
		end)
	)
end

local function bindLobby(lobby: Instance)
	disconnectAll(lobbyConnections)

	local portalsFolder = lobby:FindFirstChild("Portals")
	if portalsFolder then
		wirePortalsFolder(portalsFolder)
	end

	table.insert(
		lobbyConnections,
		lobby.ChildAdded:Connect(function(child)
			if child.Name == "Portals" then
				wirePortalsFolder(child)
			end
		end)
	)
end

function PortalService.start(toast: RemoteEvent, partyUpdated: RemoteEvent, portalsUpdated: RemoteEvent)
	if started then
		return
	end
	started = true
	toastRemote = toast
	partyUpdatedRemote = partyUpdated
	portalsUpdatedRemote = portalsUpdated

	PartyService.setChangedCallback(function(partySnapshot, portalInfos)
		refreshPortalVisuals(portalInfos)
		portalsUpdated:FireAllClients(portalInfos)
		if partySnapshot then
			for _, member in partySnapshot.members do
				local player = Players:GetPlayerByUserId(member.userId)
				if player then
					partyUpdated:FireClient(player, partySnapshot)
				end
			end
		end
	end)

	refreshPortalVisuals(PartyService.getPortalInfos())

	-- Initial bind (lobby should already exist from Bootstrap polish)
	local root = Workspace:WaitForChild("SurviveAtSeaLobby", 30)
	if root then
		bindLobby(root)
	end

	-- Rojo live-sync can replace the whole lobby folder after scripts start.
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == "SurviveAtSeaLobby" then
			task.defer(function()
				bindLobby(child)
				refreshPortalVisuals(PartyService.getPortalInfos())
			end)
		end
	end)

	-- Periodic re-bind if Portals was swapped in place without replacing the lobby
	task.spawn(function()
		while started do
			task.wait(2)
			local lobby = Workspace:FindFirstChild("SurviveAtSeaLobby")
			if not lobby then
				continue
			end
			local portalsFolder = lobby:FindFirstChild("Portals")
			if not portalsFolder then
				continue
			end
			local needsRewire = false
			for _, child in portalsFolder:GetChildren() do
				if child:IsA("Model") and not wiredModels[child] then
					needsRewire = true
					break
				end
			end
			if needsRewire then
				bindLobby(lobby)
				refreshPortalVisuals(PartyService.getPortalInfos())
			end
		end
	end)

	print("[SurviveAtSea] PortalService ready — prompts + walk-in, resilient to lobby resync")
end

return PortalService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">RaftStarterKit</string>
          <string name="Source"><![CDATA[-- Visual starter kit for each crew raft: vertical steering column + ship's wheel.
-- Pure construction — HelmService owns interaction / movement / look-driven wheel spin.

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local RaftStarterKit = {}

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "KitPart"
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then false else props.CanCollide
	p.Material = props.Material or Enum.Material.Wood
	p.Color = props.Color or Config.Theme.Driftwood
	p.Size = props.Size or Vector3.new(1, 1, 1)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function deckTopY(deck: BasePart): number
	return deck.Position.Y + deck.Size.Y / 2
end

-- Classic pirate helm: tall vertical post with an upright wheel mounted on it.
-- Cylinder axis is local X; rotate 90° about Y so the wheel stands vertical (YZ → world XY).
local function buildHelmWheel(kit: Folder, deck: BasePart, center: Vector3)
	local standOffset = Config.Helm.StandLocalOffset
	local topY = deckTopY(deck)
	local standPos = Vector3.new(center.X + standOffset.X, topY, center.Z + standOffset.Z)
	-- Face toward the bow (negative Z in local raft space)
	local standCf = CFrame.new(standPos, standPos + Vector3.new(0, 0, -10))

	-- Deck plate under the column
	makePart({
		Name = "HelmBase",
		Parent = kit,
		Size = Vector3.new(3.6, 0.45, 3.6),
		CFrame = standCf * CFrame.new(0, 0.22, 0),
		Color = Color3.fromRGB(86, 58, 34),
		Material = Enum.Material.WoodPlanks,
		CanCollide = true,
	})

	-- Vertical steering column (the post the wheel lives on)
	local columnHeight = 4.4
	local column = makePart({
		Name = "HelmPedestal",
		Parent = kit,
		Size = Vector3.new(1.15, columnHeight, 1.15),
		CFrame = standCf * CFrame.new(0, columnHeight / 2, 0),
		Color = Color3.fromRGB(72, 48, 28),
		Material = Enum.Material.Wood,
		CanCollide = true,
	})

	-- Cap on top of the post
	makePart({
		Name = "HelmColumnCap",
		Parent = kit,
		Size = Vector3.new(1.55, 0.4, 1.55),
		CFrame = standCf * CFrame.new(0, columnHeight + 0.15, 0),
		Color = Color3.fromRGB(58, 40, 24),
		Material = Enum.Material.Wood,
		CanCollide = true,
	})

	-- Axle stub sticking out of the post toward the helmsman (+Z local)
	-- Keep the wheel at a natural hand height while leaving a clear sightline for
	-- a standard-height Roblox character standing at the helm.
	local wheelCenter = standCf * CFrame.new(0, 2.65, 0.95)
	-- Upright wheel: cylinder axis points at helmsman (world ±stand Look flipped → local +Z)
	local wheelCf = wheelCenter * CFrame.Angles(0, math.rad(90), 0)

	-- Spinning assembly — HelmService pivots this with look yaw while helming
	local wheelModel = Instance.new("Model")
	wheelModel.Name = "HelmWheel"
	wheelModel.Parent = kit

	makePart({
		Name = "HelmAxle",
		Parent = wheelModel,
		Size = Vector3.new(1.1, 0.55, 0.55),
		CFrame = wheelCf,
		Color = Color3.fromRGB(48, 34, 22),
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
	})

	-- Rim — thick silhouette so it still reads at sailing distances
	makePart({
		Name = "HelmRim",
		Parent = wheelModel,
		Size = Vector3.new(0.7, 4.8, 4.8),
		CFrame = wheelCf,
		Color = Color3.fromRGB(110, 78, 48),
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
	})

	local hub = makePart({
		Name = "HelmHub",
		Parent = wheelModel,
		Size = Vector3.new(0.85, 1.25, 1.25),
		CFrame = wheelCf,
		Color = Color3.fromRGB(58, 40, 24),
		Material = Enum.Material.Wood,
		Shape = Enum.PartType.Cylinder,
	})
	wheelModel.PrimaryPart = hub

	-- Spokes in the wheel plane (radial around the cylinder axis / local X)
	for i = 0, 5 do
		local angle = math.rad(i * 30)
		makePart({
			Name = `HelmSpoke_{i}`,
			Parent = wheelModel,
			Size = Vector3.new(0.32, 0.32, 3.9),
			CFrame = hub.CFrame * CFrame.Angles(angle, 0, 0),
			Color = Color3.fromRGB(96, 68, 42),
			Material = Enum.Material.Wood,
		})
	end

	-- Handles on the rim
	for i = 0, 7 do
		local angle = math.rad(i * 45)
		makePart({
			Name = `HelmHandle_{i}`,
			Parent = wheelModel,
			Size = Vector3.new(0.4, 1.05, 0.4),
			CFrame = hub.CFrame * CFrame.Angles(angle, 0, 0) * CFrame.new(0, 2.55, 0),
			Color = Color3.fromRGB(130, 92, 55),
			Material = Enum.Material.Wood,
		})
	end

	-- Rest pose relative to the post so the wheel can spin after the raft moves
	local restLocal = Instance.new("CFrameValue")
	restLocal.Name = "WheelRestLocal"
	restLocal.Value = column.CFrame:ToObjectSpace(wheelCf)
	restLocal.Parent = wheelModel

	-- Invisible stand anchor: where the sailor is locked while steering (behind the wheel)
	local stand = makePart({
		Name = "HelmStand",
		Parent = kit,
		Size = Vector3.new(2.4, 0.4, 2.4),
		CFrame = standCf * CFrame.new(0, 0.15, 2.1),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	stand:SetAttribute("IsHelmStand", true)

	-- Prompt rides an upright anchor at hand height on the wheel
	local promptAnchor = makePart({
		Name = "HelmPromptAnchor",
		Parent = kit,
		Size = Vector3.new(1, 1, 1),
		CFrame = wheelCenter * CFrame.new(0, 0, 0.2),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HelmPrompt"
	prompt.ActionText = "Take the Helm"
	prompt.ObjectText = "Steering Wheel"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Config.Helm.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.ClickablePrompt = true
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.UIOffset = Vector2.new(0, -40)
	prompt.Parent = promptAnchor

	return stand, prompt, column
end

function RaftStarterKit.attach(model: Model, deck: BasePart, center: Vector3)
	local existing = model:FindFirstChild("StarterKit")
	if existing then
		existing:Destroy()
	end

	local kit = Instance.new("Folder")
	kit.Name = "StarterKit"
	kit.Parent = model

	local stand, prompt = buildHelmWheel(kit, deck, center)

	-- Flaming torch welded on the raft at spawn (light + fire; can unweld / drag)
	local LootPropService = require(script.Parent:WaitForChild("LootPropService"))
	LootPropService.attachStarterTorch(model, deck)

	return {
		kit = kit,
		stand = stand,
		prompt = prompt,
	}
end

return RaftStarterKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">StarterBaseService</string>
          <string name="Source"><![CDATA[-- One huge open wooden platform per crew — the Survive at Sea starter base.
-- Party size only gates who can join; it never changes the plank footprint.
-- Deck is timber planks with no rails / walls — pure open raft.
--
-- Bases are Models with PrimaryPart = Deck so they can be moved later
-- (sea drift / voyage travel) via setBaseCFrame without rebuilding.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local OceanConfig = require(Shared:WaitForChild("OceanConfig"))
local LobbyWorld = require(Shared:WaitForChild("LobbyWorld"))

local RaftStarterKit = require(script.Parent:WaitForChild("RaftStarterKit"))

local StarterBaseService = {}

StarterBaseService._basesByCode = {} :: { [string]: Model }
-- Optional hook so HelmService can bind the wheel prompt when a base is built.
StarterBaseService._onBaseBuilt = nil :: ((string, Model) -> ())?
StarterBaseService._onBaseDestroyed = nil :: ((string) -> ())?

local function lobbyRoot(): Folder
	local root = Workspace:FindFirstChild("SurviveAtSeaLobby")
	if root and root:IsA("Folder") then
		return root
	end
	return LobbyWorld.ensure()
end

local function basesFolder(): Folder
	local root = lobbyRoot()
	local folder = root:FindFirstChild("StarterBases")
	if folder and folder:IsA("Folder") then
		return folder
	end
	folder = Instance.new("Folder")
	folder.Name = "StarterBases"
	folder.Parent = root
	return folder
end

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "BasePart"
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Material = props.Material or Enum.Material.WoodPlanks
	p.Color = props.Color or Config.Theme.Driftwood
	p.Size = props.Size or Vector3.new(4, 1, 4)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = if props.CastShadow == nil then true else props.CastShadow
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	p.Parent = props.Parent
	return p
end

-- Pivot the assembled raft in one engine operation.  Moving every decorative plank,
-- wheel piece, and marker individually on every helm frame was needlessly expensive
-- once several crews were sailing at the same time.
local function shiftModel(model: Model, fromCFrame: CFrame, toCFrame: CFrame)
	-- The model pivot follows PrimaryPart (Deck), so this places the deck exactly at
	-- toCFrame while preserving all of the raft's local offsets.
	model:PivotTo(toCFrame)
end

-- baseSlot is an independent raft index — not tied to pier PortalCount.
function StarterBaseService.getBaseCenter(baseSlot: number): Vector3
	local cfg = Config.StarterBase
	-- Slot 1 at origin, then ±SpacingX for additional concurrent crews
	local offsetIndex = baseSlot - 1
	return cfg.Origin + Vector3.new(offsetIndex * cfg.SpacingX, 0, 0)
end

function StarterBaseService.getSpawnCFrame(baseSlot: number, slotIndex: number?): CFrame
	local center = StarterBaseService.getBaseCenter(baseSlot)
	local base = StarterBaseService._basesByCode
	-- If a live base exists for this slot, prefer its current deck position (supports future movement)
	for _, model in base do
		local slotValue = model:FindFirstChild("BaseSlot")
		local deck = model.PrimaryPart or model:FindFirstChild("Deck")
		if slotValue and slotValue:IsA("IntValue") and slotValue.Value == baseSlot and deck and deck:IsA("BasePart") then
			center = deck.Position
			break
		end
	end

	local y = center.Y + Config.StarterBase.Thickness / 2 + Config.StarterBase.DeckClearance
	local slot = slotIndex or 1
	local offset = Vector3.new(((slot - 1) % 5) * 4 - 8, 0, math.floor((slot - 1) / 5) * 4 - 2)
	local pos = Vector3.new(center.X, y, center.Z) + offset
	return CFrame.new(pos, pos + Vector3.new(0, 0, -40))
end

function StarterBaseService.ensureBase(code: string, baseSlot: number): Model
	local existing = StarterBaseService._basesByCode[code]
	if existing and existing.Parent then
		return existing
	end

	local size = Config.StarterBase.SizeStuds
	local thickness = Config.StarterBase.Thickness
	local center = StarterBaseService.getBaseCenter(baseSlot)

	local model = Instance.new("Model")
	model.Name = `StarterBase_{code}`
	model.Parent = basesFolder()

	local codeValue = Instance.new("StringValue")
	codeValue.Name = "PartyCode"
	codeValue.Value = code
	codeValue.Parent = model

	local slotValue = Instance.new("IntValue")
	slotValue.Name = "BaseSlot"
	slotValue.Value = baseSlot
	slotValue.Parent = model

	local privacyValue = Instance.new("StringValue")
	privacyValue.Name = "Privacy"
	privacyValue.Value = "Private"
	privacyValue.Parent = model

	-- Structural deck (collision) — warm timber base under the visible plank layer
	local deck = makePart({
		Name = "Deck",
		Parent = model,
		Size = Vector3.new(size, thickness, size),
		CFrame = CFrame.new(center),
		Color = Color3.fromRGB(96, 64, 38),
		Material = Enum.Material.Wood,
	})
	model.PrimaryPart = deck

	-- Legacy local-sea markers (hidden). Real waves come from OceanTerrainService.
	-- Kept as large non-colliding parts so older clients / maps still have a sea hint.
	makePart({
		Name = "LocalSea",
		Parent = model,
		Size = Vector3.new(size + 420, 1.5, size + 420),
		CFrame = CFrame.new(center.X, OceanConfig.SurfaceY, center.Z),
		Color = OceanConfig.WaterColor,
		Material = Enum.Material.Glass,
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	makePart({
		Name = "LocalSeaDeep",
		Parent = model,
		Size = Vector3.new(size + 900, 4, size + 900),
		CFrame = CFrame.new(center.X, OceanConfig.SurfaceY - OceanConfig.DepthStuds + 2, center.Z),
		Color = OceanConfig.AbyssColor,
		Material = Enum.Material.SmoothPlastic,
		Transparency = OceanConfig.AbyssTransparency,
		CanCollide = false,
		CastShadow = false,
	})

	-- Open wooden platform: dense plank boards + timber beams. No rails / walls / posts.
	local half = size / 2
	local deckTop = center.Y + thickness / 2
	local plankColors = {
		Color3.fromRGB(138, 96, 58),
		Color3.fromRGB(122, 82, 48),
		Color3.fromRGB(148, 104, 64),
		Color3.fromRGB(110, 74, 42),
		Color3.fromRGB(132, 90, 54),
		Color3.fromRGB(118, 78, 46),
	}
	local plankW = 3.2
	local plankGap = 0.18
	local plankStep = plankW + plankGap
	local plankCount = math.max(1, math.floor((size - 1.5) / plankStep))
	local plankSpan = plankCount * plankStep - plankGap
	local plankStart = -plankSpan / 2 + plankW / 2
	for i = 0, plankCount - 1 do
		local tone = plankColors[(i % #plankColors) + 1]
		makePart({
			Name = `Plank_{i}`,
			Parent = model,
			Size = Vector3.new(plankW, 0.55, size - 2.4),
			CFrame = CFrame.new(center.X + plankStart + i * plankStep, deckTop + 0.22, center.Z),
			Color = tone,
			Material = Enum.Material.WoodPlanks,
			CanCollide = false,
		})
	end

	-- Cross-grain timber joists peeking between plank runs
	local joistColor = Color3.fromRGB(78, 50, 28)
	for j = -3, 3 do
		makePart({
			Name = `Joist_{j}`,
			Parent = model,
			Size = Vector3.new(size - 3.2, 0.35, 0.9),
			CFrame = CFrame.new(center.X, deckTop + 0.05, center.Z + j * (size / 7)),
			Color = joistColor,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end

	-- Low flush rim boards (trim only — not walls) so the platform edges read as timber
	local rimH = 0.7
	local rimT = 1.35
	local rimY = deckTop + rimH / 2 + 0.15
	local rimColor = Color3.fromRGB(86, 56, 32)
	for _, spec in {
		{ Name = "RimNorth", CFrame = CFrame.new(center.X, rimY, center.Z - half + rimT / 2), Size = Vector3.new(size, rimH, rimT) },
		{ Name = "RimSouth", CFrame = CFrame.new(center.X, rimY, center.Z + half - rimT / 2), Size = Vector3.new(size, rimH, rimT) },
		{ Name = "RimWest", CFrame = CFrame.new(center.X - half + rimT / 2, rimY, center.Z), Size = Vector3.new(rimT, rimH, size - rimT * 2) },
		{ Name = "RimEast", CFrame = CFrame.new(center.X + half - rimT / 2, rimY, center.Z), Size = Vector3.new(rimT, rimH, size - rimT * 2) },
	} do
		makePart({
			Name = spec.Name,
			Parent = model,
			Size = spec.Size,
			CFrame = spec.CFrame,
			Color = rimColor,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end

	-- Underside timber beams so the hull still reads as wood from the waterline
	local beamY = center.Y - thickness / 2 - 0.35
	for b = -2, 2 do
		makePart({
			Name = `KeelBeam_{b}`,
			Parent = model,
			Size = Vector3.new(1.6, 0.9, size - 4),
			CFrame = CFrame.new(center.X + b * (size / 5), beamY, center.Z),
			Color = Color3.fromRGB(72, 46, 26),
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end

	-- The raft is also the crew's opening hub: a small, readable harbour pavilion in
	-- the middle of the archipelago rather than an anonymous flat square. Everything
	-- is part of the moving model, so the pavilion travels with the crew after departure.
	local hub = Instance.new("Model")
	hub.Name = "VoyageHub"
	hub.Parent = model
	local postColor = Color3.fromRGB(76, 50, 29)
	local canopyColor = Color3.fromRGB(42, 92, 67)
	for _, x in { -half + 5, half - 5 } do
		for _, z in { -half + 5, half - 5 } do
			local post = makePart({
				Name = "HarbourPost",
				Parent = hub,
				Size = Vector3.new(1.4, 10, 1.4),
				CFrame = CFrame.new(center.X + x, deckTop + 5, center.Z + z),
				Color = postColor,
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
			local lantern = makePart({
				Name = "HubLantern",
				Parent = hub,
				Size = Vector3.new(1.5, 2.1, 1.5),
				CFrame = post.CFrame * CFrame.new(0, 3.5, 0),
				Color = Color3.fromRGB(255, 181, 78),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CastShadow = false,
			})
			local light = Instance.new("PointLight")
			light.Name = "HarbourGlow"
			light.Color = lantern.Color
			light.Brightness = 1.6
			light.Range = 24
			light.Shadows = false
			light.Parent = lantern
		end
	end

	-- A timber gateway and green sailcloth mark the bow and frame the island ring.
	for _, x in { -12, 12 } do
		makePart({
			Name = "HubGatePost",
			Parent = hub,
			Size = Vector3.new(1.8, 13, 1.8),
			CFrame = CFrame.new(center.X + x, deckTop + 6.5, center.Z - half + 6),
			Color = postColor,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end
	makePart({
		Name = "HubGateBeam",
		Parent = hub,
		Size = Vector3.new(27, 1.8, 1.8),
		CFrame = CFrame.new(center.X, deckTop + 12.4, center.Z - half + 6),
		Color = postColor,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	makePart({
		Name = "HubBanner",
		Parent = hub,
		Size = Vector3.new(16, 5.5, 0.35),
		CFrame = CFrame.new(center.X, deckTop + 9, center.Z - half + 6),
		Color = canopyColor,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
	})

	-- Invisible spawn pad so deaths land on the raft (not the pier)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "RaftSpawn"
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(center + Vector3.new(0, thickness / 2 + 0.6, 0))
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.Transparency = 1
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Enabled = true
	spawn.Parent = model

	-- Starter kit: vertical steering column + upright pirate wheel
	RaftStarterKit.attach(model, deck, center)

	StarterBaseService._basesByCode[code] = model
	if StarterBaseService._onBaseBuilt then
		StarterBaseService._onBaseBuilt(code, model)
	end
	return model
end

-- Future sea travel: move the whole plank (and its local water) as one unit.
function StarterBaseService.setBaseCFrame(code: string, newDeckCFrame: CFrame): boolean
	local model = StarterBaseService._basesByCode[code]
	if not model then
		return false
	end
	local deck = model.PrimaryPart or model:FindFirstChild("Deck")
	if not (deck and deck:IsA("BasePart")) then
		return false
	end
	shiftModel(model, deck.CFrame, newDeckCFrame)
	return true
end

function StarterBaseService.getBaseModel(code: string): Model?
	return StarterBaseService._basesByCode[code]
end

function StarterBaseService.destroyBase(code: string)
	local base = StarterBaseService._basesByCode[code]
	StarterBaseService._basesByCode[code] = nil
	if StarterBaseService._onBaseDestroyed then
		StarterBaseService._onBaseDestroyed(code)
	end
	if base then
		base:Destroy()
	end
end

function StarterBaseService.teleportPlayerToBase(player: Player, baseSlot: number, slotIndex: number)
	local character = player.Character
	if not character then
		return
	end
	local spawnCFrame = StarterBaseService.getSpawnCFrame(baseSlot, slotIndex)
	-- Pivoting the character model does not depend on HumanoidRootPart having
	-- replicated on this exact frame, so boarding cannot silently do nothing.
	character:PivotTo(spawnCFrame)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	-- Bind respawn to this raft so death returns here (for now)
	for _, model in StarterBaseService._basesByCode do
		local slotValue = model:FindFirstChild("BaseSlot")
		local raftSpawn = model:FindFirstChild("RaftSpawn")
		if slotValue and slotValue:IsA("IntValue") and slotValue.Value == baseSlot
			and raftSpawn and raftSpawn:IsA("SpawnLocation")
		then
			player.RespawnLocation = raftSpawn
			break
		end
	end
end

function StarterBaseService.clearRespawn(player: Player)
	player.RespawnLocation = nil
end

function StarterBaseService.teleportPlayerToLobby(player: Player)
	local character = player.Character
	if not character then
		return
	end
	StarterBaseService.clearRespawn(player)
	LobbyWorld.seatCharacter(character)
end

-- If a crewmate falls in the water, put them back on top of their raft.
local rescueDebounce: { [number]: boolean } = {}

function StarterBaseService.startWaterRescue(
	getSeatInfo: (Player) -> ({ baseSlot: number, slotIndex: number }?),
	shouldSkip: ((Player) -> boolean)?
)
	local RunService = game:GetService("RunService")
	local waterY = Config.StarterBase.WaterRescueY

	RunService.Heartbeat:Connect(function()
		for _, player in Players:GetPlayers() do
			if rescueDebounce[player.UserId] then
				continue
			end
			if shouldSkip and shouldSkip(player) then
				continue
			end
			local seat = getSeatInfo(player)
			if not seat then
				continue
			end
			local character = player.Character
			if not character then
				continue
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local root = character:FindFirstChild("HumanoidRootPart")
			if not (humanoid and root and root:IsA("BasePart")) then
				continue
			end
			if humanoid.Health <= 0 then
				continue
			end
			if root.Position.Y > waterY then
				continue
			end

			rescueDebounce[player.UserId] = true
			-- Kill horizontal velocity so they don't immediately slide off again
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			StarterBaseService.teleportPlayerToBase(player, seat.baseSlot, seat.slotIndex)
			task.delay(1.25, function()
				rescueDebounce[player.UserId] = nil
			end)
		end
	end)
end

return StarterBaseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">StarterGearService</string>
          <string name="Source"><![CDATA[-- Grants the starter Club when a player boards a crew raft.
-- Re-grants on respawn if they no longer have one (dropped / lost).
-- Does not grant while on the pier lobby.

local Players = game:GetService("Players")

local ClubToolFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("ClubToolFactory"))

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local StarterGearService = {}

local isInCrew: ((Player) -> boolean)? = nil

local function findClub(container: Instance?): Tool?
	if not container then
		return nil
	end
	for _, child in container:GetChildren() do
		if child:IsA("Tool") and (child.Name == Config.Club.ToolName or child:GetAttribute("ItemId") == "StarterClub") then
			return child
		end
	end
	return nil
end

local function playerHasClub(player: Player): boolean
	if findClub(player:FindFirstChild("Backpack")) then
		return true
	end
	local character = player.Character
	if character and findClub(character) then
		return true
	end
	return false
end

function StarterGearService.ensureStarterClub(player: Player)
	if not isInCrew or not isInCrew(player) then
		return
	end
	if playerHasClub(player) then
		return
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		backpack = player:WaitForChild("Backpack", 5)
	end
	if not backpack then
		return
	end

	local club = ClubToolFactory.create()
	club.Parent = backpack
end

function StarterGearService.clearStarterClub(player: Player)
	local backpack = player:FindFirstChild("Backpack")
	local club = findClub(backpack)
	if club then
		club:Destroy()
	end
	local character = player.Character
	if character then
		local held = findClub(character)
		if held then
			held:Destroy()
		end
	end
end

function StarterGearService.start(inCrewCheck: (Player) -> boolean)
	isInCrew = inCrewCheck

	local function onCharacter(player: Player, _character: Model)
		task.defer(function()
			-- Wait a beat so seat/teleport finishes, then grant if still on crew
			task.wait(0.15)
			if player.Parent then
				StarterGearService.ensureStarterClub(player)
			end
		end)
	end

	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			onCharacter(player, player.Character)
		end
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)
end

return StarterGearService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">VillageBuilder</string>
          <string name="Source"><![CDATA[-- Builds themed island villages: wooden / cobblestone houses (with detachable salvage
-- walls you can drag to your raft), beds, torches, fences, a central campfire or well,
-- weapon pickups and lootable chests. Returns suggested villager + merchant spawn spots.
--
-- Loot props created here (walls, beds, torches) are tagged IsLootProp by LootPropFactory
-- and get auto-registered by IslandService.ensure() after the island is built, so they are
-- immediately draggable / weldable. Weapon pickups wire their own prompt on spawn. Chests
-- are wired here using the passed-in deps (toast / party accessors).

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local Weapons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Weapons"))
local Armor = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Armor"))

local LootPropFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("LootPropFactory"))
local WeaponService = require(script.Parent:WaitForChild("WeaponService"))

local VillageBuilder = {}

local WOOD = Color3.fromRGB(120, 84, 50)
local WOOD_DARK = Color3.fromRGB(80, 54, 32)
local ROOF_THATCH = Color3.fromRGB(150, 120, 64)
local ROOF_WOOD = Color3.fromRGB(74, 50, 30)
local STONE = Color3.fromRGB(128, 130, 132)
local STONE_DARK = Color3.fromRGB(96, 98, 100)
local MOSS = Color3.fromRGB(96, 118, 76)
local ASH = Color3.fromRGB(60, 58, 54)
local GLASS_WARM = Color3.fromRGB(255, 214, 130)
local DOOR_WOOD = Color3.fromRGB(64, 42, 26)
local NET = Color3.fromRGB(196, 188, 150)

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "VillagePart"
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Material = props.Material or Enum.Material.Wood
	p.Color = props.Color or WOOD
	p.Size = props.Size or Vector3.new(1, 1, 1)
	p.CFrame = props.CFrame or CFrame.new()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	-- Village geometry (houses, walls, roofs, fences, towers) no longer casts shadows by
	-- default — a town of 20+ houses was thousands of shadow-casters. Sun/terrain shadows
	-- still apply via GlobalShadows.
	p.CastShadow = props.CastShadow == true
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

-- Level-of-Detail system for buildings based on distance from players
local function setupBuildingLOD(model: Model, center: Vector3)
	local LOD_NEAR = 150   -- Full detail
	local LOD_MID = 300    -- Medium detail
	local LOD_FAR = 500    -- Low detail
	
	local lodFolder = Instance.new("Folder")
	lodFolder.Name = "LODController"
	lodFolder.Parent = model
	
	-- Create LOD script for runtime distance checking
	local lodScript = Instance.new("Script")
	lodScript.Name = "BuildingLOD"
	lodScript.Parent = lodFolder
	
		-- LOD script code (runs on server with optimizations)
	lodScript.Source = [[
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		
		local model = script.Parent.Parent
		local center = Vector3.new(]] .. center.X .. [[, ]] .. center.Y .. [[, ]] .. center.Z .. [[)
		local LOD_NEAR = 150
		local LOD_MID = 300
		local LOD_FAR = 500
		
		-- Cache for performance
		local detailParts = {}
		local borderParts = {}
		local decorativeParts = {}
		
		-- Categorize parts on startup
		for _, child in pairs(model:GetChildren()) do
			if child.Name == "Village" then
				for _, building in pairs(child:GetChildren()) do
					for _, part in pairs(building:GetDescendants()) do
						if part:IsA("BasePart") then
							if part.Name:match("TimberPost") or part.Name:match("TimberBeam") or 
							   part.Name:match("WindowFrame") or part.Name:match("WindowShutter") then
								table.insert(detailParts, part)
							elseif part.Name:match("DoorHandle") or part.Name:match("RoofSupport") or
								   part.Name:match("ChimneyCap") or part.Name:match("StepRail") then
								table.insert(borderParts, part)
							elseif part.Name:match("PathBorder") or part.Name:match("Rubble") or
								   part.Name:match("Finial") or part.Name:match("LanternFrame") then
								table.insert(decorativeParts, part)
							end
						end
					end
				end
			end
		end
		
		local function getClosestPlayerDistance()
			local minDist = math.huge
			for _, player in pairs(Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (player.Character.HumanoidRootPart.Position - center).Magnitude
					minDist = math.min(minDist, dist)
				end
			end
			return minDist
		end
		
		local function setDetailLevel(level)
			-- Level 0: High detail (all visible)
			-- Level 1: Medium detail (hide fine details)  
			-- Level 2: Low detail (hide most decorative elements)
			
			-- Performance optimization: batch operations
			local hideDetail = level >= 2
			local hideBorder = level >= 1
			local hideDecorative = level >= 2
			
			for _, part in pairs(detailParts) do
				if part.Parent then
					part.Transparency = hideDetail and 1 or 0
				end
			end
			
			for _, part in pairs(borderParts) do
				if part.Parent then
					part.Transparency = hideBorder and 1 or 0
				end
			end
			
			for _, part in pairs(decorativeParts) do
				if part.Parent then
					part.Transparency = hideDecorative and 1 or 0
				end
			end
		end
		
		local lastLevel = -1
		local updateTimer = 0
		local UPDATE_INTERVAL = 1.0  -- Update every second for performance
		
		RunService.Heartbeat:Connect(function(dt)
			updateTimer += dt
			if updateTimer < UPDATE_INTERVAL then
				return
			end
			updateTimer = 0
			
			local dist = getClosestPlayerDistance()
			local level = 0
			
			if dist > LOD_FAR then
				level = 2  -- Low detail
			elseif dist > LOD_MID then 
				level = 1  -- Medium detail
			else
				level = 0  -- High detail
			end
			
			if level ~= lastLevel then
				setDetailLevel(level)
				lastLevel = level
			end
		end)
	]]
end

-- Enhanced medieval house with detailed timber framing and architectural variety.
-- `opts`: cobblestone (bool), ruined (bool), islandId (string), style ("timber"|"stone"|"cottage").
-- Walls are detachable salvage (LootPropFactory) so they can be hauled to a raft.
local function buildHouse(model: Model, cf: CFrame, opts: { [string]: any })
	local cobble = opts.cobblestone == true
	local ruined = opts.ruined == true
	local style = opts.style or (if cobble then "stone" else "timber")
	
	-- Enhanced color palette for medieval aesthetics
	local TIMBER_FRAME = Color3.fromRGB(62, 39, 35)
	local PLASTER_WHITE = Color3.fromRGB(245, 240, 230)
	local PLASTER_CREAM = Color3.fromRGB(235, 220, 200)
	local MEDIEVAL_STONE = Color3.fromRGB(140, 135, 130)
	local COBBLE_DARK = Color3.fromRGB(85, 82, 78)
	
	local wallColor = if cobble then MEDIEVAL_STONE else PLASTER_CREAM
	local wallMat = if cobble then Enum.Material.Cobblestone else Enum.Material.SmoothPlastic
	local floorColor = if cobble then COBBLE_DARK else Color3.fromRGB(104, 74, 46)

	local w, d = 16, 14
	local wallH = if ruined then 4.5 else 8.5  -- Slightly taller for more impressive medieval look

	-- Enhanced stone foundation
	local foundation = makePart({
		Name = "HouseFoundation",
		Parent = model,
		Size = Vector3.new(w + 1, 1.2, d + 1),
		CFrame = cf * CFrame.new(0, 0.6, 0),
		Color = STONE_DARK,
		Material = Enum.Material.Cobblestone,
	})

	local floor = makePart({
		Name = "HouseFloor",
		Parent = model,
		Size = Vector3.new(w, 0.4, d),
		CFrame = cf * CFrame.new(0, 1.4, 0),
		Color = floorColor,
		Material = if cobble then Enum.Material.Slate else Enum.Material.WoodPlanks,
	})

	local wallsFolder = Instance.new("Folder")
	wallsFolder.Name = "SalvageWalls"
	wallsFolder.Parent = model

	local wallY = wallH * 0.5 + 1.6
	local specs = {
		{ Name = "WallBack", Size = Vector3.new(w, wallH, 0.8), Offset = Vector3.new(0, wallY, -d * 0.5) },
		{ Name = "WallLeft", Size = Vector3.new(0.8, wallH, d), Offset = Vector3.new(-w * 0.5, wallY, 0) },
		{ Name = "WallRight", Size = Vector3.new(0.8, wallH, d), Offset = Vector3.new(w * 0.5, wallY, 0) },
		{ Name = "WallFrontL", Size = Vector3.new(w * 0.32, wallH, 0.8), Offset = Vector3.new(-w * 0.34, wallY, d * 0.5) },
		{ Name = "WallFrontR", Size = Vector3.new(w * 0.32, wallH, 0.8), Offset = Vector3.new(w * 0.34, wallY, d * 0.5) },
	}
	
	for i, spec in specs do
		-- Ruined houses are missing a wall or two.
		if ruined and (i == 2 or i == 4) and math.random() < 0.6 then
			continue
		end
		local wallCf = cf * CFrame.new(spec.Offset)
		local wall = LootPropFactory.createWallWorld(wallsFolder, spec.Size, wallCf)
		wall.Name = spec.Name
		if opts.islandId then
			wall:SetAttribute("IslandId", opts.islandId)
		end
		wall:SetAttribute("FromHouse", true)
		if cobble then
			local prim = wall.PrimaryPart
			if prim then
				prim.Color = MEDIEVAL_STONE
				prim.Material = Enum.Material.Cobblestone
			end
		else
			local prim = wall.PrimaryPart
			if prim then
				prim.Color = wallColor
				prim.Material = Enum.Material.SmoothPlastic
			end
		end
	end

	-- Add detailed timber framing for non-stone houses
	if not cobble and not ruined then
		-- Vertical timber posts
		for _, pos in { 
			{-w * 0.45, 0, -d * 0.45}, {w * 0.45, 0, -d * 0.45}, 
			{-w * 0.45, 0, d * 0.45}, {w * 0.45, 0, d * 0.45},
			{0, 0, -d * 0.5}, {0, 0, d * 0.5}
		} do
			makePart({
				Name = "TimberPost",
				Parent = model,
				Size = Vector3.new(0.4, wallH, 0.4),
				CFrame = cf * CFrame.new(pos[1], wallY, pos[3]),
				Color = TIMBER_FRAME,
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
		end
		
		-- Horizontal timber beams
		for y = wallH * 0.3, wallH * 0.8, wallH * 0.25 do
			-- Front and back beams
			for _, z in {-d * 0.5, d * 0.5} do
				makePart({
					Name = "TimberBeam",
					Parent = model,
					Size = Vector3.new(w * 0.9, 0.3, 0.4),
					CFrame = cf * CFrame.new(0, 1.6 + y, z),
					Color = TIMBER_FRAME,
					Material = Enum.Material.Wood,
					CanCollide = false,
				})
			end
			-- Side beams
			for _, x in {-w * 0.5, w * 0.5} do
				makePart({
					Name = "TimberBeam",
					Parent = model,
					Size = Vector3.new(0.4, 0.3, d * 0.9),
					CFrame = cf * CFrame.new(x, 1.6 + y, 0),
					Color = TIMBER_FRAME,
					Material = Enum.Material.Wood,
					CanCollide = false,
				})
			end
		end
	end

	if not ruined then
		-- Enhanced pitched roof with overhangs and detailed structure
		for i = -1, 1, 2 do
			makePart({
				Name = "RoofSlope",
				Parent = model,
				Size = Vector3.new(w * 0.65, 0.6, d + 3.0),
				CFrame = cf * CFrame.new(i * w * 0.26, wallY + wallH * 0.45 + 1.8, 0) * CFrame.Angles(0, 0, math.rad(i * -35)),
				Color = if cobble then ROOF_WOOD else Color3.fromRGB(120, 85, 45),
				Material = if cobble then Enum.Material.Wood else Enum.Material.Grass,
			})
		end
		
		-- Roof ridge beam
		makePart({
			Name = "RoofRidge",
			Parent = model,
			Size = Vector3.new(0.8, 0.8, d + 3.2),
			CFrame = cf * CFrame.new(0, wallY + wallH * 0.45 + 3.2, 0),
			Color = ROOF_WOOD,
			Material = Enum.Material.Wood,
		})
		
		-- Roof supports/rafters
		for i = -1, 1, 1 do
			if i ~= 0 then
				makePart({
					Name = "RoofSupport",
					Parent = model,
					Size = Vector3.new(0.3, w * 0.4, 0.3),
					CFrame = cf * CFrame.new(0, wallY + wallH * 0.3 + 1.5, i * d * 0.25) * CFrame.Angles(0, 0, math.rad(i * 25)),
					Color = TIMBER_FRAME,
					Material = Enum.Material.Wood,
					CanCollide = false,
				})
			end
		end
		
		-- Enhanced chimney with detailed brickwork
		if cobble or math.random() < 0.7 then
			local chimney = makePart({
				Name = "Chimney",
				Parent = model,
				Size = Vector3.new(1.6, 4.2, 1.6),
				CFrame = cf * CFrame.new(w * 0.25, wallY + wallH * 0.5 + 2.8, -d * 0.25),
				Color = if cobble then STONE_DARK else Color3.fromRGB(120, 65, 45),
				Material = if cobble then Enum.Material.Cobblestone else Enum.Material.Brick,
			})
			
			-- Chimney cap
			makePart({
				Name = "ChimneyCap",
				Parent = model,
				Size = Vector3.new(2.2, 0.4, 2.2),
				CFrame = cf * CFrame.new(w * 0.25, wallY + wallH * 0.5 + 5.2, -d * 0.25),
				Color = STONE_DARK,
				Material = Enum.Material.Slate,
			})
			
			local smoke = Instance.new("Smoke")
			smoke.Size = 2.8
			smoke.Opacity = 0.3
			smoke.RiseVelocity = 5
			smoke.Color = Color3.fromRGB(180, 180, 180)
			smoke.Parent = chimney
		end
	else
		-- Enhanced ruins with more detail
		makePart({
			Name = "CollapsedBeam",
			Parent = model,
			Size = Vector3.new(w * 0.8, 0.6, 0.6),
			CFrame = cf * CFrame.new(0, wallH * 0.4, 0) * CFrame.Angles(0, math.rad(18), math.rad(24)),
			Color = MOSS,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
		
		-- Rubble pile
		for i = 1, 3 do
			makePart({
				Name = "Rubble",
				Parent = model,
				Size = Vector3.new(1 + math.random(), 0.8 + math.random() * 0.4, 1 + math.random()),
				CFrame = cf * CFrame.new((math.random() - 0.5) * w * 0.8, 2, (math.random() - 0.5) * d * 0.8),
				Color = STONE_DARK,
				Material = Enum.Material.Concrete,
				CanCollide = false,
				Shape = Enum.PartType.Block,
			})
		end
	end

	-- Enhanced door with frame and details
	if not ruined or math.random() < 0.5 then
		-- Door frame
		makePart({
			Name = "DoorFrame",
			Parent = model,
			Size = Vector3.new(w * 0.32, wallH * 0.8, 0.2),
			CFrame = cf * CFrame.new(0, wallY - wallH * 0.1, d * 0.5 + 0.1),
			Color = TIMBER_FRAME,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
		
		-- Door
		makePart({
			Name = "Door",
			Parent = model,
			Size = Vector3.new(w * 0.26, wallH * 0.72, 0.3),
			CFrame = cf * CFrame.new(0, wallY - wallH * 0.14, d * 0.5 + 0.05),
			Color = Color3.fromRGB(85, 55, 35),
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
		
		-- Door handle
		makePart({
			Name = "DoorHandle",
			Parent = model,
			Size = Vector3.new(0.2, 0.2, 0.3),
			CFrame = cf * CFrame.new(w * 0.08, wallY - wallH * 0.14, d * 0.5 + 0.2),
			Color = Color3.fromRGB(60, 60, 60),
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end

	-- Enhanced windows with frames and shutters
	if not ruined then
		for i = -1, 1, 2 do
			-- Window frame
			makePart({
				Name = "WindowFrame",
				Parent = model,
				Size = Vector3.new(0.4, 2.2, 2.4),
				CFrame = cf * CFrame.new(i * w * 0.5, wallY - wallH * 0.1, d * 0.1),
				Color = TIMBER_FRAME,
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
			
			-- Window pane (diamond pattern)
			local pane = makePart({
				Name = "Window",
				Parent = model,
				Size = Vector3.new(0.2, 1.8, 2.0),
				CFrame = cf * CFrame.new(i * w * 0.5, wallY - wallH * 0.1, d * 0.1),
				Color = GLASS_WARM,
				Material = Enum.Material.Neon,
				CanCollide = false,
			})
			pane.Transparency = 0.12
			
			-- Window shutters
			for j = -1, 1, 2 do
				makePart({
					Name = "WindowShutter",
					Parent = model,
					Size = Vector3.new(0.3, 1.8, 0.8),
					CFrame = cf * CFrame.new(i * w * 0.5, wallY - wallH * 0.1, d * 0.1 + j * 1.2),
					Color = Color3.fromRGB(65, 45, 30),
					Material = Enum.Material.Wood,
					CanCollide = false,
				})
			end
		end
	end

	-- Interior bed (loot) + torch (loot)
	local bed = LootPropFactory.createBedWorld(model, cf * CFrame.new(-w * 0.25, 2.5, -d * 0.22))
	if opts.islandId then
		bed:SetAttribute("IslandId", opts.islandId)
	end
	local torch = LootPropFactory.createTorchWorld(model, cf * CFrame.new(w * 0.28, 3.5, -d * 0.22))
	if opts.islandId then
		torch:SetAttribute("IslandId", opts.islandId)
	end
end

-- Enhanced cobblestone street network connecting buildings and village center
local function buildCobblestoneStreets(model: Model, center: Vector3, topY: number, villagerSpots: { Vector3 }, villageRadius: number)
	local COBBLE_MAIN = Color3.fromRGB(110, 108, 105)
	local COBBLE_ACCENT = Color3.fromRGB(95, 92, 88)
	
	-- Main town square (circular plaza)
	local squareRadius = villageRadius * 0.25
	makePart({
		Name = "TownSquare",
		Parent = model,
		Size = Vector3.new(squareRadius * 2, 0.3, squareRadius * 2),
		CFrame = CFrame.new(center.X, topY + 0.15, center.Z),
		Color = COBBLE_MAIN,
		Material = Enum.Material.Cobblestone,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
	})
	
	-- Radial streets from center to houses
	for i, spot in villagerSpots do
		if i > #villagerSpots * 0.7 then break end -- Don't connect every house to avoid overcrowding
		
		local direction = (Vector3.new(spot.X, topY, spot.Z) - Vector3.new(center.X, topY, center.Z)).Unit
		local distance = (Vector3.new(spot.X, topY, spot.Z) - Vector3.new(center.X, topY, center.Z)).Magnitude
		local pathLength = distance - squareRadius - 8 -- Leave gaps at both ends
		
		if pathLength > 10 then
			local pathCenter = Vector3.new(center.X, topY, center.Z) + direction * (squareRadius + pathLength * 0.5 + 8)
			
			-- Main path
			makePart({
				Name = "CobblePath",
				Parent = model,
				Size = Vector3.new(4, 0.2, pathLength),
				CFrame = CFrame.lookAt(pathCenter, pathCenter + direction) * CFrame.Angles(math.rad(90), 0, 0),
				Color = COBBLE_MAIN,
				Material = Enum.Material.Cobblestone,
				CanCollide = false,
			})
			
			-- Path border stones
			for side = -1, 1, 2 do
				makePart({
					Name = "PathBorder",
					Parent = model,
					Size = Vector3.new(0.5, 0.3, pathLength + 2),
					CFrame = CFrame.lookAt(pathCenter + direction:Cross(Vector3.new(0, 1, 0)) * side * 2.2, pathCenter + direction + direction:Cross(Vector3.new(0, 1, 0)) * side * 2.2) * CFrame.Angles(math.rad(90), 0, 0),
					Color = COBBLE_ACCENT,
					Material = Enum.Material.Cobblestone,
					CanCollide = false,
				})
			end
		end
	end
	
	-- Connecting ring road around the village
	local ringRadius = villageRadius * 0.65
	local segments = 24
	for i = 1, segments do
		local angle1 = (i - 1) / segments * math.pi * 2
		local angle2 = i / segments * math.pi * 2
		local pos1 = Vector3.new(center.X + math.cos(angle1) * ringRadius, topY, center.Z + math.sin(angle1) * ringRadius)
		local pos2 = Vector3.new(center.X + math.cos(angle2) * ringRadius, topY, center.Z + math.sin(angle2) * ringRadius)
		local segmentCenter = (pos1 + pos2) * 0.5
		local segmentLength = (pos2 - pos1).Magnitude
		
		makePart({
			Name = "RingRoad",
			Parent = model,
			Size = Vector3.new(3, 0.2, segmentLength),
			CFrame = CFrame.lookAt(segmentCenter, pos2) * CFrame.Angles(math.rad(90), 0, 0),
			Color = COBBLE_MAIN,
			Material = Enum.Material.Cobblestone,
			CanCollide = false,
		})
	end
end

-- A perimeter of short posts + rails around the village heart.
local function buildFenceRing(model: Model, center: Vector3, topY: number, radius: number)
	local posts = math.clamp(math.floor(radius / 6), 10, 40)
	for i = 1, posts do
		local a = (i / posts) * math.pi * 2
		local x = center.X + math.cos(a) * radius
		local z = center.Z + math.sin(a) * radius
		makePart({
			Name = "FencePost",
			Parent = model,
			Size = Vector3.new(0.5, 3, 0.5),
			CFrame = CFrame.new(x, topY + 1.3, z),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end
end

local function buildCampfire(model: Model, pos: Vector3)
	local ring = makePart({
		Name = "FirePit",
		Parent = model,
		Size = Vector3.new(4, 0.5, 4),
		CFrame = CFrame.new(pos),
		Color = STONE_DARK,
		Material = Enum.Material.Slate,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	})
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	local logs = makePart({
		Name = "Logs",
		Parent = model,
		Size = Vector3.new(2.4, 1.0, 2.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.7, 0)),
		Color = ASH,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 12
	fire.Color = Color3.fromRGB(255, 140, 40)
	fire.Parent = logs
	local light = Instance.new("PointLight")
	light.Brightness = 3
	light.Range = 34
	light.Color = Color3.fromRGB(255, 176, 90)
	light.Parent = logs
end

-- A lootable chest. Wired here with deps so IslandService stays lean.
local function buildChest(model: Model, cf: CFrame, islandId: string, deps: { [string]: any })
	local chest = makePart({
		Name = "VillageChest",
		Parent = model,
		Size = Vector3.new(2.6, 1.7, 1.7),
		CFrame = cf,
		Color = Color3.fromRGB(96, 68, 36),
		Material = Enum.Material.Wood,
	})
	chest:SetAttribute("IslandId", islandId)
	makePart({
		Name = "ChestLid",
		Parent = model,
		Size = Vector3.new(2.75, 0.4, 1.85),
		CFrame = cf * CFrame.new(0, 1.0, 0),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
	})

	local anchor = makePart({
		Name = "ChestPromptAnchor",
		Parent = model,
		Size = Vector3.new(1, 1, 1),
		CFrame = cf * CFrame.new(0, 1.4, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ChestPrompt"
	prompt.ActionText = "Loot"
	prompt.ObjectText = "Village Cache"
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor

	prompt.Triggered:Connect(function(player: Player)
		if deps.isLocked and deps.getPartyCode then
			local code = deps.getPartyCode(player)
			if code and deps.isLocked(code, islandId) then
				if deps.toast then
					deps.toast(player, "This isle is closed to your crew.", "error")
				end
				return
			end
		end
		if chest:GetAttribute("Looted_" .. player.UserId) == true then
			if deps.toast then
				deps.toast(player, "You already looted this cache.", "info")
			end
			return
		end
		chest:SetAttribute("Looted_" .. player.UserId, true)
		VillageBuilder.grantChestLoot(player, deps)
	end)
end

-- Random chest reward: weapon (+starter ammo), armor, ammo bundle, or currency.
function VillageBuilder.grantChestLoot(player: Player, deps: { [string]: any })
	local roll = math.random()
	if roll < 0.38 then
		local weaponId = Weapons.rollLootWeapon(function(a, b)
			return math.random(a, b)
		end)
		local def = Weapons.get(weaponId)
		WeaponService.giveWeapon(player, weaponId, true)
		if def and def.Class == "ranged" and def.Ammo then
			WeaponService.giveAmmo(player, def.Ammo, Weapons.AmmoBundle[def.Ammo] or 6)
		end
		if deps.toast then
			deps.toast(player, `Looted a {def and def.Name or weaponId}!`, "success")
		end
	elseif roll < 0.58 and deps.wearArmor then
		-- Armor cache — equipped straight away (swaps the slot).
		local armorId = Armor.rollLootArmor(function(a, b)
			return math.random(a, b)
		end)
		local def = Armor.get(armorId)
		deps.wearArmor(player, armorId)
		if deps.toast and def then
			deps.toast(player, `Looted {def.Name} armor!`, "success")
		end
	elseif roll < 0.78 then
		local types = { "Bullet", "Shell", "Arrow", "Powder" }
		local ammoId = types[math.random(1, #types)]
		local amount = (Weapons.AmmoBundle[ammoId] or 6) * math.random(1, 2)
		WeaponService.giveAmmo(player, ammoId, amount)
		if deps.toast then
			deps.toast(player, `Found {amount} {Weapons.Ammo[ammoId].Label}.`, "success")
		end
	else
		local doubloons = math.random(10, 30)
		local scrap = math.random(3, 8)
		WeaponService.addCurrency(player, "Doubloons", doubloons)
		WeaponService.addCurrency(player, "Scrap", scrap)
		if deps.toast then
			deps.toast(player, `Found {doubloons} Doubloons & {scrap} Scrap.`, "success")
		end
	end
end

-- A stone well — village centrepiece for stone settlements.
local function buildWell(model: Model, pos: Vector3)
	-- Vertical stone ring (cylinder axis is local X, so rotate 90° about Z to stand it up).
	makePart({
		Name = "WellRing",
		Parent = model,
		Size = Vector3.new(2.4, 4.4, 4.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = STONE,
		Material = Enum.Material.Cobblestone,
		Shape = Enum.PartType.Cylinder,
		CanCollide = true,
	})
	makePart({
		Name = "WellWater",
		Parent = model,
		Size = Vector3.new(3.4, 0.3, 3.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 2.0, 0)),
		Color = Color3.fromRGB(40, 96, 120),
		Material = Enum.Material.Glass,
		CanCollide = false,
	})
	for i = -1, 1, 2 do
		makePart({
			Name = "WellPost",
			Parent = model,
			Size = Vector3.new(0.4, 3.4, 0.4),
			CFrame = CFrame.new(pos + Vector3.new(i * 1.9, 3.0, 0)),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
	end
	makePart({
		Name = "WellRoof",
		Parent = model,
		Size = Vector3.new(5.0, 0.4, 2.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 4.8, 0)),
		Color = ROOF_WOOD,
		Material = Enum.Material.Wood,
	})
end

-- A covered market stall with a striped awning — a town square touch.
local function buildMarketStall(model: Model, cf: CFrame)
	makePart({
		Name = "StallCounter",
		Parent = model,
		Size = Vector3.new(5, 1.6, 2),
		CFrame = cf * CFrame.new(0, 0.8, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	for _, sx in { -2.2, 2.2 } do
		makePart({
			Name = "StallPost",
			Parent = model,
			Size = Vector3.new(0.3, 4.2, 0.3),
			CFrame = cf * CFrame.new(sx, 2.1, -0.8),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
	end
	makePart({
		Name = "StallAwning",
		Parent = model,
		Size = Vector3.new(5.6, 0.3, 3),
		CFrame = cf * CFrame.new(0, 4.2, -0.2) * CFrame.Angles(math.rad(-16), 0, 0),
		Color = Color3.fromRGB(180, 72, 66),
		Material = Enum.Material.Fabric,
	})
end

-- Fish-drying rack with hanging catch — a fishing-village staple.
local function buildFishRack(model: Model, cf: CFrame)
	for _, sx in { -2, 2 } do
		makePart({
			Name = "RackPost",
			Parent = model,
			Size = Vector3.new(0.3, 3.4, 0.3),
			CFrame = cf * CFrame.new(sx, 1.7, 0),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
	end
	makePart({
		Name = "RackBar",
		Parent = model,
		Size = Vector3.new(4.4, 0.25, 0.25),
		CFrame = cf * CFrame.new(0, 3.2, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	for i = -1, 1 do
		makePart({
			Name = "DryingNet",
			Parent = model,
			Size = Vector3.new(0.1, 1.6, 1.2),
			CFrame = cf * CFrame.new(i * 1.3, 2.2, 0),
			Color = NET,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
end

-- A stone watchtower — stone-town skyline landmark with a torch on top.
local function buildWatchtower(model: Model, pos: Vector3)
	makePart({
		Name = "TowerBody",
		Parent = model,
		Size = Vector3.new(6, 18, 6),
		CFrame = CFrame.new(pos + Vector3.new(0, 9, 0)),
		Color = STONE,
		Material = Enum.Material.Cobblestone,
		CanCollide = true,
	})
	makePart({
		Name = "TowerCrown",
		Parent = model,
		Size = Vector3.new(7, 1.6, 7),
		CFrame = CFrame.new(pos + Vector3.new(0, 18.5, 0)),
		Color = STONE_DARK,
		Material = Enum.Material.Cobblestone,
	})
	-- Battlement teeth
	for i = 0, 3 do
		local a = math.rad(i * 90)
		makePart({
			Name = "Merlon",
			Parent = model,
			Size = Vector3.new(1.4, 1.6, 1.4),
			CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 2.6, 19.8, math.sin(a) * 2.6)),
			Color = STONE,
			Material = Enum.Material.Cobblestone,
		})
	end
end

-- === Palette for grand structures (church / mansion / castle / lamps) ===============
local STONE_LIGHT = Color3.fromRGB(178, 180, 182)
local GOLD = Color3.fromRGB(226, 190, 96)
local BANNER = Color3.fromRGB(150, 46, 52)
local BANNER_GOLD = Color3.fromRGB(210, 176, 96)
local LAMP_GLASS = Color3.fromRGB(255, 224, 150)
local IRON = Color3.fromRGB(58, 60, 66)
local STAINED = {
	Color3.fromRGB(196, 72, 72),
	Color3.fromRGB(72, 132, 196),
	Color3.fromRGB(96, 176, 96),
	Color3.fromRGB(226, 196, 96),
}

-- A warm glowing lantern head + PointLight (shadowless — see makePart notes). Used by
-- lamp posts, mansions and castle walls to make a settlement read as "lit up".
local function attachLampGlow(holder: BasePart, range: number?)
	local light = Instance.new("PointLight")
	light.Brightness = 2.2
	light.Range = range or 26
	light.Color = Color3.fromRGB(255, 206, 130)
	light.Shadows = false
	light.Parent = holder
	return light
end

-- A climbable ladder. TrussParts are auto-climbable by Roblox Humanoids, so this is a
-- real way to scale towers, steeples and cliffs. `height` studs tall, base at basePos.
local function buildLadder(model: Model, basePos: Vector3, height: number, yaw: number?): BasePart
	local truss = Instance.new("TrussPart")
	truss.Name = "Ladder"
	truss.Anchored = true
	truss.CanCollide = true
	truss.Color = Color3.fromRGB(96, 66, 40)
	truss.Material = Enum.Material.Wood
	-- TrussPart climbs along its Y axis; X/Z are fixed at 2 studs.
	truss.Size = Vector3.new(2, height, 2)
	truss.CFrame = CFrame.new(basePos + Vector3.new(0, height * 0.5, 0)) * CFrame.Angles(0, yaw or 0, 0)
	truss.CastShadow = false
	truss.Parent = model
	return truss
end

-- A lit iron street lamp — the backbone of a town that glows at night.
local function buildLampPost(model: Model, pos: Vector3)
	makePart({
		Name = "LampPost",
		Parent = model,
		Size = Vector3.new(0.5, 7.5, 0.5),
		CFrame = CFrame.new(pos + Vector3.new(0, 3.75, 0)),
		Color = IRON,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	local lantern = makePart({
		Name = "Lantern",
		Parent = model,
		Size = Vector3.new(1.1, 1.5, 1.1),
		CFrame = CFrame.new(pos + Vector3.new(0, 7.7, 0)),
		Color = LAMP_GLASS,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	makePart({
		Name = "LampCap",
		Parent = model,
		Size = Vector3.new(1.5, 0.4, 1.5),
		CFrame = CFrame.new(pos + Vector3.new(0, 8.6, 0)),
		Color = IRON,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	attachLampGlow(lantern, 30)
end

-- A stone church: nave with a pitched roof, arched stained-glass windows, a warm interior
-- glow, and a tall bell tower topped with a golden cross. A climbable ladder runs up the
-- tower so players can reach the belfry. `cf` faces the church entrance toward +Z.
local function buildChurch(model: Model, cf: CFrame, islandId: string?)
	local w, d, wallH = 18, 30, 13

	makePart({
		Name = "ChurchFloor",
		Parent = model,
		Size = Vector3.new(w + 1, 0.8, d + 1),
		CFrame = cf * CFrame.new(0, 0.4, 0),
		Color = STONE_DARK,
		Material = Enum.Material.Slate,
	})

	-- Four stone walls (front wall split to leave a doorway).
	local wallY = wallH * 0.5 + 0.8
	local wallSpecs = {
		{ Name = "NaveBack", Size = Vector3.new(w, wallH, 0.9), Offset = Vector3.new(0, wallY, -d * 0.5) },
		{ Name = "NaveLeft", Size = Vector3.new(0.9, wallH, d), Offset = Vector3.new(-w * 0.5, wallY, 0) },
		{ Name = "NaveRight", Size = Vector3.new(0.9, wallH, d), Offset = Vector3.new(w * 0.5, wallY, 0) },
		{ Name = "NaveFrontL", Size = Vector3.new(w * 0.36, wallH, 0.9), Offset = Vector3.new(-w * 0.32, wallY, d * 0.5) },
		{ Name = "NaveFrontR", Size = Vector3.new(w * 0.36, wallH, 0.9), Offset = Vector3.new(w * 0.32, wallY, d * 0.5) },
	}
	for _, spec in wallSpecs do
		makePart({
			Name = spec.Name,
			Parent = model,
			Size = spec.Size,
			CFrame = cf * CFrame.new(spec.Offset),
			Color = STONE,
			Material = Enum.Material.Cobblestone,
		})
	end

	-- Pitched roof panels + ridge.
	for i = -1, 1, 2 do
		makePart({
			Name = "ChurchRoof",
			Parent = model,
			Size = Vector3.new(w * 0.64, 0.6, d + 2),
			CFrame = cf * CFrame.new(i * w * 0.25, wallY + wallH * 0.5 + 1.4, 0) * CFrame.Angles(0, 0, math.rad(i * -34)),
			Color = ROOF_WOOD,
			Material = Enum.Material.Wood,
		})
	end
	makePart({
		Name = "ChurchRidge",
		Parent = model,
		Size = Vector3.new(0.7, 0.7, d + 2.1),
		CFrame = cf * CFrame.new(0, wallY + wallH * 0.5 + 2.6, 0),
		Color = ROOF_WOOD,
		Material = Enum.Material.Wood,
	})

	-- Arched stained-glass windows down each side (emissive so they "glow").
	for i = -2, 2 do
		if i == 0 then
			continue
		end
		for side = -1, 1, 2 do
			local pane = makePart({
				Name = "StainedGlass",
				Parent = model,
				Size = Vector3.new(0.3, 3.4, 1.6),
				CFrame = cf * CFrame.new(side * w * 0.5, wallY, i * d * 0.16),
				Color = STAINED[((i + 2) % #STAINED) + 1],
				Material = Enum.Material.Neon,
				CanCollide = false,
			})
			pane.Transparency = 0.12
		end
	end

	-- Big doors.
	makePart({
		Name = "ChurchDoor",
		Parent = model,
		Size = Vector3.new(w * 0.24, wallH * 0.66, 0.4),
		CFrame = cf * CFrame.new(0, wallY - wallH * 0.16, d * 0.5),
		Color = DOOR_WOOD,
		Material = Enum.Material.Wood,
		CanCollide = false,
	})

	-- Warm interior glow.
	local glowHolder = makePart({
		Name = "ChurchGlow",
		Parent = model,
		Size = Vector3.new(1, 1, 1),
		CFrame = cf * CFrame.new(0, wallH * 0.5, 0),
		Transparency = 1,
		CanCollide = false,
	})
	attachLampGlow(glowHolder, 46)

	-- Bell tower at the back, rising well above the roof.
	local towerH = wallH + 16
	local towerW = 6
	local towerCf = cf * CFrame.new(0, 0, -d * 0.5 + towerW * 0.5)
	makePart({
		Name = "BellTower",
		Parent = model,
		Size = Vector3.new(towerW, towerH, towerW),
		CFrame = towerCf * CFrame.new(0, towerH * 0.5 + 0.8, 0),
		Color = STONE,
		Material = Enum.Material.Cobblestone,
	})
	-- Belfry openings (dark) near the top.
	for side = -1, 1, 2 do
		makePart({
			Name = "BelfryArch",
			Parent = model,
			Size = Vector3.new(towerW + 0.1, 3, 1.4),
			CFrame = towerCf * CFrame.new(0, towerH - 3, side * (towerW * 0.5 - 0.2)),
			Color = STONE_DARK,
			Material = Enum.Material.Slate,
			CanCollide = false,
		})
	end
	-- The bell.
	makePart({
		Name = "Bell",
		Parent = model,
		Size = Vector3.new(2, 2.2, 2),
		CFrame = towerCf * CFrame.new(0, towerH - 3, 0),
		Color = GOLD,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	-- Spire + golden cross crowning the steeple.
	makePart({
		Name = "Spire",
		Parent = model,
		Size = Vector3.new(towerW - 1, 5, towerW - 1),
		CFrame = towerCf * CFrame.new(0, towerH + 3, 0),
		Color = ROOF_WOOD,
		Material = Enum.Material.Wood,
	})
	makePart({
		Name = "CrossV",
		Parent = model,
		Size = Vector3.new(0.5, 3.2, 0.5),
		CFrame = towerCf * CFrame.new(0, towerH + 7.2, 0),
		Color = GOLD,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	makePart({
		Name = "CrossH",
		Parent = model,
		Size = Vector3.new(2, 0.5, 0.5),
		CFrame = towerCf * CFrame.new(0, towerH + 7.8, 0),
		Color = GOLD,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})

	-- Climbable ladder up the outside of the tower to reach the belfry.
	local _, churchYaw = cf:ToOrientation()
	buildLadder(model, (towerCf * CFrame.new(0, 0, -towerW * 0.5 - 0.6)).Position, towerH - 2, churchYaw)
end

-- A grand two-storey manor house: columned portico entrance, many lit windows, a balcony
-- and a chimney. `cobble` gives it a stone-town palette instead of timber.
local function buildMansion(model: Model, cf: CFrame, cobble: boolean, islandId: string?)
	local w, d = 24, 20
	local storyH = 7
	local wallColor = if cobble then STONE else Color3.fromRGB(150, 120, 84)
	local wallMat = if cobble then Enum.Material.Cobblestone else Enum.Material.WoodPlanks

	makePart({
		Name = "ManorFloor",
		Parent = model,
		Size = Vector3.new(w + 1, 0.8, d + 1),
		CFrame = cf * CFrame.new(0, 0.4, 0),
		Color = STONE_DARK,
		Material = Enum.Material.Slate,
	})

	-- Two stacked storeys of solid walls (front wall left open at ground for the portico).
	for story = 0, 1 do
		local baseY = 0.8 + story * storyH + storyH * 0.5
		local specs = {
			{ Name = "Back", Size = Vector3.new(w, storyH, 0.8), Offset = Vector3.new(0, baseY, -d * 0.5) },
			{ Name = "Left", Size = Vector3.new(0.8, storyH, d), Offset = Vector3.new(-w * 0.5, baseY, 0) },
			{ Name = "Right", Size = Vector3.new(0.8, storyH, d), Offset = Vector3.new(w * 0.5, baseY, 0) },
			{ Name = "Front", Size = Vector3.new(w, storyH, 0.8), Offset = Vector3.new(0, baseY, d * 0.5) },
		}
		for _, spec in specs do
			-- Ground front stays open (portico), upper front is solid with a balcony rail.
			if story == 0 and spec.Name == "Front" then
				continue
			end
			makePart({
				Name = `Manor_{spec.Name}_{story}`,
				Parent = model,
				Size = spec.Size,
				CFrame = cf * CFrame.new(spec.Offset),
				Color = wallColor,
				Material = wallMat,
			})
		end
		-- Storey divider slab.
		makePart({
			Name = `ManorFloorSlab_{story}`,
			Parent = model,
			Size = Vector3.new(w, 0.5, d),
			CFrame = cf * CFrame.new(0, 0.8 + (story + 1) * storyH, 0),
			Color = STONE_DARK,
			Material = Enum.Material.Slate,
		})
		-- Lit windows around this storey.
		for i = -1, 1, 2 do
			for _, zf in { -0.28, 0.0, 0.28 } do
				local pane = makePart({
					Name = "ManorWindow",
					Parent = model,
					Size = Vector3.new(0.3, 2.6, 1.6),
					CFrame = cf * CFrame.new(i * w * 0.5, baseY, zf * d),
					Color = GLASS_WARM,
					Material = Enum.Material.Neon,
					CanCollide = false,
				})
				pane.Transparency = 0.15
			end
		end
	end

	-- Portico: columns + entablature over the ground-floor entrance.
	for _, sx in { -w * 0.32, -w * 0.11, w * 0.11, w * 0.32 } do
		makePart({
			Name = "Column",
			Parent = model,
			Size = Vector3.new(1.4, storyH - 0.5, 1.4),
			CFrame = cf * CFrame.new(sx, 0.8 + (storyH - 0.5) * 0.5, d * 0.5 + 2.2),
			Color = STONE_LIGHT,
			Material = Enum.Material.Marble,
		})
	end
	makePart({
		Name = "Portico",
		Parent = model,
		Size = Vector3.new(w * 0.86, 0.8, 5),
		CFrame = cf * CFrame.new(0, 0.8 + storyH, d * 0.5 + 1.6),
		Color = STONE_LIGHT,
		Material = Enum.Material.Marble,
	})
	-- Balcony rail on the upper front.
	makePart({
		Name = "BalconyRail",
		Parent = model,
		Size = Vector3.new(w * 0.86, 1.1, 0.4),
		CFrame = cf * CFrame.new(0, 0.8 + storyH + 0.9, d * 0.5 + 3.8),
		Color = STONE_LIGHT,
		Material = Enum.Material.Marble,
		CanCollide = false,
	})

	-- Pitched roof + chimney.
	for i = -1, 1, 2 do
		makePart({
			Name = "ManorRoof",
			Parent = model,
			Size = Vector3.new(w * 0.62, 0.6, d + 2),
			CFrame = cf * CFrame.new(i * w * 0.24, 0.8 + 2 * storyH + 1.6, 0) * CFrame.Angles(0, 0, math.rad(i * -30)),
			Color = ROOF_WOOD,
			Material = Enum.Material.Wood,
		})
	end
	local chimney = makePart({
		Name = "ManorChimney",
		Parent = model,
		Size = Vector3.new(1.6, 4, 1.6),
		CFrame = cf * CFrame.new(w * 0.3, 0.8 + 2 * storyH + 3, -d * 0.3),
		Color = STONE_DARK,
		Material = Enum.Material.Cobblestone,
	})
	local smoke = Instance.new("Smoke")
	smoke.Size = 3
	smoke.Opacity = 0.22
	smoke.RiseVelocity = 5
	smoke.Color = Color3.fromRGB(180, 180, 180)
	smoke.Parent = chimney
end

-- A huge castle: square curtain walls with battlements, four corner towers, a gatehouse,
-- a tall central keep, hanging banners, wall torches, and climbable ladders up the towers.
-- Centred on `center`, sized by `radius` (half the wall span). Reused by the "castle" theme.
local function buildCastle(model: Model, center: Vector3, topY: number, radius: number, islandId: string?)
	local wallH = 20
	local wallT = 3
	local half = radius
	local baseY = topY + wallH * 0.5

	local function wallRun(name: string, size: Vector3, pos: Vector3)
		makePart({
			Name = name,
			Parent = model,
			Size = size,
			CFrame = CFrame.new(pos),
			Color = STONE,
			Material = Enum.Material.Cobblestone,
		})
	end

	-- Four curtain walls, with a gap in the front (+Z) wall for the gate.
	wallRun("WallBack", Vector3.new(half * 2, wallH, wallT), Vector3.new(center.X, baseY, center.Z - half))
	wallRun("WallLeft", Vector3.new(wallT, wallH, half * 2), Vector3.new(center.X - half, baseY, center.Z))
	wallRun("WallRight", Vector3.new(wallT, wallH, half * 2), Vector3.new(center.X + half, baseY, center.Z))
	local gateGap = half * 0.5
	wallRun("WallFrontL", Vector3.new(half - gateGap * 0.5, wallH, wallT), Vector3.new(center.X - (half + gateGap * 0.5) * 0.5, baseY, center.Z + half))
	wallRun("WallFrontR", Vector3.new(half - gateGap * 0.5, wallH, wallT), Vector3.new(center.X + (half + gateGap * 0.5) * 0.5, baseY, center.Z + half))

	-- Battlement merlons along all four wall tops.
	local function crenellate(fromP: Vector3, toP: Vector3)
		local span = (toP - fromP).Magnitude
		local count = math.max(2, math.floor(span / 6))
		for i = 0, count do
			local t = i / count
			local p = fromP:Lerp(toP, t)
			makePart({
				Name = "Merlon",
				Parent = model,
				Size = Vector3.new(2, 2.4, 2),
				CFrame = CFrame.new(p.X, topY + wallH + 1.2, p.Z),
				Color = STONE_DARK,
				Material = Enum.Material.Cobblestone,
				CastShadow = false,
			})
		end
	end
	crenellate(Vector3.new(center.X - half, 0, center.Z - half), Vector3.new(center.X + half, 0, center.Z - half))
	crenellate(Vector3.new(center.X - half, 0, center.Z + half), Vector3.new(center.X + half, 0, center.Z + half))
	crenellate(Vector3.new(center.X - half, 0, center.Z - half), Vector3.new(center.X - half, 0, center.Z + half))
	crenellate(Vector3.new(center.X + half, 0, center.Z - half), Vector3.new(center.X + half, 0, center.Z + half))

	-- Four corner towers (taller than the walls) with a ladder up each + a torch on top.
	local towerH = wallH + 14
	for _, corner in {
		Vector3.new(-half, 0, -half),
		Vector3.new(half, 0, -half),
		Vector3.new(-half, 0, half),
		Vector3.new(half, 0, half),
	} do
		local tx, tz = center.X + corner.X, center.Z + corner.Z
		makePart({
			Name = "CornerTower",
			Parent = model,
			Size = Vector3.new(9, towerH, 9),
			CFrame = CFrame.new(tx, topY + towerH * 0.5, tz),
			Color = STONE,
			Material = Enum.Material.Cobblestone,
		})
		makePart({
			Name = "TowerCrown",
			Parent = model,
			Size = Vector3.new(10.5, 1.6, 10.5),
			CFrame = CFrame.new(tx, topY + towerH + 0.8, tz),
			Color = STONE_DARK,
			Material = Enum.Material.Cobblestone,
		})
		for i = 0, 3 do
			local a = math.rad(i * 90 + 45)
			makePart({
				Name = "TowerMerlon",
				Parent = model,
				Size = Vector3.new(1.6, 1.8, 1.6),
				CFrame = CFrame.new(tx + math.cos(a) * 4, topY + towerH + 2, tz + math.sin(a) * 4),
				Color = STONE_DARK,
				Material = Enum.Material.Cobblestone,
				CastShadow = false,
			})
		end
		buildLadder(model, Vector3.new(tx + 5.4, topY, tz), towerH - 2)
		local torch = LootPropFactory.createTorchWorld(model, CFrame.new(tx, topY + towerH + 1.6, tz))
		if islandId then
			torch:SetAttribute("IslandId", islandId)
		end
	end

	-- Gatehouse framing the entrance, with a raised portcullis and banners.
	for _, sx in { -gateGap * 0.5 - 1.5, gateGap * 0.5 + 1.5 } do
		makePart({
			Name = "GatePillar",
			Parent = model,
			Size = Vector3.new(3, wallH + 6, wallT + 2),
			CFrame = CFrame.new(center.X + sx, topY + (wallH + 6) * 0.5, center.Z + half),
			Color = STONE_DARK,
			Material = Enum.Material.Cobblestone,
		})
	end
	makePart({
		Name = "GateArch",
		Parent = model,
		Size = Vector3.new(gateGap + 5, 4, wallT + 2),
		CFrame = CFrame.new(center.X, topY + wallH + 4, center.Z + half),
		Color = STONE_DARK,
		Material = Enum.Material.Cobblestone,
	})
	makePart({
		Name = "Portcullis",
		Parent = model,
		Size = Vector3.new(gateGap, 6, 0.4),
		CFrame = CFrame.new(center.X, topY + wallH + 5, center.Z + half),
		Color = IRON,
		Material = Enum.Material.DiamondPlate,
		CanCollide = false,
	})
	for _, sx in { -gateGap * 0.5 - 1.5, gateGap * 0.5 + 1.5 } do
		makePart({
			Name = "GateBanner",
			Parent = model,
			Size = Vector3.new(0.3, 6, 2.4),
			CFrame = CFrame.new(center.X + sx, topY + wallH - 1, center.Z + half + wallT * 0.5 + 0.3),
			Color = BANNER,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end

	-- Central keep: a tall square tower with its own battlements and a ladder up.
	local keepW = math.max(16, half * 0.7)
	local keepH = towerH + 14
	makePart({
		Name = "Keep",
		Parent = model,
		Size = Vector3.new(keepW, keepH, keepW),
		CFrame = CFrame.new(center.X, topY + keepH * 0.5, center.Z),
		Color = STONE,
		Material = Enum.Material.Cobblestone,
	})
	makePart({
		Name = "KeepCrown",
		Parent = model,
		Size = Vector3.new(keepW + 2, 2, keepW + 2),
		CFrame = CFrame.new(center.X, topY + keepH + 1, center.Z),
		Color = STONE_DARK,
		Material = Enum.Material.Cobblestone,
	})
	for i = 0, 7 do
		local a = math.rad(i * 45)
		makePart({
			Name = "KeepMerlon",
			Parent = model,
			Size = Vector3.new(2, 2, 2),
			CFrame = CFrame.new(center.X + math.cos(a) * keepW * 0.5, topY + keepH + 2.5, center.Z + math.sin(a) * keepW * 0.5),
			Color = STONE_DARK,
			Material = Enum.Material.Cobblestone,
			CastShadow = false,
		})
	end
	-- Keep banner + a golden pennant on top.
	makePart({
		Name = "KeepBanner",
		Parent = model,
		Size = Vector3.new(0.3, 8, 3),
		CFrame = CFrame.new(center.X, topY + keepH * 0.7, center.Z + keepW * 0.5 + 0.3),
		Color = BANNER,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})
	makePart({
		Name = "KeepPennant",
		Parent = model,
		Size = Vector3.new(0.4, 6, 0.4),
		CFrame = CFrame.new(center.X, topY + keepH + 5, center.Z),
		Color = BANNER_GOLD,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	buildLadder(model, Vector3.new(center.X + keepW * 0.5 + 0.6, topY, center.Z), keepH - 2)
end

-- Main entry. Returns { villagerSpots = {Vector3}, merchantSpot = Vector3 }.
function VillageBuilder.build(
	model: Model,
	center: Vector3,
	size: number,
	topY: number,
	entry: { [string]: any },
	deps: { [string]: any }
): { villagerSpots: { Vector3 }, merchantSpot: Vector3 }
	local theme = entry.Theme or "village"
	local islandId = entry.Id
	local abandoned = entry.Abandoned == true
	-- Stone settlements (stone_village / stone_town) get cobblestone houses.
	local cobble = theme == "stone_village" or theme == "stone_town"
	-- Towns are larger settlements — more houses spread over a wider heart.
	local isTown = theme == "town" or theme == "stone_town"
	local half = size * 0.5
	local villageRadius = half * (if isTown then 0.62 else 0.5)

	local villageFolder = Instance.new("Folder")
	villageFolder.Name = "Village"
	villageFolder.Parent = model

	-- === Castle isles ===============================================================
	-- Some islands are just one huge castle rising out of the jungle. Build the keep,
	-- scatter garrison loot inside the courtyard, and hand back guard posts + a merchant
	-- spot just outside the gate. No houses / campfire / fences.
	if theme == "castle" then
		local castleRadius = math.clamp(half * 0.4, 70, 240)
		buildCastle(villageFolder, center, topY, castleRadius, islandId)

		-- Wall + gate lighting so the keep glows if the isle is flagged Lit.
		if entry.Lit == true then
			local lamps = 8
			for i = 1, lamps do
				local a = (i / lamps) * math.pi * 2
				local r = castleRadius * 0.72
				buildLampPost(villageFolder, Vector3.new(center.X + math.cos(a) * r, topY, center.Z + math.sin(a) * r))
			end
		end

		-- Garrison guard posts spread across the courtyard.
		local guardSpots: { Vector3 } = {}
		for i = 1, 16 do
			local a = (i / 16) * math.pi * 2 + math.random() * 0.4
			local r = castleRadius * (0.2 + math.random() * 0.55)
			table.insert(guardSpots, Vector3.new(center.X + math.cos(a) * r, topY + 2.5, center.Z + math.sin(a) * r))
		end

		-- Treasure: weapon / armor / chest loot inside the walls.
		local weaponCount = (entry.Loot and entry.Loot.Weapons) or 4
		for _ = 1, weaponCount do
			local a = math.random() * math.pi * 2
			local r = castleRadius * (0.15 + math.random() * 0.6)
			local weaponId = Weapons.rollLootWeapon(function(lo, hi)
				return math.random(lo, hi)
			end)
			local cf = CFrame.new(center.X + math.cos(a) * r, topY + 0.5, center.Z + math.sin(a) * r)
				* CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
			WeaponService.spawnWeaponPickup(villageFolder, weaponId, cf)
		end
		local armorCount = (entry.Loot and entry.Loot.Armor) or 0
		if deps.spawnArmorPickup then
			for _ = 1, armorCount do
				local a = math.random() * math.pi * 2
				local r = castleRadius * (0.15 + math.random() * 0.6)
				local armorId = Armor.rollLootArmor(function(lo, hi)
					return math.random(lo, hi)
				end)
				deps.spawnArmorPickup(villageFolder, armorId, CFrame.new(center.X + math.cos(a) * r, topY + 0.4, center.Z + math.sin(a) * r))
			end
		end
		local chestCount = (entry.Loot and entry.Loot.Chests) or 0
		for i = 1, chestCount do
			local a = (i / math.max(chestCount, 1)) * math.pi * 2 + 0.6
			local r = castleRadius * (0.2 + math.random() * 0.5)
			buildChest(villageFolder, CFrame.new(center.X + math.cos(a) * r, topY + 0.85, center.Z + math.sin(a) * r), islandId, deps)
		end

		local merchantSpot = Vector3.new(center.X, topY + 2.5, center.Z + castleRadius + 16)
		return { villagerSpots = guardSpots, merchantSpot = merchantSpot }
	end

	-- Houses laid out around the heart. Towns get many more, spread over two rings so
	-- the settlement reads as a proper town you can wander through, not a tiny hamlet.
	local totalPop = (entry.Villagers and (entry.Villagers.Passive + entry.Villagers.Hostile)) or 0
	local houseCount
	if abandoned then
		houseCount = if isTown then math.random(10, 16) else math.random(5, 9)
	elseif isTown then
		-- Dense waterfront skyline from the town reference: close-set rooflines,
		-- multiple streets, and enough buildings to feel like a real port.
		houseCount = math.clamp(math.floor(totalPop / 2) + 16, 24, 40)
	else
		houseCount = math.clamp(math.floor(totalPop / 2) + 9, 12, 20)
	end

	-- A deliberate harbour-facing row gives living towns the layered dockside
	-- silhouette in the reference instead of leaving houses evenly scattered.
	if not abandoned and (isTown or theme == "fishing_village") then
		local waterfrontCount = if isTown then 7 else 5
		local waterfrontZ = center.Z + villageRadius * 0.72
		for i = 1, waterfrontCount do
			local alpha = if waterfrontCount == 1 then 0.5 else (i - 1) / (waterfrontCount - 1)
			local x = center.X + (alpha - 0.5) * villageRadius * 1.25
			local pos = Vector3.new(x, topY, waterfrontZ + math.sin(i * 1.9) * 4)
			buildHouse(villageFolder, CFrame.lookAt(pos, pos + Vector3.new(0, 0, 20)), {
				cobblestone = cobble,
				ruined = false,
				islandId = islandId,
			})
			table.insert(villagerSpots, pos + Vector3.new(0, 2.5, -8))
		end
	end
	local villagerSpots: { Vector3 } = {}

	for i = 1, houseCount do
		local a = (i / houseCount) * math.pi * 2 + math.random() * 0.3
		-- Towns fill an inner + outer ring so streets of houses stretch outward.
		local ringSpread = if isTown and i % 2 == 0 then 0.9 else 0.55
		local r = villageRadius * (ringSpread + math.random() * 0.4)
		local x = center.X + math.cos(a) * r
		local z = center.Z + math.sin(a) * r
		-- River settlements line both banks instead of dropping cottages into the
		-- channel. This creates the dense waterfront silhouette in the town reference
		-- while keeping the full raft-width waterway visibly open.
		if entry.River == true then
			local riverAngle = tonumber(entry.RiverAngle) or 0
			local riverYaw = math.atan2(math.cos(riverAngle), math.sin(riverAngle))
			local riverCf = CFrame.new(center.X, 0, center.Z) * CFrame.Angles(0, riverYaw, 0)
			local localPos = riverCf:PointToObjectSpace(Vector3.new(x, 0, z))
			local bankOffset = (tonumber(entry.RiverWidth) or 190) * 0.5 + 28
			if math.abs(localPos.X) < bankOffset then
				local side = if i % 2 == 0 then 1 else -1
				localPos = Vector3.new(side * bankOffset, 0, localPos.Z)
				local worldPos = riverCf:PointToWorldSpace(localPos)
				x, z = worldPos.X, worldPos.Z
			end
		end
		-- Face the house toward the village center
		local houseCf = CFrame.lookAt(Vector3.new(x, topY, z), Vector3.new(center.X, topY, center.Z))
		buildHouse(villageFolder, houseCf, {
			cobblestone = cobble,
			ruined = abandoned,
			islandId = islandId,
		})
		-- A villager spot by each house
		table.insert(villagerSpots, Vector3.new(x, topY + 2.5, z))
	end

	-- Central campfire (lit villages) or a cold ash pit (abandoned).
	if abandoned then
		makePart({
			Name = "ColdPit",
			Parent = villageFolder,
			Size = Vector3.new(4, 0.5, 4),
			CFrame = CFrame.new(center.X, topY + 0.3, center.Z),
			Color = ASH,
			Material = Enum.Material.Ground,
			CanCollide = false,
		})
	else
		buildCampfire(villageFolder, Vector3.new(center.X, topY + 0.3, center.Z))
	end

	-- Theme flavour: each settlement type gets a distinctive landmark so isles feel
	-- different at a glance (a fishing village reads nothing like a stone town).
	if not abandoned then
		if theme == "fishing_village" then
			for i = 1, 4 do
				local a = (i / 4) * math.pi * 2 + 0.4
				local r = villageRadius * 0.6
				local cf = CFrame.new(center.X + math.cos(a) * r, topY, center.Z + math.sin(a) * r)
				buildFishRack(villageFolder, cf)
			end
		elseif theme == "town" then
			for i = 1, 3 do
				local a = (i / 3) * math.pi * 2
				local r = villageRadius * 0.32
				local cf = CFrame.new(center.X + math.cos(a) * r, topY, center.Z + math.sin(a) * r)
				buildMarketStall(villageFolder, cf)
			end
		elseif theme == "stone_town" then
			buildWell(villageFolder, Vector3.new(center.X + villageRadius * 0.22, topY, center.Z))
			local towerPos = Vector3.new(center.X - villageRadius * 0.5, topY, center.Z - villageRadius * 0.4)
			buildWatchtower(villageFolder, towerPos)
			-- A climbable ladder so players can actually get up on the watchtower.
			buildLadder(villageFolder, towerPos + Vector3.new(3.4, 0, 0), 18)
		elseif cobble then
			buildWell(villageFolder, Vector3.new(center.X + villageRadius * 0.22, topY, center.Z))
		end
	end

	-- Grand landmarks: a church, manor houses, and street lamps that light up the town.
	if not abandoned then
		if entry.Church == true then
			-- Church sits on the near side of the square, facing the heart.
			local churchCf = CFrame.lookAt(
				Vector3.new(center.X, topY + 0.8, center.Z + villageRadius * 0.72),
				Vector3.new(center.X, topY + 0.8, center.Z)
			)
			buildChurch(villageFolder, churchCf, islandId)
		end

		local mansions = tonumber(entry.Mansions) or 0
		for i = 1, mansions do
			local a = (i / math.max(mansions, 1)) * math.pi * 2 + 1.1
			local r = villageRadius * 0.82
			local pos = Vector3.new(center.X + math.cos(a) * r, topY + 0.8, center.Z + math.sin(a) * r)
			buildMansion(villageFolder, CFrame.lookAt(pos, Vector3.new(center.X, topY + 0.8, center.Z)), cobble, islandId)
		end

		if entry.Lit == true then
			-- Street lamps ring the square and dot an inner path so the town glows.
			local lamps = math.clamp(math.floor(villageRadius / 10), 6, 16)
			for i = 1, lamps do
				local a = (i / lamps) * math.pi * 2
				local r = villageRadius * 0.55
				buildLampPost(villageFolder, Vector3.new(center.X + math.cos(a) * r, topY, center.Z + math.sin(a) * r))
			end
			for i = 1, 4 do
				local a = (i / 4) * math.pi * 2 + 0.5
				local r = villageRadius * 0.25
				buildLampPost(villageFolder, Vector3.new(center.X + math.cos(a) * r, topY, center.Z + math.sin(a) * r))
			end
		end

		-- A couple of derelict, abandoned huts on the outskirts of an otherwise living
		-- settlement — ruined shells to poke around in ("some houses abandoned").
		local ruins = if isTown then 3 else 2
		for i = 1, ruins do
			local a = (i / ruins) * math.pi * 2 + 2.3
			local r = villageRadius * (0.98 + math.random() * 0.22)
			local pos = Vector3.new(center.X + math.cos(a) * r, topY, center.Z + math.sin(a) * r)
			buildHouse(villageFolder, CFrame.lookAt(pos, Vector3.new(center.X, topY, center.Z)), {
				cobblestone = cobble,
				ruined = true,
				islandId = islandId,
			})
		end
	end

	-- Torch posts around the village (simple villages "with torches and stuff").
	local torchPosts = if abandoned then 2 else math.clamp(math.floor(villageRadius / 12), 4, 10)
	for i = 1, torchPosts do
		local a = (i / torchPosts) * math.pi * 2
		local r = villageRadius * 0.75
		local cf = CFrame.new(center.X + math.cos(a) * r, topY + 1.7, center.Z + math.sin(a) * r)
		local torch = LootPropFactory.createTorchWorld(villageFolder, cf)
		torch:SetAttribute("IslandId", islandId)
		-- Abandoned torches are unlit (kill the flame + light)
		if abandoned then
			for _, d in torch:GetDescendants() do
				if d:IsA("Fire") or d:IsA("PointLight") then
					d:Destroy()
				end
			end
		end
	end

	if not abandoned then
		buildFenceRing(villageFolder, center, topY, villageRadius * 0.95)
		
		-- Add cobblestone streets connecting the village
		buildCobblestoneStreets(villageFolder, center, topY, villagerSpots, villageRadius)
	end

	-- Weapon pickups scattered through the village (all villages have loot).
	local weaponCount = (entry.Loot and entry.Loot.Weapons) or 2
	for _ = 1, weaponCount do
		local a = math.random() * math.pi * 2
		local r = villageRadius * (0.2 + math.random() * 0.7)
		local weaponId = Weapons.rollLootWeapon(function(lo, hi)
			return math.random(lo, hi)
		end)
		local cf = CFrame.new(center.X + math.cos(a) * r, topY + 0.5, center.Z + math.sin(a) * r)
			* CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
		WeaponService.spawnWeaponPickup(villageFolder, weaponId, cf)
	end

	-- Armor pickups on display stands scattered through the settlement.
	local armorCount = (entry.Loot and entry.Loot.Armor) or 0
	if deps.spawnArmorPickup then
		for _ = 1, armorCount do
			local a = math.random() * math.pi * 2
			local r = villageRadius * (0.2 + math.random() * 0.7)
			local armorId = Armor.rollLootArmor(function(lo, hi)
				return math.random(lo, hi)
			end)
			local cf = CFrame.new(center.X + math.cos(a) * r, topY + 0.4, center.Z + math.sin(a) * r)
			deps.spawnArmorPickup(villageFolder, armorId, cf)
		end
	end

	-- Lootable chests.
	local chestCount = (entry.Loot and entry.Loot.Chests) or 0
	for i = 1, chestCount do
		local a = (i / math.max(chestCount, 1)) * math.pi * 2 + 0.6
		local r = villageRadius * (0.3 + math.random() * 0.5)
		local cf = CFrame.new(center.X + math.cos(a) * r, topY + 0.85, center.Z + math.sin(a) * r)
		buildChest(villageFolder, cf, islandId, deps)
	end

	local merchantSpot = Vector3.new(
		center.X + villageRadius * 0.35,
		topY + 2.5,
		center.Z + villageRadius * 0.15
	)

	-- Setup Level-of-Detail system for performance optimization
	setupBuildingLOD(model, center)

	return { villagerSpots = villagerSpots, merchantSpot = merchantSpot }
end

return VillageBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[-- Server authority for ALL weapons' ranged fire, ammo reserves, player currency,
-- weapon/ammo granting, world pickups and merchant crafting/buying grants.
--
-- Ammo reserves + currency live as Player attributes so they replicate to the owning
-- client for the HUD with no extra remote:
--   Ammo_<Type>  (e.g. Ammo_Bullet)   ·   Doubloons   ·   Scrap
--
-- Ranged fire is fully server-validated: cooldown, chamber (Tool "Loaded" attribute),
-- raycast (per-pellet spread), damage. Melee stays in MeleeService.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Weapons = require(Shared:WaitForChild("Weapons"))

local WeaponToolFactory = require(script.Parent:WaitForChild("Items"):WaitForChild("WeaponToolFactory"))

local WeaponService = {}

WeaponService._Toast = nil :: RemoteEvent?
WeaponService._WeaponFx = nil :: RemoteEvent?
WeaponService._lastShotAt = {} :: { [number]: number }
WeaponService._reloadingUntil = {} :: { [number]: number }
WeaponService._started = false
-- Optional hook: called when an NPC humanoid is damaged by a player (isle defense).
WeaponService.onNpcDamaged = nil :: ((Model, Player) -> ())?

local function toast(player: Player, message: string, kind: string)
	if WeaponService._Toast then
		WeaponService._Toast:FireClient(player, message, kind)
	end
end

-- === Currency & ammo (Player attributes) =================================

function WeaponService.getCurrency(player: Player, currencyId: string): number
	local def = Config.Currency[currencyId]
	if not def then
		return 0
	end
	local v = player:GetAttribute(def.Attribute)
	return if typeof(v) == "number" then v else 0
end

function WeaponService.addCurrency(player: Player, currencyId: string, amount: number)
	local def = Config.Currency[currencyId]
	if not def then
		return
	end
	local cur = WeaponService.getCurrency(player, currencyId)
	player:SetAttribute(def.Attribute, math.max(0, cur + amount))
end

function WeaponService.spendCurrency(player: Player, currencyId: string, amount: number): boolean
	local cur = WeaponService.getCurrency(player, currencyId)
	if cur < amount then
		return false
	end
	local def = Config.Currency[currencyId]
	player:SetAttribute(def.Attribute, cur - amount)
	return true
end

function WeaponService.getAmmo(player: Player, ammoId: string): number
	local attr = Weapons.ammoAttribute(ammoId)
	if not attr then
		return 0
	end
	local v = player:GetAttribute(attr)
	return if typeof(v) == "number" then v else 0
end

function WeaponService.giveAmmo(player: Player, ammoId: string, amount: number)
	local ammo = Weapons.Ammo[ammoId]
	if not ammo then
		return
	end
	local cur = WeaponService.getAmmo(player, ammoId)
	player:SetAttribute(ammo.Attribute, math.clamp(cur + amount, 0, ammo.Max))
end

function WeaponService.initPlayer(player: Player)
	for currencyId, def in Config.Currency do
		if player:GetAttribute(def.Attribute) == nil then
			player:SetAttribute(def.Attribute, def.StartAmount or 0)
		end
	end
	for _, ammo in Weapons.Ammo do
		if player:GetAttribute(ammo.Attribute) == nil then
			player:SetAttribute(ammo.Attribute, 0)
		end
	end
end

-- === Granting ============================================================

local function findWeaponTool(player: Player, weaponId: string): Tool?
	local function scan(container: Instance?): Tool?
		if not container then
			return nil
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("WeaponId") == weaponId then
				return child
			end
		end
		return nil
	end
	return scan(player:FindFirstChildOfClass("Backpack")) or scan(player.Character)
end

function WeaponService.giveWeapon(player: Player, weaponId: string, silent: boolean?): boolean
	local def = Weapons.get(weaponId)
	if not def then
		return false
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false
	end
	if findWeaponTool(player, weaponId) then
		if not silent then
			toast(player, `You already carry a {def.Name}.`, "info")
		end
		return false
	end
	local tool = WeaponToolFactory.createTool(weaponId)
	if not tool then
		return false
	end
	tool.Parent = backpack
	if not silent then
		toast(player, `Picked up a {def.Name}!`, "success")
	end
	return true
end

-- === World pickups =======================================================

function WeaponService.attachPickupPrompt(model: Model)
	local primary = model.PrimaryPart or model:FindFirstChild("Primary")
	if not (primary and primary:IsA("BasePart")) then
		return
	end
	if primary:FindFirstChild("WeaponPickupPrompt") then
		return
	end
	local weaponId = model:GetAttribute("WeaponId")
	local def = typeof(weaponId) == "string" and Weapons.get(weaponId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WeaponPickupPrompt"
	prompt.ActionText = "Take"
	prompt.ObjectText = if def then def.Name else "Weapon"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = Config.Loot.PickupPromptDistance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Parent = primary

	prompt.Triggered:Connect(function(player: Player)
		if typeof(weaponId) ~= "string" then
			return
		end
		if WeaponService.giveWeapon(player, weaponId) then
			-- Toss in a little starter ammo so a looted gun isn't dead weight.
			if def and def.Class == "ranged" and def.Ammo then
				WeaponService.giveAmmo(player, def.Ammo, Weapons.AmmoBundle[def.Ammo] or 6)
			end
			model:Destroy()
		end
	end)
end

function WeaponService.spawnWeaponPickup(parent: Instance, weaponId: string, cf: CFrame): Model?
	local model = WeaponToolFactory.createWorldPickup(parent, weaponId, cf)
	if model then
		WeaponService.attachPickupPrompt(model)
	end
	return model
end

-- === Ranged fire =========================================================

local function equippedRanged(player: Player): Tool?
	local character = player.Character
	if not character then
		return nil
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and (child:GetAttribute("Ranged") == true or child:GetAttribute("SurviveGun") == true) then
			return child
		end
	end
	return nil
end

local function weaponDefForTool(tool: Tool): { [string]: any }?
	local id = tool:GetAttribute("WeaponId")
	if typeof(id) == "string" then
		return Weapons.get(id)
	end
	-- Legacy flintlock (from old chests) behaves like a pistol with no ammo cost.
	if tool:GetAttribute("SurviveGun") == true then
		return {
			Id = "Flintlock",
			Name = "Flintlock",
			Class = "ranged",
			Damage = Config.Islands.Gun.Damage,
			Cooldown = Config.Islands.Gun.Cooldown,
			Range = Config.Islands.Gun.Range,
			Ammo = nil,
			MagSize = 1,
			Pellets = 1,
			Spread = 0.01,
			ReloadTime = 0,
		}
	end
	return nil
end

function WeaponService.reload(player: Player): boolean
	local tool = equippedRanged(player)
	if not tool then
		return false
	end
	local def = weaponDefForTool(tool)
	if not def or not def.Ammo then
		return false
	end
	local loaded = tool:GetAttribute("Loaded") or 0
	if typeof(loaded) ~= "number" then
		loaded = 0
	end
	local magSize = def.MagSize or 1
	if loaded >= magSize then
		return false
	end
	local reserve = WeaponService.getAmmo(player, def.Ammo)
	if reserve <= 0 then
		toast(player, `Out of {Weapons.Ammo[def.Ammo].Label}.`, "error")
		return false
	end
	local need = magSize - loaded
	local take = math.min(need, reserve)

	WeaponService._reloadingUntil[player.UserId] = os.clock() + (def.ReloadTime or 0)
	task.delay(def.ReloadTime or 0, function()
		if not player.Parent then
			return
		end
		local live = equippedRanged(player)
		if live ~= tool then
			return
		end
		-- Recompute reserve at completion in case it changed
		local reserveNow = WeaponService.giveAmmoConsume(player, def.Ammo, take)
		tool:SetAttribute("Loaded", (tool:GetAttribute("Loaded") or 0) + reserveNow)
	end)
	return true
end

-- Consume up to `amount` ammo from reserve; returns amount actually consumed.
function WeaponService.giveAmmoConsume(player: Player, ammoId: string, amount: number): number
	local have = WeaponService.getAmmo(player, ammoId)
	local take = math.min(have, amount)
	if take > 0 then
		local ammo = Weapons.Ammo[ammoId]
		player:SetAttribute(ammo.Attribute, have - take)
	end
	return take
end

function WeaponService.tryShoot(player: Player, look: Vector3): boolean
	if typeof(look) ~= "Vector3" then
		return false
	end
	local tool = equippedRanged(player)
	if not tool then
		return false
	end
	local def = weaponDefForTool(tool)
	if not def then
		return false
	end

	local now = os.clock()
	local last = WeaponService._lastShotAt[player.UserId] or 0
	if now - last < (def.Cooldown or 0.5) then
		return false
	end
	if (WeaponService._reloadingUntil[player.UserId] or 0) > now then
		return false
	end

	-- Ammo / chamber handling
	if def.Ammo then
		local loaded = tool:GetAttribute("Loaded")
		if typeof(loaded) ~= "number" then
			loaded = 0
		end
		if loaded <= 0 then
			-- Instant-draw weapons (bow) pull straight from the reserve.
			if (def.ReloadTime or 0) <= 0 and WeaponService.getAmmo(player, def.Ammo) > 0 then
				WeaponService.giveAmmoConsume(player, def.Ammo, 1)
				loaded = 1
			else
				toast(player, `Empty — press R to reload {Weapons.Ammo[def.Ammo].Label}.`, "error")
				return false
			end
		end
		tool:SetAttribute("Loaded", loaded - 1)
	end

	WeaponService._lastShotAt[player.UserId] = now

	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local originPart = if head and head:IsA("BasePart")
		then head
		elseif root and root:IsA("BasePart") then root
		else nil
	if not originPart then
		return false
	end

	local baseDir = look.Unit
	local origin = originPart.Position + baseDir * 1.5

	-- Broadcast FX (muzzle flash / tracer) so all clients can render the shot.
	if WeaponService._WeaponFx then
		WeaponService._WeaponFx:FireAllClients(player.UserId, def.Id, origin, baseDir)
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true

	local pellets = def.Pellets or 1
	local spread = def.Spread or 0
	local range = def.Range or 200

	for _ = 1, pellets do
		local dir = baseDir
		if spread > 0 then
			dir = (baseDir + Vector3.new(
				(math.random() - 0.5) * spread * 2,
				(math.random() - 0.5) * spread * 2,
				(math.random() - 0.5) * spread * 2
			)).Unit
		end

		local result = Workspace:Raycast(origin, dir * range, params)
		if result then
			local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
			if hitModel then
				local humanoid = hitModel:FindFirstChildOfClass("Humanoid")
				local isNpc = hitModel:GetAttribute("IsNpc") == true or hitModel:GetAttribute("IsPirate") == true
				if humanoid and humanoid.Health > 0 and isNpc then
					humanoid:TakeDamage(def.Damage)
					if WeaponService.onNpcDamaged then
						WeaponService.onNpcDamaged(hitModel, player)
					end
				end
			end
		end
	end

	return true
end

function WeaponService.start(remotes: {
	Toast: RemoteEvent,
	WeaponFx: RemoteEvent,
})
	if WeaponService._started then
		return
	end
	WeaponService._started = true
	WeaponService._Toast = remotes.Toast
	WeaponService._WeaponFx = remotes.WeaponFx

	for _, player in Players:GetPlayers() do
		WeaponService.initPlayer(player)
	end
	Players.PlayerAdded:Connect(function(player)
		WeaponService.initPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		WeaponService._lastShotAt[player.UserId] = nil
		WeaponService._reloadingUntil[player.UserId] = nil
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">WeatherService</string>
          <string name="Source"><![CDATA[-- Authoritative cosmetic weather schedule for the open sea.
-- Publishes Workspace attributes; clients apply FX only while in a crew.
-- Does not touch lobby geometry, portals, or LobbyWorld.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Weather = require(Shared:WaitForChild("Weather"))

local WeatherService = {}

local started = false
local bootTime = 0
local rng = Random.new()

local current: Weather.Mode = "Sunny"
local nextMode: Weather.Mode = "Sunny"
local phase: "Hold" | "Transition" = "Hold"
local phaseElapsed = 0
local phaseDuration = Weather.MinHoldSeconds
local nextLightningAt: number? = nil

local function publish(state: Weather.WeatherState)
	Workspace:SetAttribute(Weather.ATTR_FROM, state.fromMode)
	Workspace:SetAttribute(Weather.ATTR_TO, state.toMode)
	Workspace:SetAttribute(Weather.ATTR_BLEND, state.blend)
	Workspace:SetAttribute(Weather.ATTR_RAIN, state.rain)
	Workspace:SetAttribute(Weather.ATTR_CLOUD, state.cloud)
	Workspace:SetAttribute(Weather.ATTR_THUNDER, state.thunderChance)
	Workspace:SetAttribute(Weather.ATTR_SUN, state.sun)
	Workspace:SetAttribute(Weather.ATTR_VOYAGE, state.voyageAge)
end

local function currentState(): Weather.WeatherState
	local voyage = Weather.voyageAge(Workspace:GetServerTimeNow() - bootTime)
	if phase == "Hold" then
		return Weather.makeState(current, current, 1, voyage)
	end
	local blend = if phaseDuration > 0 then phaseElapsed / phaseDuration else 1
	return Weather.makeState(current, nextMode, blend, voyage)
end

local function scheduleLightning(state: Weather.WeatherState, now: number)
	local mean = Weather.lightningInterval(state.thunderChance)
	if not mean then
		nextLightningAt = nil
		return
	end
	-- Jitter around the mean so strikes feel organic.
	local gap = rng:NextNumber(mean * 0.55, mean * 1.45)
	nextLightningAt = now + gap
end

local function maybeStrike(state: Weather.WeatherState, now: number)
	if state.thunderChance < 0.12 then
		nextLightningAt = nil
		return
	end
	if nextLightningAt == nil then
		scheduleLightning(state, now)
		return
	end
	if now < nextLightningAt then
		return
	end
	-- Cosmetic flash marker — clients render local lightning only at sea.
	Workspace:SetAttribute(Weather.ATTR_FLASH, now)
	scheduleLightning(state, now)
end

local function beginHold(mode: Weather.Mode)
	current = mode
	nextMode = mode
	phase = "Hold"
	phaseElapsed = 0
	phaseDuration = Weather.holdDuration(rng)
end

local function beginTransition(fromMode: Weather.Mode, toMode: Weather.Mode, voyageAge: number)
	current = fromMode
	nextMode = toMode
	phase = "Transition"
	phaseElapsed = 0
	phaseDuration = Weather.transitionDuration(rng)
	-- Slightly longer fades when entering/leaving storms so they feel heavier.
	if toMode == "Thunderstorm" or fromMode == "Thunderstorm" then
		phaseDuration = math.max(phaseDuration, Weather.MaxTransitionSeconds * 0.85)
	end
	-- Prefer settling into something else rather than looping the same label.
	if fromMode == toMode then
		nextMode = Weather.pickNext(rng, fromMode, voyageAge)
	end
end

function WeatherService.start()
	if started then
		return
	end
	started = true
	bootTime = Workspace:GetServerTimeNow()

	-- Open on a calm sea; weather builds gradually as the session ages.
	beginHold("Sunny")
	publish(currentState())

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		phaseElapsed += dt

		local now = Workspace:GetServerTimeNow()
		local voyage = Weather.voyageAge(now - bootTime)

		if phase == "Hold" then
			if phaseElapsed >= phaseDuration then
				local pick = Weather.pickNext(rng, current, voyage)
				if pick == current then
					-- Rare same-mode "refresh" — just hold again so we don't thrash.
					beginHold(current)
				else
					beginTransition(current, pick, voyage)
				end
			end
		elseif phase == "Transition" then
			if phaseElapsed >= phaseDuration then
				beginHold(nextMode)
			end
		end

		local state = currentState()
		maybeStrike(state, now)

		-- Publish often enough for smooth client blends without flooding.
		if accum >= 0.2 then
			accum = 0
			publish(state)
		end
	end)

	print("[SurviveAtSea] Weather service started — gradual open-sea atmosphere (cosmetic)")
end

return WeatherService
]]></string>
        </Properties>
      </Item>
    </Item>
